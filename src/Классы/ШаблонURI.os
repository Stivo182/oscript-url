#Использовать errors
#Использовать "../internal"

Перем _Представление; // Строка
Перем _ПодготовленныйШаблон; // ФиксированнаяСтруктура
Перем _ОбработчикВыражений; // ОбработчикВыраженийШаблонаURI

#Область ОбработчикиСобытий

// Создаёт шаблон URI по RFC 6570.
//
// Ссылки:
//  RFC 6570 - шаблоны URI:
//  https://www.rfc-editor.org/rfc/rfc6570.html
//
// Параметры:
//  Представление - Строка - Представление шаблона URI.
//
// Исключения:
//  argument.invalid_type - Представление не является строкой.
//  url.template.invalid_syntax.* - Представление нарушает грамматику шаблона URI.
Процедура ПриСозданииОбъекта(Представление)

	ПроверкаАргументов.ПроверитьТип("Представление", Представление, Тип("Строка"));

	РазобранныйШаблон = СервисыБиблиотекиURL.РазборщикШаблонаURI().Разобрать(Представление);

	_Представление = Представление;
	_ОбработчикВыражений = СервисыБиблиотекиURL.ОбработчикВыраженийШаблонаURI();
	_ПодготовленныйШаблон = _ОбработчикВыражений.Подготовить(РазобранныйШаблон);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Раскрывает шаблон именованными значениями.
//
// Параметры:
//  Значения - Соответствие, ФиксированноеСоответствие, Структура, ФиксированнаяСтруктура,
//             Неопределено - Именованные значения переменных.
//
// Возвращаемое значение:
//  URL - Новая URI-ссылка.
//
// Исключения:
//  argument.invalid_type - Передан недопустимый тип коллекции, ключа или значения.
//  argument.invalid_value.* - Значение нарушает ограничения раскрытия шаблона URI.
//  url.invalid_syntax - Результат раскрытия нарушает общую грамматику URI.
//  url.invalid_scheme - Результат содержит схему с недопустимым синтаксисом.
//  url.invalid_percent_encoding - Результат содержит недопустимую последовательность %HH.
//  url.invalid_authority - Результат содержит недопустимую серверную часть.
//  url.invalid_host - Результат содержит хост с недопустимым синтаксисом.
Функция Раскрыть(Значения = Неопределено) Экспорт

	ПредставлениеURL = _ОбработчикВыражений.Раскрыть(
		_ПодготовленныйШаблон,
		Значения
	);

	Возврат Новый URL(ПредставлениеURL);

КонецФункции

// Возвращает имена переменных шаблона.
//
// Возвращаемое значение:
//  Массив - Новая изменяемая копия уникальных имён в порядке первого появления.
Функция ИменаПеременных() Экспорт

	Имена = Новый Массив;
	Для Каждого Имя Из _ПодготовленныйШаблон.ИменаПеременных Цикл
		Имена.Добавить(Имя);
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Возвращает исходное представление шаблона.
//
// Возвращаемое значение:
//  Строка - Исходное представление без нормализации.
Функция ВСтроку() Экспорт

	Возврат _Представление;

КонецФункции

#КонецОбласти
