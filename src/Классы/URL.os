#Использовать errors
#Использовать "../internal"

Перем _Схема; // Строка, Неопределено
Перем _СервернаяЧастьОпределена; // Булево
Перем _ДанныеПользователяОпределены; // Булево
Перем _КодированныеДанныеПользователя; // Строка, Неопределено
Перем _КодированныйХост; // Строка, Неопределено
Перем _ВидХоста; // Строка, Неопределено
Перем _ПортУказан; // Булево
Перем _ТекстПорта; // Строка, Неопределено
Перем _КодированныйПуть; // Строка
Перем _ЗапросОпределен; // Булево
Перем _КодированныйЗапрос; // Строка, Неопределено
Перем _ФрагментОпределен; // Булево
Перем _КодированныйФрагмент; // Строка, Неопределено
Перем _ПредставлениеДанныхПользователя; // Строка, Неопределено
Перем _ПредставлениеХоста; // Строка, Неопределено
Перем _ПредставлениеПути; // Строка
Перем _ПредставлениеЗапроса; // Строка, Неопределено
Перем _ПредставлениеФрагмента; // Строка, Неопределено
Перем _ОпределительСтандартногоПорта; // ОпределительСтандартногоПортаURI, Неопределено

#Область ОбработчикиСобытий

// Создаёт URL из URI-ссылки с необязательной абсолютной базой.
// Относительная ссылка разрешается по RFC 3986 §5.2.
//
// Ссылки:
//  RFC 3986, раздел 5.2 - разрешение относительных ссылок:
//  https://www.rfc-editor.org/rfc/rfc3986.html#section-5.2
//
// Параметры:
//  Адрес - Строка, URL, Неопределено - Адрес ссылки.
//  База - Строка, URL, Неопределено - Абсолютная база для разрешения ссылки.
//
// Исключения:
//  argument.invalid_type - Адрес или База имеет недопустимый тип.
//  argument.required - При указанной базе не заполнен Адрес.
//  url.base_not_absolute - База не является абсолютной.
//  url.invalid_syntax - Строка Адреса или Базы нарушает общую грамматику URI.
//  url.invalid_scheme - Схема строки Адреса или Базы имеет недопустимый синтаксис.
//  url.invalid_percent_encoding - Строка Адреса или Базы содержит недопустимую последовательность %HH.
//  url.invalid_authority - Серверная часть строки Адреса или Базы имеет недопустимую структуру.
//  url.invalid_host - Хост строки Адреса или Базы имеет недопустимый синтаксис.
Процедура ПриСозданииОбъекта(Адрес = Неопределено, База = Неопределено)

	Если База = Неопределено Тогда
		Если Адрес = Неопределено Тогда
			УстановитьКомпоненты("");
			Возврат;
		КонецЕсли;

		УстановитьКомпоненты(СтрокаАдреса("Адрес", Адрес));
		Возврат;
	КонецЕсли;

	Если Адрес = Неопределено Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыСтандартныхОшибок.АргументНеЗаполнен(),
			"Не заполнен обязательный аргумент Адрес",
			Новый Структура("ИмяАргумента", "Адрес")
		);
	КонецЕсли;

	АдресURL = Новый URL(СтрокаАдреса("Адрес", Адрес));
	БазаURL = Новый URL(СтрокаАдреса("База", База));

	Если БазаURL.Схема() = Неопределено Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыОшибокURL.БазаНеАбсолютная(),
			"База URL должна быть абсолютной"
		);
	КонецЕсли;

	Результат = СервисыБиблиотекиURL.РазрешительURI().Разрешить(БазаURL, АдресURL);
	ЗаполнитьКомпоненты(Результат.СнимокКомпонентов());

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет наличие схемы.
//
// Возвращаемое значение:
//  Булево - Истина, если URL содержит схему.
Функция ЯвляетсяАбсолютным() Экспорт

	Возврат _Схема <> Неопределено;

КонецФункции

// Возвращает URL в исходном написании без потерь.
//
// Возвращаемое значение:
//  Строка - URL в исходном написании.
Функция ВСтроку() Экспорт

	Возврат СобратьПредставление(Истина);

КонецФункции

// Возвращает ASCII-представление URL.
//
// Возвращаемое значение:
//  Строка - URL из символов ASCII по RFC 3986.
Функция КодированноеПредставление() Экспорт

	Возврат СобратьПредставление(Ложь);

КонецФункции

// Возвращает схему URL по RFC 3986 §3.1.
//
// Возвращаемое значение:
//  Строка, Неопределено - Схема или Неопределено для относительной ссылки.
Функция Схема() Экспорт

	Возврат _Схема;

КонецФункции

// Возвращает декодированную серверную часть по RFC 3986 §3.2.
//
// Возвращаемое значение:
//  Строка, Неопределено - Серверная часть или Неопределено при её отсутствии.
//
// Исключения:
//  encoding.invalid - Декодируемый компонент не образует корректный UTF-8.
//  idna.data.invalid - Встроенные данные IDNA повреждены или несовместимы.
Функция СервернаяЧасть() Экспорт

	Если Не _СервернаяЧастьОпределена Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = "";

	Если _ДанныеПользователяОпределены Тогда
		Результат = ДанныеПользователя() + "@";
	КонецЕсли;

	Результат = Результат + Хост();

	Если _ПортУказан Тогда
		Результат = Результат + ":" + ТекстПорта();
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает кодированную серверную часть по RFC 3986 §3.2.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированная серверная часть или Неопределено при её отсутствии.
Функция КодированнаяСервернаяЧасть() Экспорт

	Возврат СобратьСервернуюЧасть(Ложь);

КонецФункции

// Возвращает декодированные данные пользователя по RFC 3986 §3.2.1.
//
// Возвращаемое значение:
//  Строка, Неопределено - Данные пользователя или Неопределено при их отсутствии.
//
// Исключения:
//  encoding.invalid - Процентные байты не образуют корректный UTF-8.
Функция ДанныеПользователя() Экспорт

	Возврат ДекодироватьНеобязательныйКомпонент(КодированныеДанныеПользователя());

КонецФункции

// Возвращает кодированные данные пользователя по RFC 3986 §3.2.1.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированные данные пользователя или Неопределено при их отсутствии.
Функция КодированныеДанныеПользователя() Экспорт

	Возврат ?(_ДанныеПользователяОпределены, _КодированныеДанныеПользователя, Неопределено);

КонецФункции

// Возвращает декодированный хост по RFC 3986 §3.2.2.
//
// Возвращаемое значение:
//  Строка, Неопределено - Хост или Неопределено при его отсутствии.
//
// Исключения:
//  encoding.invalid - Процентные байты имени не образуют корректный UTF-8.
//  idna.data.invalid - Встроенные данные IDNA повреждены или несовместимы.
Функция Хост() Экспорт

	КодированноеЗначение = КодированныйХост();

	Если КодированноеЗначение = Неопределено Или Лев(КодированноеЗначение, 1) = "[" Тогда
		Возврат КодированноеЗначение;
	КонецЕсли;

	Возврат ДекодироватьAMеткиХоста(ДекодироватьКомпонент(КодированноеЗначение));

КонецФункции

// Возвращает IDN-хост. Зарегистрированное имя строго проверяется по UTS #46
// и преобразуется в Punycode с непереходной обработкой. ASCII-метка не длиннее 63 октетов,
// содержит только буквы, цифры и дефис, который не может быть первым или последним.
// Полное ASCII-имя без завершающей точки не длиннее 253 октетов.
// IP-литералы сохраняют квадратные скобки.
//
// Возвращаемое значение:
//  Строка, Неопределено - IDN-хост или Неопределено при отсутствии хоста.
//
// Исключения:
//  encoding.invalid - Процентные байты имени не образуют корректный UTF-8.
//  url.invalid_host - Зарегистрированное имя не соответствует требованиям IDNA.
//  idna.data.invalid - Встроенные данные IDNA повреждены или несовместимы.
Функция IDNХост() Экспорт

	КодированноеЗначение = КодированныйХост();

	Если КодированноеЗначение = Неопределено Или Лев(КодированноеЗначение, 1) = "[" Тогда
		Возврат КодированноеЗначение;
	КонецЕсли;

	ДекодированныйХост = ДекодироватьКомпонент(КодированноеЗначение);

	Попытка
		Результат = СервисыБиблиотекиURL.ПреобразовательДоменов().Кодировать(ДекодированныйХост, Ложь, Истина);
		ПроверитьДопустимостьIDNХоста(Результат);
		Возврат Результат;
	Исключение
		Причина = ИнформацияОбОшибке();

		Если ДиагностикаОшибок.КодОшибки(Причина)
			= КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента() Тогда
			ВызватьИсключение ФабрикаОшибок.Обернуть(
				Причина,
				КодыОшибокURL.НедопустимыйХост(),
				"Недопустимый IDN-хост URL"
			);
		КонецЕсли;

		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Возвращает синтаксический вид хоста по RFC 3986 §3.2.2.
//
// Возвращаемое значение:
//  Строка, Неопределено - Значение ВидыХостаURL или Неопределено без серверной части.
Функция ВидХоста() Экспорт

	Возврат _ВидХоста;

КонецФункции

// Возвращает кодированный хост по RFC 3986 §3.2.2.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированный хост или Неопределено при его отсутствии.
Функция КодированныйХост() Экспорт

	Возврат ?(_СервернаяЧастьОпределена, _КодированныйХост, Неопределено);

КонецФункции

// Возвращает исходный текст порта по RFC 3986 §3.2.3.
//
// Возвращаемое значение:
//  Строка, Неопределено - Текст порта или Неопределено при его отсутствии.
Функция ТекстПорта() Экспорт

	Возврат ?(_ПортУказан, _ТекстПорта, Неопределено);

КонецФункции

// Возвращает числовое значение порта.
//
// Возвращаемое значение:
//  Число, Неопределено - Порт или Неопределено при отсутствии либо пустом значении.
//
// Исключения:
//  url.port.numeric_overflow - Текст порта невозможно точно представить числом.
Функция Порт() Экспорт

	Текст = ТекстПорта();

	Если Текст = Неопределено Или Текст = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЗначениеПорта = Число(Текст);
	Исключение
		ВызватьПереполнениеЧисловогоПорта();
	КонецПопытки;

	Если НормализоватьДесятичноеЧисло(Формат(ЗначениеПорта, "ЧГ=0"))
		<> НормализоватьДесятичноеЧисло(Текст) Тогда
		ВызватьПереполнениеЧисловогоПорта();
	КонецЕсли;

	Возврат ЗначениеПорта;

КонецФункции

// Возвращает стандартный порт схемы.
//
// Возвращаемое значение:
//  Число, Неопределено - Стандартный порт или Неопределено для неизвестной схемы.
Функция СтандартныйПорт() Экспорт

	Возврат ОпределительСтандартногоПорта().Определить(Схема());

КонецФункции

// Возвращает явно указанный непустой порт.
// Если порт отсутствует или указан пустым, возвращает стандартный порт схемы.
// Метод не изменяет URL и не проверяет доступность сетевого порта.
//
// Возвращаемое значение:
//  Число, Неопределено - Явный или стандартный порт; Неопределено для
//  неизвестной схемы без явного непустого порта.
//
// Исключения:
//  url.port.numeric_overflow - Явный порт невозможно точно представить числом.
Функция ЭффективныйПорт() Экспорт

	Текст = ТекстПорта();
	Возврат ?(Текст = Неопределено Или Текст = "", СтандартныйПорт(), Порт());

КонецФункции

// Проверяет использование стандартного порта схемы.
//
// Возвращаемое значение:
//  Булево - Истина, если URL использует стандартный порт.
Функция ИспользуетСтандартныйПорт() Экспорт

	Стандартный = СтандартныйПорт();

	Если Стандартный = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Текст = ТекстПорта();

	Если Текст = Неопределено Или Текст = "" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат НормализоватьДесятичноеЧисло(Текст) = Формат(Стандартный, "ЧГ=0");

КонецФункции

// Возвращает декодированный путь по RFC 3986 §3.3.
//
// Возвращаемое значение:
//  Строка - Декодированный путь.
//
// Исключения:
//  encoding.invalid - Процентные байты не образуют корректный UTF-8.
Функция Путь() Экспорт

	Возврат ДекодироватьКомпонент(КодированныйПуть());

КонецФункции

// Возвращает кодированный путь по RFC 3986 §3.3.
//
// Возвращаемое значение:
//  Строка - Кодированный путь.
Функция КодированныйПуть() Экспорт

	Возврат _КодированныйПуть;

КонецФункции

// Возвращает декодированные сегменты пути по RFC 3986 §3.3.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Неизменяемый массив декодированных сегментов пути.
//
// Исключения:
//  encoding.invalid - Процентные байты сегмента не образуют корректный UTF-8.
Функция СегментыПути() Экспорт

	Сегменты = Новый Массив;

	Для Каждого КодированныйСегмент Из РазделитьПутьНаСегменты(КодированныйПуть()) Цикл
		Сегменты.Добавить(ДекодироватьКомпонент(КодированныйСегмент));
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Сегменты);

КонецФункции

// Возвращает кодированные сегменты пути по RFC 3986 §3.3.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Неизменяемый массив кодированных сегментов пути.
Функция КодированныеСегментыПути() Экспорт

	Возврат Новый ФиксированныйМассив(РазделитьПутьНаСегменты(КодированныйПуть()));

КонецФункции

// Возвращает кодированные путь и строку запроса.
//
// Возвращаемое значение:
//  Строка - Кодированные путь и строка запроса.
Функция ПутьИСтрокаЗапроса() Экспорт

	Результат = КодированныйПуть();

	Если КодированнаяСтрокаЗапроса() <> Неопределено Тогда
		Результат = Результат + "?" + КодированнаяСтрокаЗапроса();
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает декодированную строку запроса по RFC 3986 §3.4.
//
// Возвращаемое значение:
//  Строка, Неопределено - Строка запроса или Неопределено при её отсутствии.
//
// Исключения:
//  encoding.invalid - Процентные байты не образуют корректный UTF-8.
Функция СтрокаЗапроса() Экспорт

	Возврат ДекодироватьНеобязательныйКомпонент(КодированнаяСтрокаЗапроса());

КонецФункции

// Возвращает кодированную строку запроса по RFC 3986 §3.4.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированная строка запроса или Неопределено при её отсутствии.
Функция КодированнаяСтрокаЗапроса() Экспорт

	Возврат ?(_ЗапросОпределен, _КодированныйЗапрос, Неопределено);

КонецФункции

// Возвращает связанную с URL коллекцию параметров запроса формы.
// Чтение коллекции сохраняет исходное написание запроса, а её изменение сериализует запрос
// по алгоритму application/x-www-form-urlencoded WHATWG URL §5.
//
// Ссылки:
//  RFC 3986, раздел 3.4 - компонент запроса:
//  https://www.rfc-editor.org/rfc/rfc3986.html#section-3.4
//  WHATWG URL, раздел 5 - form-urlencoded:
//  https://url.spec.whatwg.org/#application-x-www-form-urlencoded
//
// Возвращаемое значение:
//  ПараметрыЗапросаURL - Связанная с текущим URL коллекция параметров.
Функция ПараметрыЗапроса() Экспорт

	СтрокаПараметров = КодированнаяСтрокаЗапроса();

	Если СтрокаПараметров = Неопределено Тогда
		СтрокаПараметров = "";
	КонецЕсли;

	Возврат Новый ПараметрыЗапросаURL(СтрокаПараметров, ЭтотОбъект);

КонецФункции

// Копирует параметры в компонент запроса URL.
//
// Параметры:
//  Значение - ПараметрыЗапросаURL - Копируемая коллекция.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
Функция УстановитьПараметрыЗапроса(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип(
		"Значение", Значение, "ПараметрыЗапросаURL"
	);

	СтрокаПараметров = Значение.ВСтроку();

	Если СтрокаПараметров = "" Тогда
		Возврат УдалитьЗапрос();
	КонецЕсли;

	Возврат УстановитьКодированнуюСтрокуЗапроса(СтрокаПараметров);

КонецФункции

// Возвращает декодированный фрагмент по RFC 3986 §3.5.
//
// Возвращаемое значение:
//  Строка, Неопределено - Фрагмент или Неопределено при его отсутствии.
//
// Исключения:
//  encoding.invalid - Процентные байты не образуют корректный UTF-8.
Функция Фрагмент() Экспорт

	Возврат ДекодироватьНеобязательныйКомпонент(КодированныйФрагмент());

КонецФункции

// Возвращает кодированный фрагмент по RFC 3986 §3.5.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированный фрагмент или Неопределено при его отсутствии.
Функция КодированныйФрагмент() Экспорт

	Возврат ?(_ФрагментОпределен, _КодированныйФрагмент, Неопределено);

КонецФункции

// Устанавливает схему абсолютного URL по RFC 3986 §3.1.
//
// Параметры:
//  Значение - Строка - Схема URL.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  url.invalid_scheme - Значение не соответствует грамматике схемы.
Функция УстановитьСхему(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	Кандидат = СкопироватьКомпоненты();
	Кандидат.Схема = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьСхему(Значение);

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает декодированную структурную серверную часть по RFC 3986 §3.2.
// Разделители @, :, [ и ] интерпретируются как синтаксис серверной части.
//
// Параметры:
//  Значение - Строка, Неопределено - Серверная часть или признак её удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
//  url.invalid_authority - Серверная часть имеет недопустимую структуру.
//  url.invalid_host - Хост имеет недопустимый синтаксис.
Функция УстановитьСервернуюЧасть(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат УдалитьСервернуюЧасть();
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	РазборщикКомпонентов = СервисыБиблиотекиURL.РазборщикКомпонентовURL();
	КомпонентыСервернойЧасти = РазборщикКомпонентов.РазобратьДекодированнуюСервернуюЧасть(Значение);
	Кандидат = СкопироватьКомпоненты();
	ЗаполнитьСервернуюЧастьКандидата(Кандидат, КомпонентыСервернойЧасти);

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает кодированную серверную часть по RFC 3986 без изменения исходного написания.
//
// Параметры:
//  Значение - Строка, Неопределено - Кодированная серверная часть или признак её удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  url.invalid_syntax - Значение нарушает общую грамматику URI.
//  url.invalid_percent_encoding - Значение содержит недопустимую последовательность %HH.
//  url.invalid_authority - Значение имеет недопустимую структуру серверной части.
//  url.invalid_host - Хост значения имеет недопустимый синтаксис.
Функция УстановитьКодированнуюСервернуюЧасть(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат УдалитьСервернуюЧасть();
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	РазборщикКомпонентов = СервисыБиблиотекиURL.РазборщикКомпонентовURL();
	КомпонентыСервернойЧасти = РазборщикКомпонентов.РазобратьКодированнуюСервернуюЧасть(Значение);
	Кандидат = СкопироватьКомпоненты();
	ЗаполнитьСервернуюЧастьКандидата(Кандидат, КомпонентыСервернойЧасти);

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает декодированные данные пользователя по RFC 3986 §3.2.1.
//
// Параметры:
//  Значение - Строка, Неопределено - Данные пользователя или признак их удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Функция УстановитьДанныеПользователя(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат УстановитьКодированныеДанныеПользователя(Неопределено);
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	ПодготовленноеЗначение = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьДанныеПользователя(Значение);
	Кандидат = СкопироватьКомпоненты();
	ОбеспечитьСервернуюЧасть(Кандидат);
	Кандидат.ДанныеПользователяОпределены = Истина;
	Кандидат.КодированныеДанныеПользователя = ПодготовленноеЗначение.КодированноеЗначение;
	Кандидат.ПредставлениеДанныхПользователя = ПодготовленноеЗначение.Представление;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает кодированные данные пользователя без завершающего @ и без изменения исходного написания.
//
// Параметры:
//  Значение - Строка, Неопределено - Кодированные данные пользователя или признак их удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  url.invalid_syntax - Значение содержит недопустимый символ.
//  url.invalid_authority - Значение нарушает структуру данных пользователя.
//  url.invalid_percent_encoding - Значение содержит недопустимую последовательность %HH.
Функция УстановитьКодированныеДанныеПользователя(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Кандидат = СкопироватьКомпоненты();
		Кандидат.ДанныеПользователяОпределены = Ложь;
		Кандидат.КодированныеДанныеПользователя = Неопределено;
		Кандидат.ПредставлениеДанныхПользователя = Неопределено;
		Возврат ПрименитьКандидат(Кандидат);
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));
	РазборщикКомпонентов = СервисыБиблиотекиURL.РазборщикКомпонентовURL();
	ПодготовленноеЗначение = РазборщикКомпонентов.ПроверитьКодированныеДанныеПользователя(Значение);

	Кандидат = СкопироватьКомпоненты();
	ОбеспечитьСервернуюЧасть(Кандидат);
	Кандидат.ДанныеПользователяОпределены = Истина;
	Кандидат.КодированныеДанныеПользователя = ПодготовленноеЗначение.КодированноеЗначение;
	Кандидат.ПредставлениеДанныхПользователя = ПодготовленноеЗначение.Представление;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает декодированный хост по RFC 3986 §3.2.2.
// IPv6 без скобок автоматически получает обязательные квадратные скобки.
// Символы Unicode сохраняются в представлении URL, а каждый байт их представления в UTF-8 записывается как %HH.
//
// Параметры:
//  Значение - Строка - Хост URL.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
//  url.invalid_host - Хост имеет недопустимый синтаксис.
Функция УстановитьХост(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	ПодготовленныйХост = СервисыБиблиотекиURL.РазборщикКомпонентовURL().РазобратьДекодированныйХост(Значение);

	Кандидат = СкопироватьКомпоненты();
	ОбеспечитьСервернуюЧасть(Кандидат);
	Кандидат.КодированныйХост = ПодготовленныйХост.КодированныйХост;
	Кандидат.ВидХоста = ПодготовленныйХост.ВидХоста;
	Кандидат.ПредставлениеХоста = ПодготовленныйХост.Представление;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает кодированный хост по RFC 3986 без изменения исходного написания.
// IPv6 и IPvFuture должны быть заключены в квадратные скобки.
//
// Параметры:
//  Значение - Строка - Кодированный хост URL.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  url.invalid_syntax - Значение содержит недопустимый символ.
//  url.invalid_percent_encoding - Значение содержит недопустимую последовательность %HH.
//  url.invalid_host - Хост имеет недопустимый синтаксис.
Функция УстановитьКодированныйХост(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));
	ПодготовленныйХост = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПроверитьКодированныйХост(Значение);

	Кандидат = СкопироватьКомпоненты();
	ОбеспечитьСервернуюЧасть(Кандидат);
	Кандидат.КодированныйХост = ПодготовленныйХост.КодированноеЗначение;
	Кандидат.ВидХоста = ПодготовленныйХост.ВидХоста;
	Кандидат.ПредставлениеХоста = ПодготовленныйХост.Представление;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает порт по RFC 3986 §3.2.3 без ограничения диапазоном 65535.
//
// Параметры:
//  Значение - Строка, Число, Неопределено - Порт либо признак его удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  argument.invalid_value - Передано отрицательное или дробное число либо строка, содержащая не только цифры ASCII.
Функция УстановитьПорт(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Кандидат = СкопироватьКомпоненты();
		Кандидат.ПортУказан = Ложь;
		Кандидат.ТекстПорта = Неопределено;
		Возврат ПрименитьКандидат(Кандидат);
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, "Строка, Число");

	ТекстПорта = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьПорт(Значение);

	Кандидат = СкопироватьКомпоненты();
	ОбеспечитьСервернуюЧасть(Кандидат);
	Кандидат.ПортУказан = Истина;
	Кандидат.ТекстПорта = ТекстПорта;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает декодированный путь с сохранением структурных разделителей / по RFC 3986 §3.3.
//
// Параметры:
//  Значение - Строка - Декодированный путь URL.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Функция УстановитьПуть(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	ПодготовленныйПуть = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьПуть(Значение);

	Кандидат = СкопироватьКомпоненты();
	Кандидат.КодированныйПуть = ПодготовленныйПуть.КодированноеЗначение;
	Кандидат.ПредставлениеПути = ПодготовленныйПуть.Представление;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает кодированный путь без изменения его исходного написания по RFC 3986 §3.3.
//
// Параметры:
//  Значение - Строка - Кодированный путь URL.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  url.invalid_syntax - Значение содержит недопустимый символ.
//  url.invalid_percent_encoding - Значение содержит недопустимую последовательность %HH.
Функция УстановитьКодированныйПуть(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	ПодготовленныйПуть = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПроверитьКодированныйПуть(Значение);

	Кандидат = СкопироватьКомпоненты();
	Кандидат.КодированныйПуть = ПодготовленныйПуть.КодированноеЗначение;
	Кандидат.ПредставлениеПути = ПодготовленныйПуть.Представление;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Добавляет декодированный сегмент пути по RFC 3986 §3.3, кодируя / внутри сегмента как %2F.
//
// Параметры:
//  Сегмент - Строка - Декодированный сегмент пути.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Сегмент имеет недопустимый тип.
//  url.invalid_syntax - Сегмент содержит недопустимую кодовую точку Unicode.
Функция ДобавитьСегментПути(Сегмент) Экспорт

	ПроверкаАргументов.ПроверитьТип("Сегмент", Сегмент, Тип("Строка"));

	Кандидат = СкопироватьКомпоненты();
	ДобавитьСегментВПредставленияПути(Кандидат, Сегмент);

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Добавляет декодированные сегменты пути по RFC 3986 §3.3.
//
// Параметры:
//  Сегменты - Массив, ФиксированныйМассив - Декодированные сегменты пути.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Аргумент или один из элементов коллекции имеет недопустимый тип.
//  url.invalid_syntax - Сегмент содержит недопустимую кодовую точку Unicode.
Функция ДобавитьСегментыПути(Сегменты) Экспорт

	ПроверкаАргументов.ПроверитьТип("Сегменты", Сегменты, "Массив, ФиксированныйМассив");

	Для Каждого Сегмент Из Сегменты Цикл
		ПроверкаАргументов.ПроверитьТип("Сегмент", Сегмент, Тип("Строка"));
	КонецЦикла;

	Кандидат = СкопироватьКомпоненты();

	Для Каждого Сегмент Из Сегменты Цикл
		ДобавитьСегментВПредставленияПути(Кандидат, Сегмент);
	КонецЦикла;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает декодированную строку запроса по RFC 3986 §3.4.
//
// Параметры:
//  Значение - Строка, Неопределено - Декодированная строка запроса или признак её удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Функция УстановитьСтрокуЗапроса(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат УдалитьЗапрос();
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	ПодготовленныйЗапрос = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьЗапрос(Значение);

	Кандидат = СкопироватьКомпоненты();
	Кандидат.ЗапросОпределен = Истина;
	Кандидат.КодированныйЗапрос = ПодготовленныйЗапрос.КодированноеЗначение;
	Кандидат.ПредставлениеЗапроса = ПодготовленныйЗапрос.Представление;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает кодированную строку запроса без изменения её исходного написания по RFC 3986 §3.4.
//
// Параметры:
//  Значение - Строка, Неопределено - Кодированная строка запроса или признак её удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  url.invalid_syntax - Значение содержит недопустимый символ.
//  url.invalid_percent_encoding - Значение содержит недопустимую последовательность %HH.
Функция УстановитьКодированнуюСтрокуЗапроса(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат УдалитьЗапрос();
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	ПодготовленныйЗапрос = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПроверитьКодированныйЗапрос(Значение);

	Кандидат = СкопироватьКомпоненты();
	Кандидат.ЗапросОпределен = Истина;
	Кандидат.КодированныйЗапрос = ПодготовленныйЗапрос.КодированноеЗначение;
	Кандидат.ПредставлениеЗапроса = ПодготовленныйЗапрос.Представление;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает декодированный фрагмент по RFC 3986 §3.5.
//
// Параметры:
//  Значение - Строка, Неопределено - Декодированный фрагмент или признак его удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Функция УстановитьФрагмент(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат УдалитьФрагмент();
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	ПодготовленныйФрагмент = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьФрагмент(Значение);

	Кандидат = СкопироватьКомпоненты();
	Кандидат.ФрагментОпределен = Истина;
	Кандидат.КодированныйФрагмент = ПодготовленныйФрагмент.КодированноеЗначение;
	Кандидат.ПредставлениеФрагмента = ПодготовленныйФрагмент.Представление;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает кодированный фрагмент без изменения его исходного написания по RFC 3986 §3.5.
//
// Параметры:
//  Значение - Строка, Неопределено - Кодированный фрагмент или признак его удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  url.invalid_syntax - Значение содержит недопустимый символ.
//  url.invalid_percent_encoding - Значение содержит недопустимую последовательность %HH.
Функция УстановитьКодированныйФрагмент(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат УдалитьФрагмент();
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	ПодготовленныйФрагмент = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПроверитьКодированныйФрагмент(Значение);

	Кандидат = СкопироватьКомпоненты();
	Кандидат.ФрагментОпределен = Истина;
	Кандидат.КодированныйФрагмент = ПодготовленныйФрагмент.КодированноеЗначение;
	Кандидат.ПредставлениеФрагмента = ПодготовленныйФрагмент.Представление;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Возвращает строку URL с замаскированным паролем.
//
// Метод не гарантирует безопасное журналирование: секреты могут оставаться в пути, запросе и фрагменте.
//
// Возвращаемое значение:
//  Строка - URL, в котором пароль заменён маской *****.
Функция ВСтрокуСМаскированнымПаролем() Экспорт

	ПредставлениеДанных = ИсходныеДанныеПользователя();

	Если ПредставлениеДанных = Неопределено Тогда
		Возврат ВСтроку();
	КонецЕсли;

	ПозицияПароля = СтрНайти(ПредставлениеДанных, ":");

	Если ПозицияПароля = 0 Тогда
		Возврат ВСтроку();
	КонецЕсли;

	Замена = Лев(ПредставлениеДанных, ПозицияПароля) + "*****";
	Возврат ЗаменитьДанныеПользователяВСтроке(Замена, Ложь);

КонецФункции

// Возвращает строку URL без данных пользователя.
//
// Метод не гарантирует безопасное журналирование: секреты могут оставаться в пути, запросе и фрагменте.
//
// Возвращаемое значение:
//  Строка - URL без данных пользователя и разделителя @.
Функция ВСтрокуБезДанныхПользователя() Экспорт

	Если КодированныеДанныеПользователя() = Неопределено Тогда
		Возврат ВСтроку();
	КонецЕсли;

	Возврат ЗаменитьДанныеПользователяВСтроке("", Истина);

КонецФункции

// Разрешает ссылку относительно URL по RFC 3986 §5.2.
//
// Ссылки:
//  RFC 3986, раздел 5.2 - разрешение относительных ссылок:
//  https://www.rfc-editor.org/rfc/rfc3986.html#section-5.2
//
// Параметры:
//  Ссылка - Строка, URL - Разрешаемая ссылка.
//
// Возвращаемое значение:
//  URL - Новый независимый абсолютный URL.
//
// Исключения:
//  argument.invalid_type - Ссылка имеет недопустимый тип.
//  url.base_not_absolute - Текущий URL не является абсолютной базой.
//  url.invalid_syntax - Строка ссылки нарушает общую грамматику URI.
//  url.invalid_scheme - Схема строки ссылки имеет недопустимый синтаксис.
//  url.invalid_percent_encoding - Строка ссылки содержит недопустимую последовательность %HH.
//  url.invalid_authority - Серверная часть строки ссылки имеет недопустимую структуру.
//  url.invalid_host - Хост строки ссылки имеет недопустимый синтаксис.
Функция Разрешить(Ссылка) Экспорт

	СсылкаURL = Новый URL(СтрокаАдреса("Ссылка", Ссылка));
	Возврат СервисыБиблиотекиURL.РазрешительURI().Разрешить(ЭтотОбъект, СсылкаURL);

КонецФункции

// Строит URI-ссылку на абсолютную цель относительно текущего URL.
//
// Параметры:
//  Цель - Строка, URL - Абсолютная цель.
//
// Возвращаемое значение:
//  URL - Относительная или нормализованная абсолютная URI-ссылка.
//
// Исключения:
//  argument.invalid_type - Цель имеет недопустимый тип.
//  argument.invalid_value - Цель не является абсолютной.
//  url.base_not_absolute - Текущий URL не является абсолютной базой.
//  url.invalid_syntax - Строка цели нарушает общую грамматику URI.
//  url.invalid_scheme - Схема строки цели имеет недопустимый синтаксис.
//  url.invalid_percent_encoding - Строка цели содержит недопустимую последовательность %HH.
//  url.invalid_authority - Серверная часть строки цели имеет недопустимую структуру.
//  url.invalid_host - Хост строки цели имеет недопустимый синтаксис.
Функция СделатьОтносительным(Цель) Экспорт

	ЦельURL = ПривестиКURL("Цель", Цель);

	Если Не ЦельURL.ЯвляетсяАбсолютным() Тогда
		ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента(
			"Цель",
			"абсолютный URL"
		);
	КонецЕсли;

	Возврат СервисыБиблиотекиURL.РелятивизаторURI().СделатьОтносительным(ЭтотОбъект, ЦельURL);

КонецФункции

// Возвращает новый URL, нормализованный по RFC 3986 §6.2.2.
//
// Ссылки:
//  RFC 3986, раздел 6.2.2 - синтаксическая нормализация:
//  https://www.rfc-editor.org/rfc/rfc3986.html#section-6.2.2
//
// Возвращаемое значение:
//  URL - Новый независимый нормализованный URL.
Функция Нормализованный() Экспорт

	Возврат СервисыБиблиотекиURL.НормализаторURI().Нормализовать(ЭтотОбъект);

КонецФункции

// Возвращает новый URL, нормализованный по общим правилам и правилам конкретной схемы.
//
// Возвращаемое значение:
//  URL - Новый независимый нормализованный URL.
Функция НормализованныйДляСхемы() Экспорт

	Возврат СервисыБиблиотекиURL.НормализаторURI().НормализоватьДляСхемы(ЭтотОбъект);

КонецФункции

// Создаёт полностью независимую изменяемую копию URL.
//
// Возвращаемое значение:
//  URL - Новый URL с независимым состоянием.
Функция Скопировать() Экспорт

	Возврат Новый URL(ВСтроку());

КонецФункции

// Сравнивает исходное написание URL и URI-ссылки.
//
// Параметры:
//  Другое - Строка, URL - Сравниваемая ссылка.
//
// Возвращаемое значение:
//  Булево - Истина, если исходные написания совпадают.
//
// Исключения:
//  argument.invalid_type - Другое имеет недопустимый тип.
//  Коды разбора URI - Строка Другое имеет недопустимый синтаксис.
Функция Равен(Другое) Экспорт

	Возврат ВСтроку() = ПривестиКURL("Другое", Другое).ВСтроку();

КонецФункции

// Сравнивает кодированные компоненты с нормализацией регистра схемы, хоста и %HH.
//
// Параметры:
//  Другое - Строка, URL - Сравниваемая ссылка.
//
// Возвращаемое значение:
//  Булево - Истина, если компоненты равны.
//
// Исключения:
//  argument.invalid_type - Другое имеет недопустимый тип.
//  Коды разбора URI - Строка Другое имеет недопустимый синтаксис.
Функция РавенПоКомпонентам(Другое) Экспорт

	Возврат Сравнить(Другое) = 0;

КонецФункции

// Сравнивает URL по кодированным компонентам для детерминированного упорядочивания.
//
// Параметры:
//  Другое - Строка, URL - Сравниваемая ссылка.
//
// Возвращаемое значение:
//  Число - Отрицательное число, ноль или положительное число.
//
// Исключения:
//  argument.invalid_type - Другое имеет недопустимый тип.
//  Коды разбора URI - Строка Другое имеет недопустимый синтаксис.
Функция Сравнить(Другое) Экспорт

	Возврат СервисыБиблиотекиURL.СравнивательURL().Сравнить(ЭтотОбъект, ПривестиКURL("Другое", Другое));

КонецФункции

// Сравнивает URL и URI-ссылку после общей нормализации RFC 3986 §6.2.2.
//
// Параметры:
//  Другое - Строка, URL - Сравниваемая ссылка.
//
// Возвращаемое значение:
//  Булево - Истина, если ссылки эквивалентны после общей нормализации.
//
// Исключения:
//  argument.invalid_type - Другое имеет недопустимый тип.
//  Коды разбора URI - Строка Другое имеет недопустимый синтаксис.
Функция Эквивалентен(Другое) Экспорт

	Возврат Нормализованный().КодированноеПредставление()
		= ПривестиКURL("Другое", Другое).Нормализованный().КодированноеПредставление();

КонецФункции

// Сравнивает URL и URI-ссылку после общей нормализации и нормализации для конкретной схемы.
//
// Параметры:
//  Другое - Строка, URL - Сравниваемая ссылка.
//
// Возвращаемое значение:
//  Булево - Истина, если ссылки эквивалентны после нормализации для схемы.
//
// Исключения:
//  argument.invalid_type - Другое имеет недопустимый тип.
//  Коды разбора URI - Строка Другое имеет недопустимый синтаксис.
Функция ЭквивалентенДляСхемы(Другое) Экспорт

	Возврат НормализованныйДляСхемы().КодированноеПредставление()
		= ПривестиКURL("Другое", Другое).НормализованныйДляСхемы().КодированноеПредставление();

КонецФункции

// Проверяет соответствие ограничениям известной URI-схемы без исключения.
//
// Возвращаемое значение:
//  Булево - Истина, если ссылка соответствует ограничениям схемы.
//
// Исключения:
//  Повторно вызывает неожиданную ошибку, отличную от url.invalid_for_scheme.
Функция СоответствуетСхеме() Экспорт

	Попытка
		Проверяющий = СервисыБиблиотекиURL.ПроверяющийСхемыURL();
		Проверяющий.Проверить(ЭтотОбъект);
	Исключение
		Если ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке()) = КодыОшибокURL.НедопустимыйДляСхемы() Тогда
			Возврат Ложь;
		КонецЕсли;

		ВызватьИсключение;
	КонецПопытки;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает свежий снимок проверенных компонентов URL.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Неизменяемый снимок компонентов URL.
Функция СнимокКомпонентов() Экспорт

	Компоненты = Новый Структура;
	Компоненты.Вставить("Схема", _Схема);
	Компоненты.Вставить("СервернаяЧастьОпределена", _СервернаяЧастьОпределена);
	Компоненты.Вставить("ДанныеПользователяОпределены", _ДанныеПользователяОпределены);
	Компоненты.Вставить("КодированныеДанныеПользователя", _КодированныеДанныеПользователя);
	Компоненты.Вставить("КодированныйХост", _КодированныйХост);
	Компоненты.Вставить("ВидХоста", _ВидХоста);
	Компоненты.Вставить("ПортУказан", _ПортУказан);
	Компоненты.Вставить("ТекстПорта", _ТекстПорта);
	Компоненты.Вставить("КодированныйПуть", _КодированныйПуть);
	Компоненты.Вставить("ЗапросОпределен", _ЗапросОпределен);
	Компоненты.Вставить("КодированныйЗапрос", _КодированныйЗапрос);
	Компоненты.Вставить("ФрагментОпределен", _ФрагментОпределен);
	Компоненты.Вставить("КодированныйФрагмент", _КодированныйФрагмент);
	Компоненты.Вставить("ПредставлениеДанныхПользователя", _ПредставлениеДанныхПользователя);
	Компоненты.Вставить("ПредставлениеХоста", _ПредставлениеХоста);
	Компоненты.Вставить("ПредставлениеПути", _ПредставлениеПути);
	Компоненты.Вставить("ПредставлениеЗапроса", _ПредставлениеЗапроса);
	Компоненты.Вставить("ПредставлениеФрагмента", _ПредставлениеФрагмента);

	Возврат Новый ФиксированнаяСтруктура(Компоненты);

КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УдалитьСервернуюЧасть()

	Кандидат = СкопироватьКомпоненты();
	Кандидат.СервернаяЧастьОпределена = Ложь;
	Кандидат.ДанныеПользователяОпределены = Ложь;
	Кандидат.КодированныеДанныеПользователя = Неопределено;
	Кандидат.КодированныйХост = Неопределено;
	Кандидат.ПредставлениеДанныхПользователя = Неопределено;
	Кандидат.ПредставлениеХоста = Неопределено;
	Кандидат.ВидХоста = Неопределено;
	Кандидат.ПортУказан = Ложь;
	Кандидат.ТекстПорта = Неопределено;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

Функция УдалитьЗапрос()

	Кандидат = СкопироватьКомпоненты();
	Кандидат.ЗапросОпределен = Ложь;
	Кандидат.КодированныйЗапрос = Неопределено;
	Кандидат.ПредставлениеЗапроса = Неопределено;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

Функция УдалитьФрагмент()

	Кандидат = СкопироватьКомпоненты();
	Кандидат.ФрагментОпределен = Ложь;
	Кандидат.КодированныйФрагмент = Неопределено;
	Кандидат.ПредставлениеФрагмента = Неопределено;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

Функция ИсходныеДанныеПользователя()

	Возврат ?(_ДанныеПользователяОпределены, _ПредставлениеДанныхПользователя, Неопределено);

КонецФункции

Процедура ЗаполнитьКомпоненты(Компоненты)

	_Схема = Компоненты.Схема;
	_СервернаяЧастьОпределена = Компоненты.СервернаяЧастьОпределена;
	_ДанныеПользователяОпределены = Компоненты.ДанныеПользователяОпределены;
	_КодированныеДанныеПользователя = Компоненты.КодированныеДанныеПользователя;
	_КодированныйХост = Компоненты.КодированныйХост;
	_ВидХоста = Компоненты.ВидХоста;
	_ПортУказан = Компоненты.ПортУказан;
	_ТекстПорта = Компоненты.ТекстПорта;
	_КодированныйПуть = Компоненты.КодированныйПуть;
	_ЗапросОпределен = Компоненты.ЗапросОпределен;
	_КодированныйЗапрос = Компоненты.КодированныйЗапрос;
	_ФрагментОпределен = Компоненты.ФрагментОпределен;
	_КодированныйФрагмент = Компоненты.КодированныйФрагмент;
	_ПредставлениеДанныхПользователя = Компоненты.ПредставлениеДанныхПользователя;
	_ПредставлениеХоста = Компоненты.ПредставлениеХоста;
	_ПредставлениеПути = Компоненты.ПредставлениеПути;
	_ПредставлениеЗапроса = Компоненты.ПредставлениеЗапроса;
	_ПредставлениеФрагмента = Компоненты.ПредставлениеФрагмента;

КонецПроцедуры

Процедура ПроверитьИнварианты(ТребоватьАбсолютный = Ложь)

	ПроверитьОбщиеИнварианты(ТребоватьАбсолютный);

	Если _СервернаяЧастьОпределена Тогда
		ПроверитьИнвариантыСервернойЧасти();
	Иначе
		ПроверитьИнвариантыБезСервернойЧасти();
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОбщиеИнварианты(ТребоватьАбсолютный)

	Если Не ЭтоСтрока(_КодированныйПуть)
		Или Не ЭтоСтрока(_ПредставлениеПути)
		Или Не ЭтоБулево(_СервернаяЧастьОпределена)
		Или Не ЭтоБулево(_ДанныеПользователяОпределены)
		Или Не ЭтоБулево(_ПортУказан)
		Или Не ЭтоБулево(_ЗапросОпределен)
		Или Не ЭтоБулево(_ФрагментОпределен) Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	ПроверитьСогласованностьОпциональногоКомпонента(_Схема, _Схема <> Неопределено);
	ПроверитьСогласованностьОпциональногоКомпонента(
		_КодированныеДанныеПользователя,
		_ДанныеПользователяОпределены
	);
	ПроверитьСогласованностьОпциональногоКомпонента(
		_ПредставлениеДанныхПользователя,
		_ДанныеПользователяОпределены
	);
	ПроверитьСогласованностьОпциональногоКомпонента(_ТекстПорта, _ПортУказан);
	ПроверитьСогласованностьОпциональногоКомпонента(_КодированныйЗапрос, _ЗапросОпределен);
	ПроверитьСогласованностьОпциональногоКомпонента(_ПредставлениеЗапроса, _ЗапросОпределен);
	ПроверитьСогласованностьОпциональногоКомпонента(_КодированныйФрагмент, _ФрагментОпределен);
	ПроверитьСогласованностьОпциональногоКомпонента(_ПредставлениеФрагмента, _ФрагментОпределен);

	Если _Схема <> Неопределено И _Схема = "" Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	Если ТребоватьАбсолютный И _Схема = Неопределено Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИнвариантыСервернойЧасти()

	Если Не ЭтоСтрока(_КодированныйХост)
		Или Не ЭтоСтрока(_ПредставлениеХоста)
		Или Не ЭтоСтрока(_ВидХоста) Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	Классификатор = СервисыБиблиотекиURL.КлассификаторХостаURI();

	Если Классификатор.Классифицировать(_КодированныйХост) <> _ВидХоста Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	Если Не ЭтоТекстПорта(_ТекстПорта) Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	Если _КодированныйПуть <> "" И Лев(_КодированныйПуть, 1) <> "/" Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИнвариантыБезСервернойЧасти()

	Если _КодированныйХост <> Неопределено
		Или _ПредставлениеХоста <> Неопределено
		Или _ВидХоста <> Неопределено
		Или _ДанныеПользователяОпределены
		Или _ПортУказан
		Или Лев(_КодированныйПуть, 2) = "//" Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	ПроверитьОтносительныйПутьБезСхемы();

КонецПроцедуры

Процедура ПроверитьСогласованностьОпциональногоКомпонента(Значение, Определен)

	Если Определен И Не ЭтоСтрока(Значение) Или Не Определен И Значение <> Неопределено Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОтносительныйПутьБезСхемы()

	Если _Схема <> Неопределено Или Лев(_КодированныйПуть, 1) = "/" Тогда
		Возврат;
	КонецЕсли;

	ПозицияСлеша = СтрНайти(_КодированныйПуть, "/");
	ПервыйСегмент = ?(ПозицияСлеша = 0, _КодированныйПуть, Лев(_КодированныйПуть, ПозицияСлеша - 1));

	Если СтрНайти(ПервыйСегмент, ":") > 0 Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

КонецПроцедуры

Функция ЭтоСтрока(Значение)

	Возврат ТипЗнч(Значение) = Тип("Строка");

КонецФункции

Функция ЭтоТекстПорта(Значение)

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Сред(Значение, Индекс, 1));

		Если Код < 48 Или Код > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоБулево(Значение)

	Возврат ТипЗнч(Значение) = Тип("Булево");

КонецФункции

Процедура ВызватьНедопустимоеСостояние()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыйСинтаксис(),
		"Недопустимое внутреннее состояние URI"
	);

КонецПроцедуры

Функция СобратьПредставление(Исходное)

	Фрагменты = Новый Массив;

	Если _Схема <> Неопределено Тогда
		Фрагменты.Добавить(_Схема);
		Фрагменты.Добавить(":");
	КонецЕсли;

	Если _СервернаяЧастьОпределена Тогда
		Фрагменты.Добавить("//");
		Фрагменты.Добавить(СобратьСервернуюЧасть(Исходное));
	КонецЕсли;

	Фрагменты.Добавить(?(Исходное, _ПредставлениеПути, _КодированныйПуть));

	Если _ЗапросОпределен Тогда
		Фрагменты.Добавить("?");
		Фрагменты.Добавить(?(Исходное, _ПредставлениеЗапроса, _КодированныйЗапрос));
	КонецЕсли;

	Если _ФрагментОпределен Тогда
		Фрагменты.Добавить("#");
		Фрагменты.Добавить(?(Исходное, _ПредставлениеФрагмента, _КодированныйФрагмент));
	КонецЕсли;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Функция СобратьСервернуюЧасть(Исходное)

	Если Не _СервернаяЧастьОпределена Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = "";

	Если _ДанныеПользователяОпределены Тогда
		Результат = ?(Исходное, _ПредставлениеДанныхПользователя, _КодированныеДанныеПользователя) + "@";
	КонецЕсли;

	Результат = Результат + ?(Исходное, _ПредставлениеХоста, _КодированныйХост);

	Если _ПортУказан Тогда
		Результат = Результат + ":" + _ТекстПорта;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ДекодироватьНеобязательныйКомпонент(КодированныйКомпонент)

	Если КодированныйКомпонент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ДекодироватьКомпонент(КодированныйКомпонент);

КонецФункции

Функция ДекодироватьКомпонент(КодированныйКомпонент)

	Кодировщик = СервисыБиблиотекиURL.КодировщикКомпонентовURI();
	Данные = Кодировщик.ДекодироватьВБайты(КодированныйКомпонент);
	Возврат Кодировщик.ДекодироватьСтрогийUTF8(Данные);

КонецФункции

Функция ДекодироватьAMеткиХоста(Хост)

	Результат = Новый Массив;

	Для Каждого Метка Из СтрРазделить(Хост, ".", Истина) Цикл
		Если Лев(НРег(Метка), 4) = "xn--" Тогда
			Результат.Добавить(СервисыБиблиотекиURL.ПреобразовательДоменов().Декодировать(Метка));
		Иначе
			Результат.Добавить(Метка);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Результат, ".");

КонецФункции

Процедура ПроверитьДопустимостьIDNХоста(Хост)

	Если Хост = "" Или Хост = "." Тогда
		Возврат;
	КонецЕсли;

	Метки = СтрРазделить(Хост, ".", Истина);
	ПоследнийИндекс = Метки.Количество() - 1;

	Для Индекс = 0 По ПоследнийИндекс Цикл
		Метка = Метки[Индекс];

		Если СтрДлина(Метка) > 63
			Или Метка = "" И Индекс <> ПоследнийИндекс
			Или Не ЭтоДопустимаяASCIIМеткаIDN(Метка) Тогда
			ВызватьНедопустимыйIDNХост();
		КонецЕсли;
	КонецЦикла;

	ДлинаКорневойТочки = ?(Прав(Хост, 1) = ".", 1, 0);

	Если СтрДлина(Хост) - ДлинаКорневойТочки > 253 Тогда
		ВызватьНедопустимыйIDNХост();
	КонецЕсли;

КонецПроцедуры

Функция ЭтоДопустимаяASCIIМеткаIDN(Метка)

	Если Метка = "" Тогда
		Возврат Истина;
	КонецЕсли;

	Если Лев(Метка, 1) = "-"
		Или Прав(Метка, 1) = "-"
		Или СтрДлина(Метка) >= 4
			И Сред(Метка, 3, 2) = "--"
			И Лев(НРег(Метка), 4) <> "xn--" Тогда
		Возврат Ложь;
	КонецЕсли;

	ДопустимыеСимволы = "abcdefghijklmnopqrstuvwxyz0123456789-";

	Для Индекс = 1 По СтрДлина(Метка) Цикл
		Если СтрНайти(ДопустимыеСимволы, НРег(Сред(Метка, Индекс, 1))) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура ВызватьНедопустимыйIDNХост()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыйХост(),
		"Недопустимый IDN-хост URL"
	);

КонецПроцедуры

Функция РазделитьПутьНаСегменты(КодированныйПуть)

	Сегменты = Новый Массив;
	НачалоСегмента = 1;

	Для Индекс = 1 По СтрДлина(КодированныйПуть) Цикл
		Если Сред(КодированныйПуть, Индекс, 1) = "/" Тогда
			Сегменты.Добавить(Сред(КодированныйПуть, НачалоСегмента, Индекс - НачалоСегмента));
			НачалоСегмента = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Сегменты.Добавить(Сред(КодированныйПуть, НачалоСегмента));
	Возврат Сегменты;

КонецФункции

Функция НормализоватьДесятичноеЧисло(Текст)

	ИндексПервогоЗначимогоРазряда = 1;

	Пока ИндексПервогоЗначимогоРазряда <= СтрДлина(Текст)
		И Сред(Текст, ИндексПервогоЗначимогоРазряда, 1) = "0" Цикл
		ИндексПервогоЗначимогоРазряда = ИндексПервогоЗначимогоРазряда + 1;
	КонецЦикла;

	Возврат ?(ИндексПервогоЗначимогоРазряда > СтрДлина(Текст), "0", Сред(Текст, ИндексПервогоЗначимогоРазряда));

КонецФункции

Функция ОпределительСтандартногоПорта()

	Если _ОпределительСтандартногоПорта = Неопределено Тогда
		_ОпределительСтандартногоПорта = СервисыБиблиотекиURL.ОпределительСтандартногоПортаURI();
	КонецЕсли;

	Возврат _ОпределительСтандартногоПорта;

КонецФункции

Процедура ВызватьПереполнениеЧисловогоПорта()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.ПереполнениеЧисловогоПорта(),
		"Невозможно точно представить порт как число"
	);

КонецПроцедуры

Функция ПривестиКURL(ИмяАргумента, Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Новый URL(Значение);
	КонецЕсли;

	Если Строка(ТипЗнч(Значение)) = "URL" Тогда
		Возврат Значение;
	КонецЕсли;

	ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
		ИмяАргумента,
		"Строка, URL",
		Значение
	);

КонецФункции

Функция СкопироватьКомпоненты()

	Возврат Новый Структура(СнимокКомпонентов());

КонецФункции

Функция ПрименитьКандидат(Кандидат)

	НормализоватьСовместимостьСервернойЧастиИПути(Кандидат);
	УстановитьКомпоненты(СервисыБиблиотекиURL.СборщикURL().Собрать(Кандидат));

	Возврат ЭтотОбъект;

КонецФункции

Процедура НормализоватьСовместимостьСервернойЧастиИПути(Кандидат)

	Если Кандидат.СервернаяЧастьОпределена Тогда
		Если Кандидат.КодированныйПуть <> "" И Лев(Кандидат.КодированныйПуть, 1) <> "/" Тогда
			Кандидат.КодированныйПуть = "/" + Кандидат.КодированныйПуть;
			Кандидат.ПредставлениеПути = "/" + Кандидат.ПредставлениеПути;
		КонецЕсли;
	ИначеЕсли Лев(Кандидат.КодированныйПуть, 2) = "//" Тогда
		Кандидат.КодированныйПуть = "%2F" + Сред(Кандидат.КодированныйПуть, 2);
		Кандидат.ПредставлениеПути = "%2F" + Сред(Кандидат.ПредставлениеПути, 2);
	КонецЕсли;

КонецПроцедуры

Процедура ОбеспечитьСервернуюЧасть(Кандидат)

	Если Кандидат.СервернаяЧастьОпределена Тогда
		Возврат;
	КонецЕсли;

	Кандидат.СервернаяЧастьОпределена = Истина;
	Кандидат.ДанныеПользователяОпределены = Ложь;
	Кандидат.КодированныеДанныеПользователя = Неопределено;
	Кандидат.КодированныйХост = "";
	Кандидат.ПредставлениеДанныхПользователя = Неопределено;
	Кандидат.ПредставлениеХоста = "";
	Кандидат.ВидХоста = СервисыБиблиотекиURL.КлассификаторХостаURI().Классифицировать("");
	Кандидат.ПортУказан = Ложь;
	Кандидат.ТекстПорта = Неопределено;

КонецПроцедуры

Процедура ЗаполнитьСервернуюЧастьКандидата(Кандидат, Компоненты)

	Кандидат.СервернаяЧастьОпределена = Истина;
	Кандидат.ДанныеПользователяОпределены = Компоненты.ДанныеПользователяОпределены;
	Кандидат.КодированныеДанныеПользователя = Компоненты.КодированныеДанныеПользователя;
	Кандидат.ПредставлениеДанныхПользователя = Компоненты.ПредставлениеДанныхПользователя;
	Кандидат.КодированныйХост = Компоненты.КодированныйХост;
	Кандидат.ПредставлениеХоста = Компоненты.ПредставлениеХоста;
	Кандидат.ВидХоста = Компоненты.ВидХоста;
	Кандидат.ПортУказан = Компоненты.ПортУказан;
	Кандидат.ТекстПорта = Компоненты.ТекстПорта;

КонецПроцедуры

Процедура УстановитьКомпоненты(СтрокаАдреса)

	Компоненты = СервисыБиблиотекиURL.ПарсерIRI().Разобрать(СтрокаАдреса);
	ЗаполнитьКомпоненты(Компоненты);
	ПроверитьИнварианты();

КонецПроцедуры

Функция СтрокаАдреса(ИмяАргумента, Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Если Строка(ТипЗнч(Значение)) = "URL" Тогда
		Возврат Значение.ВСтроку();
	КонецЕсли;

	ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
		ИмяАргумента,
		"Строка, URL",
		Значение
	);

КонецФункции

Процедура ДобавитьСегментВПредставленияПути(Кандидат, Сегмент)

	ПодготовленныйСегмент = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьСегментПути(Сегмент);
	Кандидат.КодированныйПуть = ДобавитьСегментКПути(
		Кандидат.КодированныйПуть,
		ПодготовленныйСегмент.КодированноеЗначение,
		Кандидат.СервернаяЧастьОпределена
	);
	Кандидат.ПредставлениеПути = ДобавитьСегментКПути(
		Кандидат.ПредставлениеПути,
		ПодготовленныйСегмент.Представление,
		Кандидат.СервернаяЧастьОпределена
	);

КонецПроцедуры

Функция ДобавитьСегментКПути(Путь, Сегмент, СервернаяЧастьОпределена)

	Если Путь = "" Тогда
		Если Не СервернаяЧастьОпределена И Сегмент = "" Тогда
			Возврат "";
		КонецЕсли;

		Если СервернаяЧастьОпределена Тогда
			Возврат "/" + Сегмент;
		Иначе
			Возврат Сегмент;
		КонецЕсли;
	ИначеЕсли Прав(Путь, 1) = "/" Тогда
		Если Сегмент = "" Тогда
			Возврат Путь + "/";
		Иначе
			Возврат Путь + Сегмент;
		КонецЕсли;
	Иначе
		Возврат Путь + "/" + Сегмент;
	КонецЕсли;

КонецФункции

Функция ЗаменитьДанныеПользователяВСтроке(Замена, УдалитьРазделитель)

	ИсходнаяСтрока = ВСтроку();
	ЗначениеСхемы = Схема();

	Если ЗначениеСхемы = Неопределено Тогда
		НачалоДанныхПользователя = 3;
	Иначе
		НачалоДанныхПользователя = СтрДлина(ЗначениеСхемы) + 4;
	КонецЕсли;

	ДлинаДанныхПользователя = СтрДлина(ИсходныеДанныеПользователя());
	Префикс = Лев(ИсходнаяСтрока, НачалоДанныхПользователя - 1);

	Если УдалитьРазделитель Тогда
		Суффикс = Сред(ИсходнаяСтрока, НачалоДанныхПользователя + ДлинаДанныхПользователя + 1);
	Иначе
		Суффикс = Сред(ИсходнаяСтрока, НачалоДанныхПользователя + ДлинаДанныхПользователя);
	КонецЕсли;

	Возврат Префикс + Замена + Суффикс;

КонецФункции

#КонецОбласти
