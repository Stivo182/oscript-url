#Использовать errors
#Использовать "../internal"

Перем _Состояние; // СостояниеURI

#Область ОбработчикиСобытий

// Создаёт изменяемый абсолютный URL из URI-ссылки с необязательной абсолютной базой.
// Относительная ссылка разрешается по RFC 3986 §5.2.
//
// Ссылки:
//  RFC 3986, раздел 5.2 - разрешение относительных ссылок:
//  https://www.rfc-editor.org/rfc/rfc3986.html#section-5.2
//
// Параметры:
//  Адрес - Строка, URI, URL, Неопределено - Адрес ссылки.
//  База - Строка, URI, URL, Неопределено - Абсолютная база для разрешения ссылки.
//
// Исключения:
//  argument.invalid_type - Адрес или База имеет недопустимый тип.
//  argument.required - При указанной базе не заполнен Адрес.
//  url.relative_without_base - Относительный Адрес передан без Базы.
//  url.base_not_absolute - База не является абсолютной.
//  uri.invalid_syntax - Строка Адреса или Базы нарушает общую грамматику URI.
//  uri.invalid_scheme - Схема строки Адреса или Базы имеет недопустимый синтаксис.
//  uri.invalid_percent_encoding - Строка Адреса или Базы содержит недопустимую последовательность %HH.
//  uri.invalid_authority - Серверная часть строки Адреса или Базы имеет недопустимую структуру.
//  uri.invalid_host - Хост строки Адреса или Базы имеет недопустимый синтаксис.
//  uri.invalid_ipv6 - IPv6-литерал строки Адреса или Базы имеет недопустимый синтаксис.
//  uri.invalid_ipvfuture - IPvFuture-литерал строки Адреса или Базы имеет недопустимый синтаксис.
Процедура ПриСозданииОбъекта(Адрес = Неопределено, База = Неопределено)

	Если База = Неопределено Тогда
		Если Адрес = Неопределено Тогда
			УстановитьСостояние("http://localhost/");
			Возврат;
		КонецЕсли;

		АдресURI = ПривестиКURI("Адрес", Адрес);

		Если Не АдресURI.ЯвляетсяАбсолютным() Тогда
			ВызватьИсключение ФабрикаОшибок.Создать(
				КодыОшибокURL.ОтносительныйURLБезБазы(),
				"Невозможно создать URL из относительной ссылки без базы"
			);
		КонецЕсли;

		УстановитьСостояние(АдресURI.ВСтроку());
		Возврат;
	КонецЕсли;

	Если Адрес = Неопределено Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыСтандартныхОшибок.АргументНеЗаполнен(),
			"Не заполнен обязательный аргумент Адрес",
			Новый Структура("ИмяАргумента", "Адрес")
		);
	КонецЕсли;

	АдресURI = ПривестиКURI("Адрес", Адрес);
	БазаURI = ПривестиКURI("База", База);

	Если Не БазаURI.ЯвляетсяАбсолютным() Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыОшибокURL.БазаURLНеАбсолютная(),
			"База URL должна быть абсолютной"
		);
	КонецЕсли;

	УстановитьСостояние(БазаURI.Разрешить(АдресURI).ВСтроку());

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает неизменяемый снимок текущего состояния URL.
//
// Возвращаемое значение:
//  URI - Независимый URI-снимок в исходном написании по RFC 3986 §3.
Функция URI() Экспорт

	Возврат Новый URI(_Состояние.ВСтроку());

КонецФункции

// Возвращает URL в исходном написании без потерь.
//
// Возвращаемое значение:
//  Строка - URL в исходном написании.
Функция ВСтроку() Экспорт

	Возврат URI().ВСтроку();

КонецФункции

// Возвращает ASCII-представление URL.
