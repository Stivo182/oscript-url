//
// Исключения:
//  encoding.invalid - Процентные байты сегмента не образуют корректный UTF-8.
Функция СегментыПути() Экспорт

	Возврат URI().СегментыПути();

КонецФункции

// Возвращает кодированные сегменты пути по RFC 3986 §3.3.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Неизменяемый массив кодированных сегментов пути.
Функция КодированныеСегментыПути() Экспорт

	Возврат URI().КодированныеСегментыПути();

КонецФункции

// Возвращает кодированные путь и запрос.
//
// Возвращаемое значение:
//  Строка - Кодированные путь и запрос.
Функция ПутьИЗапрос() Экспорт

	Возврат URI().ПутьИЗапрос();

КонецФункции

// Возвращает декодированный запрос по RFC 3986 §3.4.
//
// Возвращаемое значение:
//  Строка, Неопределено - Запрос или Неопределено при его отсутствии.
//
// Исключения:
//  encoding.invalid - Процентные байты не образуют корректный UTF-8.
Функция Запрос() Экспорт

	Возврат URI().Запрос();

КонецФункции

// Возвращает кодированный запрос по RFC 3986 §3.4.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированный запрос или Неопределено при его отсутствии.
Функция КодированныйЗапрос() Экспорт

	Возврат URI().КодированныйЗапрос();

КонецФункции

// Возвращает связанную с URL коллекцию query-параметров формы.
// Чтение коллекции сохраняет исходное написание запроса, а её изменение сериализует запрос
// по алгоритму application/x-www-form-urlencoded WHATWG URL §5.
//
// Ссылки:
//  RFC 3986, раздел 3.4 - компонент запроса:
//  https://www.rfc-editor.org/rfc/rfc3986.html#section-3.4
//  WHATWG URL, раздел 5 - form-urlencoded:
//  https://url.spec.whatwg.org/#application-x-www-form-urlencoded
//
// Возвращаемое значение:
//  ПараметрыЗапросаURL - Связанная с текущим URL коллекция параметров.
Функция ПараметрыЗапроса() Экспорт

	СтрокаПараметров = КодированныйЗапрос();

	Если СтрокаПараметров = Неопределено Тогда
		СтрокаПараметров = "";
	КонецЕсли;

	Возврат Новый ПараметрыЗапросаURL(СтрокаПараметров, ЭтотОбъект);

КонецФункции

// Копирует параметры в компонент запроса URL.
//
// Параметры:
//  Значение - ПараметрыЗапросаURL - Копируемая коллекция.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
Функция УстановитьПараметрыЗапроса(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип(
		"Значение", Значение, "ПараметрыЗапросаURL"
	);

	СтрокаПараметров = Значение.ВСтроку();

	Если СтрокаПараметров = "" Тогда
		Возврат ОчиститьЗапрос();
	КонецЕсли;

	Возврат УстановитьКодированныйЗапрос(СтрокаПараметров);

КонецФункции

// Возвращает декодированный фрагмент по RFC 3986 §3.5.
//
// Возвращаемое значение:
//  Строка, Неопределено - Фрагмент или Неопределено при его отсутствии.
//
// Исключения:
//  encoding.invalid - Процентные байты не образуют корректный UTF-8.
Функция Фрагмент() Экспорт

	Возврат URI().Фрагмент();

КонецФункции

// Возвращает кодированный фрагмент по RFC 3986 §3.5.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированный фрагмент или Неопределено при его отсутствии.
Функция КодированныйФрагмент() Экспорт

	Возврат URI().КодированныйФрагмент();

КонецФункции

// Устанавливает схему абсолютного URL по RFC 3986 §3.1.
//
// Параметры:
//  Значение - Строка - Схема URL.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_scheme - Значение не соответствует грамматике схемы.
Функция УстановитьСхему(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	Если Не ЭтоДопустимаяСхема(Значение) Тогда
		ВызватьНедопустимуюСхему();
	КонецЕсли;

	Кандидат = СкопироватьКомпонентыСостояния();
	Кандидат.Схема = Значение;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает декодированную структурную серверную часть по RFC 3986 §3.2.
// Разделители @, :, [ и ] интерпретируются как синтаксис серверной части.
//
// Параметры:
//  Значение - Строка, Неопределено - Серверная часть или признак её удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
//  uri.invalid_authority - Серверная часть имеет недопустимую структуру.
//  uri.invalid_host - Хост имеет недопустимый синтаксис.
//  url.incompatible_components - Серверная часть несовместима с путём.
Функция УстановитьСервернуюЧасть(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат ОчиститьСервернуюЧасть();
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	КомпонентыСервернойЧасти = РазобратьДекодированнуюСервернуюЧасть(Значение);
	Кандидат = СкопироватьКомпонентыСостояния();
	ЗаполнитьСервернуюЧастьКандидата(Кандидат, КомпонентыСервернойЧасти);

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает кодированную серверную часть по RFC 3986 без изменения исходного написания.
//
// Параметры:
//  Значение - Строка, Неопределено - Кодированная серверная часть или признак её удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_syntax - Значение нарушает общую грамматику URI.
//  uri.invalid_percent_encoding - Значение содержит недопустимую последовательность %HH.
//  uri.invalid_authority - Значение имеет недопустимую структуру серверной части.
//  uri.invalid_host - Хост значения имеет недопустимый синтаксис.
//  uri.invalid_ipv6 - IPv6-литерал значения имеет недопустимый синтаксис.
//  uri.invalid_ipvfuture - IPvFuture-литерал значения имеет недопустимый синтаксис.
//  url.incompatible_components - Серверная часть несовместима с путём.
Функция УстановитьКодированнуюСервернуюЧасть(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат ОчиститьСервернуюЧасть();
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	КомпонентыСервернойЧасти = РазобратьКодированнуюСервернуюЧасть(Значение);
	Кандидат = СкопироватьКомпонентыСостояния();
	ЗаполнитьСервернуюЧастьКандидата(Кандидат, КомпонентыСервернойЧасти);

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Удаляет серверную часть и все её подкомпоненты.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  url.incompatible_components - Путь требует наличия серверной части.
Функция ОчиститьСервернуюЧасть() Экспорт

	Кандидат = СкопироватьКомпонентыСостояния();
	Кандидат.СервернаяЧастьОпределена = Ложь;
	Кандидат.ДанныеПользователяОпределены = Ложь;
	Кандидат.КодированныеДанныеПользователя = Неопределено;
	Кандидат.КодированныйХост = Неопределено;
	Кандидат.ПредставлениеДанныхПользователя = Неопределено;
	Кандидат.ПредставлениеХоста = Неопределено;
	Кандидат.ВидХоста = Неопределено;
	Кандидат.ПортУказан = Ложь;
	Кандидат.ТекстПорта = Неопределено;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает декодированные данные пользователя по RFC 3986 §3.2.1.
//
// Параметры:
//  Значение - Строка, Неопределено - Данные пользователя или признак их удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
//  url.incompatible_components - Создаваемая серверная часть несовместима с путём.
Функция УстановитьДанныеПользователя(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат УстановитьКодированныеДанныеПользователя(Неопределено);
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	Кандидат = СкопироватьКомпонентыСостояния();
	ОбеспечитьСервернуюЧасть(Кандидат);
	Кандидат.ДанныеПользователяОпределены = Истина;
	Кандидат.КодированныеДанныеПользователя = КодированиеURL.КодироватьДанныеПользователя(Значение);
	Кандидат.ПредставлениеДанныхПользователя = ПодготовитьПредставлениеКомпонента(
		Значение,
		ДопустимыеСимволыДанныхПользователя()
	);

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает кодированные данные пользователя без завершающего @ и без изменения исходного написания.
//
// Параметры:
//  Значение - Строка, Неопределено - Кодированные данные пользователя или признак их удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_syntax - Значение содержит недопустимый символ.
//  uri.invalid_authority - Значение нарушает структуру данных пользователя.
//  uri.invalid_percent_encoding - Значение содержит недопустимую последовательность %HH.
//  url.incompatible_components - Создаваемая серверная часть несовместима с путём.
Функция УстановитьКодированныеДанныеПользователя(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Кандидат = СкопироватьКомпонентыСостояния();
		Кандидат.ДанныеПользователяОпределены = Ложь;
		Кандидат.КодированныеДанныеПользователя = Неопределено;
		Кандидат.ПредставлениеДанныхПользователя = Неопределено;
		Возврат ПрименитьКандидат(Кандидат);
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));
	ПроверитьКодированныеДанныеПользователя(Значение);

	Кандидат = СкопироватьКомпонентыСостояния();
	ОбеспечитьСервернуюЧасть(Кандидат);
	Кандидат.ДанныеПользователяОпределены = Истина;
	Кандидат.КодированныеДанныеПользователя = Значение;
	Кандидат.ПредставлениеДанныхПользователя = Значение;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает декодированное имя пользователя, сохраняя существующий кодированный пароль.
//
// Параметры:
//  Значение - Строка, Неопределено - Имя пользователя или признак удаления данных пользователя.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
//  url.incompatible_components - Создаваемая серверная часть несовместима с путём.
Функция УстановитьИмяПользователя(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат УстановитьКодированныеДанныеПользователя(Неопределено);
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	КодированноеИмя = КодированиеURL.КодироватьИмяПользователя(Значение);
	ПредставлениеИмени = ПодготовитьПредставлениеКомпонента(Значение, ДопустимыеСимволыИмениПользователя());
	КодированныеДанные = _Состояние.КодированныеДанныеПользователя();
	ПредставлениеДанных = _Состояние.ПредставлениеДанныхПользователя();
	ПозицияПароля = 0;
	ПозицияПароляПредставления = 0;

	Если КодированныеДанные <> Неопределено Тогда
		ПозицияПароля = СтрНайти(КодированныеДанные, ":");
		ПозицияПароляПредставления = СтрНайти(ПредставлениеДанных, ":");
	КонецЕсли;

	Если ПозицияПароля > 0 Тогда
		КодированноеИмя = КодированноеИмя + Сред(КодированныеДанные, ПозицияПароля);
		ПредставлениеИмени = ПредставлениеИмени + Сред(ПредставлениеДанных, ПозицияПароляПредставления);
	КонецЕсли;

	Кандидат = СкопироватьКомпонентыСостояния();
	ОбеспечитьСервернуюЧасть(Кандидат);
	Кандидат.ДанныеПользователяОпределены = Истина;
	Кандидат.КодированныеДанныеПользователя = КодированноеИмя;
	Кандидат.ПредставлениеДанныхПользователя = ПредставлениеИмени;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает декодированный пароль, сохраняя существующее кодированное имя пользователя.
//
// Параметры:
//  Значение - Строка, Неопределено - Пароль или признак его удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
//  url.incompatible_components - Создаваемая серверная часть несовместима с путём.
Функция УстановитьПароль(Значение) Экспорт

	КодированныеДанные = _Состояние.КодированныеДанныеПользователя();
	ПредставлениеДанных = _Состояние.ПредставлениеДанныхПользователя();

	Если Значение = Неопределено Тогда
		Если КодированныеДанные = Неопределено Тогда
			Возврат ЭтотОбъект;
		КонецЕсли;

		ПозицияПароля = СтрНайти(КодированныеДанные, ":");

		Если ПозицияПароля = 0 Тогда
			Возврат ЭтотОбъект;
		КонецЕсли;

		Кандидат = СкопироватьКомпонентыСостояния();
		Кандидат.КодированныеДанныеПользователя = Лев(КодированныеДанные, ПозицияПароля - 1);
		ПозицияПароляПредставления = СтрНайти(ПредставлениеДанных, ":");
		Кандидат.ПредставлениеДанныхПользователя = Лев(
			ПредставлениеДанных,
			ПозицияПароляПредставления - 1
		);
		Возврат ПрименитьКандидат(Кандидат);
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	Если КодированныеДанные = Неопределено Тогда
		КодированноеИмя = "";
		ПредставлениеИмени = "";
	Иначе
		ПозицияПароля = СтрНайти(КодированныеДанные, ":");

		Если ПозицияПароля = 0 Тогда
			КодированноеИмя = КодированныеДанные;
			ПредставлениеИмени = ПредставлениеДанных;
		Иначе
			КодированноеИмя = Лев(КодированныеДанные, ПозицияПароля - 1);
			ПозицияПароляПредставления = СтрНайти(ПредставлениеДанных, ":");
			ПредставлениеИмени = Лев(ПредставлениеДанных, ПозицияПароляПредставления - 1);
		КонецЕсли;
	КонецЕсли;

	Кандидат = СкопироватьКомпонентыСостояния();
	ОбеспечитьСервернуюЧасть(Кандидат);
	Кандидат.ДанныеПользователяОпределены = Истина;
	Кандидат.КодированныеДанныеПользователя = КодированноеИмя + ":" + КодированиеURL.КодироватьПароль(Значение);
	Кандидат.ПредставлениеДанныхПользователя = ПредставлениеИмени + ":" + ПодготовитьПредставлениеКомпонента(
		Значение,
		ДопустимыеСимволыДанныхПользователя()
	);

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает декодированный хост по RFC 3986 §3.2.2.
// IPv6 без скобок автоматически получает обязательные квадратные скобки.
// Символы Unicode сохраняются в представлении URL, а каждый байт их представления в UTF-8 записывается как %HH.
//
// Параметры:
//  Значение - Строка - Хост URL.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
//  uri.invalid_host - Хост имеет недопустимый синтаксис.
//  url.incompatible_components - Создаваемая серверная часть несовместима с путём.
Функция УстановитьХост(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	ПодготовленныйХост = ПодготовитьДекодированныйХост(Значение);

	Кандидат = СкопироватьКомпонентыСостояния();
	ОбеспечитьСервернуюЧасть(Кандидат);
	Кандидат.КодированныйХост = ПодготовленныйХост.КодированныйХост;
	Кандидат.ВидХоста = ПодготовленныйХост.ВидХоста;
	Кандидат.ПредставлениеХоста = ПодготовитьПредставлениеХоста(
		Значение,
		ПодготовленныйХост.КодированныйХост
	);

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает кодированный хост по RFC 3986 без изменения исходного написания.
// IPv6 и IPvFuture должны быть заключены в квадратные скобки.
//
// Параметры:
//  Значение - Строка - Кодированный хост URL.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_syntax - Значение содержит недопустимый символ.
//  uri.invalid_percent_encoding - Значение содержит недопустимую последовательность %HH.
//  uri.invalid_host - Хост имеет недопустимый синтаксис.
//  url.incompatible_components - Создаваемая серверная часть несовместима с путём.
Функция УстановитьКодированныйХост(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));
	ПроверитьASCIIИПроцентноеКодирование(Значение);

	ВидХоста = КлассифицироватьХост(Значение);

	Если ВидХоста = Неопределено Тогда
		ВызватьНедопустимыйХост();
	КонецЕсли;

	Кандидат = СкопироватьКомпонентыСостояния();
	ОбеспечитьСервернуюЧасть(Кандидат);
	Кандидат.КодированныйХост = Значение;
	Кандидат.ВидХоста = ВидХоста;
	Кандидат.ПредставлениеХоста = Значение;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает порт по RFC 3986 §3.2.3 без ограничения диапазоном 65535.
//
// Параметры:
//  Значение - Строка, Число, Неопределено - Порт либо признак его удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  argument.invalid_value - Значение отрицательное, дробное или содержит не только цифры ASCII.
//  url.incompatible_components - Создаваемая серверная часть несовместима с путём.
Функция УстановитьПорт(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Кандидат = СкопироватьКомпонентыСостояния();
		Кандидат.ПортУказан = Ложь;
		Кандидат.ТекстПорта = Неопределено;
		Возврат ПрименитьКандидат(Кандидат);
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, "Строка, Число");

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		ПроверкаАргументов.ПроверитьДопустимость(
			"Значение",
			Значение >= 0 И Цел(Значение) = Значение,
			"целое неотрицательное число"
		);
		ТекстПорта = Формат(Значение, "ЧГ=0");
	Иначе
		ТекстПорта = Значение;
	КонецЕсли;

	ПроверкаАргументов.ПроверитьДопустимость(
		"Значение",
		ТолькоЦифрыASCII(ТекстПорта),
		"строка из цифр ASCII"
	);

	Кандидат = СкопироватьКомпонентыСостояния();
	ОбеспечитьСервернуюЧасть(Кандидат);
	Кандидат.ПортУказан = Истина;
	Кандидат.ТекстПорта = ТекстПорта;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает декодированный путь с сохранением структурных разделителей / по RFC 3986 §3.3.
//
// Параметры:
//  Значение - Строка - Декодированный путь URL.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
//  url.incompatible_components - Путь несовместим с серверной частью.
Функция УстановитьПуть(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	Кандидат = СкопироватьКомпонентыСостояния();
	Кандидат.КодированныйПуть = КодированиеURL.КодироватьПуть(Значение);
	Кандидат.ПредставлениеПути = ПодготовитьПредставлениеКомпонента(Значение, ДопустимыеСимволыПути());

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает кодированный путь без изменения его исходного написания по RFC 3986 §3.3.
//
// Параметры:
//  Значение - Строка - Кодированный путь URL.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_syntax - Значение содержит недопустимый символ.
//  uri.invalid_percent_encoding - Значение содержит недопустимую последовательность %HH.
//  url.incompatible_components - Путь несовместим с серверной частью.
Функция УстановитьКодированныйПуть(Значение) Экспорт

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));
	ПроверитьКодированныйКомпонент(Значение, ДопустимыеСимволыПути());

	Кандидат = СкопироватьКомпонентыСостояния();
	Кандидат.КодированныйПуть = Значение;
	Кандидат.ПредставлениеПути = Значение;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Удаляет путь целиком по RFC 3986 §3.3.
//
// Возвращаемое значение:
//  URL - Этот объект.
Функция ОчиститьПуть() Экспорт

	Кандидат = СкопироватьКомпонентыСостояния();
	Кандидат.КодированныйПуть = "";
	Кандидат.ПредставлениеПути = "";

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Добавляет декодированный сегмент пути по RFC 3986 §3.3, кодируя / внутри сегмента как %2F.
//
// Параметры:
//  Сегмент - Строка - Декодированный сегмент пути.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Сегмент имеет недопустимый тип.
//  uri.invalid_syntax - Сегмент содержит недопустимую кодовую точку Unicode.
//  url.incompatible_components - Полученный путь несовместим с серверной частью.
Функция ДобавитьСегментПути(Сегмент) Экспорт

	ПроверкаАргументов.ПроверитьТип("Сегмент", Сегмент, Тип("Строка"));

	Кандидат = СкопироватьКомпонентыСостояния();
	ДобавитьСегментВПредставленияПути(Кандидат, Сегмент);

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Добавляет декодированные сегменты пути по RFC 3986 §3.3.
//
// Параметры:
//  Сегменты - Массив, ФиксированныйМассив - Декодированные сегменты пути.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Сегменты или элемент коллекции имеет недопустимый тип.
//  uri.invalid_syntax - Сегмент содержит недопустимую кодовую точку Unicode.
//  url.incompatible_components - Полученный путь несовместим с серверной частью.
Функция ДобавитьСегментыПути(Сегменты) Экспорт

	ПроверкаАргументов.ПроверитьТип("Сегменты", Сегменты, "Массив, ФиксированныйМассив");

	Для Каждого Сегмент Из Сегменты Цикл
		ПроверкаАргументов.ПроверитьТип("Сегмент", Сегмент, Тип("Строка"));
	КонецЦикла;

	Кандидат = СкопироватьКомпонентыСостояния();

	Для Каждого Сегмент Из Сегменты Цикл
		ДобавитьСегментВПредставленияПути(Кандидат, Сегмент);
	КонецЦикла;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Удаляет последний сегмент пути, сохраняя запрос и фрагмент.
//
// Возвращаемое значение:
//  URL - Этот объект.
Функция УдалитьПоследнийСегментПути() Экспорт

	Кандидат = СкопироватьКомпонентыСостояния();
	Путь = Кандидат.КодированныйПуть;

	Если Путь = "" Тогда
		Возврат ПрименитьКандидат(Кандидат);
	КонецЕсли;

	Кандидат.КодированныйПуть = УдалитьПоследнийСегментИзПути(Путь);
	Кандидат.ПредставлениеПути = УдалитьПоследнийСегментИзПути(Кандидат.ПредставлениеПути);

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает декодированный запрос по RFC 3986 §3.4.
//
// Параметры:
//  Значение - Строка, Неопределено - Декодированный запрос или признак его удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Функция УстановитьЗапрос(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат ОчиститьЗапрос();
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	Кандидат = СкопироватьКомпонентыСостояния();
	Кандидат.ЗапросОпределен = Истина;
	Кандидат.КодированныйЗапрос = КодированиеURL.КодироватьЗапрос(Значение);
	Кандидат.ПредставлениеЗапроса = ПодготовитьПредставлениеКомпонента(
		Значение,
		ДопустимыеСимволыЗапросаИФрагмента(),
		Истина
	);

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает кодированный запрос без изменения его исходного написания по RFC 3986 §3.4.
//
// Параметры:
//  Значение - Строка, Неопределено - Кодированный запрос или признак его удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_syntax - Значение содержит недопустимый символ.
//  uri.invalid_percent_encoding - Значение содержит недопустимую последовательность %HH.
Функция УстановитьКодированныйЗапрос(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат ОчиститьЗапрос();
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));
	ПроверитьКодированныйКомпонент(Значение, ДопустимыеСимволыЗапросаИФрагмента());

	Кандидат = СкопироватьКомпонентыСостояния();
	Кандидат.ЗапросОпределен = Истина;
	Кандидат.КодированныйЗапрос = Значение;
	Кандидат.ПредставлениеЗапроса = Значение;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Удаляет запрос целиком по RFC 3986 §3.4.
//
// Возвращаемое значение:
//  URL - Этот объект.
Функция ОчиститьЗапрос() Экспорт

	Кандидат = СкопироватьКомпонентыСостояния();
	Кандидат.ЗапросОпределен = Ложь;
	Кандидат.КодированныйЗапрос = Неопределено;
	Кандидат.ПредставлениеЗапроса = Неопределено;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает декодированный фрагмент по RFC 3986 §3.5.
//
// Параметры:
//  Значение - Строка, Неопределено - Декодированный фрагмент или признак его удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Функция УстановитьФрагмент(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат ОчиститьФрагмент();
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

	Кандидат = СкопироватьКомпонентыСостояния();
	Кандидат.ФрагментОпределен = Истина;
	Кандидат.КодированныйФрагмент = КодированиеURL.КодироватьФрагмент(Значение);
	Кандидат.ПредставлениеФрагмента = ПодготовитьПредставлениеКомпонента(
		Значение,
		ДопустимыеСимволыЗапросаИФрагмента()
	);

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Устанавливает кодированный фрагмент без изменения его исходного написания по RFC 3986 §3.5.
//
// Параметры:
//  Значение - Строка, Неопределено - Кодированный фрагмент или признак его удаления.
//
// Возвращаемое значение:
//  URL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение имеет недопустимый тип.
//  uri.invalid_syntax - Значение содержит недопустимый символ.
//  uri.invalid_percent_encoding - Значение содержит недопустимую последовательность %HH.
Функция УстановитьКодированныйФрагмент(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат ОчиститьФрагмент();
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));
	ПроверитьКодированныйКомпонент(Значение, ДопустимыеСимволыЗапросаИФрагмента());

	Кандидат = СкопироватьКомпонентыСостояния();
	Кандидат.ФрагментОпределен = Истина;
	Кандидат.КодированныйФрагмент = Значение;
	Кандидат.ПредставлениеФрагмента = Значение;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Удаляет фрагмент целиком по RFC 3986 §3.5.
//
// Возвращаемое значение:
//  URL - Этот объект.
Функция ОчиститьФрагмент() Экспорт

	Кандидат = СкопироватьКомпонентыСостояния();
	Кандидат.ФрагментОпределен = Ложь;
	Кандидат.КодированныйФрагмент = Неопределено;
	Кандидат.ПредставлениеФрагмента = Неопределено;

	Возврат ПрименитьКандидат(Кандидат);

КонецФункции

// Возвращает строку URL с замаскированным паролем.
//
// Метод не гарантирует безопасное журналирование: секреты могут оставаться в path, query и fragment.
//
// Возвращаемое значение:
//  Строка - URL, в котором пароль заменён маской *****.
Функция СтрокаБезПароля() Экспорт

	ПредставлениеДанных = _Состояние.ПредставлениеДанныхПользователя();

	Если ПредставлениеДанных = Неопределено Тогда
		Возврат _Состояние.ВСтроку();
	КонецЕсли;

	ПозицияПароля = СтрНайти(ПредставлениеДанных, ":");

	Если ПозицияПароля = 0 Тогда
		Возврат _Состояние.ВСтроку();
	КонецЕсли;

	Замена = Лев(ПредставлениеДанных, ПозицияПароля) + "*****";
	Возврат ЗаменитьДанныеПользователяВСтроке(Замена, Ложь);

КонецФункции

// Возвращает строку URL без данных пользователя.
//
// Метод не гарантирует безопасное журналирование: секреты могут оставаться в path, query и fragment.
//
// Возвращаемое значение:
//  Строка - URL без userinfo и разделителя @.
Функция СтрокаБезДанныхПользователя() Экспорт

	Если _Состояние.КодированныеДанныеПользователя() = Неопределено Тогда
		Возврат _Состояние.ВСтроку();
	КонецЕсли;

	Возврат ЗаменитьДанныеПользователяВСтроке("", Истина);

КонецФункции

// Разрешает ссылку относительно URL по RFC 3986 §5.2.
//
// Ссылки:
//  RFC 3986, раздел 5.2 - разрешение относительных ссылок:
//  https://www.rfc-editor.org/rfc/rfc3986.html#section-5.2
//
// Параметры:
//  Ссылка - Строка, URI, URL - Разрешаемая ссылка.
//
// Возвращаемое значение:
//  URL - Новый независимый абсолютный URL.
//
// Исключения:
//  argument.invalid_type - Ссылка имеет недопустимый тип.
//  uri.invalid_syntax - Строка ссылки нарушает общую грамматику URI.
//  uri.invalid_scheme - Схема строки ссылки имеет недопустимый синтаксис.
//  uri.invalid_percent_encoding - Строка ссылки содержит недопустимую последовательность %HH.
//  uri.invalid_authority - Серверная часть строки ссылки имеет недопустимую структуру.
//  uri.invalid_host - Хост строки ссылки имеет недопустимый синтаксис.
//  uri.invalid_ipv6 - IPv6-литерал строки ссылки имеет недопустимый синтаксис.
//  uri.invalid_ipvfuture - IPvFuture-литерал строки ссылки имеет недопустимый синтаксис.
Функция Разрешить(Ссылка) Экспорт

	Возврат Новый URL(URI().Разрешить(Ссылка));

КонецФункции

// Строит URI-ссылку на абсолютную цель относительно текущего URL.
//
// Параметры:
//  Цель - Строка, URI, URL - Абсолютная цель.
//
// Возвращаемое значение:
//  URI - Относительная или нормализованная абсолютная URI-ссылка.
//
// Исключения:
//  argument.invalid_type - Цель имеет недопустимый тип.
//  argument.invalid_value - Цель не является абсолютной.
//  uri.invalid_syntax - Строка цели нарушает общую грамматику URI.
//  uri.invalid_scheme - Схема строки цели имеет недопустимый синтаксис.
//  uri.invalid_percent_encoding - Строка цели содержит недопустимую последовательность %HH.
//  uri.invalid_authority - Серверная часть строки цели имеет недопустимую структуру.
//  uri.invalid_host - Хост строки цели имеет недопустимый синтаксис.
//  uri.invalid_ipv6 - IPv6-литерал строки цели имеет недопустимый синтаксис.
//  uri.invalid_ipvfuture - IPvFuture-литерал строки цели имеет недопустимый синтаксис.
Функция СделатьОтносительным(Цель) Экспорт

	Возврат URI().СделатьОтносительным(Цель);

КонецФункции

// Возвращает новый URL, нормализованный по RFC 3986 §6.2.2.
//
// Ссылки:
//  RFC 3986, раздел 6.2.2 - синтаксическая нормализация:
//  https://www.rfc-editor.org/rfc/rfc3986.html#section-6.2.2
//
// Возвращаемое значение:
//  URL - Новый независимый нормализованный URL.
Функция Нормализованный() Экспорт

	Возврат Новый URL(URI().Нормализованный());

КонецФункции

// Возвращает новый URL, нормализованный по общим правилам и правилам конкретной схемы.
//
// Возвращаемое значение:
//  URL - Новый независимый нормализованный URL.
Функция НормализованныйДляСхемы() Экспорт

	Возврат Новый URL(URI().НормализованныйДляСхемы());

КонецФункции

// Создаёт полностью независимую изменяемую копию URL.
//
// Возвращаемое значение:
//  URL - Новый URL с независимым состоянием.
Функция Скопировать() Экспорт

	Возврат Новый URL(URI());

КонецФункции

// Сравнивает исходное написание URL и URI-ссылки.
//
// Параметры:
//  Другое - URI, URL - Сравниваемая ссылка.
//
// Возвращаемое значение:
//  Булево - Истина, если исходные написания совпадают.
//
// Исключения:
//  argument.invalid_type - Другое имеет недопустимый тип.
Функция Равен(Другое) Экспорт

	Возврат URI().Равен(Другое);

КонецФункции

// Сравнивает кодированные компоненты с нормализацией регистра схемы, хоста и %HH.
//
// Параметры:
//  Другое - URI, URL - Сравниваемая ссылка.
//
// Возвращаемое значение:
//  Булево - Истина, если компоненты равны.
//
// Исключения:
//  argument.invalid_type - Другое имеет недопустимый тип.
Функция РавенПоКомпонентам(Другое) Экспорт

	Возврат URI().РавенПоКомпонентам(Другое);

КонецФункции

// Сравнивает URL по кодированным компонентам для детерминированного упорядочивания.
//
// Параметры:
//  Другое - URI, URL - Сравниваемая ссылка.
//
// Возвращаемое значение:
//  Число - Отрицательное число, ноль или положительное число.
//
// Исключения:
//  argument.invalid_type - Другое имеет недопустимый тип.
Функция Сравнить(Другое) Экспорт

	Возврат URI().Сравнить(Другое);

КонецФункции

// Сравнивает URL и URI-ссылки после общей нормализации RFC 3986 §6.2.2.
//
// Параметры:
//  Другое - URI, URL - Сравниваемая ссылка.
//
// Возвращаемое значение:
//  Булево - Истина, если ссылки эквивалентны после общей нормализации.
//
// Исключения:
//  argument.invalid_type - Другое имеет недопустимый тип.
Функция Эквивалентен(Другое) Экспорт

	Возврат URI().Эквивалентен(Другое);

КонецФункции

// Сравнивает URL и URI-ссылки после общей нормализации и нормализации для конкретной схемы.
//
// Параметры:
//  Другое - URI, URL - Сравниваемая ссылка.
//
// Возвращаемое значение:
//  Булево - Истина, если ссылки эквивалентны после нормализации для схемы.
//
// Исключения:
//  argument.invalid_type - Другое имеет недопустимый тип.
Функция ЭквивалентенДляСхемы(Другое) Экспорт

	Возврат URI().ЭквивалентенДляСхемы(Другое);

КонецФункции

// Проверяет соответствие ограничениям известной URI-схемы.
//
// Исключения:
//  uri.invalid_for_scheme - URL нарушает ограничения известной схемы.
Процедура ПроверитьСоответствиеСхеме() Экспорт

	URI().ПроверитьСоответствиеСхеме();

КонецПроцедуры

// Проверяет соответствие ограничениям известной URI-схемы без исключения.
//
// Возвращаемое значение:
//  Булево - Истина, если ссылка соответствует ограничениям схемы.
//
// Исключения:
//  Повторно вызывает неожиданную ошибку, отличную от uri.invalid_for_scheme.
Функция СоответствуетСхеме() Экспорт

	Возврат URI().СоответствуетСхеме();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлассифицироватьХост(КодированныйХост)

	Классификатор = Новый КлассификаторХостаURI;
	Возврат Классификатор.Классифицировать(КодированныйХост);

КонецФункции

Функция СкопироватьКомпонентыСостояния()

	Состояние = _Состояние.Скопировать();
	КодированныйЗапрос = Состояние.КодированныйЗапрос();
	КодированныйФрагмент = Состояние.КодированныйФрагмент();
	КодированныйХост = Состояние.КодированныйХост();

	Если КодированныйХост = Неопределено Тогда
		ВидХоста = Неопределено;
	Иначе
		ВидХоста = КлассифицироватьХост(КодированныйХост);
	КонецЕсли;

	Кандидат = Новый Структура;
	Кандидат.Вставить("Схема", Состояние.Схема());
	Кандидат.Вставить("СервернаяЧастьОпределена", Состояние.СервернаяЧастьОпределена());
	Кандидат.Вставить("ДанныеПользователяОпределены", Состояние.ДанныеПользователяОпределены());
	Кандидат.Вставить("КодированныеДанныеПользователя", Состояние.КодированныеДанныеПользователя());
	Кандидат.Вставить("КодированныйХост", КодированныйХост);
	Кандидат.Вставить("ВидХоста", ВидХоста);
	Кандидат.Вставить("ПортУказан", Состояние.ПортУказан());
	Кандидат.Вставить("ТекстПорта", Состояние.ТекстПорта());
	Кандидат.Вставить("КодированныйПуть", Состояние.КодированныйПуть());
	Кандидат.Вставить("ЗапросОпределен", КодированныйЗапрос <> Неопределено);
	Кандидат.Вставить("КодированныйЗапрос", КодированныйЗапрос);
	Кандидат.Вставить("ФрагментОпределен", КодированныйФрагмент <> Неопределено);
	Кандидат.Вставить("КодированныйФрагмент", КодированныйФрагмент);
	Кандидат.Вставить("ПредставлениеДанныхПользователя", Состояние.ПредставлениеДанныхПользователя());
	Кандидат.Вставить("ПредставлениеХоста", Состояние.ПредставлениеХоста());
	Кандидат.Вставить("ПредставлениеПути", Состояние.ПредставлениеПути());
	Кандидат.Вставить("ПредставлениеЗапроса", Состояние.ПредставлениеЗапроса());
	Кандидат.Вставить("ПредставлениеФрагмента", Состояние.ПредставлениеФрагмента());

	Возврат Кандидат;

КонецФункции

Функция ПрименитьКандидат(Кандидат)

	СинхронизироватьПредставленияКандидата(Кандидат);
	ПроверитьСовместимостьСервернойЧастиИПути(Кандидат);
	НовоеСостояние = Новый СостояниеURI(Кандидат);
	НовоеСостояние.ПроверитьИнварианты(Истина);

	_Состояние = НовоеСостояние;
	Возврат ЭтотОбъект;

КонецФункции

Процедура СинхронизироватьПредставленияКандидата(Кандидат)

	Если Кандидат.КодированныеДанныеПользователя <> _Состояние.КодированныеДанныеПользователя()
		И Кандидат.ПредставлениеДанныхПользователя = _Состояние.ПредставлениеДанныхПользователя() Тогда
		Кандидат.ПредставлениеДанныхПользователя = Кандидат.КодированныеДанныеПользователя;
	КонецЕсли;

	Если Кандидат.КодированныйХост <> _Состояние.КодированныйХост()
		И Кандидат.ПредставлениеХоста = _Состояние.ПредставлениеХоста() Тогда
		Кандидат.ПредставлениеХоста = Кандидат.КодированныйХост;
	КонецЕсли;

	Если Кандидат.КодированныйПуть <> _Состояние.КодированныйПуть()
		И Кандидат.ПредставлениеПути = _Состояние.ПредставлениеПути() Тогда
		Кандидат.ПредставлениеПути = Кандидат.КодированныйПуть;
	КонецЕсли;

	Если Кандидат.КодированныйЗапрос <> _Состояние.КодированныйЗапрос()
		И Кандидат.ПредставлениеЗапроса = _Состояние.ПредставлениеЗапроса() Тогда
		Кандидат.ПредставлениеЗапроса = Кандидат.КодированныйЗапрос;
	КонецЕсли;

	Если Кандидат.КодированныйФрагмент <> _Состояние.КодированныйФрагмент()
		И Кандидат.ПредставлениеФрагмента = _Состояние.ПредставлениеФрагмента() Тогда
		Кандидат.ПредставлениеФрагмента = Кандидат.КодированныйФрагмент;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСовместимостьСервернойЧастиИПути(Кандидат)

	Путь = Кандидат.КодированныйПуть;
	Несовместимы = Кандидат.СервернаяЧастьОпределена
		И Путь <> ""
		И Лев(Путь, 1) <> "/";
	Несовместимы = Несовместимы
		Или Не Кандидат.СервернаяЧастьОпределена И Лев(Путь, 2) = "//";

	Если Несовместимы Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыОшибокURL.НесовместимыеКомпонентыURL(),
			"Серверная часть и путь URL несовместимы"
		);
	КонецЕсли;

КонецПроцедуры

Процедура ОбеспечитьСервернуюЧасть(Кандидат)

	Если Кандидат.СервернаяЧастьОпределена Тогда
		Возврат;
	КонецЕсли;

	Кандидат.СервернаяЧастьОпределена = Истина;
	Кандидат.ДанныеПользователяОпределены = Ложь;
	Кандидат.КодированныеДанныеПользователя = Неопределено;
	Кандидат.КодированныйХост = "";
	Кандидат.ПредставлениеДанныхПользователя = Неопределено;
	Кандидат.ПредставлениеХоста = "";
	Кандидат.ВидХоста = КлассифицироватьХост("");
	Кандидат.ПортУказан = Ложь;
	Кандидат.ТекстПорта = Неопределено;

КонецПроцедуры

Процедура ЗаполнитьСервернуюЧастьКандидата(Кандидат, Компоненты)

	Кандидат.СервернаяЧастьОпределена = Истина;
	Кандидат.ДанныеПользователяОпределены = Компоненты.ДанныеПользователяОпределены;
	Кандидат.КодированныеДанныеПользователя = Компоненты.КодированныеДанныеПользователя;
	Кандидат.ПредставлениеДанныхПользователя = Компоненты.ПредставлениеДанныхПользователя;
	Кандидат.КодированныйХост = Компоненты.КодированныйХост;
	Кандидат.ПредставлениеХоста = Компоненты.ПредставлениеХоста;
	Кандидат.ВидХоста = Компоненты.ВидХоста;
	Кандидат.ПортУказан = Компоненты.ПортУказан;
	Кандидат.ТекстПорта = Компоненты.ТекстПорта;

КонецПроцедуры

Функция РазобратьКодированнуюСервернуюЧасть(Значение)

	Состояние = Новый ПарсерIRI().Разобрать("x://" + Значение + "/");

	Если Состояние.КодированнаяСервернаяЧасть() <> Значение
		Или Состояние.КодированныйПуть() <> "/"
		Или Состояние.КодированныйЗапрос() <> Неопределено
		Или Состояние.КодированныйФрагмент() <> Неопределено Тогда
		ВызватьНедопустимуюСервернуюЧасть();
	КонецЕсли;

	Компоненты = Новый Структура;
	Компоненты.Вставить("ДанныеПользователяОпределены", Состояние.ДанныеПользователяОпределены());
	Компоненты.Вставить("КодированныеДанныеПользователя", Состояние.КодированныеДанныеПользователя());
	Компоненты.Вставить("ПредставлениеДанныхПользователя", Состояние.ПредставлениеДанныхПользователя());
	Компоненты.Вставить("КодированныйХост", Состояние.КодированныйХост());
	Компоненты.Вставить("ПредставлениеХоста", Состояние.ПредставлениеХоста());
	Компоненты.Вставить("ВидХоста", КлассифицироватьХост(Состояние.КодированныйХост()));
	Компоненты.Вставить("ПортУказан", Состояние.ПортУказан());
	Компоненты.Вставить("ТекстПорта", Состояние.ТекстПорта());

	Возврат Компоненты;

КонецФункции

Функция РазобратьДекодированнуюСервернуюЧасть(Значение)

	Если КоличествоСимволов(Значение, "@") > 1 Тогда
		ВызватьНедопустимуюСервернуюЧасть();
	КонецЕсли;

	ПозицияПользователя = СтрНайти(Значение, "@");

	Если ПозицияПользователя = 0 Тогда
		ДанныеПользователяОпределены = Ложь;
		КодированныеДанныеПользователя = Неопределено;
		ПредставлениеДанныхПользователя = Неопределено;
		ХостИПорт = Значение;
	Иначе
		ДанныеПользователяОпределены = Истина;
		ДанныеПользователя = Лев(Значение, ПозицияПользователя - 1);

		Если СтрНайти(ДанныеПользователя, "[") > 0 Или СтрНайти(ДанныеПользователя, "]") > 0 Тогда
			ВызватьНедопустимуюСервернуюЧасть();
		КонецЕсли;

		КодированныеДанныеПользователя = КодированиеURL.КодироватьДанныеПользователя(ДанныеПользователя);
		ПредставлениеДанныхПользователя = ПодготовитьПредставлениеКомпонента(
			ДанныеПользователя,
			ДопустимыеСимволыДанныхПользователя()
		);
		ХостИПорт = Сред(Значение, ПозицияПользователя + 1);
	КонецЕсли;

	РазобранныеХостИПорт = РазобратьДекодированныеХостИПорт(ХостИПорт);
	Компоненты = Новый Структура;
	Компоненты.Вставить("ДанныеПользователяОпределены", ДанныеПользователяОпределены);
	Компоненты.Вставить("КодированныеДанныеПользователя", КодированныеДанныеПользователя);
	Компоненты.Вставить("ПредставлениеДанныхПользователя", ПредставлениеДанныхПользователя);
	Компоненты.Вставить("КодированныйХост", РазобранныеХостИПорт.КодированныйХост);
	Компоненты.Вставить("ПредставлениеХоста", РазобранныеХостИПорт.ПредставлениеХоста);
	Компоненты.Вставить("ВидХоста", РазобранныеХостИПорт.ВидХоста);
	Компоненты.Вставить("ПортУказан", РазобранныеХостИПорт.ПортУказан);
	Компоненты.Вставить("ТекстПорта", РазобранныеХостИПорт.ТекстПорта);

	Возврат Компоненты;

КонецФункции

Функция РазобратьДекодированныеХостИПорт(Значение)

	ПортУказан = Ложь;
	ТекстПорта = Неопределено;

	Если Лев(Значение, 1) = "[" Тогда
		ПозицияЗакрывающейСкобки = СтрНайти(Значение, "]");

		Если ПозицияЗакрывающейСкобки = 0 Тогда
			ВызватьНедопустимуюСервернуюЧасть();
		КонецЕсли;

		Хост = Лев(Значение, ПозицияЗакрывающейСкобки);
		Остаток = Сред(Значение, ПозицияЗакрывающейСкобки + 1);

		Если Остаток <> "" Тогда
			Если Лев(Остаток, 1) <> ":" Тогда
				ВызватьНедопустимуюСервернуюЧасть();
			КонецЕсли;

			ПортУказан = Истина;
			ТекстПорта = Сред(Остаток, 2);
		КонецЕсли;
	Иначе
		Если СтрНайти(Значение, "[") > 0 Или СтрНайти(Значение, "]") > 0
			Или КоличествоСимволов(Значение, ":") > 1 Тогда
			ВызватьНедопустимуюСервернуюЧасть();
		КонецЕсли;

		ПозицияПорта = СтрНайти(Значение, ":");

		Если ПозицияПорта = 0 Тогда
			Хост = Значение;
		Иначе
			Хост = Лев(Значение, ПозицияПорта - 1);
			ПортУказан = Истина;
			ТекстПорта = Сред(Значение, ПозицияПорта + 1);
		КонецЕсли;
	КонецЕсли;

	Если Не ТолькоЦифрыASCII(ТекстПорта) Тогда
		ВызватьНедопустимуюСервернуюЧасть();
	КонецЕсли;

	ПодготовленныйХост = ПодготовитьДекодированныйХост(Хост);

	Компоненты = Новый Структура;
	Компоненты.Вставить("КодированныйХост", ПодготовленныйХост.КодированныйХост);
	Компоненты.Вставить(
		"ПредставлениеХоста",
		ПодготовитьПредставлениеХоста(Хост, ПодготовленныйХост.КодированныйХост)
	);
	Компоненты.Вставить("ВидХоста", ПодготовленныйХост.ВидХоста);
	Компоненты.Вставить("ПортУказан", ПортУказан);
	Компоненты.Вставить("ТекстПорта", ТекстПорта);

	Возврат Компоненты;

КонецФункции

Функция ПодготовитьДекодированныйХост(Значение)

	ЕстьОткрывающаяСкобка = Лев(Значение, 1) = "[";
	ЕстьЗакрывающаяСкобка = Прав(Значение, 1) = "]";

	Если ЕстьОткрывающаяСкобка Или ЕстьЗакрывающаяСкобка Тогда
		Если Не (ЕстьОткрывающаяСкобка И ЕстьЗакрывающаяСкобка) Тогда
			ВызватьНедопустимыйХост();
		КонецЕсли;

		КодированныйХост = Значение;
		ВидХоста = КлассифицироватьХост(КодированныйХост);
	ИначеЕсли СтрНайти(Значение, ":") > 0 Тогда
		КодированныйХост = "[" + Значение + "]";
		ВидХоста = КлассифицироватьХост(КодированныйХост);

		Если ВидХоста <> ВидыХостаURI.IPv6() Тогда
			ВызватьНедопустимыйХост();
		КонецЕсли;
	Иначе
		ПроверкаКодовыхТочекIRI.ПроверитьКомпонент(Значение);
		КодированныйХост = КодироватьЗарегистрированноеИмя(Значение);
		ВидХоста = КлассифицироватьХост(КодированныйХост);
	КонецЕсли;

	Если ВидХоста = Неопределено Тогда
		ВызватьНедопустимыйХост();
	КонецЕсли;

	Возврат Новый Структура("КодированныйХост,ВидХоста", КодированныйХост, ВидХоста);

КонецФункции

Функция КодироватьЗарегистрированноеИмя(Значение)

	Возврат КодированиеКомпонентовURI.Кодировать(
		Значение,
		ДопустимыеСимволыЗарегистрированногоИмени()
	);

КонецФункции

Процедура ПроверитьКодированныеДанныеПользователя(Значение)

	Состояние = Новый ПарсерIRI().Разобрать("x://" + Значение + "@h/");

	Если Не Состояние.ДанныеПользователяОпределены()
		Или Состояние.КодированныеДанныеПользователя() <> Значение
		Или Состояние.КодированныйХост() <> "h"
		Или Состояние.КодированныйПуть() <> "/"
		Или Состояние.КодированныйЗапрос() <> Неопределено
		Или Состояние.КодированныйФрагмент() <> Неопределено Тогда
		ВызватьНедопустимуюСервернуюЧасть();
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьASCIIИПроцентноеКодирование(Значение)

	Индекс = 1;

	Пока Индекс <= СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);

		Если КодСимвола(Символ) > 127 Тогда
			ВызватьНедопустимыйСинтаксис();
		КонецЕсли;

		Если Символ = "%" Тогда
			Если Индекс + 2 > СтрДлина(Значение)
				Или Не ЭтоШестнадцатеричныйСимвол(Сред(Значение, Индекс + 1, 1))
				Или Не ЭтоШестнадцатеричныйСимвол(Сред(Значение, Индекс + 2, 1)) Тогда
				ВызватьНедопустимоеПроцентноеКодирование();
			КонецЕсли;

			Индекс = Индекс + 3;
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция КоличествоСимволов(Значение, ИскомыйСимвол)

	Результат = 0;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если Сред(Значение, Индекс, 1) = ИскомыйСимвол Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ТолькоЦифрыASCII(Значение)

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если Не ЭтоЦифраASCII(Сред(Значение, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоДопустимаяСхема(Значение)

	Если Значение = "" Или Не ЭтоБукваASCII(Лев(Значение, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 2 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);

		Если Не ЭтоБукваASCII(Символ)
			И Не ЭтоЦифраASCII(Символ)
			И СтрНайти("+.-", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоБукваASCII(Символ)

	Код = КодСимвола(Символ);

	// Коды ASCII: A-Z - 65-90, a-z - 97-122.
	Возврат Код >= 65 И Код <= 90
		Или Код >= 97 И Код <= 122;

КонецФункции

Функция ЭтоЦифраASCII(Символ)

	Код = КодСимвола(Символ);

	// Коды ASCII: 0-9 - 48-57.
	Возврат Код >= 48 И Код <= 57;

КонецФункции

Функция ЭтоШестнадцатеричныйСимвол(Символ)

	Код = КодСимвола(Символ);

	// Коды ASCII: A-F - 65-70, a-f - 97-102.
	Возврат ЭтоЦифраASCII(Символ)
		Или Код >= 65 И Код <= 70
		Или Код >= 97 И Код <= 102;

КонецФункции

Процедура ВызватьНедопустимуюСхему()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимаяСхемаURI(),
		"Недопустимая схема URL"
	);

КонецПроцедуры

Процедура ВызватьНедопустимуюСервернуюЧасть()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимаяСервернаяЧастьURI(),
		"Недопустимая серверная часть URL"
	);

КонецПроцедуры

Процедура ВызватьНедопустимыйХост()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыйХостURI(),
		"Недопустимый хост URL"
	);

КонецПроцедуры

Процедура ВызватьНедопустимыйСинтаксис()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыйСинтаксисURI(),
		"Недопустимый синтаксис URL"
	);

КонецПроцедуры

Процедура ВызватьНедопустимоеПроцентноеКодирование()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимоеПроцентноеКодированиеURI(),
		"Недопустимое процентное кодирование URL"
	);

КонецПроцедуры

Процедура УстановитьСостояние(СтрокаURI)

	Состояние = Новый ПарсерIRI().Разобрать(СтрокаURI);
	Состояние.ПроверитьИнварианты(Истина);
	_Состояние = Состояние;

КонецПроцедуры

Функция ПривестиКURI(ИмяАргумента, Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Или ТипЗнч(Значение) = Тип("URI") Тогда
		Возврат Новый URI(Значение);
	КонецЕсли;

	Если Строка(ТипЗнч(Значение)) = "URL" Тогда
		Возврат Значение.URI();
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип(ИмяАргумента, Значение, "Строка, URI, URL");

КонецФункции

Процедура ДобавитьСегментВПредставленияПути(Кандидат, Сегмент)

	Кандидат.КодированныйПуть = ДобавитьСегментКПути(
		Кандидат.КодированныйПуть,
		КодированиеURL.КодироватьСегментПути(Сегмент),
		Кандидат.СервернаяЧастьОпределена
	);
	Кандидат.ПредставлениеПути = ДобавитьСегментКПути(
		Кандидат.ПредставлениеПути,
		ПодготовитьПредставлениеКомпонента(Сегмент, ДопустимыеСимволыСегментаПути()),
		Кандидат.СервернаяЧастьОпределена
	);

КонецПроцедуры

Функция ДобавитьСегментКПути(Путь, Сегмент, СервернаяЧастьОпределена)

	Если Путь = "" Тогда
		Если Не СервернаяЧастьОпределена И Сегмент = "" Тогда
			Возврат "";
		КонецЕсли;

		Если СервернаяЧастьОпределена Тогда
			Возврат "/" + Сегмент;
		Иначе
			Возврат Сегмент;
		КонецЕсли;
	ИначеЕсли Прав(Путь, 1) = "/" Тогда
		Если Сегмент = "" Тогда
			Возврат Путь + "/";
		Иначе
			Возврат Путь + Сегмент;
		КонецЕсли;
	Иначе
		Возврат Путь + "/" + Сегмент;
	КонецЕсли;

КонецФункции

Функция УдалитьПоследнийСегментИзПути(Путь)

	Если Прав(Путь, 1) = "/" Тогда
		Возврат Лев(Путь, СтрДлина(Путь) - 1);
	КонецЕсли;

	ПозицияСлеша = ПоследняяПозицияСимвола(Путь, "/");

	Если ПозицияСлеша = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Лев(Путь, ПозицияСлеша - 1);

КонецФункции

Процедура ПроверитьКодированныйКомпонент(Значение, РазрешенныеСимволы)

	ПроверитьASCIIИПроцентноеКодирование(Значение);
	Индекс = 1;

	Пока Индекс <= СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);

		Если Символ = "%" Тогда
			Индекс = Индекс + 3;
		ИначеЕсли СтрНайти(РазрешенныеСимволы, Символ) = 0 Тогда
			ВызватьНедопустимыйСинтаксис();
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПодготовитьПредставлениеКомпонента(
	Значение,
	РазрешенныеСимволы,
	РазрешитьЧастныеКодовыеТочки = Ложь
)

	ПроверкаКодовыхТочекIRI.ПроверитьКомпонент(Значение, РазрешитьЧастныеКодовыеТочки);
	Результат = "";

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);

		Если КодСимвола(Символ) > 127 Или СтрНайти(РазрешенныеСимволы, Символ) > 0 Тогда
			Результат = Результат + Символ;
		Иначе
			Результат = Результат + КодированиеКомпонентовURI.Кодировать(Символ, "");
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПодготовитьПредставлениеХоста(Значение, КодированныйХост)

	Если СодержитСимволыВнеASCII(Значение) Тогда
		Возврат ПодготовитьПредставлениеКомпонента(
			Значение,
			ДопустимыеСимволыЗарегистрированногоИмени()
		);
	КонецЕсли;

	Возврат КодированныйХост;

КонецФункции

Функция СодержитСимволыВнеASCII(Значение)

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если КодСимвола(Сред(Значение, Индекс, 1)) > 127 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ДопустимыеСимволыЗарегистрированногоИмени()

	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;=";

КонецФункции

Функция ДопустимыеСимволыПути()

	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;=:@/";

КонецФункции

Функция ДопустимыеСимволыСегментаПути()

	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;=:@";

КонецФункции

Функция ДопустимыеСимволыИмениПользователя()

	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;=";

КонецФункции

Функция ДопустимыеСимволыДанныхПользователя()

	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;=:";

КонецФункции

Функция ДопустимыеСимволыЗапросаИФрагмента()

	Возврат ДопустимыеСимволыПути() + "?";

КонецФункции

Функция ПоследняяПозицияСимвола(Значение, Символ)

	Результат = 0;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если Сред(Значение, Индекс, 1) = Символ Тогда
			Результат = Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗаменитьДанныеПользователяВСтроке(Замена, УдалитьРазделитель)

	ИсходнаяСтрока = _Состояние.ВСтроку();
	НачалоДанныхПользователя = СтрДлина(_Состояние.Схема()) + 4;
	ДлинаДанныхПользователя = СтрДлина(_Состояние.ПредставлениеДанныхПользователя());
	Префикс = Лев(ИсходнаяСтрока, НачалоДанныхПользователя - 1);

	Если УдалитьРазделитель Тогда
		Суффикс = Сред(ИсходнаяСтрока, НачалоДанныхПользователя + ДлинаДанныхПользователя + 1);
	Иначе
		Суффикс = Сред(ИсходнаяСтрока, НачалоДанныхПользователя + ДлинаДанныхПользователя);
	КонецЕсли;

	Возврат Префикс + Замена + Суффикс;

КонецФункции

#КонецОбласти
