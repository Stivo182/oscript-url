#Использовать errors
#Использовать "../internal"

Перем _Состояние; // СостояниеURI

#Область ОбработчикиСобытий

// Создаёт изменяемый абсолютный URL из ссылки и необязательной абсолютной базы.
// Относительная ссылка разрешается по RFC 3986 §5.2.
//
// Ссылки:
//  RFC 3986, раздел 5.2 - разрешение относительных ссылок:
//  https://www.rfc-editor.org/rfc/rfc3986.html#section-5.2
//
// Параметры:
//  Адрес - Строка, URI, URL, Неопределено - Адрес ссылки.
//  База - Строка, URI, URL, Неопределено - Абсолютная база для разрешения ссылки.
Процедура ПриСозданииОбъекта(Адрес = Неопределено, База = Неопределено)

	Если База = Неопределено Тогда
		Если Адрес = Неопределено Тогда
			УстановитьСостояние("http://localhost/");
			Возврат;
		КонецЕсли;

		АдресURI = ПривестиКURI("Адрес", Адрес);
		Если Не АдресURI.ЭтоАбсолютный() Тогда
			ВызватьИсключение ФабрикаОшибок.Создать(
				КодыОшибокURL.ОтносительныйURLБезБазы(),
				"Невозможно создать URL из относительной ссылки без базы"
			);
		КонецЕсли;

		УстановитьСостояние(АдресURI.ВСтроку());
		Возврат;
	КонецЕсли;

	Если Адрес = Неопределено Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыСтандартныхОшибок.АргументНеЗаполнен(),
			"Не заполнен обязательный аргумент Адрес",
			Новый Структура("ИмяАргумента", "Адрес")
		);
	КонецЕсли;

	АдресURI = ПривестиКURI("Адрес", Адрес);
	БазаURI = ПривестиКURI("База", База);
	Если Не БазаURI.ЭтоАбсолютный() Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыОшибокURL.БазаURLНеАбсолютная(),
			"База URL должна быть абсолютной"
		);
	КонецЕсли;

	УстановитьСостояние(БазаURI.Разрешить(АдресURI).ВСтроку());

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает неизменяемый снимок текущего состояния URL.
//
// Возвращаемое значение:
//  URI - Независимый URI-снимок в исходном написании по RFC 3986 §3.
Функция URI() Экспорт

	Возврат Новый URI(_Состояние.ВСтроку());

КонецФункции

// Возвращает URL в исходном написании без потерь.
//
// Возвращаемое значение:
//  Строка - URL по RFC 3986 §3.
Функция ВСтроку() Экспорт

	Возврат URI().ВСтроку();

КонецФункции

// Возвращает схему URL по RFC 3986 §3.1.
//
// Возвращаемое значение:
//  Строка - Схема абсолютного URL.
Функция Схема() Экспорт

	Возврат URI().Схема();

КонецФункции

// Возвращает декодированную серверную часть по RFC 3986 §3.2.
//
// Возвращаемое значение:
//  Строка, Неопределено - Серверная часть или Неопределено при её отсутствии.
Функция СервернаяЧасть() Экспорт

	Возврат URI().СервернаяЧасть();

КонецФункции

// Возвращает кодированную серверную часть по RFC 3986 §3.2.
//
// Возвращаемое значение:
