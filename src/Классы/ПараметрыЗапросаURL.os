#Использовать errors
#Использовать "../internal"

Перем _Пары; // ТаблицаЗначений
Перем _СледующийПорядок; // Число
Перем _КодированнаяСтрокаПараметров; // Строка, Неопределено
Перем _ПредставлениеСтрокиПараметров; // Строка, Неопределено
Перем _Формат; // Строка
Перем _СтрокиАктуальны; // Булево

#Область ОбработчикиСобытий

// Создаёт коллекцию параметров URL.
//
// Параметры:
//  СтрокаПараметров - Строка, Неопределено - Кодированная строка без ? или её отсутствие.
//  Формат - Строка, Неопределено - Формат параметров или RFC3986 при Неопределено.
//
// Исключения:
//  argument.invalid_type - Аргумент имеет недопустимый тип.
//  argument.invalid_value - Формат не поддерживается.
//  url.invalid_syntax - СтрокаПараметров содержит недопустимый символ.
Процедура ПриСозданииОбъекта(СтрокаПараметров = Неопределено, Формат = Неопределено)

	_Пары = НоваяТаблицаПар();
	_СледующийПорядок = 0;
	_Формат = НормализоватьФормат(Формат);
	_КодированнаяСтрокаПараметров = Неопределено;
	_ПредставлениеСтрокиПараметров = Неопределено;
	_СтрокиАктуальны = Истина;

	Если СтрокаПараметров <> Неопределено Тогда
		ИнициализироватьИзСтрокиПараметров(СтрокаПараметров);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает число пар, включая пары с повторяющимся именем.
//
// Возвращаемое значение:
//  Число - Количество пар параметров.
Функция Количество() Экспорт

	Возврат _Пары.Количество();

КонецФункции

// Проверяет наличие хотя бы одной пары с заданным именем.
//
// Параметры:
//  Имя - Строка - Имя параметра.
//
// Возвращаемое значение:
//  Булево - Истина, если параметр существует.
//
// Исключения:
//  argument.invalid_type - Имя имеет недопустимый тип.
Функция Содержит(Имя) Экспорт

	ПроверитьСтроковыйАргумент("Имя", Имя);

	Возврат НайтиПары(Имя).Количество() > 0;

КонецФункции

// Возвращает первое значение параметра по его имени.
//
// Параметры:
//  Имя - Строка - Имя параметра.
//
// Возвращаемое значение:
//  Строка, Неопределено - Первое значение либо Неопределено.
//
// Исключения:
//  argument.invalid_type - Имя имеет недопустимый тип.
Функция Получить(Имя) Экспорт

	ПроверитьСтроковыйАргумент("Имя", Имя);

	Пары = НайтиПары(Имя);

	Если Пары.Количество() > 0 Тогда
		Возврат ПерваяПараПоПорядку(Пары).Значение;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает все значения параметра в исходном порядке.
//
// Параметры:
//  Имя - Строка - Имя параметра.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Новый неизменяемый массив строковых и неопределенных значений.
//
// Исключения:
//  argument.invalid_type - Имя имеет недопустимый тип.
Функция ПолучитьВсе(Имя) Экспорт

	ПроверитьСтроковыйАргумент("Имя", Имя);

	Значения = Новый Массив;
	Пары = ОтсортироватьПарыПоПорядку(НайтиПары(Имя));

	Для Каждого Пара Из Пары Цикл
		Значения.Добавить(Пара.Значение);
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Значения);

КонецФункции

// Добавляет новую пару в конец коллекции.
//
// Параметры:
//  Имя - Строка - Имя параметра.
//  Значение - Произвольный, Неопределено - Значение параметра. В RFC3986 Неопределено добавляет параметр без
//      значения, в ВебФорма нормализуется в пустую строку.
//      Строки сохраняются без изменений, булевы значения, числа и даты преобразуются в независимое от локали
//      строковое представление, остальные значения преобразуются функцией Строка().
//
// Возвращаемое значение:
//  ПараметрыЗапросаURL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Имя имеет недопустимый тип или Значение равно Null.
//  argument.invalid_value - Имя пустое для параметра без значения.
Функция Добавить(Имя, Значение = Неопределено) Экспорт

	ПроверитьСтроковыйАргумент("Имя", Имя);

	Значение = СтроковоеПредставлениеЗначения(Значение);
	Значение = НормализоватьЗначениеДляФормата(Значение, _Формат);
	ПроверитьДопустимостьПараметраБезЗначения(Имя, Значение);

	ДобавитьПаруВКонец(Имя, Значение);
	СделатьСтрокиНеактуальными();

	Возврат ЭтотОбъект;

КонецФункции

// Заменяет все пары с именем, сохраняя позицию первой пары.
//
// Параметры:
//  Имя - Строка - Имя параметра.
//  Значение - Произвольный, Неопределено - Новое значение параметра. В RFC3986 Неопределено устанавливает
//      параметр без значения, в ВебФорма нормализуется в пустую строку. Строки сохраняются без изменений,
//      булевы значения, числа и даты преобразуются в независимое от локали строковое представление, остальные
//      значения преобразуются функцией Строка().
//
// Возвращаемое значение:
//  ПараметрыЗапросаURL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Имя имеет недопустимый тип или Значение равно Null.
//  argument.invalid_value - Имя пустое для параметра без значения.
Функция Установить(Имя, Значение = Неопределено) Экспорт

	ПроверитьСтроковыйАргумент("Имя", Имя);

	Значение = СтроковоеПредставлениеЗначения(Значение);
	Значение = НормализоватьЗначениеДляФормата(Значение, _Формат);
	ПроверитьДопустимостьПараметраБезЗначения(Имя, Значение);

	Пары = НайтиПары(Имя);

	Если Пары.Количество() = 0 Тогда
		ДобавитьПаруВКонец(Имя, Значение);
	Иначе
		ПерваяПара = ПерваяПараПоПорядку(Пары);
		ПерваяПара.Значение = Значение;

		Для Каждого Пара Из Пары Цикл
			Если Пара.Порядок <> ПерваяПара.Порядок Тогда
				_Пары.Удалить(Пара);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	СделатьСтрокиНеактуальными();

	Возврат ЭтотОбъект;

КонецФункции

// Удаляет все пары с заданным именем.
//
// Параметры:
//  Имя - Строка - Имя параметра.
//
// Возвращаемое значение:
//  ПараметрыЗапросаURL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Имя имеет недопустимый тип.
Функция Удалить(Имя) Экспорт

	ПроверитьСтроковыйАргумент("Имя", Имя);

	Для Каждого Пара Из НайтиПары(Имя) Цикл
		_Пары.Удалить(Пара);
	КонецЦикла;

	СделатьСтрокиНеактуальными();

	Возврат ЭтотОбъект;

КонецФункции

// Удаляет все параметры из коллекции.
//
// Возвращаемое значение:
//  ПараметрыЗапросаURL - Этот объект.
Функция Очистить() Экспорт

	_Пары = НоваяТаблицаПар();
	_СледующийПорядок = 0;
	_КодированнаяСтрокаПараметров = Неопределено;
	_ПредставлениеСтрокиПараметров = Неопределено;
	_СтрокиАктуальны = Истина;

	Возврат ЭтотОбъект;

КонецФункции

// Стабильно сортирует пары по имени в порядке кодовых единиц UTF-16.
//
// Возвращаемое значение:
//  ПараметрыЗапросаURL - Этот объект.
Функция Сортировать() Экспорт

	ОтсортированныеПары = ОтсортироватьПарыПоИмени();

	_Пары = НоваяТаблицаПар();
	_СледующийПорядок = 0;

	Для Каждого Пара Из ОтсортированныеПары Цикл
		ДобавитьПаруВКонец(Пара.Имя, Пара.Значение);
	КонецЦикла;

	СделатьСтрокиНеактуальными();

	Возврат ЭтотОбъект;

КонецФункции

// Возвращает глубокие независимые копии пар параметров.
//
// Возвращаемое значение:
//  Массив - Новый массив структур Имя и Значение. Значение имеет тип Строка или Неопределено.
Функция ВМассив() Экспорт

	Результат = Новый Массив;

	Для Каждого Пара Из _Пары Цикл
		Результат.Добавить(НоваяКопияПары(Пара.Имя, Пара.Значение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заменяет кодированную строку и разбирает её в указанном или текущем формате.
//
// Параметры:
//  Значение - Строка, Неопределено - Строка без ? или признак удаления компонента запроса.
//  Формат - Строка, Неопределено - Новый формат или текущий при Неопределено.
//
// Возвращаемое значение:
//  ПараметрыЗапросаURL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Значение или Формат имеет недопустимый тип.
//  argument.invalid_value - Формат не поддерживается.
//  url.invalid_syntax - Значение содержит недопустимый символ.
Функция УстановитьКодированнуюСтроку(Значение, Формат = Неопределено) Экспорт

	Если Значение <> Неопределено Тогда
		ПроверитьСтроковыйАргумент("Значение", Значение);
	КонецЕсли;

	НовыйФормат = ?(Формат = Неопределено, _Формат, НормализоватьФормат(Формат));
	Кандидат = Новый ПараметрыЗапросаURL(Значение, НовыйФормат);

	ЗаменитьПары(Кандидат.ВМассив());

	_Формат = НовыйФормат;
	_КодированнаяСтрокаПараметров = Кандидат.КодированнаяСтрока();
	_ПредставлениеСтрокиПараметров = Кандидат.ИсходнаяСтрока();
	_СтрокиАктуальны = Истина;

	Возврат ЭтотОбъект;

КонецФункции

// Повторно разбирает текущую кодированную строку в указанном формате.
//
// Параметры:
//  Формат - Строка - Формат разбора параметров.
//
// Возвращаемое значение:
//  ПараметрыЗапросаURL - Этот объект.
//
// Исключения:
//  argument.invalid_type - Формат имеет недопустимый тип.
//  argument.invalid_value - Формат не поддерживается или кодированная строка пуста.
Функция РазобратьКак(Формат) Экспорт

	ПроверитьСтроковыйАргумент("Формат", Формат);

	Формат = НормализоватьФормат(Формат);

	ОбеспечитьСтроковыеПредставления();
	ПроверкаАргументов.ПроверитьДопустимость(
		"КодированнаяСтрока",
		_КодированнаяСтрокаПараметров <> Неопределено И _КодированнаяСтрокаПараметров <> "",
		"непустая кодированная строка"
	);

	Кандидат = Новый ПараметрыЗапросаURL(_КодированнаяСтрокаПараметров, Формат);
	ЗаменитьПары(Кандидат.ВМассив());
	_Формат = Формат;

	Возврат ЭтотОбъект;

КонецФункции

// Возвращает текущий формат разбора и сериализации параметров.
//
// Возвращаемое значение:
//  Строка - Одно из значений ФорматыПараметровЗапросаURL.
Функция ТекущийФормат() Экспорт

	Возврат _Формат;

КонецФункции

// Возвращает актуальную кодированную строку параметров.
//
// Возвращаемое значение:
//  Строка, Неопределено - Строка без начального ? или отсутствие компонента запроса.
Функция КодированнаяСтрока() Экспорт

	ОбеспечитьСтроковыеПредставления();

	Возврат _КодированнаяСтрокаПараметров;

КонецФункции

// Возвращает исходное представление строки параметров.
//
// Возвращаемое значение:
//  Строка, Неопределено - Строка без ? или отсутствие компонента запроса.
Функция ИсходнаяСтрока() Экспорт

	ОбеспечитьСтроковыеПредставления();

	Возврат _ПредставлениеСтрокиПараметров;

КонецФункции

// Сериализует пары в текущем или указанном формате.
//
// Параметры:
//  Формат - Строка, Неопределено - Целевой формат или текущий при Неопределено.
//
// Возвращаемое значение:
//  Строка - Строка параметров без начального символа ?.
//
// Исключения:
//  argument.invalid_type - Формат имеет недопустимый тип.
//  argument.invalid_value - Формат не поддерживается.
Функция ВСтроку(Формат = Неопределено) Экспорт

	Формат = ?(Формат = Неопределено, _Формат, НормализоватьФормат(Формат));

	Возврат СериализоватьПары(Формат);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ИнициализироватьИзСтрокиПараметров(СтрокаПараметров)

	ПроверитьСтроковыйАргумент("СтрокаПараметров", СтрокаПараметров);

	Компоненты = СервисыБиблиотекиURL.ПарсерIRI().Разобрать("?" + СтрокаПараметров);

	Если Компоненты.ФрагментОпределен Тогда
		ВызватьНедопустимыйСинтаксисСтрокиПараметров();
	КонецЕсли;

	СервисыБиблиотекиURL.РазборщикКомпонентовURL()
		.ПроверитьКодированныйЗапрос(Компоненты.КодированныйЗапрос);

	_КодированнаяСтрокаПараметров = Компоненты.КодированныйЗапрос;
	_ПредставлениеСтрокиПараметров = Компоненты.ПредставлениеЗапроса;

	РазобратьСтрокуПараметров(_КодированнаяСтрокаПараметров, _Формат);

КонецПроцедуры

Функция СериализоватьПары(Формат)

	Фрагменты = Новый Массив;

	Для Каждого Пара Из _Пары Цикл
		КодированноеИмя = КодироватьПараметр(Пара.Имя, Формат);

		Если Пара.Значение = Неопределено
			И Формат = ФорматыПараметровЗапросаURL.RFC3986() Тогда
			Фрагменты.Добавить(КодированноеИмя);
		Иначе
			Значение = ?(Пара.Значение = Неопределено, "", Пара.Значение);
			Фрагменты.Добавить(
				КодированноеИмя + "=" + КодироватьПараметр(Значение, Формат)
			);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, "&");

КонецФункции

Функция КодироватьПараметр(Значение, Формат)

	Если Формат = ФорматыПараметровЗапросаURL.ВебФорма() Тогда
		Возврат КодированиеURL.КодироватьПараметрФормы(Значение);
	КонецЕсли;

	Возврат СервисыБиблиотекиURL.КодировщикКомпонентовURI().Кодировать(
		Значение,
		"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~"
	);

КонецФункции

Процедура СделатьСтрокиНеактуальными()

	_СтрокиАктуальны = Ложь;

КонецПроцедуры

Процедура ВызватьНедопустимыйСинтаксисСтрокиПараметров()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыйСинтаксис(),
		"Строка параметров содержит разделитель фрагмента"
	);

КонецПроцедуры

Процедура ОбеспечитьСтроковыеПредставления()

	Если _СтрокиАктуальны Тогда
		Возврат;
	КонецЕсли;

	ЗапросБылЯвноПустым = _КодированнаяСтрокаПараметров = "";
	СтрокаПараметров = СериализоватьПары(_Формат);

	_КодированнаяСтрокаПараметров = СтрокаПараметров;
	Если СтрокаПараметров = "" И Не ЗапросБылЯвноПустым Тогда
		_КодированнаяСтрокаПараметров = Неопределено;
	КонецЕсли;

	_ПредставлениеСтрокиПараметров = _КодированнаяСтрокаПараметров;
	_СтрокиАктуальны = Истина;

КонецПроцедуры

Функция НоваяТаблицаПар()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Значение");
	Таблица.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	Таблица.Индексы.Добавить("Имя");

	Возврат Таблица;

КонецФункции

Процедура ДобавитьПаруВКонец(Имя, Значение)

	Пара = _Пары.Добавить();
	Пара.Имя = Имя;
	Пара.Значение = Значение;
	Пара.Порядок = _СледующийПорядок;

	_СледующийПорядок = _СледующийПорядок + 1;

КонецПроцедуры

Процедура ЗаменитьПары(Пары)

	_Пары = НоваяТаблицаПар();
	_СледующийПорядок = 0;

	Для Каждого Пара Из Пары Цикл
		ДобавитьПаруВКонец(Пара.Имя, Пара.Значение);
	КонецЦикла;

КонецПроцедуры

Функция НайтиПары(Имя)

	Возврат _Пары.НайтиСтроки(Новый Структура("Имя", Имя));

КонецФункции

Функция ПерваяПараПоПорядку(Пары)

	ПерваяПара = Пары[0];

	Для Индекс = 1 По Пары.Количество() - 1 Цикл
		Если Пары[Индекс].Порядок < ПерваяПара.Порядок Тогда
			ПерваяПара = Пары[Индекс];
		КонецЕсли;
	КонецЦикла;

	Возврат ПерваяПара;

КонецФункции

Функция ОтсортироватьПарыПоПорядку(Пары)

	Результат = Новый Массив;

	Для Каждого Пара Из Пары Цикл
		ВставитьПаруПоПорядку(Результат, Пара);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ВставитьПаруПоПорядку(Пары, Пара)

	Для Индекс = 0 По Пары.Количество() - 1 Цикл
		Если Пара.Порядок < Пары[Индекс].Порядок Тогда
			Пары.Вставить(Индекс, Пара);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Пары.Добавить(Пара);

КонецПроцедуры

Функция ОтсортироватьПарыПоИмени()

	Результат = Новый Массив;

	Для Каждого Пара Из _Пары Цикл
		ВставитьПаруПоИмени(Результат, Пара);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ВставитьПаруПоИмени(Пары, Пара)

	Для Индекс = 0 По Пары.Количество() - 1 Цикл
		Если СравнитьИменаПоUTF16(Пара.Имя, Пары[Индекс].Имя) < 0 Тогда
			Пары.Вставить(Индекс, Пара);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Пары.Добавить(Пара);

КонецПроцедуры

Процедура РазобратьСтрокуПараметров(СтрокаПараметров, Формат)

	Для Каждого Часть Из СтрРазделить(СтрокаПараметров, "&") Цикл
		Если Часть = "" Тогда
			Продолжить;
		КонецЕсли;

		ПозицияРазделителя = СтрНайти(Часть, "=");

		Если ПозицияРазделителя = 0 Тогда
			Имя = Часть;
			Значение = Неопределено;
		Иначе
			Имя = Лев(Часть, ПозицияРазделителя - 1);
			Значение = Сред(Часть, ПозицияРазделителя + 1);
		КонецЕсли;

		Имя = ДекодироватьПараметр(Имя, Формат);

		Если Значение <> Неопределено Тогда
			Значение = ДекодироватьПараметр(Значение, Формат);
		ИначеЕсли Формат = ФорматыПараметровЗапросаURL.ВебФорма() Тогда
			Значение = "";
		КонецЕсли;

		ДобавитьПаруВКонец(Имя, Значение);
	КонецЦикла;

КонецПроцедуры

Функция ДекодироватьПараметр(Значение, Формат)

	Если Формат = ФорматыПараметровЗапросаURL.ВебФорма() Тогда
		Возврат КодированиеURL.ДекодироватьПараметрФормы(Значение);
	КонецЕсли;

	Возврат СервисыБиблиотекиURL.КодировщикКомпонентовURI().ДекодироватьПроценты(Значение);

КонецФункции

Функция НоваяКопияПары(Имя, Значение)

	Возврат Новый Структура("Имя,Значение", Имя, Значение);

КонецФункции

Функция НормализоватьФормат(Формат)

	Если Формат = Неопределено Тогда
		Возврат ФорматыПараметровЗапросаURL.RFC3986();
	КонецЕсли;

	ПроверитьСтроковыйАргумент("Формат", Формат);
	ПроверкаАргументов.ПроверитьДопустимость(
		"Формат",
		Формат = ФорматыПараметровЗапросаURL.RFC3986() Или Формат = ФорматыПараметровЗапросаURL.ВебФорма(),
		"RFC3986, FormUrlEncoded"
	);

	Возврат Формат;

КонецФункции

Функция НормализоватьЗначениеДляФормата(Значение, Формат)

	Если Значение = Неопределено
		И Формат = ФорматыПараметровЗапросаURL.ВебФорма() Тогда
		Возврат "";
	КонецЕсли;

	Возврат Значение;

КонецФункции

Процедура ПроверитьСтроковыйАргумент(ИмяАргумента, Значение)

	ПроверкаАргументов.ПроверитьТип(
		ИмяАргумента,
		Значение,
		Тип("Строка")
	);

КонецПроцедуры

Процедура ПроверитьДопустимостьПараметраБезЗначения(Имя, Значение)

	ПроверкаАргументов.ПроверитьДопустимость(
		"Имя",
		Имя <> "" Или Значение <> Неопределено,
		"непустая строка для параметра без значения"
	);

КонецПроцедуры

Функция СтроковоеПредставлениеЗначения(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Null") Тогда
		ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
			"Значение",
			"Произвольный, кроме Null",
			Значение
		);
	КонецЕсли;

	Если ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Неопределено") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

Функция СравнитьИменаПоUTF16(ПервоеИмя, ВтороеИмя)

	МинимальнаяДлина = Мин(СтрДлина(ПервоеИмя), СтрДлина(ВтороеИмя));

	Для Индекс = 1 По МинимальнаяДлина Цикл
		ПервыйКод = КодСимвола(Сред(ПервоеИмя, Индекс, 1));
		ВторойКод = КодСимвола(Сред(ВтороеИмя, Индекс, 1));

		Если ПервыйКод <> ВторойКод Тогда
			Возврат ПервыйКод - ВторойКод;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрДлина(ПервоеИмя) - СтрДлина(ВтороеИмя);

КонецФункции

#КонецОбласти
