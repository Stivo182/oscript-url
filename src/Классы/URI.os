#Использовать errors
#Использовать "../internal"

Перем _Состояние; // СостояниеURI

#Область ОбработчикиСобытий

// Создаёт неизменяемую URI-ссылку из строки или независимую копию URI.
// Разбирает URI по RFC 3986 §2.1, §3 и §3.2, сохраняя исходное написание компонентов.
//
// Параметры:
//  Значение - Строка, URI - Разбираемая URI-ссылка или исходный URI.
Процедура ПриСозданииОбъекта(Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		УстановитьСостояние(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("URI") Тогда
		УстановитьСостояние(Значение.ВСтроку());
	Иначе
		ПроверкаАргументов.ПроверитьТип("Значение", Значение, "Строка, URI");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьСостояние(СтрокаURI)

	_Состояние = Новый ПарсерURIВнутренний().Разобрать(СтрокаURI);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает исходное написание URI-ссылки без потерь.
//
// Возвращаемое значение:
//  Строка - URI-ссылка в исходном написании по RFC 3986.
Функция ВСтроку() Экспорт

	Возврат _Состояние.ВСтроку();

КонецФункции

// Возвращает ASCII-представление URI-ссылки.
//
// Возвращаемое значение:
//  Строка - ASCII URI-ссылка.
Функция ASCIIСтрока() Экспорт

	Возврат ВСтроку();

КонецФункции

// Возвращает схему в исходном регистре.
//
// Возвращаемое значение:
//  Строка, Неопределено - Схема или Неопределено для относительной ссылки.
Функция Схема() Экспорт

	Возврат _Состояние.Схема();

КонецФункции

// Возвращает серверную часть в исходном написании без начального //.
//
// Возвращаемое значение:
//  Строка, Неопределено - Серверная часть или Неопределено при её отсутствии.
Функция КодированнаяСервернаяЧасть() Экспорт

	Возврат _Состояние.КодированнаяСервернаяЧасть();

КонецФункции

// Проверяет наличие структурного разделителя //.
//
// Возвращаемое значение:
//  Булево - Истина, если серверная часть определена.
Функция СервернаяЧастьОпределена() Экспорт

	Возврат _Состояние.СервернаяЧастьОпределена();

КонецФункции

// Возвращает кодированные данные пользователя без @.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированные данные пользователя или Неопределено при их отсутствии.
Функция КодированныеДанныеПользователя() Экспорт

	Возврат _Состояние.КодированныеДанныеПользователя();

КонецФункции

// Проверяет наличие структурного разделителя @.
//
// Возвращаемое значение:
//  Булево - Истина, если данные пользователя определены.
Функция ДанныеПользователяОпределены() Экспорт

	Возврат _Состояние.ДанныеПользователяОпределены();

КонецФункции

// Возвращает данные пользователя после строгого процентного декодирования UTF-8 по RFC 3986 §3.2.1.
//
// Возвращаемое значение:
//  Строка, Неопределено - Декодированные данные пользователя или Неопределено при их отсутствии.
Функция ДанныеПользователя() Экспорт

	Возврат ДекодироватьНеобязательныйКомпонент(КодированныеДанныеПользователя());

КонецФункции

// Возвращает кодированную часть данных пользователя до первого буквального символа :.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированное имя пользователя или Неопределено при отсутствии данных пользователя.
Функция КодированноеИмяПользователя() Экспорт

	КодированныеДанные = КодированныеДанныеПользователя();
	Если КодированныеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПозицияРазделителя = СтрНайти(КодированныеДанные, ":");
	Если ПозицияРазделителя = 0 Тогда
		Возврат КодированныеДанные;
	КонецЕсли;

	Возврат Лев(КодированныеДанные, ПозицияРазделителя - 1);

КонецФункции

// Возвращает кодированную часть данных пользователя после первого буквального символа :.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированный пароль или Неопределено без разделителя :.
Функция КодированныйПароль() Экспорт

	КодированныеДанные = КодированныеДанныеПользователя();
	Если КодированныеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПозицияРазделителя = СтрНайти(КодированныеДанные, ":");
	Если ПозицияРазделителя = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Сред(КодированныеДанные, ПозицияРазделителя + 1);

КонецФункции

// Возвращает имя пользователя после строгого процентного декодирования UTF-8.
//
// Возвращаемое значение:
//  Строка, Неопределено - Имя пользователя или Неопределено при отсутствии данных пользователя.
Функция ИмяПользователя() Экспорт

	Возврат ДекодироватьНеобязательныйКомпонент(КодированноеИмяПользователя());

КонецФункции

// Возвращает пароль после строгого процентного декодирования UTF-8.
//
// Возвращаемое значение:
//  Строка, Неопределено - Пароль или Неопределено без разделителя :.
Функция Пароль() Экспорт

	Возврат ДекодироватьНеобязательныйКомпонент(КодированныйПароль());

КонецФункции

// Возвращает кодированный хост; IP-литерал сохраняет квадратные скобки.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированный хост или Неопределено без серверной части.
Функция КодированныйХост() Экспорт

	Возврат _Состояние.КодированныйХост();

КонецФункции

// Возвращает логическое представление хоста по RFC 3986 §3.2.2.
// IP-литералы сохраняют квадратные скобки; зарегистрированное имя строго декодируется как UTF-8.
//
// Возвращаемое значение:
//  Строка, Неопределено - Хост или Неопределено при отсутствии серверной части.
Функция Хост() Экспорт

	КодированныйХост = КодированныйХост();
	Если КодированныйХост = Неопределено Или Лев(КодированныйХост, 1) = "[" Тогда
		Возврат КодированныйХост;
	КонецЕсли;

	Возврат ДекодироватьКомпонент(КодированныйХост);

КонецФункции

// Возвращает серверную часть с декодированными данными пользователя и хостом, без начального //.
// RFC 3986 §3.2 задаёт серверную часть как [данные пользователя@]хост[:порт].
//
// Возвращаемое значение:
//  Строка, Неопределено - Декодированная серверная часть или Неопределено при её отсутствии.
Функция СервернаяЧасть() Экспорт

	Если Не СервернаяЧастьОпределена() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = "";
	Если ДанныеПользователяОпределены() Тогда
		Результат = ДанныеПользователя() + "@";
	КонецЕсли;

	Результат = Результат + Хост();
	Если ПортУказан() Тогда
		Результат = Результат + ":" + ТекстПорта();
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает исходный текст порта без начального :.
//
// Возвращаемое значение:
//  Строка, Неопределено - Текст порта или Неопределено, если : отсутствует.
Функция ТекстПорта() Экспорт

	Возврат _Состояние.ТекстПорта();

КонецФункции

// Проверяет наличие разделителя : перед портом.
//
// Возвращаемое значение:
//  Булево - Истина, если порт указан, включая пустой порт.
Функция ПортУказан() Экспорт

	Возврат _Состояние.ПортУказан();

КонецФункции

// Возвращает числовое значение непустого порта, если его можно представить точно.
// RFC 3986 §3.2.3 задаёт общий порт как *DIGIT без ограничения диапазоном сетевого порта.
//
// Возвращаемое значение:
//  Число, Неопределено - Порт или Неопределено для отсутствующего и пустого порта.
Функция Порт() Экспорт

	Текст = ТекстПорта();
	Если Текст = Неопределено Или Текст = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЗначениеПорта = Число(Текст);
	Исключение
		ВызватьПереполнениеЧисловогоПорта();
	КонецПопытки;

	Если НормализоватьДесятичноеЧисло(Строка(ЗначениеПорта))
		<> НормализоватьДесятичноеЧисло(Текст) Тогда
		ВызватьПереполнениеЧисловогоПорта();
	КонецЕсли;

	Возврат ЗначениеПорта;

КонецФункции

// Возвращает стандартный порт схемы без учёта регистра.
// RFC 3986 §3.2.3 допускает стандартный порт, определяемый спецификацией схемы.
//
// Возвращаемое значение:
//  Число, Неопределено - Стандартный порт или Неопределено для неизвестной схемы.
Функция СтандартныйПорт() Экспорт

	Возврат СхемыURI.СтандартныйПорт(Схема());

КонецФункции

// Проверяет, отсутствует ли порт, пуст ли он или равен стандартному порту схемы.
//
// Возвращаемое значение:
//  Булево - Истина, если URI использует стандартный порт известной схемы.
Функция ИспользуетСтандартныйПорт() Экспорт

	Стандартный = СтандартныйПорт();
	Если Стандартный = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Текст = ТекстПорта();
	Если Текст = Неопределено Или Текст = "" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат НормализоватьДесятичноеЧисло(Текст) = Строка(Стандартный);

КонецФункции

// Возвращает явный непустой порт или стандартный порт схемы.
//
// Возвращаемое значение:
//  Число, Неопределено - Эффективный порт или Неопределено для неизвестной схемы без порта.
Функция ЭффективныйПорт() Экспорт

	Текст = ТекстПорта();
	Если Текст = Неопределено Или Текст = "" Тогда
		Возврат СтандартныйПорт();
	КонецЕсли;

	Возврат Порт();

КонецФункции

// Возвращает кодированный путь.
//
// Возвращаемое значение:
//  Строка - Всегда определённый кодированный путь.
Функция КодированныйПуть() Экспорт

	Возврат _Состояние.КодированныйПуть();

КонецФункции

// Возвращает путь после строгого процентного декодирования UTF-8 по RFC 3986 §3.3.
//
// Возвращаемое значение:
//  Строка - Декодированный путь.
Функция Путь() Экспорт

	Возврат ДекодироватьКомпонент(КодированныйПуть());

КонецФункции

// Возвращает кодированные сегменты пути, разделённые по буквальному символу / до декодирования по RFC 3986 §3.3.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Новый неизменяемый массив кодированных сегментов пути.
Функция КодированныеСегментыПути() Экспорт

	Возврат Новый ФиксированныйМассив(РазделитьПутьНаСегменты(КодированныйПуть()));

КонецФункции

// Возвращает сегменты пути, каждый из которых отдельно строго декодирован как UTF-8.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Новый неизменяемый массив декодированных сегментов пути.
Функция СегментыПути() Экспорт

	КодированныеСегменты = РазделитьПутьНаСегменты(КодированныйПуть());
	Сегменты = Новый Массив;
	Для Каждого КодированныйСегмент Из КодированныеСегменты Цикл
		Сегменты.Добавить(ДекодироватьКомпонент(КодированныйСегмент));
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Сегменты);

КонецФункции

// Возвращает кодированный запрос без начального ?.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированный запрос или Неопределено при отсутствии ?.
Функция КодированныйЗапрос() Экспорт

	Возврат _Состояние.КодированныйЗапрос();

КонецФункции

// Возвращает запрос после строгого процентного декодирования UTF-8 по RFC 3986 §3.4.
//
// Возвращаемое значение:
//  Строка, Неопределено - Декодированный запрос или Неопределено при отсутствии ?.
Функция Запрос() Экспорт

	Возврат ДекодироватьНеобязательныйКомпонент(КодированныйЗапрос());

КонецФункции

// Возвращает кодированный фрагмент без начального #.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированный фрагмент или Неопределено при отсутствии #.
Функция КодированныйФрагмент() Экспорт

	Возврат _Состояние.КодированныйФрагмент();

КонецФункции

// Возвращает фрагмент после строгого процентного декодирования UTF-8 по RFC 3986 §3.5.
//
// Возвращаемое значение:
//  Строка, Неопределено - Декодированный фрагмент или Неопределено при отсутствии #.
Функция Фрагмент() Экспорт

	Возврат ДекодироватьНеобязательныйКомпонент(КодированныйФрагмент());

КонецФункции

// Возвращает кодированные путь и запрос без фрагмента.
//
// Возвращаемое значение:
//  Строка - Кодированный путь и, при наличии ?, кодированный запрос.
Функция ПутьИЗапрос() Экспорт

	Результат = КодированныйПуть();
	Если КодированныйЗапрос() <> Неопределено Тогда
		Результат = Результат + "?" + КодированныйЗапрос();
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверяет наличие схемы.
//
// Возвращаемое значение:
//  Булево - Истина, если URI-ссылка абсолютна.
Функция ЭтоАбсолютный() Экспорт

	Возврат Схема() <> Неопределено;

КонецФункции

// Проверяет отсутствие схемы.
//
// Возвращаемое значение:
//  Булево - Истина, если URI-ссылка относительна.
Функция ЭтоОтносительный() Экспорт

	Возврат Не ЭтоАбсолютный();

КонецФункции

// Возвращает новую URI-ссылку, нормализованную по RFC 3986 §6.2.2.
// Процентные триплеты, регистр схемы и хоста, а также путь приводятся к общему виду.
//
// Возвращаемое значение:
//  URI - Новая нормализованная URI-ссылка.
Функция Нормализованный() Экспорт

	Состояние = Новый НормализаторURI().Нормализовать(_Состояние);
	Возврат Новый URI(Состояние.ВСтроку());

КонецФункции

// Возвращает новую URI-ссылку, нормализованную по общим и scheme-specific правилам.
// Для http, https, ws, wss и ftp удаляются пустой и стандартный порты.
//
// Возвращаемое значение:
//  URI - Новая нормализованная для схемы URI-ссылка.
Функция НормализованныйДляСхемы() Экспорт

	Состояние = Новый НормализаторURI().НормализоватьДляСхемы(_Состояние);
	Возврат Новый URI(Состояние.ВСтроку());

КонецФункции

// Сравнивает URI-ссылки без нормализации по исходному написанию.
//
// Параметры:
//  Другое - URI, URL - URI- или URL-ссылка для сравнения.
//
// Возвращаемое значение:
//  Булево - Истина, если исходные строки URI-ссылок совпадают.
Функция Равно(Другое) Экспорт

	Возврат ВСтроку() = ПривестиСравниваемоеКURI(Другое).ВСтроку();

КонецФункции

// Сравнивает URI-ссылки после общей нормализации по RFC 3986 §6.2.2.
//
// Параметры:
//  Другое - URI, URL - URI- или URL-ссылка для сравнения.
//
// Возвращаемое значение:
//  Булево - Истина, если URI-ссылки эквивалентны после общей нормализации.
Функция Эквивалентен(Другое) Экспорт

	Возврат Нормализованный().ВСтроку() = ПривестиСравниваемоеКURI(Другое).Нормализованный().ВСтроку();

КонецФункции

// Сравнивает URI-ссылки после общей и scheme-specific нормализации.
//
// Параметры:
//  Другое - URI, URL - URI- или URL-ссылка для сравнения.
//
// Возвращаемое значение:
//  Булево - Истина, если URI-ссылки эквивалентны после scheme-specific нормализации.
Функция ЭквивалентенДляСхемы(Другое) Экспорт

	Возврат НормализованныйДляСхемы().ВСтроку()
		= ПривестиСравниваемоеКURI(Другое).НормализованныйДляСхемы().ВСтроку();

КонецФункции

// Разрешает URI-ссылку относительно текущего абсолютного URI по RFC 3986 §5.2.
// Путь обрабатывается как исходная кодированная строка: %2E и %2E%2E не считаются сегментами «.» и «..».
//
// Параметры:
//  Ссылка - Строка, URI, URL - Относительная или абсолютная URI-ссылка.
//
// Возвращаемое значение:
//  URI - Новая независимая URI-ссылка с результатом разрешения.
Функция Разрешить(Ссылка) Экспорт

	СсылкаURI = ПривестиСсылкуКURI(Ссылка);
	СостояниеСсылки = Новый ПарсерURIВнутренний().Разобрать(СсылкаURI.ВСтроку());
	Разрешитель = Новый РазрешительURI;
	СостояниеРезультата = Разрешитель.Разрешить(_Состояние, СостояниеСсылки);

	Возврат Новый URI(СостояниеРезультата.ВСтроку());

КонецФункции

// Строит однозначно определённую URI-ссылку на абсолютную цель относительно текущей базы.
// Каждый сокращённый вариант проверяется разрешением по RFC 3986 §5.2.
//
// Параметры:
//  Цель - Строка, URI, URL - Абсолютная целевая URI-ссылка.
//
// Возвращаемое значение:
//  URI - Новая независимая относительная ссылка или нормализованная абсолютная цель.
Функция СделатьОтносительным(Цель) Экспорт

	ЦельURI = ПривестиЦельКURI(Цель);
	Если Не ЦельURI.ЭтоАбсолютный() Тогда
		ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента(
			"Цель",
			"абсолютный URI"
		);
	КонецЕсли;

	СостояниеЦели = Новый ПарсерURIВнутренний().Разобрать(ЦельURI.ВСтроку());
	Релятивизатор = Новый РелятивизаторURI;
	СостояниеРезультата = Релятивизатор.СделатьОтносительным(_Состояние, СостояниеЦели);

	Возврат Новый URI(СостояниеРезультата.ВСтроку());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДекодироватьНеобязательныйКомпонент(КодированныйКомпонент)

	Если КодированныйКомпонент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ДекодироватьКомпонент(КодированныйКомпонент);

КонецФункции

Функция ДекодироватьКомпонент(КодированныйКомпонент)

	Данные = КодированиеКомпонентовURI.ДекодироватьВБайты(КодированныйКомпонент);
	Возврат КодированиеКомпонентовURI.ДекодироватьСтрогийUTF8(Данные);

КонецФункции

Функция РазделитьПутьНаСегменты(КодированныйПуть)

	Сегменты = Новый Массив;
	НачалоСегмента = 1;
	Для Индекс = 1 По СтрДлина(КодированныйПуть) Цикл
		Если Сред(КодированныйПуть, Индекс, 1) = "/" Тогда
			Сегменты.Добавить(Сред(КодированныйПуть, НачалоСегмента, Индекс - НачалоСегмента));
			НачалоСегмента = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Сегменты.Добавить(Сред(КодированныйПуть, НачалоСегмента));
	Возврат Сегменты;

КонецФункции

Функция НормализоватьДесятичноеЧисло(Текст)

	ИндексПервогоЗначимогоРазряда = 1;
	Пока ИндексПервогоЗначимогоРазряда <= СтрДлина(Текст)
		И Сред(Текст, ИндексПервогоЗначимогоРазряда, 1) = "0" Цикл
		ИндексПервогоЗначимогоРазряда = ИндексПервогоЗначимогоРазряда + 1;
	КонецЦикла;

	Если ИндексПервогоЗначимогоРазряда > СтрДлина(Текст) Тогда
		Возврат "0";
	КонецЕсли;

	Возврат Сред(Текст, ИндексПервогоЗначимогоРазряда);

КонецФункции

Функция ПривестиСсылкуКURI(Ссылка)

	Если Ссылка = Неопределено Тогда
		ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента("Ссылка", "Строка или URI", Ссылка);
	КонецЕсли;

	Если ТипЗнч(Ссылка) = Тип("Строка") Или ТипЗнч(Ссылка) = Тип("URI") Тогда
		Возврат Новый URI(Ссылка);
	КонецЕсли;

	Если Строка(ТипЗнч(Ссылка)) = "URL" Тогда
		Возврат Новый URI(Ссылка.ВСтроку());
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Ссылка", Ссылка, "Строка, URI");

КонецФункции

Функция ПривестиЦельКURI(Цель)

	Если ТипЗнч(Цель) = Тип("Строка") Или ТипЗнч(Цель) = Тип("URI") Тогда
		Возврат Новый URI(Цель);
	КонецЕсли;

	Если Строка(ТипЗнч(Цель)) = "URL" Тогда
		Возврат Новый URI(Цель.ВСтроку());
	КонецЕсли;

	ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
		"Цель",
		"Строка, URI, URL",
		Цель
	);

КонецФункции

Функция ПривестиСравниваемоеКURI(Другое)

	Если ТипЗнч(Другое) = Тип("URI") Тогда
		Возврат Другое;
	КонецЕсли;

	Если Строка(ТипЗнч(Другое)) = "URL" Тогда
		Возврат Новый URI(Другое.ВСтроку());
	КонецЕсли;

	ПроверкаАргументов.ПроверитьТип("Другое", Другое, "URI, URL");

КонецФункции

Процедура ВызватьПереполнениеЧисловогоПорта()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.ПереполнениеЧисловогоПорта(),
		"Невозможно точно представить порт как число"
	);

КонецПроцедуры

#КонецОбласти
