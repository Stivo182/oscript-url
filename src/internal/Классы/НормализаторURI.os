Перем _ОпределительСтандартногоПорта; // ОпределительСтандартногоПортаURI
Перем _КодировщикКомпонентовURI; // КодировщикКомпонентовURI

#Область ОбработчикиСобытий

// Создаёт нормализатор URI.
//
// Параметры:
//  ОпределительСтандартногоПорта - ОпределительСтандартногоПортаURI - Определитель порта.
//  КодировщикКомпонентовURI - КодировщикКомпонентовURI - Кодировщик компонентов URI.
Процедура ПриСозданииОбъекта(
	ОпределительСтандартногоПорта,
	КодировщикКомпонентовURI
)

	_ОпределительСтандартногоПорта = ОпределительСтандартногоПорта;
	_КодировщикКомпонентовURI = КодировщикКомпонентовURI;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Нормализует URI-ссылку по общим правилам RFC 3986 §6.2.2.
//
// Параметры:
//  Адрес - URL - Исходная проверенная URI-ссылка.
//
// Возвращаемое значение:
//  URL - Новая нормализованная URI-ссылка.
Функция Нормализовать(Адрес) Экспорт

	Компоненты = Адрес.СнимокКомпонентов();
	Схема = НормализоватьНеобязательныйКомпонент(Компоненты.Схема);

	Если Схема <> Неопределено Тогда
		Схема = НРег(Схема);
	КонецЕсли;

	ДанныеПользователя = НормализоватьНеобязательныйКомпонент(Компоненты.ПредставлениеДанныхПользователя);
	Хост = НормализоватьНеобязательныйКомпонент(Компоненты.ПредставлениеХоста);

	Если Хост <> Неопределено Тогда
		Хост = НормализоватьРегистрХоста(Хост);
	КонецЕсли;

	Путь = НормализоватьКомпонент(Компоненты.ПредставлениеПути);
	Путь = НормализоватьПуть(Путь, Схема, Компоненты.СервернаяЧастьОпределена);
	Запрос = НормализоватьНеобязательныйКомпонент(Компоненты.ПредставлениеЗапроса);
	Фрагмент = НормализоватьНеобязательныйКомпонент(Компоненты.ПредставлениеФрагмента);
	ПортУказан = Компоненты.ПортУказан;
	ТекстПорта = Компоненты.ТекстПорта;

	Если ПортУказан И ТекстПорта = "" Тогда
		ПортУказан = Ложь;
		ТекстПорта = Неопределено;
	КонецЕсли;

	Возврат РазобратьКомпоненты(
		Схема,
		Компоненты.СервернаяЧастьОпределена,
		Компоненты.ДанныеПользователяОпределены,
		ДанныеПользователя,
		Хост,
		ПортУказан,
		ТекстПорта,
		Путь,
		Запрос,
		Фрагмент
	);

КонецФункции

// Выполняет общую нормализацию URI-ссылки и нормализацию с учётом схемы.
//
// Параметры:
//  Адрес - URL - Исходная проверенная URI-ссылка.
//
// Возвращаемое значение:
//  URL - Новая нормализованная для схемы URI-ссылка.
Функция НормализоватьДляСхемы(Адрес) Экспорт

	Нормализованное = Нормализовать(Адрес);
	Компоненты = Нормализованное.СнимокКомпонентов();
	Схема = Компоненты.Схема;
	Путь = Компоненты.ПредставлениеПути;
	ПортУказан = Компоненты.ПортУказан;
	ТекстПорта = Компоненты.ТекстПорта;
	СтандартныйПорт = _ОпределительСтандартногоПорта.Определить(Схема);

	Если ПортУказан И СтандартныйПорт <> Неопределено
		И НормализоватьДесятичноеЧисло(ТекстПорта) = Формат(СтандартныйПорт, "ЧГ=0") Тогда
		ПортУказан = Ложь;
		ТекстПорта = Неопределено;
	КонецЕсли;

	Если Путь = "" И Компоненты.СервернаяЧастьОпределена
		И ЭтоHTTPПодобнаяСхема(Схема) Тогда
		Путь = "/";
	КонецЕсли;

	Возврат РазобратьКомпоненты(
		Схема,
		Компоненты.СервернаяЧастьОпределена,
		Компоненты.ДанныеПользователяОпределены,
		Компоненты.ПредставлениеДанныхПользователя,
		Компоненты.ПредставлениеХоста,
		ПортУказан,
		ТекстПорта,
		Путь,
		Компоненты.ПредставлениеЗапроса,
		Компоненты.ПредставлениеФрагмента
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НормализоватьПуть(Путь, Схема, СервернаяЧастьОпределена)

	Если Схема <> Неопределено Или СервернаяЧастьОпределена Или Лев(Путь, 1) = "/" Тогда
		Возврат УдалитьТочечныеСегменты(Путь);
	КонецЕсли;

	Если Путь = "" Тогда
		Возврат Путь;
	КонецЕсли;

	Возврат НормализоватьОтносительныйПуть(Путь);

КонецФункции

Функция НормализоватьОтносительныйПуть(Путь)

	ИсходныеСегменты = РазделитьНаСегменты(Путь);
	СсылкаНаКаталог = Прав(Путь, 1) = "/"
		Или ИсходныеСегменты[ИсходныеСегменты.Количество() - 1] = "."
		Или ИсходныеСегменты[ИсходныеСегменты.Количество() - 1] = "..";
	Результат = Новый Массив;

	Для Каждого Сегмент Из ИсходныеСегменты Цикл
		Если Сегмент = "." Тогда
			Продолжить;
		КонецЕсли;

		Если Сегмент = ".." Тогда
			Если Результат.Количество() > 0 И Результат[Результат.Количество() - 1] <> ".." Тогда
				Результат.Удалить(Результат.Количество() - 1);
			Иначе
				Результат.Добавить(Сегмент);
			КонецЕсли;
		Иначе
			Результат.Добавить(Сегмент);
		КонецЕсли;
	КонецЦикла;

	Если СсылкаНаКаталог И (Результат.Количество() = 0 Или Результат[Результат.Количество() - 1] <> "") Тогда
		Результат.Добавить("");
	КонецЕсли;

	Если Результат[0] = "" Тогда
		Результат.Вставить(0, ".");
	ИначеЕсли Результат[0] <> ".." И СтрНайти(Результат[0], ":") > 0 Тогда
		Результат.Вставить(0, ".");
	КонецЕсли;

	Возврат ОбъединитьСегменты(Результат);

КонецФункции

Функция НормализоватьНеобязательныйКомпонент(Компонент)

	Если Компонент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат НормализоватьКомпонент(Компонент);

КонецФункции

Функция НормализоватьКомпонент(Компонент)

	Фрагменты = Новый Массив;
	Индекс = 1;

	Пока Индекс <= СтрДлина(Компонент) Цикл
		ТекущийСимвол = Сред(Компонент, Индекс, 1);

		Если ТекущийСимвол = "%" Тогда
			HexБайт = ВРег(Сред(Компонент, Индекс + 1, 2));

			Если ЭтоНеЗарезервированныйHexБайт(HexБайт) Тогда
				Фрагменты.Добавить(Символ(ЗначениеHexБайта(HexБайт)));
			Иначе
				Фрагменты.Добавить("%" + HexБайт);
			КонецЕсли;

			Индекс = Индекс + 3;
		Иначе
			Фрагменты.Добавить(ТекущийСимвол);
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Функция НормализоватьРегистрХоста(Хост)

	Фрагменты = Новый Массив;
	Индекс = 1;

	Пока Индекс <= СтрДлина(Хост) Цикл
		СимволХоста = Сред(Хост, Индекс, 1);
		КодСимволаХоста = КодСимвола(СимволХоста);
		// Коды ASCII: A-Z - 65-90.
		Если СимволХоста = "%" Тогда
			Фрагменты.Добавить("%" + ВРег(Сред(Хост, Индекс + 1, 2)));
			Индекс = Индекс + 3;
		ИначеЕсли КодСимволаХоста >= 65 И КодСимволаХоста <= 90 Тогда
			Фрагменты.Добавить(НРег(СимволХоста));
			Индекс = Индекс + 1;
		Иначе
			Фрагменты.Добавить(СимволХоста);
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Функция РазобратьКомпоненты(
	Схема,
	СервернаяЧастьОпределена,
	ДанныеПользователяОпределены,
	ДанныеПользователя,
	Хост,
	ПортУказан,
	ТекстПорта,
	Путь,
	Запрос,
	Фрагмент
)

	Фрагменты = Новый Массив;

	Если Схема <> Неопределено Тогда
		Фрагменты.Добавить(Схема);
		Фрагменты.Добавить(":");
	КонецЕсли;

	Если СервернаяЧастьОпределена Тогда
		Фрагменты.Добавить("//");

		Если ДанныеПользователяОпределены Тогда
			Фрагменты.Добавить(ДанныеПользователя);
			Фрагменты.Добавить("@");
		КонецЕсли;

		Фрагменты.Добавить(Хост);

		Если ПортУказан Тогда
			Фрагменты.Добавить(":");
			Фрагменты.Добавить(ТекстПорта);
		КонецЕсли;
	КонецЕсли;

	Фрагменты.Добавить(Путь);

	Если Запрос <> Неопределено Тогда
		Фрагменты.Добавить("?");
		Фрагменты.Добавить(Запрос);
	КонецЕсли;

	Если Фрагмент <> Неопределено Тогда
		Фрагменты.Добавить("#");
		Фрагменты.Добавить(Фрагмент);
	КонецЕсли;

	СтрокаURI = СтрСоединить(Фрагменты, "");
	Возврат Новый URL(СтрокаURI);

КонецФункции

Функция УдалитьТочечныеСегменты(Путь)

	Вход = Путь;
	Выход = "";

	Пока Вход <> "" Цикл
		Если Лев(Вход, 3) = "../" Тогда
			Вход = Сред(Вход, 4);
		ИначеЕсли Лев(Вход, 2) = "./" Тогда
			Вход = Сред(Вход, 3);
		ИначеЕсли Лев(Вход, 3) = "/./" Тогда
			Вход = "/" + Сред(Вход, 4);
		ИначеЕсли Вход = "/." Тогда
			Вход = "/";
		ИначеЕсли Лев(Вход, 4) = "/../" Тогда
			Вход = "/" + Сред(Вход, 5);
			Выход = УдалитьПоследнийСегмент(Выход);
		ИначеЕсли Вход = "/.." Тогда
			Вход = "/";
			Выход = УдалитьПоследнийСегмент(Выход);
		ИначеЕсли Вход = "." Или Вход = ".." Тогда
			Вход = "";
		Иначе
			ДлинаСегмента = ДлинаПервогоСегмента(Вход);
			Выход = Выход + Лев(Вход, ДлинаСегмента);
			Вход = Сред(Вход, ДлинаСегмента + 1);
		КонецЕсли;
	КонецЦикла;

	Возврат Выход;

КонецФункции

Функция РазделитьНаСегменты(Путь)

	Результат = Новый Массив;
	НачалоСегмента = 1;

	Для Индекс = 1 По СтрДлина(Путь) Цикл
		Если Сред(Путь, Индекс, 1) = "/" Тогда
			Результат.Добавить(Сред(Путь, НачалоСегмента, Индекс - НачалоСегмента));
			НачалоСегмента = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Результат.Добавить(Сред(Путь, НачалоСегмента));

	Возврат Результат;

КонецФункции

Функция ОбъединитьСегменты(Сегменты)

	Возврат СтрСоединить(Сегменты, "/");

КонецФункции

Функция ДлинаПервогоСегмента(Путь)

	Если Лев(Путь, 1) = "/" Тогда
		НачальнаяПозиция = 2;
	Иначе
		НачальнаяПозиция = 1;
	КонецЕсли;

	Для Индекс = НачальнаяПозиция По СтрДлина(Путь) Цикл
		Если Сред(Путь, Индекс, 1) = "/" Тогда
			Возврат Индекс - 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрДлина(Путь);

КонецФункции

Функция УдалитьПоследнийСегмент(Путь)

	ПозицияПоследнегоСлеша = 0;

	Для Индекс = 1 По СтрДлина(Путь) Цикл
		Если Сред(Путь, Индекс, 1) = "/" Тогда
			ПозицияПоследнегоСлеша = Индекс;
		КонецЕсли;
	КонецЦикла;

	Если ПозицияПоследнегоСлеша = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Лев(Путь, ПозицияПоследнегоСлеша - 1);

КонецФункции

Функция ЭтоНеЗарезервированныйHexБайт(HexБайт)

	ЗначениеБайта = ЗначениеHexБайта(HexБайт);
	СимволБайта = Символ(ЗначениеБайта);

	Возврат СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~", СимволБайта) > 0;

КонецФункции

Функция ЗначениеHexБайта(HexБайт)

	Возврат _КодировщикКомпонентовURI.ЗначениеШестнадцатеричногоБайта(HexБайт);

КонецФункции

Функция НормализоватьДесятичноеЧисло(Текст)

	Индекс = 1;

	Пока Индекс <= СтрДлина(Текст) И Сред(Текст, Индекс, 1) = "0" Цикл
		Индекс = Индекс + 1;
	КонецЦикла;

	Если Индекс > СтрДлина(Текст) Тогда
		Возврат "0";
	КонецЕсли;

	Возврат Сред(Текст, Индекс);

КонецФункции

Функция ЭтоHTTPПодобнаяСхема(Схема)

	Возврат Схема = "http" Или Схема = "https" Или Схема = "ws" Или Схема = "wss";

КонецФункции

#КонецОбласти
