#Область ПрограммныйИнтерфейс

// Кодирует Unicode-метку по RFC 3492.
//
// Параметры:
//  Значение - Строка - Unicode-метка.
//
// Возвращаемое значение:
//  Строка, Неопределено - Punycode без префикса xn-- или Неопределено для некорректного Unicode.
Функция Кодировать(Значение) Экспорт

	КодовыеТочки = КодовыеТочкиUnicode.ИзСтроки(Значение);

	Если КодовыеТочки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Фрагменты = Новый Массив;
	КоличествоОсновных = ДобавитьОсновныеКодовыеТочки(КодовыеТочки, Фрагменты);

	Если КоличествоОсновных > 0 Тогда
		Фрагменты.Добавить("-");
	КонецЕсли;

	Если Не КодироватьОставшиесяТочки(КодовыеТочки, Фрагменты, КоличествоОсновных) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

// Декодирует метку Punycode по RFC 3492.
//
// Параметры:
//  Значение - Строка - Punycode без префикса xn--.
//
// Возвращаемое значение:
//  Строка, Неопределено - Unicode-метка или Неопределено для некорректного Punycode.
Функция Декодировать(Значение) Экспорт

	КодовыеТочки = Новый Массив;
	ИндексВхода = ДобавитьОсновныеТочкиPunycode(Значение, КодовыеТочки);

	Если ИндексВхода = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Состояние = СоздатьСостояниеДекодирования(ИндексВхода);

	Пока Состояние.ИндексВхода <= СтрДлина(Значение) Цикл
		Если Не ДекодироватьСледующуюТочку(Значение, КодовыеТочки, Состояние) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Возврат КодовыеТочкиUnicode.ВСтроку(КодовыеТочки);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДобавитьОсновныеКодовыеТочки(КодовыеТочки, Фрагменты)

	КоличествоОсновных = 0;

	Для Каждого КодоваяТочка Из КодовыеТочки Цикл
		Если КодоваяТочка < 128 Тогда
			Фрагменты.Добавить(Символ(КодоваяТочка));
			КоличествоОсновных = КоличествоОсновных + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат КоличествоОсновных;

КонецФункции

Функция КодироватьОставшиесяТочки(КодовыеТочки, Фрагменты, КоличествоОсновных)

	Состояние = СоздатьСостояниеКодирования(КоличествоОсновных);

	Пока Состояние.КоличествоОбработанных < КодовыеТочки.Количество() Цикл
		СледующаяТочка = НайтиСледующуюКодовуюТочку(КодовыеТочки, Состояние.СледующаяКодоваяТочка);

		Если Не ПодготовитьСмещениеКодирования(СледующаяТочка, Состояние) Тогда
			Возврат Ложь;
		КонецЕсли;

		Если Не ДобавитьСовпадающиеКодовыеТочки(КодовыеТочки, Фрагменты, КоличествоОсновных, Состояние) Тогда
			Возврат Ложь;
		КонецЕсли;

		Если Состояние.Смещение = МаксимальноеСмещениеPunycode() Тогда
			Возврат Ложь;
		КонецЕсли;

		Состояние.Смещение = Состояние.Смещение + 1;
		Состояние.СледующаяКодоваяТочка = Состояние.СледующаяКодоваяТочка + 1;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция СоздатьСостояниеКодирования(КоличествоОсновных)

	Состояние = Новый Структура;
	Состояние.Вставить("КоличествоОбработанных", КоличествоОсновных);
	Состояние.Вставить("СледующаяКодоваяТочка", 128);
	Состояние.Вставить("Смещение", 0);
	Состояние.Вставить("АдаптивноеСмещение", 72);

	Возврат Состояние;

КонецФункции

Функция НайтиСледующуюКодовуюТочку(КодовыеТочки, НижняяГраница)

	Результат = 1114112;

	Для Каждого КодоваяТочка Из КодовыеТочки Цикл
		Если КодоваяТочка >= НижняяГраница И КодоваяТочка < Результат Тогда
			Результат = КодоваяТочка;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПодготовитьСмещениеКодирования(СледующаяТочка, Состояние)

	Приращение = СледующаяТочка - Состояние.СледующаяКодоваяТочка;
	Количество = Состояние.КоличествоОбработанных + 1;

	Если Не ДопустимоУмножитьИСложить(Приращение, Количество, Состояние.Смещение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Состояние.Смещение = Состояние.Смещение + Приращение * Количество;
	Состояние.СледующаяКодоваяТочка = СледующаяТочка;

	Возврат Истина;

КонецФункции

Функция ДобавитьСовпадающиеКодовыеТочки(КодовыеТочки, Фрагменты, КоличествоОсновных, Состояние)

	Для Каждого КодоваяТочка Из КодовыеТочки Цикл
		Если КодоваяТочка < Состояние.СледующаяКодоваяТочка Тогда
			Если Состояние.Смещение = МаксимальноеСмещениеPunycode() Тогда
				Возврат Ложь;
			КонецЕсли;

			Состояние.Смещение = Состояние.Смещение + 1;
		ИначеЕсли КодоваяТочка = Состояние.СледующаяКодоваяТочка Тогда
			ДобавитьКодированноеСмещение(Фрагменты, Состояние.Смещение, Состояние.АдаптивноеСмещение);
			Состояние.АдаптивноеСмещение = АдаптироватьСмещение(
				Состояние.Смещение,
				Состояние.КоличествоОбработанных + 1,
				Состояние.КоличествоОбработанных = КоличествоОсновных
			);
			Состояние.Смещение = 0;
			Состояние.КоличествоОбработанных = Состояние.КоличествоОбработанных + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура ДобавитьКодированноеСмещение(Фрагменты, Знач Смещение, Знач АдаптивноеСмещение)

	Основание = 36;

	Пока Истина Цикл
		Порог = ПорогКодирования(Основание, АдаптивноеСмещение);

		Если Смещение < Порог Тогда
			Прервать;
		КонецЕсли;

		Цифра = Порог + (Смещение - Порог) % (36 - Порог);
		Фрагменты.Добавить(СимволPunycode(Цифра));
		Смещение = Цел((Смещение - Порог) / (36 - Порог));
		Основание = Основание + 36;
	КонецЦикла;

	Фрагменты.Добавить(СимволPunycode(Смещение));

КонецПроцедуры

Функция ДобавитьОсновныеТочкиPunycode(Значение, КодовыеТочки)

	ПозицияРазделителя = ПоследняяПозицияРазделителя(Значение);

	Если ПозицияРазделителя = 0 Тогда
		Возврат 1;
	КонецЕсли;

	Если ПозицияРазделителя = 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Индекс = 1 По ПозицияРазделителя - 1 Цикл
		Код = КодСимвола(Сред(Значение, Индекс, 1));
		// ASCII занимает коды 0-127.
		Если Код >= 128 Тогда
			Возврат Неопределено;
		КонецЕсли;

		КодовыеТочки.Добавить(Код);
	КонецЦикла;

	Возврат ПозицияРазделителя + 1;

КонецФункции

Функция ПоследняяПозицияРазделителя(Значение)

	Результат = 0;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если Сред(Значение, Индекс, 1) = "-" Тогда
			Результат = Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СоздатьСостояниеДекодирования(ИндексВхода)

	Состояние = Новый Структура;
	Состояние.Вставить("ИндексВхода", ИндексВхода);
	Состояние.Вставить("СледующаяКодоваяТочка", 128);
	Состояние.Вставить("Смещение", 0);
	Состояние.Вставить("АдаптивноеСмещение", 72);

	Возврат Состояние;

КонецФункции

Функция ДекодироватьСледующуюТочку(Значение, КодовыеТочки, Состояние)

	ИсходноеСмещение = ПрочитатьСмещениеPunycode(Значение, Состояние);

	Если ИсходноеСмещение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ДобавитьДекодированнуюКодовуюТочку(КодовыеТочки, Состояние, ИсходноеСмещение);

КонецФункции

Функция ДобавитьДекодированнуюКодовуюТочку(КодовыеТочки, Состояние, ИсходноеСмещение)

	КоличествоТочек = КодовыеТочки.Количество() + 1;
	Состояние.АдаптивноеСмещение = АдаптироватьСмещение(
		Состояние.Смещение - ИсходноеСмещение,
		КоличествоТочек,
		ИсходноеСмещение = 0
	);
	Приращение = Цел(Состояние.Смещение / КоличествоТочек);

	Если Приращение > МаксимальноеСмещениеPunycode() - Состояние.СледующаяКодоваяТочка Тогда
		Возврат Ложь;
	КонецЕсли;

	Состояние.СледующаяКодоваяТочка = Состояние.СледующаяКодоваяТочка + Приращение;
	Состояние.Смещение = Состояние.Смещение % КоличествоТочек;

	Если Не ДопустимаяКодоваяТочка(Состояние.СледующаяКодоваяТочка) Тогда
		Возврат Ложь;
	КонецЕсли;

	КодовыеТочки.Вставить(Состояние.Смещение, Состояние.СледующаяКодоваяТочка);

	Если Состояние.Смещение = МаксимальноеСмещениеPunycode() Тогда
		Возврат Ложь;
	КонецЕсли;

	Состояние.Смещение = Состояние.Смещение + 1;
	Возврат Истина;

КонецФункции

Функция ПрочитатьСмещениеPunycode(Значение, Состояние)

	ИсходноеСмещение = Состояние.Смещение;
	Множитель = 1;
	Основание = 36;

	Пока Истина Цикл
		Цифра = ПрочитатьЦифруPunycode(Значение, Состояние);

		Если Цифра = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		Если Не ДопустимоУмножитьИСложить(Цифра, Множитель, Состояние.Смещение) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Состояние.Смещение = Состояние.Смещение + Цифра * Множитель;
		Порог = ПорогКодирования(Основание, Состояние.АдаптивноеСмещение);

		Если Цифра < Порог Тогда
			Возврат ИсходноеСмещение;
		КонецЕсли;

		Если Множитель > Цел(МаксимальноеСмещениеPunycode() / (36 - Порог)) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Множитель = Множитель * (36 - Порог);
		Основание = Основание + 36;
	КонецЦикла;

КонецФункции

Функция ПрочитатьЦифруPunycode(Значение, Состояние)

	Если Состояние.ИндексВхода > СтрДлина(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = ЗначениеСимволаPunycode(Сред(Значение, Состояние.ИндексВхода, 1));

	Если Результат <> Неопределено Тогда
		Состояние.ИндексВхода = Состояние.ИндексВхода + 1;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ДопустимаяКодоваяТочка(КодоваяТочка)

	Возврат КодоваяТочка <= 1114111
		И Не (КодоваяТочка >= 55296 И КодоваяТочка <= 57343);

КонецФункции

Функция МаксимальноеСмещениеPunycode()

	Возврат 2147483647;

КонецФункции

Функция ДопустимоУмножитьИСложить(Множимое, Множитель, Слагаемое)

	Если Множимое = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Множимое <= Цел((МаксимальноеСмещениеPunycode() - Слагаемое) / Множитель);

КонецФункции

Функция ПорогКодирования(Основание, АдаптивноеСмещение)

	Если Основание <= АдаптивноеСмещение Тогда
		Возврат 1;
	ИначеЕсли Основание >= АдаптивноеСмещение + 26 Тогда
		Возврат 26;
	КонецЕсли;

	Возврат Основание - АдаптивноеСмещение;

КонецФункции

Функция АдаптироватьСмещение(Смещение, КоличествоКодовыхТочек, ПервоеСмещение)

	Если ПервоеСмещение Тогда
		Смещение = Цел(Смещение / 700);
	Иначе
		Смещение = Цел(Смещение / 2);
	КонецЕсли;

	Смещение = Смещение + Цел(Смещение / КоличествоКодовыхТочек);
	Результат = 0;

	Пока Смещение > 455 Цикл
		Смещение = Цел(Смещение / 35);
		Результат = Результат + 36;
	КонецЦикла;

	Возврат Результат + Цел(36 * Смещение / (Смещение + 38));

КонецФункции

Функция СимволPunycode(Значение)

	// Код ASCII строчной латинской a - 97; цифры 0-9 получаются из диапазона значений 26-35.
	Если Значение < 26 Тогда
		Возврат Символ(97 + Значение);
	КонецЕсли;

	Возврат Символ(22 + Значение);

КонецФункции

Функция ЗначениеСимволаPunycode(СимволКода)

	Код = КодСимвола(СимволКода);
	// Коды ASCII: A-Z - 65-90, a-z - 97-122, 0-9 - 48-57.
	Если Код >= 65 И Код <= 90 Тогда
		Возврат Код - 65;
	ИначеЕсли Код >= 97 И Код <= 122 Тогда
		Возврат Код - 97;
	ИначеЕсли Код >= 48 И Код <= 57 Тогда
		Возврат Код - 22;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
