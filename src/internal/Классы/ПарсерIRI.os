#Использовать errors

#Область СлужебныйПрограммныйИнтерфейс

// Разбирает URI-ссылку с символами Unicode по RFC 3986 и RFC 3987, сохраняя исходное представление компонентов.
//
// Параметры:
//  Значение - Строка - URI-ссылка для разбора.
//
// Возвращаемое значение:
//  СостояниеURI - Проверенное внутреннее состояние URI-ссылки, позволяющее восстановить её без потерь.
//
// Исключения:
//  uri.invalid_syntax - Значение нарушает общую грамматику URI.
//  uri.invalid_scheme - Схема имеет недопустимый синтаксис.
//  uri.invalid_percent_encoding - Значение содержит недопустимую последовательность %HH.
//  uri.invalid_authority - Серверная часть имеет недопустимую структуру.
//  uri.invalid_host - Хост имеет недопустимый синтаксис.
//  uri.invalid_ipv6 - IPv6-литерал имеет недопустимый синтаксис.
//  uri.invalid_ipvfuture - IPvFuture-литерал имеет недопустимый синтаксис.
Функция Разобрать(Значение) Экспорт

	ПроверитьПроцентноеКодирование(Значение);

	Контекст = НовыйКонтекстРазбора(Значение);

	ОтделитьФрагмент(Контекст);
	ОтделитьЗапрос(Контекст);
	ОтделитьСхему(Контекст);
	ОтделитьСервернуюЧасть(Контекст);
	ПроверитьASCIIСимволыКомпонентов(Контекст);
	ПодготовитьКодированныеКомпоненты(Контекст);
	ПроверитьГрамматикуКомпонентов(Контекст);

	Возврат СоздатьСостояние(Контекст);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйКонтекстРазбора(Значение)

	Контекст = Новый Структура;
	Контекст.Вставить("Остаток", Значение);
	Контекст.Вставить("Схема", Неопределено);
	Контекст.Вставить("СервернаяЧастьОпределена", Ложь);
	Контекст.Вставить("ДанныеПользователяОпределены", Ложь);
	Контекст.Вставить("КодированныеДанныеПользователя", Неопределено);
	Контекст.Вставить("КодированныйХост", Неопределено);
	Контекст.Вставить("ВидХоста", Неопределено);
	Контекст.Вставить("ПортУказан", Ложь);
	Контекст.Вставить("ТекстПорта", Неопределено);
	Контекст.Вставить("КодированныйПуть", Значение);
	Контекст.Вставить("ЗапросОпределен", Ложь);
	Контекст.Вставить("КодированныйЗапрос", Неопределено);
	Контекст.Вставить("ФрагментОпределен", Ложь);
	Контекст.Вставить("КодированныйФрагмент", Неопределено);
	Контекст.Вставить("ПредставлениеДанныхПользователя", Неопределено);
	Контекст.Вставить("ПредставлениеХоста", Неопределено);
	Контекст.Вставить("ПредставлениеПути", Значение);
	Контекст.Вставить("ПредставлениеЗапроса", Неопределено);
	Контекст.Вставить("ПредставлениеФрагмента", Неопределено);

	Возврат Контекст;

КонецФункции

Процедура ОтделитьФрагмент(Контекст)

	Позиция = СтрНайти(Контекст.Остаток, "#");

	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;

	Контекст.ФрагментОпределен = Истина;
	Контекст.КодированныйФрагмент = Сред(Контекст.Остаток, Позиция + 1);
	Контекст.ПредставлениеФрагмента = Контекст.КодированныйФрагмент;
	Контекст.Остаток = Лев(Контекст.Остаток, Позиция - 1);

КонецПроцедуры

Процедура ПроверитьASCIIСимволыКомпонентов(Контекст)

	Если Контекст.КодированныеДанныеПользователя <> Неопределено Тогда
		ПроверитьСимволыКомпонента(
			Контекст.КодированныеДанныеПользователя,
			":",
			КодыОшибокURL.НедопустимаяСервернаяЧастьURI(),
			Истина
		);
	КонецЕсли;

	Если Контекст.КодированныйХост <> Неопределено
		И Лев(Контекст.КодированныйХост, 1) <> "[" Тогда
		ПроверитьСимволыКомпонента(
			Контекст.КодированныйХост,
			"",
			КодыОшибокURL.НедопустимыйХостURI(),
			Истина
		);
	КонецЕсли;

	ПроверитьСимволыКомпонента(
		Контекст.КодированныйПуть,
		"/:@",
		КодыОшибокURL.НедопустимыйСинтаксисURI(),
		Истина
	);

	Если Контекст.КодированныйЗапрос <> Неопределено Тогда
		ПроверитьСимволыКомпонента(
			Контекст.КодированныйЗапрос,
			"/:@?",
			КодыОшибокURL.НедопустимыйСинтаксисURI(),
			Истина
		);
	КонецЕсли;

	Если Контекст.КодированныйФрагмент <> Неопределено Тогда
		ПроверитьСимволыКомпонента(
			Контекст.КодированныйФрагмент,
			"/:@?",
			КодыОшибокURL.НедопустимыйСинтаксисURI(),
			Истина
		);
	КонецЕсли;

КонецПроцедуры

Процедура ОтделитьЗапрос(Контекст)

	Позиция = СтрНайти(Контекст.Остаток, "?");

	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;

	Контекст.ЗапросОпределен = Истина;
	Контекст.КодированныйЗапрос = Сред(Контекст.Остаток, Позиция + 1);
	Контекст.ПредставлениеЗапроса = Контекст.КодированныйЗапрос;
	Контекст.Остаток = Лев(Контекст.Остаток, Позиция - 1);

КонецПроцедуры

Процедура ОтделитьСхему(Контекст)

	Контекст.Схема = ИзвлечьСхему(Контекст.Остаток);

	Если Контекст.Схема <> Неопределено Тогда
		Контекст.Остаток = Сред(Контекст.Остаток, СтрДлина(Контекст.Схема) + 2);
	КонецЕсли;

КонецПроцедуры

Процедура ОтделитьСервернуюЧасть(Контекст)

	Контекст.СервернаяЧастьОпределена = Лев(Контекст.Остаток, 2) = "//";
	Контекст.КодированныйПуть = Контекст.Остаток;
	Контекст.ПредставлениеПути = Контекст.Остаток;

	Если Контекст.СервернаяЧастьОпределена Тогда
		РазобратьСервернуюЧасть(Сред(Контекст.Остаток, 3), Контекст);
	КонецЕсли;

КонецПроцедуры

Функция СоздатьСостояние(Контекст)

	Состояние = Новый СостояниеURI(Контекст);

	Состояние.ПроверитьИнварианты();

	Возврат Состояние;

КонецФункции

Функция ИзвлечьСхему(Значение)

	ПозицияДвоеточия = СтрНайти(Значение, ":");
	ПозицияСлеша = СтрНайти(Значение, "/");

	Если ПозицияДвоеточия = 0 Или ПозицияСлеша > 0 И ПозицияСлеша < ПозицияДвоеточия Тогда
		Возврат Неопределено;
	КонецЕсли;

	Схема = Лев(Значение, ПозицияДвоеточия - 1);

	Если Не ЭтоДопустимаяСхема(Схема) Тогда
		ВызватьНедопустимуюСхему();
	КонецЕсли;

	Возврат Схема;

КонецФункции

Процедура РазобратьСервернуюЧасть(Значение, Контекст)

	ПозицияСлеша = СтрНайти(Значение, "/");

	Если ПозицияСлеша = 0 Тогда
		СервернаяЧасть = Значение;
		Контекст.КодированныйПуть = "";
		Контекст.ПредставлениеПути = "";
	Иначе
		СервернаяЧасть = Лев(Значение, ПозицияСлеша - 1);
		Контекст.КодированныйПуть = Сред(Значение, ПозицияСлеша);
		Контекст.ПредставлениеПути = Контекст.КодированныйПуть;
	КонецЕсли;

	ПозицияПользователя = ПоследняяПозиция(СервернаяЧасть, "@");

	Если ПозицияПользователя > 0 Тогда
		Контекст.ДанныеПользователяОпределены = Истина;
		Контекст.КодированныеДанныеПользователя = Лев(СервернаяЧасть, ПозицияПользователя - 1);
		Контекст.ПредставлениеДанныхПользователя = Контекст.КодированныеДанныеПользователя;
		СервернаяЧасть = Сред(СервернаяЧасть, ПозицияПользователя + 1);
	КонецЕсли;

	Если Лев(СервернаяЧасть, 1) = "[" Тогда
		ПозицияЗакрывающейСкобки = СтрНайти(СервернаяЧасть, "]");

		Если ПозицияЗакрывающейСкобки = 0 Тогда
			ВызватьНедопустимыйХост();
		КонецЕсли;

		Контекст.КодированныйХост = Лев(СервернаяЧасть, ПозицияЗакрывающейСкобки);
		Контекст.ПредставлениеХоста = Контекст.КодированныйХост;
		Остаток = Сред(СервернаяЧасть, ПозицияЗакрывающейСкобки + 1);

		Если Остаток <> "" Тогда
			Если Лев(Остаток, 1) <> ":" Тогда
				ВызватьНедопустимуюСервернуюЧасть();
			КонецЕсли;

			Контекст.ПортУказан = Истина;
			Контекст.ТекстПорта = Сред(Остаток, 2);
		КонецЕсли;
	Иначе
		ПозицияПорта = СтрНайти(СервернаяЧасть, ":");

		Если ПозицияПорта = 0 Тогда
			Контекст.КодированныйХост = СервернаяЧасть;
		Иначе
			Контекст.КодированныйХост = Лев(СервернаяЧасть, ПозицияПорта - 1);
			Контекст.ПортУказан = Истина;
			Контекст.ТекстПорта = Сред(СервернаяЧасть, ПозицияПорта + 1);
		КонецЕсли;

		Контекст.ПредставлениеХоста = Контекст.КодированныйХост;
	КонецЕсли;

КонецПроцедуры

Процедура ПодготовитьКодированныеКомпоненты(Контекст)

	Если Контекст.КодированныеДанныеПользователя <> Неопределено Тогда
		ПроверкаКодовыхТочекIRI.ПроверитьКомпонент(Контекст.КодированныеДанныеПользователя);
		Контекст.КодированныеДанныеПользователя = КодированиеКомпонентовURI.КодироватьСимволыUnicode(
			Контекст.КодированныеДанныеПользователя
		);
	КонецЕсли;

	Если Контекст.КодированныйХост <> Неопределено
		И Лев(Контекст.КодированныйХост, 1) <> "[" Тогда
		ПроверкаКодовыхТочекIRI.ПроверитьКомпонент(Контекст.КодированныйХост);
		Контекст.КодированныйХост = КодированиеКомпонентовURI.КодироватьСимволыUnicode(Контекст.КодированныйХост);
	КонецЕсли;

	ПроверкаКодовыхТочекIRI.ПроверитьКомпонент(Контекст.КодированныйПуть);
	Контекст.КодированныйПуть = КодированиеКомпонентовURI.КодироватьСимволыUnicode(Контекст.КодированныйПуть);

	Если Контекст.КодированныйЗапрос <> Неопределено Тогда
		ПроверкаКодовыхТочекIRI.ПроверитьКомпонент(Контекст.КодированныйЗапрос, Истина);
		Контекст.КодированныйЗапрос = КодированиеКомпонентовURI.КодироватьСимволыUnicode(
			Контекст.КодированныйЗапрос
		);
	КонецЕсли;

	Если Контекст.КодированныйФрагмент <> Неопределено Тогда
		ПроверкаКодовыхТочекIRI.ПроверитьКомпонент(Контекст.КодированныйФрагмент);
		Контекст.КодированныйФрагмент = КодированиеКомпонентовURI.КодироватьСимволыUnicode(
			Контекст.КодированныйФрагмент
		);
	КонецЕсли;

КонецПроцедуры

Функция ПоследняяПозиция(Значение, Символ)

	Результат = 0;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если Сред(Значение, Индекс, 1) = Символ Тогда
			Результат = Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ПроверитьГрамматикуКомпонентов(Контекст)

	Если Контекст.Схема <> Неопределено И Не ЭтоДопустимаяСхема(Контекст.Схема) Тогда
		ВызватьНедопустимуюСхему();
	КонецЕсли;

	Если Контекст.СервернаяЧастьОпределена Тогда
		Если Контекст.КодированныеДанныеПользователя <> Неопределено Тогда
			ПроверитьСимволыКомпонента(
				Контекст.КодированныеДанныеПользователя,
				":",
				КодыОшибокURL.НедопустимаяСервернаяЧастьURI()
			);
		КонецЕсли;

		Классификатор = Новый КлассификаторХостаURI;
		Контекст.ВидХоста = Классификатор.Классифицировать(Контекст.КодированныйХост);

		Если Контекст.ВидХоста = Неопределено Тогда
			ВызватьНедопустимыйХост();
		КонецЕсли;

		Если Не ТолькоЦифры(Контекст.ТекстПорта) Тогда
			ВызватьНедопустимуюСервернуюЧасть();
		КонецЕсли;

		Если Контекст.КодированныйПуть <> "" И Лев(Контекст.КодированныйПуть, 1) <> "/" Тогда
			ВызватьНедопустимыйСинтаксис();
		КонецЕсли;
	КонецЕсли;

	ПроверитьСимволыКомпонента(
		Контекст.КодированныйПуть,
		"/:@",
		КодыОшибокURL.НедопустимыйСинтаксисURI()
	);

	Если Контекст.КодированныйЗапрос <> Неопределено Тогда
		ПроверитьСимволыКомпонента(
			Контекст.КодированныйЗапрос,
			"/:@?",
			КодыОшибокURL.НедопустимыйСинтаксисURI()
		);
	КонецЕсли;

	Если Контекст.КодированныйФрагмент <> Неопределено Тогда
		ПроверитьСимволыКомпонента(
			Контекст.КодированныйФрагмент,
			"/:@?",
			КодыОшибокURL.НедопустимыйСинтаксисURI()
		);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПроцентноеКодирование(Значение)

	Индекс = 1;

	Пока Индекс <= СтрДлина(Значение) Цикл
		Если Сред(Значение, Индекс, 1) = "%" Тогда
			Если Индекс + 2 > СтрДлина(Значение)
				Или Не ЭтоHexСимвол(Сред(Значение, Индекс + 1, 1))
				Или Не ЭтоHexСимвол(Сред(Значение, Индекс + 2, 1)) Тогда
				ВызватьНедопустимоеПроцентноеКодирование(Индекс);
			КонецЕсли;

			Индекс = Индекс + 3;
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьСимволыКомпонента(
	Значение,
	ДополнительныеСимволы,
	КодОшибки,
	ПропускатьСимволыUnicode = Ложь
)

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);

		Если ПропускатьСимволыUnicode И КодСимвола(Символ) > 127 Тогда
			Продолжить;
		ИначеЕсли Символ = "%" Тогда
			Индекс = Индекс + 2;
		ИначеЕсли Не ЭтоНеразделенныйСимвол(Символ)
			И Не ЭтоПодРазделитель(Символ)
			И СтрНайти(ДополнительныеСимволы, Символ) = 0 Тогда
			ВызватьИсключение ФабрикаОшибок.Создать(КодОшибки, "Недопустимый символ URI");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЭтоДопустимаяСхема(Значение)

	Если СтрДлина(Значение) = 0 Или Не ЭтоБукваASCII(Лев(Значение, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 2 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);

		Если Не ЭтоБукваASCII(Символ) И Не ЭтоЦифраASCII(Символ)
			И СтрНайти("+.-", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ТолькоЦифры(Значение)

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если Не ЭтоЦифраASCII(Сред(Значение, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоНеразделенныйСимвол(Символ)

	Возврат ЭтоБукваASCII(Символ) Или ЭтоЦифраASCII(Символ) Или СтрНайти("-._~", Символ) > 0;

КонецФункции

Функция ЭтоПодРазделитель(Символ)

	Возврат СтрНайти("!$&'()*+,;=", Символ) > 0;

КонецФункции

Функция ЭтоБукваASCII(Символ)

	Код = КодСимвола(Символ);

	// Коды ASCII: A-Z - 65-90, a-z - 97-122.
	Возврат Код >= 65 И Код <= 90
		Или Код >= 97 И Код <= 122;

КонецФункции

Функция ЭтоЦифраASCII(Символ)

	Код = КодСимвола(Символ);

	// Коды ASCII: 0-9 - 48-57.
	Возврат Код >= 48 И Код <= 57;

КонецФункции

Функция ЭтоHexСимвол(Символ)

	Код = КодСимвола(Символ);

	// Коды ASCII: A-F - 65-70, a-f - 97-102.
	Возврат ЭтоЦифраASCII(Символ)
		Или Код >= 65 И Код <= 70
		Или Код >= 97 И Код <= 102;

КонецФункции

Процедура ВызватьНедопустимуюСхему()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимаяСхемаURI(),
		"Недопустимая схема URI"
	);

КонецПроцедуры

Процедура ВызватьНедопустимоеПроцентноеКодирование(Позиция)

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимоеПроцентноеКодированиеURI(),
		"Некорректное процентное кодирование URI",
		Новый Структура("Позиция,Ожидание", Позиция, "%HH")
	);

КонецПроцедуры

Процедура ВызватьНедопустимуюСервернуюЧасть()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимаяСервернаяЧастьURI(),
