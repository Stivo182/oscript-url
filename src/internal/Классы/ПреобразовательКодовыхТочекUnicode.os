#Использовать errors

#Область ПрограммныйИнтерфейс

// Преобразует строку UTF-16 в кодовые точки Unicode.
//
// Параметры:
//  Значение - Строка - Исходная строка UTF-16.
//
// Возвращаемое значение:
//  Массив, Неопределено - Кодовые точки или Неопределено для некорректной пары суррогатов.
Функция ИзСтроки(Значение) Экспорт

	КодовыеТочки = Новый Массив;
	Индекс = 1;

	Пока Индекс <= СтрДлина(Значение) Цикл
		СтаршаяЧасть = КодСимвола(Сред(Значение, Индекс, 1));

		Если ЭтоСтаршийСуррогат(СтаршаяЧасть) Тогда
			Если Индекс = СтрДлина(Значение) Тогда
				Возврат Неопределено;
			КонецЕсли;

			МладшаяЧасть = КодСимвола(Сред(Значение, Индекс + 1, 1));

			Если Не ЭтоМладшийСуррогат(МладшаяЧасть) Тогда
				Возврат Неопределено;
			КонецЕсли;

			КодовыеТочки.Добавить(65536 + (СтаршаяЧасть - 55296) * 1024 + МладшаяЧасть - 56320);
			Индекс = Индекс + 2;
		ИначеЕсли ЭтоМладшийСуррогат(СтаршаяЧасть) Тогда
			Возврат Неопределено;
		Иначе
			КодовыеТочки.Добавить(СтаршаяЧасть);
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат КодовыеТочки;

КонецФункции

// Собирает строку UTF-16 из кодовых точек Unicode.
//
// Параметры:
//  КодовыеТочки - Массив, ФиксированныйМассив - Кодовые точки Unicode.
//
// Возвращаемое значение:
//  Строка - Строковое представление кодовых точек.
//
// Исключения:
//  argument.invalid_value - Массив содержит значение, не являющееся скалярным значением Unicode.
Функция ВСтроку(КодовыеТочки) Экспорт

	Фрагменты = Новый Массив;

	Для Каждого КодоваяТочка Из КодовыеТочки Цикл
		Если КодоваяТочка < 0
			Или КодоваяТочка > 1114111
			Или КодоваяТочка >= 55296 И КодоваяТочка <= 57343 Тогда
			ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента(
				"КодовыеТочки",
				"массив скалярных значений Unicode"
			);
		КонецЕсли;

		Если КодоваяТочка <= 65535 Тогда
			Фрагменты.Добавить(Символ(КодоваяТочка));
		Иначе
			Значение = КодоваяТочка - 65536;
			Фрагменты.Добавить(Символ(55296 + Цел(Значение / 1024)));
			Фрагменты.Добавить(Символ(56320 + Значение % 1024));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

// Ищет индекс отсортированного диапазона, содержащего кодовую точку.
//
// Параметры:
//  КодоваяТочка - Число - Искомая кодовая точка.
//  Начала - Массив, ФиксированныйМассив - Начала диапазонов.
//  Концы - Массив, ФиксированныйМассив - Концы диапазонов включительно.
//
// Возвращаемое значение:
//  Число, Неопределено - Индекс найденного диапазона или Неопределено.
Функция ИндексДиапазона(КодоваяТочка, Начала, Концы) Экспорт

	ЛеваяГраница = 0;
	ПраваяГраница = Начала.Количество() - 1;

	Пока ЛеваяГраница <= ПраваяГраница Цикл
		СреднийИндекс = Цел((ЛеваяГраница + ПраваяГраница) / 2);

		Если КодоваяТочка < Начала[СреднийИндекс] Тогда
			ПраваяГраница = СреднийИндекс - 1;
		ИначеЕсли КодоваяТочка > Концы[СреднийИндекс] Тогда
			ЛеваяГраница = СреднийИндекс + 1;
		Иначе
			Возврат СреднийИндекс;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоСтаршийСуррогат(Код)

	Возврат Код >= 55296 И Код <= 56319;

КонецФункции

Функция ЭтоМладшийСуррогат(Код)

	Возврат Код >= 56320 И Код <= 57343;

КонецФункции

#КонецОбласти
