#Использовать errors

Перем _ПроверяющийСинтаксисURI; // ПроверяющийСинтаксисURI
Перем _ПреобразовательКодовыхТочекUnicode; // ПреобразовательКодовыхТочекUnicode
Перем _ДопустимыеASCIIЛитерала; // Строка

#Область ОбработчикиСобытий

// Создаёт разборщик шаблона URI.
//
// Параметры:
//  ПроверяющийСинтаксисURI - ПроверяющийСинтаксисURI - Проверяющий синтаксис URI.
//  ПреобразовательКодовыхТочекUnicode - ПреобразовательКодовыхТочекUnicode - Преобразователь Unicode.
Процедура ПриСозданииОбъекта(ПроверяющийСинтаксисURI, ПреобразовательКодовыхТочекUnicode)

	_ПроверяющийСинтаксисURI = ПроверяющийСинтаксисURI;
	_ПреобразовательКодовыхТочекUnicode = ПреобразовательКодовыхТочекUnicode;
	// Апостроф разрешён подтверждённой технической поправкой RFC 6570 Errata 6937.
	// https://errata.rfc-editor.org/eid6937
	_ДопустимыеASCIIЛитерала = "!#$&'()*+,-./0123456789:;=?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]_abcdefghijklmnopqrstuvwxyz~";

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет и разбирает шаблон URI по RFC 6570.
//
// Параметры:
//  Представление - Строка - Исходный шаблон URI.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Части шаблона и имена переменных.
//
// Исключения:
//  url.template.invalid_syntax.* - Представление нарушает грамматику шаблона URI.
Функция Разобрать(Представление) Экспорт

	ПозицияОшибкиUnicode = ПозицияНекорректнойПоследовательностиUnicode(Представление);
	Если ПозицияОшибкиUnicode <> Неопределено Тогда
		ВызватьОшибку("invalid_character", ПозицияОшибкиUnicode, "печатный символ Unicode");
	КонецЕсли;

	Части = Новый Массив;
	ИменаПеременных = Новый Массив;
	ИзвестныеИмена = Новый Соответствие;
	НачалоЛитерала = 1;
	НачальнаяПозицияЛитерала = 1;
	Индекс = 1;
	Позиция = 1;

	Пока Индекс <= СтрДлина(Представление) Цикл
		СимволШаблона = Сред(Представление, Индекс, 1);

		Если СимволШаблона = "{" Тогда
			ДобавитьЛитерал(
				Части,
				Представление,
				НачалоЛитерала,
				Индекс - НачалоЛитерала,
				НачальнаяПозицияЛитерала
			);

			КонецВыражения = НайтиКонецВыражения(Представление, Индекс + 1, Позиция + 1);
			Если КонецВыражения = Неопределено Тогда
				ВызватьОшибку(
					"unclosed_expression",
					Позиция,
					"закрывающая фигурная скобка"
				);
			КонецЕсли;

			ТекстВыражения = Сред(Представление, Индекс + 1, КонецВыражения - Индекс - 1);
			Выражение = РазобратьВыражение(
				ТекстВыражения,
				Позиция + 1
			);

			Части.Добавить(НоваяЧасть("Выражение", Выражение));
			ДобавитьИменаПеременных(Выражение, ИменаПеременных, ИзвестныеИмена);

			Позиция = Позиция + КонецВыражения - Индекс + 1;
			Индекс = КонецВыражения + 1;
			НачалоЛитерала = Индекс;
			НачальнаяПозицияЛитерала = Позиция;
		ИначеЕсли СимволШаблона = "}" Тогда
			ВызватьОшибку(
				"invalid_character",
				Позиция,
				"литерал или выражение"
			);
		Иначе
			Код = КодСимвола(СимволШаблона);
			Индекс = Индекс + ?(Код >= 55296 И Код <= 56319, 2, 1); // U+D800..U+DBFF
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;

	ДобавитьЛитерал(
		Части,
		Представление,
		НачалоЛитерала,
		СтрДлина(Представление) - НачалоЛитерала + 1,
		НачальнаяПозицияЛитерала
	);

	Снимок = Новый Структура;
	Снимок.Вставить("Части", Новый ФиксированныйМассив(Части));
	Снимок.Вставить("ИменаПеременных", Новый ФиксированныйМассив(ИменаПеременных));
	Снимок.Вставить("ИзвестныеИмена", Новый ФиксированноеСоответствие(ИзвестныеИмена));

	Возврат Новый ФиксированнаяСтруктура(Снимок);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьЛитерал(Части, Представление, Начало, Длина, НачальнаяПозиция)

	Если Длина <= 0 Тогда
		Возврат;
	КонецЕсли;

	Литерал = Сред(Представление, Начало, Длина);
	ПроверитьЛитерал(Литерал, НачальнаяПозиция);
	Части.Добавить(НоваяЧасть("Литерал", Литерал));

КонецПроцедуры

Функция НоваяЧасть(Вид, Значение)

	Возврат Новый ФиксированнаяСтруктура("Вид,Значение", Вид, Значение);

КонецФункции

Функция НайтиКонецВыражения(Представление, Начало, НачальнаяПозиция)

	Позиция = НачальнаяПозиция;
	Для Индекс = Начало По СтрДлина(Представление) Цикл
		СимволШаблона = Сред(Представление, Индекс, 1);
		Если СимволШаблона = "{" Тогда
			ВызватьОшибку(
				"invalid_character",
				Позиция,
				"содержимое выражения"
			);
		ИначеЕсли СимволШаблона = "}" Тогда
			Возврат Индекс;
		КонецЕсли;

		Код = КодСимвола(СимволШаблона);
		Если Код < 56320 Или Код > 57343 Тогда // Не U+DC00..U+DFFF, младший суррогат
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция РазобратьВыражение(Текст, Позиция)

	Если Текст = "" Тогда
		ВызватьОшибку("empty_expression", Позиция, "имя переменной");
	КонецЕсли;

	Оператор = "";
	ПозицияПеременных = Позиция;
	ПервыйСимвол = Лев(Текст, 1);

	Если СтрНайти("+#./;?&", ПервыйСимвол) > 0 Тогда
		Оператор = ПервыйСимвол;
		Текст = Сред(Текст, 2);
		ПозицияПеременных = ПозицияПеременных + 1;
	ИначеЕсли СтрНайти("=,!@|", ПервыйСимвол) > 0 Тогда
		ВызватьОшибку("unsupported_operator", Позиция, "оператор RFC 6570");
	КонецЕсли;

	Если Текст = "" Тогда
		ВызватьОшибку("empty_expression", ПозицияПеременных, "имя переменной");
	КонецЕсли;

	Переменные = Новый Массив;
	СмещениеПеременной = 0;
	Для Каждого ТекстПеременной Из СтрРазделить(Текст, ",", Истина) Цикл
		ПозицияПеременной = ПозицияПеременных
			+ ПозицияКодовойТочки(Текст, СмещениеПеременной + 1) - 1;
		Если ТекстПеременной = "" Тогда
			ВызватьОшибку("invalid_variable", ПозицияПеременной, "имя переменной");
		КонецЕсли;

		Переменные.Добавить(РазобратьПеременную(ТекстПеременной, ПозицияПеременной));
		СмещениеПеременной = СмещениеПеременной + СтрДлина(ТекстПеременной) + 1;
	КонецЦикла;

	Снимок = Новый Структура;
	Снимок.Вставить("Оператор", Оператор);
	Снимок.Вставить("Переменные", Новый ФиксированныйМассив(Переменные));

	Возврат Новый ФиксированнаяСтруктура(Снимок);

КонецФункции

Функция РазобратьПеременную(Текст, Позиция)

	ИсходныйТекст = Текст;

	ПозицияЛишнегоМодификатора = НайтиПозициюЛишнегоМодификатора(Текст);
	Если ПозицияЛишнегоМодификатора <> Неопределено Тогда
		ВызватьОшибку(
			"invalid_modifier",
			ПозицияМодификатора(ИсходныйТекст, ПозицияЛишнегоМодификатора, Позиция),
			"один модификатор значения"
		);
	КонецЕсли;

	Разворачивать = Прав(Текст, 1) = "*";
	Если Разворачивать Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 1);
	КонецЕсли;

	ПозицияЗвёздочки = СтрНайти(Текст, "*");
	Если ПозицияЗвёздочки > 0 Тогда
		ВызватьОшибку(
			"invalid_modifier",
			ПозицияМодификатора(ИсходныйТекст, ПозицияЗвёздочки, Позиция),
			"один модификатор значения"
		);
	КонецЕсли;

	ДлинаПрефикса = Неопределено;
	ПозицияДвоеточия = СтрНайти(Текст, ":");

	Если ПозицияДвоеточия > 0 Тогда
		ТекстПрефикса = Сред(Текст, ПозицияДвоеточия + 1);
		Текст = Лев(Текст, ПозицияДвоеточия - 1);

		Если СтрДлина(ТекстПрефикса) < 1
			Или СтрДлина(ТекстПрефикса) > 4
			Или Лев(ТекстПрефикса, 1) = "0"
			Или Не _ПроверяющийСинтаксисURI.ТолькоЦифрыASCII(ТекстПрефикса) Тогда
			ВызватьОшибку(
				"invalid_modifier",
				ПозицияМодификатора(ИсходныйТекст, ПозицияДвоеточия, Позиция),
				"целое число от 1 до 9999"
			);
		КонецЕсли;

		ДлинаПрефикса = Число(ТекстПрефикса);
	КонецЕсли;

	ПроверитьИмяПеременной(Текст, Позиция);

	Возврат Новый ФиксированнаяСтруктура("Имя,Разворачивать,ДлинаПрефикса", Текст, Разворачивать, ДлинаПрефикса);

КонецФункции

Функция НайтиПозициюЛишнегоМодификатора(Текст)

	МодификаторНайден = Ложь;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = "*" Или Символ = ":" Тогда
			Если МодификаторНайден Тогда
				Возврат Индекс;
			КонецЕсли;

			МодификаторНайден = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ПозицияМодификатора(Текст, ИндексUTF16, НачальнаяПозиция)

	Возврат НачальнаяПозиция + ПозицияКодовойТочки(Текст, ИндексUTF16) - 1;

КонецФункции

Процедура ПроверитьИмяПеременной(Имя, Позиция)

	Если Имя = "" Тогда
		ВызватьОшибку("invalid_variable", Позиция, "имя переменной");
	КонецЕсли;

	Индекс = 1;
	ПредыдущаяТочка = Истина;

	Пока Индекс <= СтрДлина(Имя) Цикл
		СимволИмени = Сред(Имя, Индекс, 1);

		Если СимволИмени = "." Тогда
			Если ПредыдущаяТочка Или Индекс = СтрДлина(Имя) Тогда
				ВызватьОшибку("invalid_variable", Позиция + Индекс - 1, "часть имени переменной");
			КонецЕсли;

			ПредыдущаяТочка = Истина;
			Индекс = Индекс + 1;
		ИначеЕсли СимволИмени = "%" Тогда
			Если Не ЭтоПроцентныйТриплет(Имя, Индекс) Тогда
				ВызватьОшибку("invalid_percent_encoding", Позиция + Индекс - 1, "последовательность %HH");
			КонецЕсли;

			ПредыдущаяТочка = Ложь;
			Индекс = Индекс + 3;
		ИначеЕсли ЭтоСимволИмени(СимволИмени) Тогда
			ПредыдущаяТочка = Ложь;
			Индекс = Индекс + 1;
		Иначе
			ВызватьОшибку("invalid_variable", Позиция + Индекс - 1, "символ имени переменной");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЭтоСимволИмени(СимволИмени)

	Код = КодСимвола(СимволИмени);
	Возврат Код >= 65 И Код <= 90 // A..Z
		Или Код >= 97 И Код <= 122 // a..z
		Или Код >= 48 И Код <= 57 // 0..9
		Или СимволИмени = "_";

КонецФункции

Процедура ПроверитьЛитерал(Литерал, НачальнаяПозиция)

	Индекс = 1;
	ЕстьСимволыВнеASCII = Ложь;
	Пока Индекс <= СтрДлина(Литерал) Цикл
		СимволЛитерала = Сред(Литерал, Индекс, 1);
		Код = КодСимвола(СимволЛитерала);

		Если СимволЛитерала = "%" Тогда
			Если Не ЭтоПроцентныйТриплет(Литерал, Индекс) Тогда
				ВызватьОшибку(
					"invalid_percent_encoding",
					ПозицияВЛитерале(Литерал, Индекс, НачальнаяПозиция),
					"последовательность %HH"
				);
			КонецЕсли;

			Индекс = Индекс + 3;
		ИначеЕсли Код <= 127 Тогда // U+0000..U+007F, ASCII
			Если СтрНайти(_ДопустимыеASCIIЛитерала, СимволЛитерала) = 0 Тогда
				ВызватьОшибку(
					"invalid_character",
					ПозицияВЛитерале(Литерал, Индекс, НачальнаяПозиция),
					"символ литерала"
				);
			КонецЕсли;

			Индекс = Индекс + 1;
		Иначе
			ЕстьСимволыВнеASCII = Истина;
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьСимволыВнеASCII Тогда
		Возврат;
	КонецЕсли;

	СмещениеКодовойТочки = 0;
	Для Каждого КодоваяТочка Из _ПреобразовательКодовыхТочекUnicode.ИзСтроки(Литерал) Цикл
		Если КодоваяТочка > 127 И Не ДопустимаяКодоваяТочкаЛитерала(КодоваяТочка) Тогда // Вне ASCII
			ВызватьОшибку(
				"invalid_character",
				НачальнаяПозиция + СмещениеКодовойТочки,
				"печатный символ Unicode"
			);
		КонецЕсли;

		СмещениеКодовойТочки = СмещениеКодовойТочки + 1;
	КонецЦикла;

КонецПроцедуры

Функция ДопустимаяКодоваяТочкаЛитерала(Код)

	Возврат Код >= 160 И Код <= 55295 // U+00A0..U+D7FF
		Или Код >= 63744 И Код <= 64975 // U+F900..U+FDCF
		Или Код >= 65008 И Код <= 65519 // U+FDF0..U+FFEF
		Или Код >= 65536 И Код <= 131069 // U+10000..U+1FFFD
		Или Код >= 131072 И Код <= 196605 // U+20000..U+2FFFD
		Или Код >= 196608 И Код <= 262141 // U+30000..U+3FFFD
		Или Код >= 262144 И Код <= 327677 // U+40000..U+4FFFD
		Или Код >= 327680 И Код <= 393213 // U+50000..U+5FFFD
		Или Код >= 393216 И Код <= 458749 // U+60000..U+6FFFD
		Или Код >= 458752 И Код <= 524285 // U+70000..U+7FFFD
		Или Код >= 524288 И Код <= 589821 // U+80000..U+8FFFD
		Или Код >= 589824 И Код <= 655357 // U+90000..U+9FFFD
		Или Код >= 655360 И Код <= 720893 // U+A0000..U+AFFFD
		Или Код >= 720896 И Код <= 786429 // U+B0000..U+BFFFD
		Или Код >= 786432 И Код <= 851965 // U+C0000..U+CFFFD
		Или Код >= 851968 И Код <= 917501 // U+D0000..U+DFFFD
		Или Код >= 921600 И Код <= 983037 // U+E1000..U+EFFFD
		Или Код >= 57344 И Код <= 63743 // U+E000..U+F8FF, частное использование
		Или Код >= 983040 И Код <= 1048573 // U+F0000..U+FFFFD, частное использование
		Или Код >= 1048576 И Код <= 1114109; // U+100000..U+10FFFD, частное использование

КонецФункции

Функция ЭтоПроцентныйТриплет(Значение, Индекс)

	Возврат Индекс + 2 <= СтрДлина(Значение)
		И _ПроверяющийСинтаксисURI.ЭтоШестнадцатеричныйСимвол(Сред(Значение, Индекс + 1, 1))
		И _ПроверяющийСинтаксисURI.ЭтоШестнадцатеричныйСимвол(Сред(Значение, Индекс + 2, 1));

КонецФункции

Функция ПозицияКодовойТочки(Представление, ИндексUTF16)

	Если ИндексUTF16 <= 1 Тогда
		Возврат 1;
	КонецЕсли;

	Позиция = 1;
	Индекс = 1;
	Пока Индекс < ИндексUTF16 Цикл
		Код = КодСимвола(Сред(Представление, Индекс, 1));
		Индекс = Индекс + ?(Код >= 55296 И Код <= 56319, 2, 1); // U+D800..U+DBFF, старший суррогат
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Позиция;

КонецФункции

Функция ПозицияНекорректнойПоследовательностиUnicode(Представление)

	Индекс = 1;
	Позиция = 1;

	Пока Индекс <= СтрДлина(Представление) Цикл
		Код = КодСимвола(Сред(Представление, Индекс, 1));

		Если Код >= 55296 И Код <= 56319 Тогда // U+D800..U+DBFF, старший суррогат
			Если Индекс = СтрДлина(Представление) Тогда
				Возврат Позиция;
			КонецЕсли;

			СледующийКод = КодСимвола(Сред(Представление, Индекс + 1, 1));
			Если СледующийКод < 56320 Или СледующийКод > 57343 Тогда // U+DC00..U+DFFF, младший суррогат
				Возврат Позиция;
			КонецЕсли;

			Индекс = Индекс + 2;
		ИначеЕсли Код >= 56320 И Код <= 57343 Тогда // U+DC00..U+DFFF без старшего суррогата
			Возврат Позиция;
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;

		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ПозицияВЛитерале(Литерал, ИндексUTF16, НачальнаяПозиция)

	Если ИндексUTF16 <= 1 Тогда
		Возврат НачальнаяПозиция;
	КонецЕсли;

	Возврат НачальнаяПозиция + ПозицияКодовойТочки(Литерал, ИндексUTF16) - 1;

КонецФункции

Процедура ДобавитьИменаПеременных(Выражение, Имена, ИзвестныеИмена)

	Для Каждого Переменная Из Выражение.Переменные Цикл
		Если ИзвестныеИмена.Получить(Переменная.Имя) = Неопределено Тогда
			Имена.Добавить(Переменная.Имя);
			ИзвестныеИмена.Вставить(Переменная.Имя, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ВызватьОшибку(УточнениеКода, Позиция, Ожидание)

	ДанныеОшибки = Новый Структура("Позиция,Ожидание", Позиция, Ожидание);
	Сообщение = СтрШаблон(
		"Недопустимый синтаксис шаблона URI в позиции %1 (ожидается: %2)",
		Позиция,
		Ожидание
	);

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыйСинтаксисШаблона() + "." + УточнениеКода,
		Сообщение,
		ДанныеОшибки
	);

КонецПроцедуры

#КонецОбласти
