#Использовать errors

#Область ПрограммныйИнтерфейс

// Разрешает URI-ссылку относительно абсолютной базы по RFC 3986 §5.2.
// Операции над путём используют пользовательское представление без декодирования последовательностей %HH.
//
// Параметры:
//  База - СостояниеURI - Абсолютное внутреннее состояние базы URI.
//  Ссылка - СостояниеURI - Внутреннее состояние URI-ссылки для разрешения.
//
// Возвращаемое значение:
//  СостояниеURI - Новое независимое внутреннее состояние результирующей URI-ссылки.
//
// Исключения:
//  uri.base_not_absolute - База не является абсолютной URI-ссылкой.
Функция Разрешить(База, Ссылка) Экспорт

	Если База.Схема() = Неопределено Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыОшибокURL.БазаURIНеАбсолютная(),
			"База URI должна быть абсолютной"
		);
	КонецЕсли;

	Если Ссылка.Схема() <> Неопределено Тогда
		Схема = Ссылка.Схема();
		СервернаяЧасть = Ссылка.ПредставлениеСервернойЧасти();
		Путь = УдалитьТочечныеСегменты(Ссылка.ПредставлениеПути());
		Запрос = Ссылка.ПредставлениеЗапроса();
	ИначеЕсли Ссылка.СервернаяЧастьОпределена() Тогда
		Схема = База.Схема();
		СервернаяЧасть = Ссылка.ПредставлениеСервернойЧасти();
		Путь = УдалитьТочечныеСегменты(Ссылка.ПредставлениеПути());
		Запрос = Ссылка.ПредставлениеЗапроса();
	Иначе
		Схема = База.Схема();
		СервернаяЧасть = База.ПредставлениеСервернойЧасти();
		ПутьСсылки = Ссылка.ПредставлениеПути();

		Если ПутьСсылки = "" Тогда
			Путь = База.ПредставлениеПути();

			Если Ссылка.ПредставлениеЗапроса() <> Неопределено Тогда
				Запрос = Ссылка.ПредставлениеЗапроса();
			Иначе
				Запрос = База.ПредставлениеЗапроса();
			КонецЕсли;
		Иначе
			Если Лев(ПутьСсылки, 1) = "/" Тогда
				Путь = УдалитьТочечныеСегменты(ПутьСсылки);
			Иначе
				Путь = УдалитьТочечныеСегменты(ОбъединитьПутиURI(База, ПутьСсылки));
			КонецЕсли;

			Запрос = Ссылка.ПредставлениеЗапроса();
		КонецЕсли;
	КонецЕсли;

	СтрокаРезультата = СобратьURI(Схема, СервернаяЧасть, Путь, Запрос, Ссылка.ПредставлениеФрагмента());

	Возврат Новый ПарсерIRI().Разобрать(СтрокаРезультата);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбъединитьПутиURI(База, ПутьСсылки)

	ПутьБазы = База.ПредставлениеПути();

	Если База.СервернаяЧастьОпределена() И ПутьБазы = "" Тогда
		Возврат "/" + ПутьСсылки;
	КонецЕсли;

	ПозицияПоследнегоСлеша = ПоследняяПозиция(ПутьБазы, "/");

	Если ПозицияПоследнегоСлеша = 0 Тогда
		Возврат ПутьСсылки;
	КонецЕсли;

	Возврат Лев(ПутьБазы, ПозицияПоследнегоСлеша) + ПутьСсылки;

КонецФункции

Функция УдалитьТочечныеСегменты(Путь)

	Вход = Путь;
	Выход = "";

	Пока Вход <> "" Цикл
		Если Лев(Вход, 3) = "../" Тогда
			Вход = Сред(Вход, 4);
		ИначеЕсли Лев(Вход, 2) = "./" Тогда
			Вход = Сред(Вход, 3);
		ИначеЕсли Лев(Вход, 3) = "/./" Тогда
			Вход = "/" + Сред(Вход, 4);
		ИначеЕсли Вход = "/." Тогда
			Вход = "/";
		ИначеЕсли Лев(Вход, 4) = "/../" Тогда
			Вход = "/" + Сред(Вход, 5);
			Выход = УдалитьПоследнийСегмент(Выход);
		ИначеЕсли Вход = "/.." Тогда
			Вход = "/";
			Выход = УдалитьПоследнийСегмент(Выход);
		ИначеЕсли Вход = "." Или Вход = ".." Тогда
			Вход = "";
		Иначе
			ДлинаСегмента = ДлинаПервогоСегмента(Вход);
			Выход = Выход + Лев(Вход, ДлинаСегмента);
			Вход = Сред(Вход, ДлинаСегмента + 1);
		КонецЕсли;
	КонецЦикла;

	Возврат Выход;

КонецФункции

Функция СобратьURI(Схема, СервернаяЧасть, Путь, Запрос, Фрагмент)

	Фрагменты = Новый Массив;

	Если Схема <> Неопределено Тогда
		Фрагменты.Добавить(Схема);
		Фрагменты.Добавить(":");
	КонецЕсли;

	Если СервернаяЧасть <> Неопределено Тогда
		Фрагменты.Добавить("//");
		Фрагменты.Добавить(СервернаяЧасть);
	КонецЕсли;

	Фрагменты.Добавить(Путь);

	Если Запрос <> Неопределено Тогда
		Фрагменты.Добавить("?");
		Фрагменты.Добавить(Запрос);
	КонецЕсли;

	Если Фрагмент <> Неопределено Тогда
		Фрагменты.Добавить("#");
		Фрагменты.Добавить(Фрагмент);
	КонецЕсли;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Функция ДлинаПервогоСегмента(Путь)

	Если Лев(Путь, 1) = "/" Тогда
		ПозицияСлеша = НайтиСимвол(Путь, "/", 2);
	Иначе
		ПозицияСлеша = НайтиСимвол(Путь, "/", 1);
	КонецЕсли;

	Если ПозицияСлеша = 0 Тогда
		Возврат СтрДлина(Путь);
	КонецЕсли;

	Возврат ПозицияСлеша - 1;

КонецФункции

Функция УдалитьПоследнийСегмент(Путь)

	ПозицияПоследнегоСлеша = ПоследняяПозиция(Путь, "/");

	Если ПозицияПоследнегоСлеша = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Лев(Путь, ПозицияПоследнегоСлеша - 1);

КонецФункции

Функция ПоследняяПозиция(Значение, Символ)

	Результат = 0;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если Сред(Значение, Индекс, 1) = Символ Тогда
			Результат = Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НайтиСимвол(Значение, Символ, НачальнаяПозиция)

	Для Индекс = НачальнаяПозиция По СтрДлина(Значение) Цикл
		Если Сред(Значение, Индекс, 1) = Символ Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

#КонецОбласти
