#Использовать errors

#Область ПрограммныйИнтерфейс

// Разрешает URI-ссылку относительно абсолютной базы по RFC 3986 §5.2.
// Операции над путём используют пользовательское представление без декодирования последовательностей %HH.
//
// Параметры:
//  База - URL - Абсолютная база URI.
//  Ссылка - URL - URI-ссылка для разрешения.
//
// Возвращаемое значение:
//  URL - Новый независимый результирующий URL.
//
// Исключения:
//  url.base_not_absolute - База не является абсолютной URI-ссылкой.
Функция Разрешить(База, Ссылка) Экспорт

	КомпонентыБазы = База.СнимокКомпонентов();
	КомпонентыСсылки = Ссылка.СнимокКомпонентов();

	Если КомпонентыБазы.Схема = Неопределено Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыОшибокURL.БазаНеАбсолютная(),
			"База URI должна быть абсолютной"
		);
	КонецЕсли;

	Сборщик = Новый СборщикURL;

	Если КомпонентыСсылки.Схема <> Неопределено Тогда
		Схема = КомпонентыСсылки.Схема;
		СервернаяЧасть = Сборщик.СобратьСервернуюЧасть(КомпонентыСсылки);
		Путь = УдалитьТочечныеСегменты(КомпонентыСсылки.ПредставлениеПути);
		Запрос = КомпонентыСсылки.ПредставлениеЗапроса;
	ИначеЕсли КомпонентыСсылки.СервернаяЧастьОпределена Тогда
		Схема = КомпонентыБазы.Схема;
		СервернаяЧасть = Сборщик.СобратьСервернуюЧасть(КомпонентыСсылки);
		Путь = УдалитьТочечныеСегменты(КомпонентыСсылки.ПредставлениеПути);
		Запрос = КомпонентыСсылки.ПредставлениеЗапроса;
	Иначе
		Схема = КомпонентыБазы.Схема;
		СервернаяЧасть = Сборщик.СобратьСервернуюЧасть(КомпонентыБазы);
		ПутьСсылки = КомпонентыСсылки.ПредставлениеПути;

		Если ПутьСсылки = "" Тогда
			Путь = КомпонентыБазы.ПредставлениеПути;

			Если КомпонентыСсылки.ЗапросОпределен Тогда
				Запрос = КомпонентыСсылки.ПредставлениеЗапроса;
			Иначе
				Запрос = КомпонентыБазы.ПредставлениеЗапроса;
			КонецЕсли;
		Иначе
			Если Лев(ПутьСсылки, 1) = "/" Тогда
				Путь = УдалитьТочечныеСегменты(ПутьСсылки);
			Иначе
				Путь = УдалитьТочечныеСегменты(ОбъединитьПутиURI(КомпонентыБазы, ПутьСсылки));
			КонецЕсли;

			Запрос = КомпонентыСсылки.ПредставлениеЗапроса;
		КонецЕсли;
	КонецЕсли;

	СтрокаРезультата = СобратьURI(
		Схема,
		СервернаяЧасть,
		Путь,
		Запрос,
		КомпонентыСсылки.ПредставлениеФрагмента
	);

	Возврат Новый URL(СтрокаРезультата);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбъединитьПутиURI(КомпонентыБазы, ПутьСсылки)

	ПутьБазы = КомпонентыБазы.ПредставлениеПути;

	Если КомпонентыБазы.СервернаяЧастьОпределена И ПутьБазы = "" Тогда
		Возврат "/" + ПутьСсылки;
	КонецЕсли;

	ПозицияПоследнегоСлеша = ПоследняяПозиция(ПутьБазы, "/");

	Если ПозицияПоследнегоСлеша = 0 Тогда
		Возврат ПутьСсылки;
	КонецЕсли;

	Возврат Лев(ПутьБазы, ПозицияПоследнегоСлеша) + ПутьСсылки;

КонецФункции

Функция УдалитьТочечныеСегменты(Путь)

	Вход = Путь;
	Выход = "";

	Пока Вход <> "" Цикл
		Если Лев(Вход, 3) = "../" Тогда
			Вход = Сред(Вход, 4);
		ИначеЕсли Лев(Вход, 2) = "./" Тогда
			Вход = Сред(Вход, 3);
		ИначеЕсли Лев(Вход, 3) = "/./" Тогда
			Вход = "/" + Сред(Вход, 4);
		ИначеЕсли Вход = "/." Тогда
			Вход = "/";
		ИначеЕсли Лев(Вход, 4) = "/../" Тогда
			Вход = "/" + Сред(Вход, 5);
			Выход = УдалитьПоследнийСегмент(Выход);
		ИначеЕсли Вход = "/.." Тогда
			Вход = "/";
			Выход = УдалитьПоследнийСегмент(Выход);
		ИначеЕсли Вход = "." Или Вход = ".." Тогда
			Вход = "";
		Иначе
			ДлинаСегмента = ДлинаПервогоСегмента(Вход);
			Выход = Выход + Лев(Вход, ДлинаСегмента);
			Вход = Сред(Вход, ДлинаСегмента + 1);
		КонецЕсли;
	КонецЦикла;

	Возврат Выход;

КонецФункции

Функция СобратьURI(Схема, СервернаяЧасть, Путь, Запрос, Фрагмент)

	Фрагменты = Новый Массив;

	Если Схема <> Неопределено Тогда
		Фрагменты.Добавить(Схема);
		Фрагменты.Добавить(":");
	КонецЕсли;

	Если СервернаяЧасть <> Неопределено Тогда
		Фрагменты.Добавить("//");
		Фрагменты.Добавить(СервернаяЧасть);
	КонецЕсли;

	Фрагменты.Добавить(Путь);

	Если Запрос <> Неопределено Тогда
		Фрагменты.Добавить("?");
		Фрагменты.Добавить(Запрос);
	КонецЕсли;

	Если Фрагмент <> Неопределено Тогда
		Фрагменты.Добавить("#");
		Фрагменты.Добавить(Фрагмент);
	КонецЕсли;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Функция ДлинаПервогоСегмента(Путь)

	Если Лев(Путь, 1) = "/" Тогда
		ПозицияСлеша = НайтиСимвол(Путь, "/", 2);
	Иначе
		ПозицияСлеша = НайтиСимвол(Путь, "/", 1);
	КонецЕсли;

	Если ПозицияСлеша = 0 Тогда
		Возврат СтрДлина(Путь);
	КонецЕсли;

	Возврат ПозицияСлеша - 1;

КонецФункции

Функция УдалитьПоследнийСегмент(Путь)

	ПозицияПоследнегоСлеша = ПоследняяПозиция(Путь, "/");

	Если ПозицияПоследнегоСлеша = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Лев(Путь, ПозицияПоследнегоСлеша - 1);

КонецФункции

Функция ПоследняяПозиция(Значение, Символ)

	Результат = 0;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если Сред(Значение, Индекс, 1) = Символ Тогда
			Результат = Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НайтиСимвол(Значение, Символ, НачальнаяПозиция)

	Для Индекс = НачальнаяПозиция По СтрДлина(Значение) Цикл
		Если Сред(Значение, Индекс, 1) = Символ Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

#КонецОбласти
