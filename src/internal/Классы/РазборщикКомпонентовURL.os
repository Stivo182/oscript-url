#Использовать errors

Перем _КодировщикКомпонентовURI; // КодировщикКомпонентовURI
Перем _ПроверяющийСинтаксисURI; // ПроверяющийСинтаксисURI
Перем _КодировщикКомпонентаIRI; // КодировщикКомпонентаIRI
Перем _КлассификаторХостаURI; // КлассификаторХостаURI

#Область ОбработчикиСобытий

// Создаёт разборщик компонентов URL.
//
// Параметры:
//  КодировщикКомпонентовURI - КодировщикКомпонентовURI - Кодировщик компонентов URI.
//  ПроверяющийСинтаксисURI - ПроверяющийСинтаксисURI - Проверяющий синтаксис URI.
//  КодировщикКомпонентаIRI - КодировщикКомпонентаIRI - Кодировщик компонента IRI.
//  КлассификаторХостаURI - КлассификаторХостаURI - Классификатор хоста URI.
Процедура ПриСозданииОбъекта(
	КодировщикКомпонентовURI,
	ПроверяющийСинтаксисURI,
	КодировщикКомпонентаIRI,
	КлассификаторХостаURI
)

	_КодировщикКомпонентовURI = КодировщикКомпонентовURI;
	_ПроверяющийСинтаксисURI = ПроверяющийСинтаксисURI;
	_КодировщикКомпонентаIRI = КодировщикКомпонентаIRI;
	_КлассификаторХостаURI = КлассификаторХостаURI;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Разбирает кодированную серверную часть URL.
//
// Параметры:
//  Значение - Строка - Серверная часть без начального //.
//
// Возвращаемое значение:
//  Структура - Разобранные данные пользователя, хост и порт.
//
// Исключения:
//  url.invalid_authority - Значение имеет недопустимую структуру.
//  url.invalid_syntax - Значение содержит недопустимый символ.
//  url.invalid_percent_encoding - Процентное кодирование имеет недопустимый синтаксис.
//  url.invalid_host - Хост имеет недопустимый синтаксис.
Функция РазобратьКодированнуюСервернуюЧасть(Значение) Экспорт

	ПроверочныйURL = Новый URL("x://" + Значение + "/");
	КомпонентыПроверочногоURL = ПроверочныйURL.СнимокКомпонентов();

	Если ПроверочныйURL.КодированнаяСервернаяЧасть() <> Значение
		Или КомпонентыПроверочногоURL.КодированныйПуть <> "/"
		Или КомпонентыПроверочногоURL.КодированныйЗапрос <> Неопределено
		Или КомпонентыПроверочногоURL.КодированныйФрагмент <> Неопределено Тогда
		ВызватьНедопустимуюСервернуюЧасть();
	КонецЕсли;

	Компоненты = Новый Структура;
	Компоненты.Вставить("ДанныеПользователяОпределены", КомпонентыПроверочногоURL.ДанныеПользователяОпределены);
	Компоненты.Вставить("КодированныеДанныеПользователя", КомпонентыПроверочногоURL.КодированныеДанныеПользователя);
	Компоненты.Вставить("ПредставлениеДанныхПользователя", КомпонентыПроверочногоURL.ПредставлениеДанныхПользователя);
	Компоненты.Вставить("КодированныйХост", КомпонентыПроверочногоURL.КодированныйХост);
	Компоненты.Вставить("ПредставлениеХоста", КомпонентыПроверочногоURL.ПредставлениеХоста);
	Компоненты.Вставить("ВидХоста", КомпонентыПроверочногоURL.ВидХоста);
	Компоненты.Вставить("ПортУказан", КомпонентыПроверочногоURL.ПортУказан);
	Компоненты.Вставить("ТекстПорта", КомпонентыПроверочногоURL.ТекстПорта);

	Возврат Компоненты;

КонецФункции

// Разбирает декодированную серверную часть URL.
//
// Параметры:
//  Значение - Строка - Серверная часть без начального //.
//
// Возвращаемое значение:
//  Структура - Кодированные компоненты и их пользовательские представления.
//
// Исключения:
//  url.invalid_authority - Значение имеет недопустимую структуру.
//  url.invalid_host - Хост имеет недопустимый синтаксис.
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Функция РазобратьДекодированнуюСервернуюЧасть(Значение) Экспорт


	Если КоличествоСимволов(Значение, "@") > 1 Тогда
		ВызватьНедопустимуюСервернуюЧасть();
	КонецЕсли;

	ПозицияПользователя = СтрНайти(Значение, "@");

	Если ПозицияПользователя = 0 Тогда
		ДанныеПользователяОпределены = Ложь;
		КодированныеДанныеПользователя = Неопределено;
		ПредставлениеДанныхПользователя = Неопределено;
		ХостИПорт = Значение;
	Иначе
		ДанныеПользователяОпределены = Истина;
		ДанныеПользователя = Лев(Значение, ПозицияПользователя - 1);

		Если СтрНайти(ДанныеПользователя, "[") > 0 Или СтрНайти(ДанныеПользователя, "]") > 0 Тогда
			ВызватьНедопустимуюСервернуюЧасть();
		КонецЕсли;

		КодированныеДанныеПользователя = КодированиеURL.КодироватьДанныеПользователя(ДанныеПользователя);
		ПредставлениеДанныхПользователя = ПодготовитьПредставлениеКомпонента(
			ДанныеПользователя,
			_ПроверяющийСинтаксисURI.ДопустимыеСимволыДанныхПользователя()
		);
		ХостИПорт = Сред(Значение, ПозицияПользователя + 1);
	КонецЕсли;

	РазобранныеХостИПорт = РазобратьДекодированныеХостИПорт(ХостИПорт);

	Компоненты = Новый Структура;
	Компоненты.Вставить("ДанныеПользователяОпределены", ДанныеПользователяОпределены);
	Компоненты.Вставить("КодированныеДанныеПользователя", КодированныеДанныеПользователя);
	Компоненты.Вставить("ПредставлениеДанныхПользователя", ПредставлениеДанныхПользователя);
	Компоненты.Вставить("КодированныйХост", РазобранныеХостИПорт.КодированныйХост);
	Компоненты.Вставить("ПредставлениеХоста", РазобранныеХостИПорт.ПредставлениеХоста);
	Компоненты.Вставить("ВидХоста", РазобранныеХостИПорт.ВидХоста);
	Компоненты.Вставить("ПортУказан", РазобранныеХостИПорт.ПортУказан);
	Компоненты.Вставить("ТекстПорта", РазобранныеХостИПорт.ТекстПорта);

	Возврат Компоненты;

КонецФункции

// Разбирает декодированный хост, включая IPv6 без квадратных скобок.
//
// Параметры:
//  Значение - Строка - Декодированный хост.
//
// Возвращаемое значение:
//  Структура - Кодированный хост и его синтаксический вид.
//
// Исключения:
//  url.invalid_host - Хост имеет недопустимый синтаксис.
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Функция РазобратьДекодированныйХост(Значение) Экспорт

	ПодготовленныйХост = ПодготовитьДекодированныйХост(Значение);
	ПодготовленныйХост.Вставить(
		"Представление",
		ПодготовитьПредставлениеХоста(Значение, ПодготовленныйХост.КодированныйХост)
	);
	Возврат ПодготовленныйХост;

КонецФункции

// Проверяет и возвращает допустимую схему URI.
//
// Параметры:
//  Значение - Строка - Проверяемая схема.
//
// Возвращаемое значение:
//  Строка - Исходная допустимая схема.
//
// Исключения:
//  url.invalid_scheme - Схема имеет недопустимый синтаксис.
Функция ПодготовитьСхему(Значение) Экспорт

	Если Не _ПроверяющийСинтаксисURI.ЭтоДопустимаяСхема(Значение) Тогда
		ВызватьНедопустимуюСхему();
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Кодирует данные пользователя и сохраняет допустимые символы исходного представления.
//
// Параметры:
//  Значение - Строка - Декодированные данные пользователя.
//
// Возвращаемое значение:
//  Структура - Кодированное значение и пользовательское представление.
//
// Исключения:
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Функция ПодготовитьДанныеПользователя(Значение) Экспорт

	Возврат ПодготовленныйКомпонент(
		КодированиеURL.КодироватьДанныеПользователя(Значение),
		ПодготовитьПредставлениеКомпонента(
			Значение,
			_ПроверяющийСинтаксисURI.ДопустимыеСимволыДанныхПользователя()
		)
	);

КонецФункции

// Проверяет кодированные данные пользователя.
//
// Параметры:
//  Значение - Строка - Данные пользователя в кодированном виде.
//
// Возвращаемое значение:
//  Структура - Проверенное кодированное значение и представление.
//
// Исключения:
//  url.invalid_authority - Значение имеет недопустимый синтаксис.
//  url.invalid_syntax - Значение содержит недопустимый символ.
//  url.invalid_percent_encoding - Процентное кодирование имеет недопустимый синтаксис.
Функция ПроверитьКодированныеДанныеПользователя(Значение) Экспорт

	Состояние = Новый URL("x://" + Значение + "@h/");

	Если Состояние.КодированныеДанныеПользователя() = Неопределено
		Или Состояние.КодированныеДанныеПользователя() <> Значение
		Или Состояние.КодированныйХост() <> "h"
		Или Состояние.КодированныйПуть() <> "/"
		Или Состояние.КодированнаяСтрокаЗапроса() <> Неопределено
		Или Состояние.КодированныйФрагмент() <> Неопределено Тогда
		ВызватьНедопустимуюСервернуюЧасть();
	КонецЕсли;

	Возврат ПодготовленныйКомпонент(Значение, Значение);

КонецФункции

// Проверяет кодированный хост и определяет его синтаксический вид.
//
// Параметры:
//  Значение - Строка - Хост в кодированном виде.
//
// Возвращаемое значение:
//  Структура - Проверенный хост, представление и синтаксический вид.
//
// Исключения:
//  url.invalid_host - Хост имеет недопустимый синтаксис.
//  url.invalid_syntax - Хост содержит символ вне ASCII.
//  url.invalid_percent_encoding - Процентное кодирование имеет недопустимый синтаксис.
Функция ПроверитьКодированныйХост(Значение) Экспорт

	ПроверитьASCIIИПроцентноеКодирование(Значение);
	ВидХоста = КлассифицироватьХост(Значение);

	Если ВидХоста = Неопределено Тогда
		ВызватьНедопустимыйХост();
	КонецЕсли;

	Возврат Новый Структура("КодированноеЗначение,Представление,ВидХоста", Значение, Значение, ВидХоста);

КонецФункции

// Приводит порт к проверенному текстовому представлению.
//
// Параметры:
//  Значение - Строка, Число - Порт в текстовом или числовом виде.
//
// Возвращаемое значение:
//  Строка - Проверенное текстовое представление порта.
//
// Исключения:
//  argument.invalid_value - Значение не является целым неотрицательным числом или строкой из цифр ASCII.
Функция ПодготовитьПорт(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		ПроверкаАргументов.ПроверитьДопустимость(
			"Значение",
			Значение >= 0 И Цел(Значение) = Значение,
			"целое неотрицательное число"
		);
		ТекстПорта = Формат(Значение, "ЧГ=0");
	Иначе
		ТекстПорта = Значение;
	КонецЕсли;

	ПроверкаАргументов.ПроверитьДопустимость(
		"Значение",
		_ПроверяющийСинтаксисURI.ТолькоЦифрыASCII(ТекстПорта),
		"строка из цифр ASCII"
	);

	Возврат ТекстПорта;

КонецФункции

// Кодирует декодированный путь.
//
// Параметры:
//  Значение - Строка - Декодированный путь.
//
// Возвращаемое значение:
//  Структура - Кодированный путь и пользовательское представление.
//
// Исключения:
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Функция ПодготовитьПуть(Значение) Экспорт

	Возврат ПодготовленныйКомпонент(
		КодированиеURL.КодироватьПуть(Значение),
		ПодготовитьПредставлениеКомпонента(Значение, _ПроверяющийСинтаксисURI.ДопустимыеСимволыПути())
	);

КонецФункции

// Проверяет кодированный путь.
//
// Параметры:
//  Значение - Строка - Путь в кодированном виде.
//
// Возвращаемое значение:
//  Структура - Проверенный кодированный путь и представление.
//
// Исключения:
//  url.invalid_syntax - Путь содержит недопустимый символ.
//  url.invalid_percent_encoding - Процентное кодирование имеет недопустимый синтаксис.
Функция ПроверитьКодированныйПуть(Значение) Экспорт

	Возврат ПроверитьКодированныйКомпонент(Значение, _ПроверяющийСинтаксисURI.ДопустимыеСимволыПути());

КонецФункции

// Кодирует декодированный сегмент пути.
//
// Параметры:
//  Значение - Строка - Декодированный сегмент пути.
//
// Возвращаемое значение:
//  Структура - Кодированный сегмент и пользовательское представление.
//
// Исключения:
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Функция ПодготовитьСегментПути(Значение) Экспорт

	Возврат ПодготовленныйКомпонент(
		КодированиеURL.КодироватьСегментПути(Значение),
		ПодготовитьПредставлениеКомпонента(
			Значение,
			_ПроверяющийСинтаксисURI.ДопустимыеСимволыСегментаПути()
		)
	);

КонецФункции

// Кодирует декодированный запрос.
//
// Параметры:
//  Значение - Строка - Декодированный запрос.
//
// Возвращаемое значение:
//  Структура - Кодированный запрос и пользовательское представление.
//
// Исключения:
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Функция ПодготовитьЗапрос(Значение) Экспорт

	Возврат ПодготовленныйКомпонент(
		КодированиеURL.КодироватьСтрокуЗапроса(Значение),
		ПодготовитьПредставлениеКомпонента(
			Значение,
			_ПроверяющийСинтаксисURI.ДопустимыеСимволыЗапросаИФрагмента(),
			Истина
		)
	);

КонецФункции

// Проверяет кодированный запрос.
//
// Параметры:
//  Значение - Строка - Запрос в кодированном виде.
//
// Возвращаемое значение:
//  Структура - Проверенный кодированный запрос и представление.
//
// Исключения:
//  url.invalid_syntax - Запрос содержит недопустимый символ.
//  url.invalid_percent_encoding - Процентное кодирование имеет недопустимый синтаксис.
Функция ПроверитьКодированныйЗапрос(Значение) Экспорт

	Возврат ПроверитьКодированныйКомпонент(
		Значение,
		_ПроверяющийСинтаксисURI.ДопустимыеСимволыЗапросаИФрагмента()
	);

КонецФункции

// Кодирует декодированный фрагмент.
//
// Параметры:
//  Значение - Строка - Декодированный фрагмент.
//
// Возвращаемое значение:
//  Структура - Кодированный фрагмент и пользовательское представление.
//
// Исключения:
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Функция ПодготовитьФрагмент(Значение) Экспорт

	Возврат ПодготовленныйКомпонент(
		КодированиеURL.КодироватьФрагмент(Значение),
		ПодготовитьПредставлениеКомпонента(
			Значение,
			_ПроверяющийСинтаксисURI.ДопустимыеСимволыЗапросаИФрагмента()
		)
	);

КонецФункции

// Проверяет кодированный фрагмент.
//
// Параметры:
//  Значение - Строка - Фрагмент в кодированном виде.
//
// Возвращаемое значение:
//  Структура - Проверенный кодированный фрагмент и представление.
//
// Исключения:
//  url.invalid_syntax - Фрагмент содержит недопустимый символ.
//  url.invalid_percent_encoding - Процентное кодирование имеет недопустимый синтаксис.
Функция ПроверитьКодированныйФрагмент(Значение) Экспорт

	Возврат ПроверитьКодированныйКомпонент(
		Значение,
		_ПроверяющийСинтаксисURI.ДопустимыеСимволыЗапросаИФрагмента()
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьДекодированныеХостИПорт(Значение)

	ПортУказан = Ложь;
	ТекстПорта = Неопределено;

	Если Лев(Значение, 1) = "[" Тогда
		ПозицияЗакрывающейСкобки = СтрНайти(Значение, "]");

		Если ПозицияЗакрывающейСкобки = 0 Тогда
			ВызватьНедопустимуюСервернуюЧасть();
		КонецЕсли;

		Хост = Лев(Значение, ПозицияЗакрывающейСкобки);
		Остаток = Сред(Значение, ПозицияЗакрывающейСкобки + 1);

		Если Остаток <> "" Тогда
			Если Лев(Остаток, 1) <> ":" Тогда
				ВызватьНедопустимуюСервернуюЧасть();
			КонецЕсли;

			ПортУказан = Истина;
			ТекстПорта = Сред(Остаток, 2);
		КонецЕсли;
	Иначе
		Если СтрНайти(Значение, "[") > 0 Или СтрНайти(Значение, "]") > 0
			Или КоличествоСимволов(Значение, ":") > 1 Тогда
			ВызватьНедопустимуюСервернуюЧасть();
		КонецЕсли;

		ПозицияПорта = СтрНайти(Значение, ":");

		Если ПозицияПорта = 0 Тогда
			Хост = Значение;
		Иначе
			Хост = Лев(Значение, ПозицияПорта - 1);
			ПортУказан = Истина;
			ТекстПорта = Сред(Значение, ПозицияПорта + 1);
		КонецЕсли;
	КонецЕсли;

	Если Не _ПроверяющийСинтаксисURI.ТолькоЦифрыASCII(ТекстПорта) Тогда
		ВызватьНедопустимуюСервернуюЧасть();
	КонецЕсли;

	ПодготовленныйХост = ПодготовитьДекодированныйХост(Хост);
	ПредставлениеХоста = ?(
		_ПроверяющийСинтаксисURI.СодержитСимволыВнеASCII(Хост),
		ПодготовитьПредставлениеКомпонента(Хост, _ПроверяющийСинтаксисURI.ДопустимыеСимволыЗарегистрированногоИмени()),
		ПодготовленныйХост.КодированныйХост
	);

	Возврат Новый Структура(
		"КодированныйХост,ПредставлениеХоста,ВидХоста,ПортУказан,ТекстПорта",
		ПодготовленныйХост.КодированныйХост,
		ПредставлениеХоста,
		ПодготовленныйХост.ВидХоста,
		ПортУказан,
		ТекстПорта
	);

КонецФункции

Функция ПодготовитьДекодированныйХост(Значение)

	ЕстьОткрывающаяСкобка = Лев(Значение, 1) = "[";
	ЕстьЗакрывающаяСкобка = Прав(Значение, 1) = "]";

	Если ЕстьОткрывающаяСкобка Или ЕстьЗакрывающаяСкобка Тогда
		Если Не (ЕстьОткрывающаяСкобка И ЕстьЗакрывающаяСкобка) Тогда
			ВызватьНедопустимыйХост();
		КонецЕсли;

		КодированныйХост = Значение;
		ВидХоста = КлассифицироватьХост(КодированныйХост);
	ИначеЕсли СтрНайти(Значение, ":") > 0 Тогда
		КодированныйХост = "[" + Значение + "]";
		ВидХоста = КлассифицироватьХост(КодированныйХост);

		Если ВидХоста <> ВидыХостаURL.IPv6() Тогда
			ВызватьНедопустимыйХост();
		КонецЕсли;
	Иначе
		_КодировщикКомпонентаIRI.Проверить(Значение);

		КодированныйХост = _КодировщикКомпонентовURI.Кодировать(
			Значение,
			_ПроверяющийСинтаксисURI.ДопустимыеСимволыЗарегистрированногоИмени()
		);
		ВидХоста = КлассифицироватьХост(КодированныйХост);
	КонецЕсли;

	Если ВидХоста = Неопределено Тогда
		ВызватьНедопустимыйХост();
	КонецЕсли;

	Возврат Новый Структура("КодированныйХост,ВидХоста", КодированныйХост, ВидХоста);

КонецФункции

Функция КоличествоСимволов(Значение, ИскомыйСимвол)

	Результат = 0;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если Сред(Значение, Индекс, 1) = ИскомыйСимвол Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПодготовленныйКомпонент(КодированноеЗначение, Представление)

	Возврат Новый Структура(
		"КодированноеЗначение,Представление",
		КодированноеЗначение,
		Представление
	);

КонецФункции

Функция ПроверитьКодированныйКомпонент(Значение, РазрешенныеСимволы)

	ПроверитьASCIIИПроцентноеКодирование(Значение);
	Индекс = 1;

	Пока Индекс <= СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);

		Если Символ = "%" Тогда
			Индекс = Индекс + 3;
		ИначеЕсли СтрНайти(РазрешенныеСимволы, Символ) = 0 Тогда
			ВызватьНедопустимыйСинтаксис();
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат ПодготовленныйКомпонент(Значение, Значение);

КонецФункции

Процедура ПроверитьASCIIИПроцентноеКодирование(Значение)

	Индекс = 1;

	Пока Индекс <= СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);

		Если КодСимвола(Символ) > 127 Тогда
			ВызватьНедопустимыйСинтаксис();
		КонецЕсли;

		Если Символ = "%" Тогда
			Если Индекс + 2 > СтрДлина(Значение)
				Или Не _ПроверяющийСинтаксисURI.ЭтоШестнадцатеричныйСимвол(Сред(Значение, Индекс + 1, 1))
				Или Не _ПроверяющийСинтаксисURI.ЭтоШестнадцатеричныйСимвол(Сред(Значение, Индекс + 2, 1)) Тогда
				ВызватьНедопустимоеПроцентноеКодирование();
			КонецЕсли;

			Индекс = Индекс + 3;
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПодготовитьПредставлениеКомпонента(
	Значение,
	РазрешенныеСимволы,
	РазрешитьЧастныеКодовыеТочки = Ложь
)

	_КодировщикКомпонентаIRI.Проверить(Значение, РазрешитьЧастныеКодовыеТочки);

	Фрагменты = Новый Массив;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);
		Код = КодСимвола(Символ);

		Если Код > 127 Или СтрНайти(РазрешенныеСимволы, Символ) > 0 Тогда
			Фрагменты.Добавить(Символ);
		Иначе
			Фрагменты.Добавить("%" + _КодировщикКомпонентовURI.ШестнадцатеричноеПредставлениеБайта(Код));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Функция ПодготовитьПредставлениеХоста(Значение, КодированныйХост)

	Если _ПроверяющийСинтаксисURI.СодержитСимволыВнеASCII(Значение) Тогда
		Возврат ПодготовитьПредставлениеКомпонента(
			Значение,
			_ПроверяющийСинтаксисURI.ДопустимыеСимволыЗарегистрированногоИмени()
		);
	КонецЕсли;

	Возврат КодированныйХост;

КонецФункции

Функция КлассифицироватьХост(КодированныйХост)

	Возврат _КлассификаторХостаURI.Классифицировать(КодированныйХост);

КонецФункции

Процедура ВызватьНедопустимуюСервернуюЧасть()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимаяСервернаяЧасть(),
		"Недопустимая серверная часть URL"
	);

КонецПроцедуры

Процедура ВызватьНедопустимыйХост()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыйХост(),
		"Недопустимый хост URL"
	);

КонецПроцедуры

Процедура ВызватьНедопустимуюСхему()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимаяСхема(),
		"Недопустимая схема URL"
	);

КонецПроцедуры

Процедура ВызватьНедопустимыйСинтаксис()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыйСинтаксис(),
		"Недопустимый синтаксис URL"
	);

КонецПроцедуры

Процедура ВызватьНедопустимоеПроцентноеКодирование()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимоеПроцентноеКодирование(),
		"Недопустимое процентное кодирование URL"
	);

КонецПроцедуры

#КонецОбласти
