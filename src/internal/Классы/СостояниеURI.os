#Использовать errors

Перем _Схема; // Строка, Неопределено
Перем _СервернаяЧастьОпределена; // Булево
Перем _ДанныеПользователяОпределены; // Булево
Перем _КодированныеДанныеПользователя; // Строка, Неопределено
Перем _КодированныйХост; // Строка, Неопределено
Перем _ВидХоста; // Строка, Неопределено
Перем _ПортУказан; // Булево
Перем _ТекстПорта; // Строка, Неопределено
Перем _КодированныйПуть; // Строка
Перем _ЗапросОпределен; // Булево
Перем _КодированныйЗапрос; // Строка, Неопределено
Перем _ФрагментОпределен; // Булево
Перем _КодированныйФрагмент; // Строка, Неопределено

#Область ОбработчикиСобытий

// Создаёт внутреннее состояние URI-ссылки, позволяющее восстановить её без потерь.
//
// Параметры:
//  Схема - Строка, Неопределено - Схема в исходном написании.
//  СервернаяЧастьОпределена - Булево - Признак разделителя //.
//  ДанныеПользователяОпределены - Булево - Признак разделителя @.
//  КодированныеДанныеПользователя - Строка, Неопределено - Кодированные данные пользователя.
//  КодированныйХост - Строка, Неопределено - Кодированный хост.
//  ВидХоста - Строка, Неопределено - Классифицированный вид хоста.
//  ПортУказан - Булево - Признак разделителя : порта.
//  ТекстПорта - Строка, Неопределено - Текст порта в исходном написании.
//  КодированныйПуть - Строка - Кодированный путь.
//  ЗапросОпределен - Булево - Признак разделителя ?.
//  КодированныйЗапрос - Строка, Неопределено - Кодированный запрос.
//  ФрагментОпределен - Булево - Признак разделителя #.
//  КодированныйФрагмент - Строка, Неопределено - Кодированный фрагмент.
Процедура ПриСозданииОбъекта(
	Схема,
	СервернаяЧастьОпределена,
	ДанныеПользователяОпределены,
	КодированныеДанныеПользователя,
	КодированныйХост,
	ВидХоста,
	ПортУказан,
	ТекстПорта,
	КодированныйПуть,
	ЗапросОпределен,
	КодированныйЗапрос,
	ФрагментОпределен,
	КодированныйФрагмент
)

	_Схема = Схема;
	_СервернаяЧастьОпределена = СервернаяЧастьОпределена;
	_ДанныеПользователяОпределены = ДанныеПользователяОпределены;
	_КодированныеДанныеПользователя = КодированныеДанныеПользователя;
	_КодированныйХост = КодированныйХост;
	_ВидХоста = ВидХоста;
	_ПортУказан = ПортУказан;
	_ТекстПорта = ТекстПорта;
	_КодированныйПуть = КодированныйПуть;
	_ЗапросОпределен = ЗапросОпределен;
	_КодированныйЗапрос = КодированныйЗапрос;
	_ФрагментОпределен = ФрагментОпределен;
	_КодированныйФрагмент = КодированныйФрагмент;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Сериализует URI-ссылку из исходных компонентов и признаков наличия разделителей.
//
// Возвращаемое значение:
//  Строка - URI-ссылка в исходном написании, восстановленная без потерь.
Функция ВСтроку() Экспорт

	Результат = "";
	Если _Схема <> Неопределено Тогда
		Результат = _Схема + ":";
	КонецЕсли;

	Если _СервернаяЧастьОпределена Тогда
		Результат = Результат + "//";

		Если _ДанныеПользователяОпределены Тогда
			Результат = Результат + _КодированныеДанныеПользователя + "@";
		КонецЕсли;

		Результат = Результат + _КодированныйХост;

		Если _ПортУказан Тогда
			Результат = Результат + ":" + _ТекстПорта;
		КонецЕсли;
	КонецЕсли;

	Результат = Результат + _КодированныйПуть;
	Если _ЗапросОпределен Тогда
		Результат = Результат + "?" + _КодированныйЗапрос;
	КонецЕсли;

	Если _ФрагментОпределен Тогда
		Результат = Результат + "#" + _КодированныйФрагмент;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает схему в исходном написании.
//
// Возвращаемое значение:
//  Строка, Неопределено - Схема или Неопределено для относительной ссылки.
Функция Схема() Экспорт

	Возврат _Схема;

КонецФункции

// Проверяет наличие серверной части.
//
// Возвращаемое значение:
//  Булево - Истина, если разделитель // присутствует.
Функция СервернаяЧастьОпределена() Экспорт

	Возврат _СервернаяЧастьОпределена;

КонецФункции

// Возвращает серверную часть в исходном написании без начального //.
//
// Возвращаемое значение:
//  Строка, Неопределено - Серверная часть или Неопределено при её отсутствии.
Функция КодированнаяСервернаяЧасть() Экспорт

	Если Не _СервернаяЧастьОпределена Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = "";

	Если _ДанныеПользователяОпределены Тогда
		Результат = _КодированныеДанныеПользователя + "@";
	КонецЕсли;

	Результат = Результат + _КодированныйХост;

	Если _ПортУказан Тогда
		Результат = Результат + ":" + _ТекстПорта;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверяет наличие данных пользователя.
//
// Возвращаемое значение:
//  Булево - Истина, если разделитель @ присутствует.
Функция ДанныеПользователяОпределены() Экспорт

	Возврат _ДанныеПользователяОпределены;

КонецФункции

// Возвращает кодированные данные пользователя без @.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированные данные пользователя или Неопределено при их отсутствии.
Функция КодированныеДанныеПользователя() Экспорт

	Если Не _ДанныеПользователяОпределены Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _КодированныеДанныеПользователя;

КонецФункции

// Возвращает кодированный хост.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированный хост или Неопределено при отсутствии серверной части.
Функция КодированныйХост() Экспорт

	Если Не _СервернаяЧастьОпределена Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _КодированныйХост;

КонецФункции

// Проверяет наличие текста порта.
//
// Возвращаемое значение:
//  Булево - Истина, если разделитель : порта присутствует.
Функция ПортУказан() Экспорт

	Возврат _ПортУказан;

КонецФункции

// Возвращает исходный текст порта без :.
//
// Возвращаемое значение:
//  Строка, Неопределено - Текст порта или Неопределено при отсутствии разделителя :.
Функция ТекстПорта() Экспорт

	Если Не _ПортУказан Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _ТекстПорта;

КонецФункции

// Возвращает кодированный путь.
//
// Возвращаемое значение:
//  Строка - Всегда определённый кодированный путь.
Функция КодированныйПуть() Экспорт

	Возврат _КодированныйПуть;

КонецФункции

// Возвращает кодированный запрос без ?.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированный запрос или Неопределено при отсутствии ?.
Функция КодированныйЗапрос() Экспорт

	Если Не _ЗапросОпределен Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _КодированныйЗапрос;

КонецФункции

// Возвращает кодированный фрагмент без #.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированный фрагмент или Неопределено при отсутствии #.
Функция КодированныйФрагмент() Экспорт

	Если Не _ФрагментОпределен Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _КодированныйФрагмент;

КонецФункции

// Создаёт независимую копию внутреннего состояния.
//
// Возвращаемое значение:
//  СостояниеURI - Независимое состояние с теми же исходными компонентами.
Функция Скопировать() Экспорт

	Возврат Новый СостояниеURI(
		_Схема,
		_СервернаяЧастьОпределена,
		_ДанныеПользователяОпределены,
		_КодированныеДанныеПользователя,
		_КодированныйХост,
		_ВидХоста,
		_ПортУказан,
		_ТекстПорта,
		_КодированныйПуть,
		_ЗапросОпределен,
		_КодированныйЗапрос,
		_ФрагментОпределен,
		_КодированныйФрагмент
	);

КонецФункции

// Проверяет согласованность внутреннего состояния и инварианты серверной части и пути по RFC 3986.
//
// Параметры:
//  ТребоватьАбсолютный - Булево - Требовать определённую схему.
Процедура ПроверитьИнварианты(ТребоватьАбсолютный = Ложь) Экспорт

	ПроверитьОбщиеИнварианты(ТребоватьАбсолютный);

	Если _СервернаяЧастьОпределена Тогда
		ПроверитьИнвариантыСервернойЧасти();
	Иначе
		ПроверитьИнвариантыБезСервернойЧасти();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОбщиеИнварианты(ТребоватьАбсолютный)

	Если Не ЭтоСтрока(_КодированныйПуть)
		Или Не ЭтоБулево(_СервернаяЧастьОпределена)
		Или Не ЭтоБулево(_ДанныеПользователяОпределены)
		Или Не ЭтоБулево(_ПортУказан)
		Или Не ЭтоБулево(_ЗапросОпределен)
		Или Не ЭтоБулево(_ФрагментОпределен) Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	ПроверитьСогласованностьОпциональногоКомпонента(_Схема, _Схема <> Неопределено);
	ПроверитьСогласованностьОпциональногоКомпонента(
		_КодированныеДанныеПользователя,
		_ДанныеПользователяОпределены
	);
	ПроверитьСогласованностьОпциональногоКомпонента(_ТекстПорта, _ПортУказан);
	ПроверитьСогласованностьОпциональногоКомпонента(_КодированныйЗапрос, _ЗапросОпределен);
	ПроверитьСогласованностьОпциональногоКомпонента(_КодированныйФрагмент, _ФрагментОпределен);

	Если _Схема <> Неопределено И _Схема = "" Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	Если ТребоватьАбсолютный И _Схема = Неопределено Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИнвариантыСервернойЧасти()

	Если Не ЭтоСтрока(_КодированныйХост) Или Не ЭтоСтрока(_ВидХоста) Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	Если КлассификаторХостаURI.Классифицировать(_КодированныйХост) <> _ВидХоста Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	Если Не ЭтоТекстПорта(_ТекстПорта) Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	Если _КодированныйПуть <> "" И Лев(_КодированныйПуть, 1) <> "/" Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИнвариантыБезСервернойЧасти()

	Если _КодированныйХост <> Неопределено
		Или _ВидХоста <> Неопределено
		Или _ДанныеПользователяОпределены
		Или _ПортУказан
		Или Лев(_КодированныйПуть, 2) = "//" Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	ПроверитьОтносительныйПутьБезСхемы();

КонецПроцедуры

Процедура ПроверитьСогласованностьОпциональногоКомпонента(Значение, Определен)

	Если Определен И Не ЭтоСтрока(Значение) Или Не Определен И Значение <> Неопределено Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОтносительныйПутьБезСхемы()

	Если _Схема <> Неопределено Или Лев(_КодированныйПуть, 1) = "/" Тогда
		Возврат;
	КонецЕсли;

	ПозицияСлеша = СтрНайти(_КодированныйПуть, "/");
	Если ПозицияСлеша = 0 Тогда
		ПервыйСегмент = _КодированныйПуть;
	Иначе
		ПервыйСегмент = Лев(_КодированныйПуть, ПозицияСлеша - 1);
	КонецЕсли;
	Если СтрНайти(ПервыйСегмент, ":") > 0 Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

КонецПроцедуры

Функция ЭтоСтрока(Значение)

	Возврат ТипЗнч(Значение) = Тип("Строка");

КонецФункции

Функция ЭтоТекстПорта(Значение)

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоБулево(Значение)

	Возврат ТипЗнч(Значение) = Тип("Булево");

КонецФункции

Процедура ВызватьНедопустимоеСостояние()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыйСинтаксисURI(),
		"Недопустимое внутреннее состояние URI"
	);

КонецПроцедуры

#КонецОбласти
