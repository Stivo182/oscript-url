#Использовать errors

Перем _Схема; // Строка, Неопределено
Перем _СервернаяЧастьОпределена; // Булево
Перем _ДанныеПользователяОпределены; // Булево
Перем _КодированныеДанныеПользователя; // Строка, Неопределено
Перем _КодированныйХост; // Строка, Неопределено
Перем _ВидХоста; // Строка, Неопределено
Перем _ПортУказан; // Булево
Перем _ТекстПорта; // Строка, Неопределено
Перем _КодированныйПуть; // Строка
Перем _ЗапросОпределен; // Булево
Перем _КодированныйЗапрос; // Строка, Неопределено
Перем _ФрагментОпределен; // Булево
Перем _КодированныйФрагмент; // Строка, Неопределено
Перем _ПредставлениеДанныхПользователя; // Строка, Неопределено
Перем _ПредставлениеХоста; // Строка, Неопределено
Перем _ПредставлениеПути; // Строка
Перем _ПредставлениеЗапроса; // Строка, Неопределено
Перем _ПредставлениеФрагмента; // Строка, Неопределено

#Область ОбработчикиСобытий

// Создаёт внутреннее состояние URI-ссылки, позволяющее восстановить её без потерь.
//
// Параметры:
//  Компоненты - Структура - Кодированные компоненты, признаки разделителей и исходные
//   представления компонентов.
Процедура ПриСозданииОбъекта(Компоненты)

	_Схема = Компоненты.Схема;
	_СервернаяЧастьОпределена = Компоненты.СервернаяЧастьОпределена;
	_ДанныеПользователяОпределены = Компоненты.ДанныеПользователяОпределены;
	_КодированныеДанныеПользователя = Компоненты.КодированныеДанныеПользователя;
	_КодированныйХост = Компоненты.КодированныйХост;
	_ВидХоста = Компоненты.ВидХоста;
	_ПортУказан = Компоненты.ПортУказан;
	_ТекстПорта = Компоненты.ТекстПорта;
	_КодированныйПуть = Компоненты.КодированныйПуть;
	_ЗапросОпределен = Компоненты.ЗапросОпределен;
	_КодированныйЗапрос = Компоненты.КодированныйЗапрос;
	_ФрагментОпределен = Компоненты.ФрагментОпределен;
	_КодированныйФрагмент = Компоненты.КодированныйФрагмент;
	_ПредставлениеДанныхПользователя = ЗначениеИлиПоУмолчанию(
		ЗначениеСвойства(Компоненты, "ПредставлениеДанныхПользователя"),
		_КодированныеДанныеПользователя
	);
	_ПредставлениеХоста = ЗначениеИлиПоУмолчанию(
		ЗначениеСвойства(Компоненты, "ПредставлениеХоста"),
		_КодированныйХост
	);
	_ПредставлениеПути = ЗначениеИлиПоУмолчанию(
		ЗначениеСвойства(Компоненты, "ПредставлениеПути"),
		_КодированныйПуть
	);
	_ПредставлениеЗапроса = ЗначениеИлиПоУмолчанию(
		ЗначениеСвойства(Компоненты, "ПредставлениеЗапроса"),
		_КодированныйЗапрос
	);
	_ПредставлениеФрагмента = ЗначениеИлиПоУмолчанию(
		ЗначениеСвойства(Компоненты, "ПредставлениеФрагмента"),
		_КодированныйФрагмент
	);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Сериализует URI-ссылку из исходных компонентов и признаков наличия разделителей.
//
// Возвращаемое значение:
//  Строка - URI-ссылка в исходном написании, восстановленная без потерь.
Функция ВСтроку() Экспорт

	Фрагменты = Новый Массив;

	Если _Схема <> Неопределено Тогда
		Фрагменты.Добавить(_Схема);
		Фрагменты.Добавить(":");
	КонецЕсли;

	Если _СервернаяЧастьОпределена Тогда
		Фрагменты.Добавить("//");

		Если _ДанныеПользователяОпределены Тогда
			Фрагменты.Добавить(_ПредставлениеДанныхПользователя);
			Фрагменты.Добавить("@");
		КонецЕсли;

		Фрагменты.Добавить(_ПредставлениеХоста);

		Если _ПортУказан Тогда
			Фрагменты.Добавить(":");
			Фрагменты.Добавить(_ТекстПорта);
		КонецЕсли;
	КонецЕсли;

	Фрагменты.Добавить(_ПредставлениеПути);

	Если _ЗапросОпределен Тогда
		Фрагменты.Добавить("?");
		Фрагменты.Добавить(_ПредставлениеЗапроса);
	КонецЕсли;

	Если _ФрагментОпределен Тогда
		Фрагменты.Добавить("#");
		Фрагменты.Добавить(_ПредставлениеФрагмента);
	КонецЕсли;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

// Сериализует URI-ссылку в ASCII-представление.
//
// Возвращаемое значение:
//  Строка - URI-ссылка из ASCII-символов.
Функция КодированноеПредставление() Экспорт

	Возврат Новый СостояниеURI(КомпонентыСостояния()).ВСтроку();

КонецФункции

// Возвращает схему в исходном написании.
//
// Возвращаемое значение:
//  Строка, Неопределено - Схема или Неопределено для относительной ссылки.
Функция Схема() Экспорт

	Возврат _Схема;

КонецФункции

// Проверяет наличие серверной части.
//
// Возвращаемое значение:
//  Булево - Истина, если разделитель // присутствует.
Функция СервернаяЧастьОпределена() Экспорт

	Возврат _СервернаяЧастьОпределена;

КонецФункции

// Возвращает кодированную серверную часть без начального //.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированная серверная часть или Неопределено при её отсутствии.
Функция КодированнаяСервернаяЧасть() Экспорт

	Если Не _СервернаяЧастьОпределена Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = "";

	Если _ДанныеПользователяОпределены Тогда
		Результат = _КодированныеДанныеПользователя + "@";
	КонецЕсли;

	Результат = Результат + _КодированныйХост;

	Если _ПортУказан Тогда
		Результат = Результат + ":" + _ТекстПорта;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает серверную часть в пользовательском представлении без начального //.
//
// Возвращаемое значение:
//  Строка, Неопределено - Серверная часть или Неопределено при её отсутствии.
Функция ПредставлениеСервернойЧасти() Экспорт

	Если Не _СервернаяЧастьОпределена Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = "";

	Если _ДанныеПользователяОпределены Тогда
		Результат = _ПредставлениеДанныхПользователя + "@";
	КонецЕсли;

	Результат = Результат + _ПредставлениеХоста;

	Если _ПортУказан Тогда
		Результат = Результат + ":" + _ТекстПорта;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверяет наличие данных пользователя.
//
// Возвращаемое значение:
//  Булево - Истина, если разделитель @ присутствует.
Функция ДанныеПользователяОпределены() Экспорт

	Возврат _ДанныеПользователяОпределены;

КонецФункции

// Возвращает кодированные данные пользователя без @.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированные данные пользователя или Неопределено при их отсутствии.
Функция КодированныеДанныеПользователя() Экспорт

	Если Не _ДанныеПользователяОпределены Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _КодированныеДанныеПользователя;

КонецФункции

// Возвращает представление данных пользователя.
//
// Возвращаемое значение:
//  Строка, Неопределено - Исходное написание или Неопределено при отсутствии данных пользователя.
Функция ПредставлениеДанныхПользователя() Экспорт

	Если Не _ДанныеПользователяОпределены Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _ПредставлениеДанныхПользователя;

КонецФункции

// Возвращает кодированный хост.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированный хост или Неопределено при отсутствии серверной части.
Функция КодированныйХост() Экспорт

	Если Не _СервернаяЧастьОпределена Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _КодированныйХост;

КонецФункции

// Возвращает представление хоста для пользователя.
//
// Возвращаемое значение:
//  Строка, Неопределено - Хост в исходном написании или Неопределено без серверной части.
Функция ПредставлениеХоста() Экспорт

	Если Не _СервернаяЧастьОпределена Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _ПредставлениеХоста;

КонецФункции

// Проверяет наличие текста порта.
//
// Возвращаемое значение:
//  Булево - Истина, если разделитель : порта присутствует.
Функция ПортУказан() Экспорт

	Возврат _ПортУказан;

КонецФункции

// Возвращает исходный текст порта без :.
//
// Возвращаемое значение:
//  Строка, Неопределено - Текст порта или Неопределено при отсутствии разделителя :.
Функция ТекстПорта() Экспорт

	Если Не _ПортУказан Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _ТекстПорта;

КонецФункции

// Возвращает кодированный путь.
//
// Возвращаемое значение:
//  Строка - Всегда определённый кодированный путь.
Функция КодированныйПуть() Экспорт

	Возврат _КодированныйПуть;

КонецФункции

// Возвращает представление пути для пользователя.
//
// Возвращаемое значение:
//  Строка - Путь в исходном написании.
Функция ПредставлениеПути() Экспорт

	Возврат _ПредставлениеПути;

КонецФункции

// Возвращает кодированный запрос без ?.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированный запрос или Неопределено при отсутствии ?.
Функция КодированныйЗапрос() Экспорт

	Если Не _ЗапросОпределен Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _КодированныйЗапрос;

КонецФункции

// Возвращает представление запроса.
//
// Возвращаемое значение:
//  Строка, Неопределено - Исходное написание или Неопределено при отсутствии запроса.
Функция ПредставлениеЗапроса() Экспорт

	Если Не _ЗапросОпределен Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _ПредставлениеЗапроса;

КонецФункции

// Возвращает кодированный фрагмент без #.
//
// Возвращаемое значение:
//  Строка, Неопределено - Кодированный фрагмент или Неопределено при отсутствии #.
Функция КодированныйФрагмент() Экспорт

	Если Не _ФрагментОпределен Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _КодированныйФрагмент;

КонецФункции

// Возвращает представление фрагмента.
//
// Возвращаемое значение:
//  Строка, Неопределено - Исходное написание или Неопределено при отсутствии фрагмента.
Функция ПредставлениеФрагмента() Экспорт

	Если Не _ФрагментОпределен Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _ПредставлениеФрагмента;

КонецФункции

// Создаёт независимую копию внутреннего состояния.
//
// Возвращаемое значение:
//  СостояниеURI - Независимое состояние с теми же исходными компонентами.
Функция Скопировать() Экспорт

	Возврат Новый СостояниеURI(КомпонентыСостояния(Истина));

КонецФункции

// Проверяет согласованность внутреннего состояния и инварианты серверной части и пути по RFC 3986.
//
// Параметры:
//  ТребоватьАбсолютный - Булево - Требовать определённую схему.
Процедура ПроверитьИнварианты(ТребоватьАбсолютный = Ложь) Экспорт

	ПроверитьОбщиеИнварианты(ТребоватьАбсолютный);

	Если _СервернаяЧастьОпределена Тогда
		ПроверитьИнвариантыСервернойЧасти();
	Иначе
		ПроверитьИнвариантыБезСервернойЧасти();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КомпонентыСостояния(ВключитьПредставления = Ложь)

	Компоненты = Новый Структура;
	Компоненты.Вставить("Схема", _Схема);
	Компоненты.Вставить("СервернаяЧастьОпределена", _СервернаяЧастьОпределена);
	Компоненты.Вставить("ДанныеПользователяОпределены", _ДанныеПользователяОпределены);
	Компоненты.Вставить("КодированныеДанныеПользователя", _КодированныеДанныеПользователя);
	Компоненты.Вставить("КодированныйХост", _КодированныйХост);
	Компоненты.Вставить("ВидХоста", _ВидХоста);
	Компоненты.Вставить("ПортУказан", _ПортУказан);
	Компоненты.Вставить("ТекстПорта", _ТекстПорта);
	Компоненты.Вставить("КодированныйПуть", _КодированныйПуть);
	Компоненты.Вставить("ЗапросОпределен", _ЗапросОпределен);
	Компоненты.Вставить("КодированныйЗапрос", _КодированныйЗапрос);
	Компоненты.Вставить("ФрагментОпределен", _ФрагментОпределен);
	Компоненты.Вставить("КодированныйФрагмент", _КодированныйФрагмент);

	Если ВключитьПредставления Тогда
		Компоненты.Вставить("ПредставлениеДанныхПользователя", _ПредставлениеДанныхПользователя);
		Компоненты.Вставить("ПредставлениеХоста", _ПредставлениеХоста);
		Компоненты.Вставить("ПредставлениеПути", _ПредставлениеПути);
		Компоненты.Вставить("ПредставлениеЗапроса", _ПредставлениеЗапроса);
		Компоненты.Вставить("ПредставлениеФрагмента", _ПредставлениеФрагмента);
	КонецЕсли;

	Возврат Компоненты;

КонецФункции

Функция ЗначениеСвойства(Компоненты, ИмяСвойства)

	Значение = Неопределено;
	Компоненты.Свойство(ИмяСвойства, Значение);
	Возврат Значение;

КонецФункции

Процедура ПроверитьОбщиеИнварианты(ТребоватьАбсолютный)

	Если Не ЭтоСтрока(_КодированныйПуть)
		Или Не ЭтоСтрока(_ПредставлениеПути)
		Или Не ЭтоБулево(_СервернаяЧастьОпределена)
		Или Не ЭтоБулево(_ДанныеПользователяОпределены)
		Или Не ЭтоБулево(_ПортУказан)
		Или Не ЭтоБулево(_ЗапросОпределен)
		Или Не ЭтоБулево(_ФрагментОпределен) Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	ПроверитьСогласованностьОпциональногоКомпонента(_Схема, _Схема <> Неопределено);
	ПроверитьСогласованностьОпциональногоКомпонента(
		_КодированныеДанныеПользователя,
		_ДанныеПользователяОпределены
	);
	ПроверитьСогласованностьОпциональногоКомпонента(
		_ПредставлениеДанныхПользователя,
		_ДанныеПользователяОпределены
	);
	ПроверитьСогласованностьОпциональногоКомпонента(_ТекстПорта, _ПортУказан);
	ПроверитьСогласованностьОпциональногоКомпонента(_КодированныйЗапрос, _ЗапросОпределен);
	ПроверитьСогласованностьОпциональногоКомпонента(_ПредставлениеЗапроса, _ЗапросОпределен);
	ПроверитьСогласованностьОпциональногоКомпонента(_КодированныйФрагмент, _ФрагментОпределен);
	ПроверитьСогласованностьОпциональногоКомпонента(_ПредставлениеФрагмента, _ФрагментОпределен);

	Если _Схема <> Неопределено И _Схема = "" Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	Если ТребоватьАбсолютный И _Схема = Неопределено Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеИлиПоУмолчанию(Значение, ЗначениеПоУмолчанию)

	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Процедура ПроверитьИнвариантыСервернойЧасти()

	Если Не ЭтоСтрока(_КодированныйХост)
		Или Не ЭтоСтрока(_ПредставлениеХоста)
		Или Не ЭтоСтрока(_ВидХоста) Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	Если КлассификаторХостаURI.Классифицировать(_КодированныйХост) <> _ВидХоста Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	Если Не ЭтоТекстПорта(_ТекстПорта) Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	Если _КодированныйПуть <> "" И Лев(_КодированныйПуть, 1) <> "/" Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИнвариантыБезСервернойЧасти()

	Если _КодированныйХост <> Неопределено
		Или _ПредставлениеХоста <> Неопределено
		Или _ВидХоста <> Неопределено
		Или _ДанныеПользователяОпределены
		Или _ПортУказан
		Или Лев(_КодированныйПуть, 2) = "//" Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

	ПроверитьОтносительныйПутьБезСхемы();

КонецПроцедуры

Процедура ПроверитьСогласованностьОпциональногоКомпонента(Значение, Определен)

	Если Определен И Не ЭтоСтрока(Значение) Или Не Определен И Значение <> Неопределено Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОтносительныйПутьБезСхемы()

	Если _Схема <> Неопределено Или Лев(_КодированныйПуть, 1) = "/" Тогда
		Возврат;
	КонецЕсли;

	ПозицияСлеша = СтрНайти(_КодированныйПуть, "/");

	Если ПозицияСлеша = 0 Тогда
		ПервыйСегмент = _КодированныйПуть;
	Иначе
		ПервыйСегмент = Лев(_КодированныйПуть, ПозицияСлеша - 1);
	КонецЕсли;

	Если СтрНайти(ПервыйСегмент, ":") > 0 Тогда
		ВызватьНедопустимоеСостояние();
	КонецЕсли;

КонецПроцедуры

Функция ЭтоСтрока(Значение)

	Возврат ТипЗнч(Значение) = Тип("Строка");

КонецФункции

Функция ЭтоТекстПорта(Значение)

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	// Коды ASCII: 0-9 - 48-57.
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Сред(Значение, Индекс, 1));

		Если Код < 48 Или Код > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоБулево(Значение)

	Возврат ТипЗнч(Значение) = Тип("Булево");

КонецФункции

Процедура ВызватьНедопустимоеСостояние()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыйСинтаксисURI(),
		"Недопустимое внутреннее состояние URI"
	);

КонецПроцедуры

#КонецОбласти
