#Использовать ip

Перем _ПроверяющийСинтаксисURI; // ПроверяющийСинтаксисURI

#Область ОбработчикиСобытий

// Создаёт классификатор хоста URI.
//
// Параметры:
//  ПроверяющийСинтаксисURI - ПроверяющийСинтаксисURI - Проверяющий синтаксис URI.
Процедура ПриСозданииОбъекта(ПроверяющийСинтаксисURI)

	_ПроверяющийСинтаксисURI = ПроверяющийСинтаксисURI;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Определяет вид полного кодированного хоста URI по RFC 3986 §3.2.2.
//
// Параметры:
//  КодированныйХост - Строка - Полный кодированный хост, включая скобки IP-литерала при их наличии.
//
// Возвращаемое значение:
//  Строка, Неопределено - Одно из значений ВидыХостаURL или Неопределено для недопустимого хоста.
Функция Классифицировать(КодированныйХост) Экспорт

	Если ТипЗнч(КодированныйХост) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЕстьОткрывающаяСкобка = Лев(КодированныйХост, 1) = "[";
	ЕстьЗакрывающаяСкобка = Прав(КодированныйХост, 1) = "]";

	Если ЕстьОткрывающаяСкобка Или ЕстьЗакрывающаяСкобка Тогда
		Если Не (ЕстьОткрывающаяСкобка И ЕстьЗакрывающаяСкобка) Тогда
			Возврат Неопределено;
		КонецЕсли;

		СодержимоеЛитерала = Сред(КодированныйХост, 2, СтрДлина(КодированныйХост) - 2);

		Если ЭтоДопустимыйIPv6(СодержимоеЛитерала) Тогда
			Возврат ВидыХостаURL.IPv6();
		КонецЕсли;

		Если ЭтоДопустимыйIPvFuture(СодержимоеЛитерала) Тогда
			Возврат ВидыХостаURL.IPvFuture();
		КонецЕсли;

		Возврат Неопределено;
	КонецЕсли;

	Если ЯвляетсяСтрогимIPv4(КодированныйХост) Тогда
		Возврат ВидыХостаURL.IPv4();
	КонецЕсли;

	Если ЭтоДопустимоеЗарегистрированноеИмя(КодированныйХост) Тогда
		Возврат ВидыХостаURL.ЗарегистрированноеИмя();
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоДопустимыйIPv6(Значение)

	Попытка
		Адрес = Новый IPАдрес(Значение);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Адрес.ЭтоIPv6() И Не Адрес.ИмеетЗону();

КонецФункции

// Проверяет соответствие текста синтаксису IPvFuture из RFC 3986 §3.2.2.
Функция ЭтоДопустимыйIPvFuture(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) < 4 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ВРег(Лев(Значение, 1)) <> "V" Тогда
		Возврат Ложь;
	КонецЕсли;

	ПозицияТочки = СтрНайти(Значение, ".");

	Если ПозицияТочки = 2 Или ПозицияТочки = 0 Или ПозицияТочки = СтрДлина(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 2 По ПозицияТочки - 1 Цикл
		Если Не ЯвляетсяHexСимволом(Сред(Значение, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Для Индекс = ПозицияТочки + 1 По СтрДлина(Значение) Цикл
		Если Не ЯвляетсяДопустимымСимволомIPvFuture(Сред(Значение, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЯвляетсяСтрогимIPv4(Значение)

	Попытка
		Адрес = Новый IPАдрес(Значение);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Адрес.ЭтоIPv4();

КонецФункции

Функция ЭтоДопустимоеЗарегистрированноеИмя(Значение)

	Индекс = 1;

	Пока Индекс <= СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);

		Если КодСимвола(Символ) > 127 Тогда
			Возврат Ложь;
		КонецЕсли;

		Если Символ = "%" Тогда
			Если Индекс + 2 > СтрДлина(Значение)
				Или Не ЯвляетсяHexСимволом(Сред(Значение, Индекс + 1, 1))
				Или Не ЯвляетсяHexСимволом(Сред(Значение, Индекс + 2, 1)) Тогда
				Возврат Ложь;
			КонецЕсли;

			Индекс = Индекс + 3;
		ИначеЕсли Не ЯвляетсяДопустимымСимволомРегИмени(Символ) Тогда
			Возврат Ложь;
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЯвляетсяHexСимволом(Символ)

	Возврат _ПроверяющийСинтаксисURI.ЭтоШестнадцатеричныйСимвол(Символ);

КонецФункции

Функция ЯвляетсяДопустимымСимволомРегИмени(Символ)

	ДопустимыеСимволы = _ПроверяющийСинтаксисURI.ДопустимыеСимволыЗарегистрированногоИмени();
	Возврат СтрНайти(ДопустимыеСимволы, Символ) > 0;

КонецФункции

Функция ЯвляетсяДопустимымСимволомIPvFuture(Символ)

	ДопустимыеСимволы = _ПроверяющийСинтаксисURI.ДопустимыеСимволыЗарегистрированногоИмени() + ":";
	Возврат СтрНайти(ДопустимыеСимволы, Символ) > 0;

КонецФункции

#КонецОбласти
