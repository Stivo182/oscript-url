#Область ПрограммныйИнтерфейс

// Определяет стандартный порт известной URI-схемы без учёта регистра.
// RFC 3986 §3.2.3: схема может определять порт по умолчанию.
//
// Параметры:
//  Схема - Строка, Неопределено - URI-схема.
//
// Возвращаемое значение:
//  Число, Неопределено - Стандартный порт либо Неопределено для неизвестной схемы.
Функция Определить(Схема) Экспорт

	Если Схема = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	СхемаВНижнемРегистре = НРег(Схема);
	Если СхемаВНижнемРегистре = "http" Или СхемаВНижнемРегистре = "ws" Тогда
		Возврат 80;
	ИначеЕсли СхемаВНижнемРегистре = "https" Или СхемаВНижнемРегистре = "wss" Тогда
		Возврат 443;
	ИначеЕсли СхемаВНижнемРегистре = "ftp" Тогда
		Возврат 21;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
