#Использовать errors

Перем _ПроверяющийСинтаксисURI; // ПроверяющийСинтаксисURI
Перем _ПроверяющийСхемыURL; // ПроверяющийСхемыURL

#Область ОбработчикиСобытий

// Создаёт разборщик URL.
//
// Параметры:
//  ПроверяющийСинтаксисURI - ПроверяющийСинтаксисURI - Проверяющий синтаксис URI.
//  ПроверяющийСхемыURL - ПроверяющийСхемыURL - Проверяющий ограничения схем URL.
Процедура ПриСозданииОбъекта(ПроверяющийСинтаксисURI, ПроверяющийСхемыURL)

	_ПроверяющийСинтаксисURI = ПроверяющийСинтаксисURI;
	_ПроверяющийСхемыURL = ПроверяющийСхемыURL;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Разбирает серверный адрес с необязательной схемой.
//
// Параметры:
//  Значение - Строка - Серверный адрес или абсолютный иерархический URL.
//  СхемаПоУмолчанию - Строка - Схема без завершающего двоеточия.
//
// Возвращаемое значение:
//  URL - Новый независимый URL.
//
// Исключения:
//  argument.invalid_type - Значение или схема по умолчанию имеют тип, отличный от Строка.
//  argument.required - Значение или схема по умолчанию не заполнены.
//  url.invalid_syntax - Сформированный URL нарушает общую грамматику URI или IRI.
//  url.invalid_scheme - Схема не соответствует RFC 3986.
//  url.server_address_required - Значение не имеет поддерживаемой формы серверного адреса.
//  url.invalid_percent_encoding - Значение содержит некорректную последовательность %HH.
//  url.invalid_authority - Сформированный URL содержит некорректную серверную часть.
//  url.invalid_host - Сформированный URL содержит некорректный хост.
//  url.invalid_for_scheme - URL нарушает ограничения известной схемы.
Функция РазобратьСоСхемойПоУмолчанию(Значение, СхемаПоУмолчанию) Экспорт

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));
	ПроверкаАргументов.ПроверитьТип("СхемаПоУмолчанию", СхемаПоУмолчанию, Тип("Строка"));
	ПроверкаАргументов.ПроверитьЗаполненность("Значение", Значение);
	ПроверкаАргументов.ПроверитьЗаполненность("СхемаПоУмолчанию", СхемаПоУмолчанию);

	Если Не _ПроверяющийСинтаксисURI.ЭтоДопустимаяСхема(СхемаПоУмолчанию) Тогда
		ВызватьНедопустимуюСхему();
	КонецЕсли;

	Если ЕстьПробельныйИлиУправляющийСимволПоКраю(Значение) Тогда
		ВызватьТребованиеСерверногоАдреса("пробельный или управляющий символ по краю значения");
	КонецЕсли;

	Если Лев(Значение, 2) = "//" Тогда
		ПредставлениеURL = СхемаПоУмолчанию + ":" + Значение;
	Иначе
		ПозицияПервогоРазделителя = ПозицияПервогоИз(Значение, ":/?#");
		ЭтоАбсолютныйURL = ПозицияПервогоРазделителя > 0
			И Сред(Значение, ПозицияПервогоРазделителя, 1) = ":"
			И Сред(Значение, ПозицияПервогоРазделителя + 1, 2) = "//";

		Если ЭтоАбсолютныйURL Тогда
			СхемаЗначения = Лев(Значение, ПозицияПервогоРазделителя - 1);
			Если Не _ПроверяющийСинтаксисURI.ЭтоДопустимаяСхема(СхемаЗначения) Тогда
				ВызватьНедопустимуюСхему();
			КонецЕсли;

			ПредставлениеURL = Значение;
		Иначе
			ПроверитьФормуСерверногоАдреса(Значение);
			ПредставлениеURL = СхемаПоУмолчанию + "://" + Значение;
		КонецЕсли;
	КонецЕсли;

	Адрес = Новый URL(ПредставлениеURL);

	Если Лев(Значение, 2) = "//" И Адрес.ТекстПорта() = "" Тогда
		ВызватьТребованиеСерверногоАдреса("не заполнен порт");
	КонецЕсли;

	Если Адрес.КодированнаяСервернаяЧасть() = Неопределено Или Адрес.КодированныйХост() = "" Тогда
		ВызватьТребованиеСерверногоАдреса("не заполнен хост");
	КонецЕсли;

	_ПроверяющийСхемыURL.Проверить(Адрес);

	Возврат Адрес;

КонецФункции

// Разбирает серверный адрес с необязательной схемой без исключений.
//
// Параметры:
//  Значение - Строка - Серверный адрес или абсолютный иерархический URL.
//  СхемаПоУмолчанию - Строка - Схема без завершающего двоеточия.
//  Ошибка - ИнформацияОбОшибке, Неопределено - Выходной параметр с информацией об ошибке разбора.
//
// Возвращаемое значение:
//  URL, Неопределено - Разобранный URL или Неопределено при ошибке.
Функция ПопытатьсяРазобратьСоСхемойПоУмолчанию(Значение, СхемаПоУмолчанию, Ошибка = Неопределено) Экспорт

	Ошибка = Неопределено;

	Попытка
		Возврат РазобратьСоСхемойПоУмолчанию(Значение, СхемаПоУмолчанию);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Разбирает URL как URI-ссылку без исключений.
//
// Параметры:
//  Значение - Строка - Разбираемая URI-ссылка.
//  Ошибка - ИнформацияОбОшибке, Неопределено - Выходной параметр с информацией об ошибке разбора.
//
// Возвращаемое значение:
//  URL, Неопределено - Разобранная ссылка или Неопределено при ошибке.
Функция ПопытатьсяРазобрать(Значение, Ошибка = Неопределено) Экспорт

	Ошибка = Неопределено;

	Попытка
		ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));
		Возврат Новый URL(Значение);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Проверяет, является ли значение корректной URI-ссылкой.
//
// Параметры:
//  Значение - Строка - Проверяемая URI-ссылка.
//
// Возвращаемое значение:
//  Булево - Истина, если значение успешно разобрано.
Функция ЭтоКорректнаяСсылка(Значение) Экспорт

	Возврат ПопытатьсяРазобрать(Значение) <> Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьФормуСерверногоАдреса(Значение)

	ПозицияРазделителя = ПозицияПервогоИз(Значение, "/?#");
	Если ПозицияРазделителя = 0 Тогда
		СерверныйАдрес = Значение;
	Иначе
		СерверныйАдрес = Лев(Значение, ПозицияРазделителя - 1);
	КонецЕсли;

	Если СерверныйАдрес = "" Тогда
		ВызватьТребованиеСерверногоАдреса("не заполнен серверный адрес");
	КонецЕсли;

	Если СтрНайти(СерверныйАдрес, "@") > 0 Тогда
		ВызватьТребованиеСерверногоАдреса("данные пользователя требуют маркера серверной части");
	КонецЕсли;

	Если Лев(СерверныйАдрес, 1) = "[" Тогда
		ПроверитьЛитералIP(СерверныйАдрес);
	Иначе
		ПроверитьИмяХостаИПорт(СерверныйАдрес);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЛитералIP(СерверныйАдрес)

	ПозицияЗакрывающейСкобки = СтрНайти(СерверныйАдрес, "]");
	Если ПозицияЗакрывающейСкобки <= 2 Тогда
		ВызватьТребованиеСерверногоАдреса("некорректный литерал IP");
	КонецЕсли;

	Остаток = Сред(СерверныйАдрес, ПозицияЗакрывающейСкобки + 1);
	Если Остаток = "" Тогда
		Возврат;
	КонецЕсли;

	Если Лев(Остаток, 1) <> ":" Или СтрДлина(Остаток) = 1
		Или Не _ПроверяющийСинтаксисURI.ТолькоЦифрыASCII(Сред(Остаток, 2)) Тогда
		ВызватьТребованиеСерверногоАдреса("некорректный порт");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИмяХостаИПорт(СерверныйАдрес)

	Если СтрНайти(СерверныйАдрес, "[") > 0 Или СтрНайти(СерверныйАдрес, "]") > 0 Тогда
		ВызватьТребованиеСерверногоАдреса("некорректный литерал IP");
	КонецЕсли;

	КоличествоДвоеточий = КоличествоСимволов(СерверныйАдрес, ":");
	Если КоличествоДвоеточий > 1 Тогда
		ВызватьТребованиеСерверногоАдреса("литерал IPv6 должен быть заключен в квадратные скобки");
	КонецЕсли;

	Если КоличествоДвоеточий = 0 Тогда
		Возврат;
	КонецЕсли;

	ПозицияДвоеточия = СтрНайти(СерверныйАдрес, ":");
	Хост = Лев(СерверныйАдрес, ПозицияДвоеточия - 1);
	Порт = Сред(СерверныйАдрес, ПозицияДвоеточия + 1);

	Если Хост = "" Или Порт = "" Или Не _ПроверяющийСинтаксисURI.ТолькоЦифрыASCII(Порт) Тогда
		ВызватьТребованиеСерверногоАдреса("некорректный хост или порт");
	КонецЕсли;

КонецПроцедуры

Функция ПозицияПервогоИз(Значение, ИскомыеСимволы)

	Результат = 0;
	Для Индекс = 1 По СтрДлина(ИскомыеСимволы) Цикл
		Позиция = СтрНайти(Значение, Сред(ИскомыеСимволы, Индекс, 1));
		Если Позиция > 0 И (Результат = 0 Или Позиция < Результат) Тогда
			Результат = Позиция;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КоличествоСимволов(Значение, ИскомыйСимвол)

	Результат = 0;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если Сред(Значение, Индекс, 1) = ИскомыйСимвол Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЕстьПробельныйИлиУправляющийСимволПоКраю(Значение)

	КодПервого = КодСимвола(Лев(Значение, 1));
	КодПоследнего = КодСимвола(Прав(Значение, 1));

	Возврат ЭтоПробельныйИлиУправляющийСимвол(КодПервого)
		Или ЭтоПробельныйИлиУправляющийСимвол(КодПоследнего);

КонецФункции

Функция ЭтоПробельныйИлиУправляющийСимвол(Код)

	Возврат Код <= 32                              // U+0000..U+0020: управляющие C0 и пробел
		Или Код >= 127 И Код <= 160               // U+007F..U+00A0: DEL, управляющие C1, NBSP
		Или Код = 5760                           // U+1680: пробел огама
		Или Код >= 8192 И Код <= 8202             // U+2000..U+200A: типографские пробелы
		Или Код = 8232                           // U+2028: разделитель строк
		Или Код = 8233                           // U+2029: разделитель абзацев
		Или Код = 8239                           // U+202F: узкий неразрывный пробел
		Или Код = 8287                           // U+205F: средний математический пробел
		Или Код = 12288;                         // U+3000: идеографический пробел

КонецФункции

Процедура ВызватьНедопустимуюСхему()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимаяСхема(),
		"Недопустимая схема URL"
	);

КонецПроцедуры

Процедура ВызватьТребованиеСерверногоАдреса(Причина)

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.ТребуетсяСерверныйАдрес(),
		"Требуется серверный адрес URL: " + Причина,
		Новый Структура("Причина", Причина)
	);

КонецПроцедуры

#КонецОбласти
