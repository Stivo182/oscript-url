#Область ПрограммныйИнтерфейс

// Сравнивает два URL по кодированным компонентам.
//
// Параметры:
//  Первый - URL - Первый URL.
//  Второй - URL - Второй URL.
//
// Возвращаемое значение:
//  Число - Отрицательное число, ноль или положительное число.
Функция Сравнить(Первый, Второй) Экспорт

	Результат = СравнитьНеобязательныеСтроки(Первый.Схема(), Второй.Схема(), Истина);
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = СравнитьБулевы(
		Первый.КодированнаяСервернаяЧасть() <> Неопределено,
		Второй.КодированнаяСервернаяЧасть() <> Неопределено
	);
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = СравнитьБулевы(
		Первый.КодированныеДанныеПользователя() <> Неопределено,
		Второй.КодированныеДанныеПользователя() <> Неопределено
	);
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = СравнитьНеобязательныеСтроки(
		Первый.КодированныеДанныеПользователя(),
		Второй.КодированныеДанныеПользователя()
	);
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = СравнитьНеобязательныеСтроки(
		Первый.КодированныйХост(),
		Второй.КодированныйХост(),
		Истина
	);
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = СравнитьБулевы(
		Первый.ТекстПорта() <> Неопределено,
		Второй.ТекстПорта() <> Неопределено
	);
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = СравнитьНеобязательныеСтроки(Первый.ТекстПорта(), Второй.ТекстПорта());
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = СравнитьСтроки(
		НормализоватьПроцентныеТриплеты(Первый.КодированныйПуть()),
		НормализоватьПроцентныеТриплеты(Второй.КодированныйПуть())
	);
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = СравнитьНеобязательныеСтроки(
		Первый.КодированнаяСтрокаЗапроса(),
		Второй.КодированнаяСтрокаЗапроса()
	);
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат СравнитьНеобязательныеСтроки(
		Первый.КодированныйФрагмент(),
		Второй.КодированныйФрагмент()
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СравнитьНеобязательныеСтроки(Первое, Второе, БезУчетаРегистраASCII = Ложь)

	Если Первое = Неопределено Тогда
		Возврат ?(Второе = Неопределено, 0, -1);
	ИначеЕсли Второе = Неопределено Тогда
		Возврат 1;
	КонецЕсли;

	Первое = НормализоватьПроцентныеТриплеты(Первое);
	Второе = НормализоватьПроцентныеТриплеты(Второе);

	Если БезУчетаРегистраASCII Тогда
		Первое = НормализоватьРегистрASCII(Первое);
		Второе = НормализоватьРегистрASCII(Второе);
	КонецЕсли;

	Возврат СравнитьСтроки(Первое, Второе);

КонецФункции

Функция СравнитьБулевы(Первое, Второе)

	Если Первое = Второе Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ?(Первое, 1, -1);

КонецФункции

Функция СравнитьСтроки(Первое, Второе)

	МинимальнаяДлина = Мин(СтрДлина(Первое), СтрДлина(Второе));

	Для Индекс = 1 По МинимальнаяДлина Цикл
		Разность = КодСимвола(Сред(Первое, Индекс, 1)) - КодСимвола(Сред(Второе, Индекс, 1));
		Если Разность <> 0 Тогда
			Возврат Разность;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрДлина(Первое) - СтрДлина(Второе);

КонецФункции

Функция НормализоватьПроцентныеТриплеты(Значение)

	Фрагменты = Новый Массив;
	Индекс = 1;

	Пока Индекс <= СтрДлина(Значение) Цикл
		Если Сред(Значение, Индекс, 1) = "%" Тогда
			Фрагменты.Добавить("%" + ВРег(Сред(Значение, Индекс + 1, 2)));
			Индекс = Индекс + 3;
		Иначе
			Фрагменты.Добавить(Сред(Значение, Индекс, 1));
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Функция НормализоватьРегистрASCII(Значение)

	Фрагменты = Новый Массив;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		ТекущийСимвол = Сред(Значение, Индекс, 1);
		Код = КодСимвола(ТекущийСимвол);
		Фрагменты.Добавить(?(Код >= 65 И Код <= 90, Символ(Код + 32), ТекущийСимвол));
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

#КонецОбласти
