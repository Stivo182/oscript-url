#Использовать errors

Перем _ШестнадцатеричныеЦифры;

#Область ПрограммныйИнтерфейс

// Проверяет допустимость кодовых точек Unicode в компоненте IRI по RFC 3987 §2.2.
//
// Параметры:
//  Значение - Строка - Проверяемое значение компонента.
//  РазрешитьЧастныеКодовыеТочки - Булево - Разрешить частные кодовые точки, допустимые только в запросе.
//
// Исключения:
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Процедура Проверить(Значение, РазрешитьЧастныеКодовыеТочки = Ложь) Экспорт

	Результат = ОбработатьКомпонент(Значение, РазрешитьЧастныеКодовыеТочки, Ложь);

КонецПроцедуры

// Проверяет кодовые точки компонента IRI и кодирует символы Unicode в UTF-8 `%HH`.
//
// Параметры:
//  Значение - Строка - Проверенное представление компонента IRI.
//  РазрешитьЧастныеКодовыеТочки - Булево - Разрешить частные кодовые точки, допустимые только в запросе.
//
// Возвращаемое значение:
//  Строка - ASCII-представление компонента URI.
//
// Исключения:
//  url.invalid_syntax - Значение содержит недопустимую кодовую точку Unicode.
Функция Кодировать(Значение, РазрешитьЧастныеКодовыеТочки = Ложь) Экспорт

	Возврат ОбработатьКомпонент(Значение, РазрешитьЧастныеКодовыеТочки, Истина);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбработатьКомпонент(Значение, РазрешитьЧастныеКодовыеТочки, КодироватьСимволы)

	Если КодироватьСимволы Тогда
		Фрагменты = Новый Массив;
	КонецЕсли;

	Длина = СтрДлина(Значение);
	Индекс = 1;
	НачалоASCII = 1;

	Пока Индекс <= Длина Цикл
		СтаршаяЧасть = КодСимвола(Значение, Индекс);

		Если СтаршаяЧасть <= 127 Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если КодироватьСимволы И НачалоASCII < Индекс Тогда
			Фрагменты.Добавить(Сред(Значение, НачалоASCII, Индекс - НачалоASCII));
		КонецЕсли;

		Если СтаршаяЧасть >= 55296 И СтаршаяЧасть <= 56319 Тогда
			Если Индекс = Длина Тогда
				ВызватьНедопустимыйСинтаксис();
			КонецЕсли;

			МладшаяЧасть = КодСимвола(Значение, Индекс + 1);

			Если МладшаяЧасть < 56320 Или МладшаяЧасть > 57343 Тогда
				ВызватьНедопустимыйСинтаксис();
			КонецЕсли;

			КодоваяТочка = 65536 + (СтаршаяЧасть - 55296) * 1024 + МладшаяЧасть - 56320;
			Индекс = Индекс + 2;
		ИначеЕсли СтаршаяЧасть >= 56320 И СтаршаяЧасть <= 57343 Тогда
			ВызватьНедопустимыйСинтаксис();
		Иначе
			КодоваяТочка = СтаршаяЧасть;
			Индекс = Индекс + 1;
		КонецЕсли;

		Если Не ЭтоКодоваяТочкаUCSChar(КодоваяТочка)
			И Не (РазрешитьЧастныеКодовыеТочки И ЭтоКодоваяТочкаIPrivate(КодоваяТочка)) Тогда
			ВызватьНедопустимыйСинтаксис();
		КонецЕсли;

		Если КодироватьСимволы Тогда
			Фрагменты.Добавить(КодироватьКодовуюТочкуUTF8(КодоваяТочка));
		КонецЕсли;

		НачалоASCII = Индекс;
	КонецЦикла;

	Если Не КодироватьСимволы Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НачалоASCII <= Длина Тогда
		Фрагменты.Добавить(Сред(Значение, НачалоASCII));
	КонецЕсли;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Функция КодироватьКодовуюТочкуUTF8(КодоваяТочка)

	Если КодоваяТочка <= 2047 Тогда
		Возврат КодироватьБайт(192 + Цел(КодоваяТочка / 64))
			+ КодироватьБайт(128 + ОстатокОтДеления(КодоваяТочка, 64));
	ИначеЕсли КодоваяТочка <= 65535 Тогда
		Возврат КодироватьБайт(224 + Цел(КодоваяТочка / 4096))
			+ КодироватьБайт(128 + ОстатокОтДеления(Цел(КодоваяТочка / 64), 64))
			+ КодироватьБайт(128 + ОстатокОтДеления(КодоваяТочка, 64));
	Иначе
		Возврат КодироватьБайт(240 + Цел(КодоваяТочка / 262144))
			+ КодироватьБайт(128 + ОстатокОтДеления(Цел(КодоваяТочка / 4096), 64))
			+ КодироватьБайт(128 + ОстатокОтДеления(Цел(КодоваяТочка / 64), 64))
			+ КодироватьБайт(128 + ОстатокОтДеления(КодоваяТочка, 64));
	КонецЕсли;

КонецФункции

Функция КодироватьБайт(Байт)

	СтаршийРазряд = Цел(Байт / 16);
	МладшийРазряд = ОстатокОтДеления(Байт, 16);
	Возврат "%" + Сред(_ШестнадцатеричныеЦифры, СтаршийРазряд + 1, 1)
		+ Сред(_ШестнадцатеричныеЦифры, МладшийРазряд + 1, 1);

КонецФункции

Функция ОстатокОтДеления(Значение, Делитель)

	Возврат Значение - Цел(Значение / Делитель) * Делитель;

КонецФункции

Функция ЭтоКодоваяТочкаUCSChar(КодоваяТочка)

	Возврат КодоваяТочка >= 160 И КодоваяТочка <= 55295
		Или КодоваяТочка >= 63744 И КодоваяТочка <= 64975
		Или КодоваяТочка >= 65008 И КодоваяТочка <= 65519
		Или КодоваяТочка >= 65536 И КодоваяТочка <= 131069
		Или КодоваяТочка >= 131072 И КодоваяТочка <= 196605
		Или КодоваяТочка >= 196608 И КодоваяТочка <= 262141
		Или КодоваяТочка >= 262144 И КодоваяТочка <= 327677
		Или КодоваяТочка >= 327680 И КодоваяТочка <= 393213
		Или КодоваяТочка >= 393216 И КодоваяТочка <= 458749
		Или КодоваяТочка >= 458752 И КодоваяТочка <= 524285
		Или КодоваяТочка >= 524288 И КодоваяТочка <= 589821
		Или КодоваяТочка >= 589824 И КодоваяТочка <= 655357
		Или КодоваяТочка >= 655360 И КодоваяТочка <= 720893
		Или КодоваяТочка >= 720896 И КодоваяТочка <= 786429
		Или КодоваяТочка >= 786432 И КодоваяТочка <= 851965
		Или КодоваяТочка >= 851968 И КодоваяТочка <= 917501
		Или КодоваяТочка >= 921600 И КодоваяТочка <= 983037;

КонецФункции

Функция ЭтоКодоваяТочкаIPrivate(КодоваяТочка)

	Возврат КодоваяТочка >= 57344 И КодоваяТочка <= 63743
		Или КодоваяТочка >= 983040 И КодоваяТочка <= 1048573
		Или КодоваяТочка >= 1048576 И КодоваяТочка <= 1114109;

КонецФункции

Процедура ВызватьНедопустимыйСинтаксис()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыйСинтаксис(),
		"Недопустимая кодовая точка Unicode в URI"
	);

КонецПроцедуры

#КонецОбласти

_ШестнадцатеричныеЦифры = "0123456789ABCDEF";
