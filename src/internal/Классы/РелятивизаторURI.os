#Использовать errors

#Область ПрограммныйИнтерфейс

// Строит однозначно определённую URI-ссылку на абсолютную цель относительно базы.
// Варианты проверяются разрешением по RFC 3986 §5.2 относительно исходной базы.
//
// Параметры:
//  База - URL - Исходная абсолютная база.
//  Цель - URL - Исходная абсолютная цель.
//
// Возвращаемое значение:
//  URL - Новая относительная ссылка или нормализованная цель.
//
// Исключения:
//  url.base_not_absolute - База не является абсолютной URI-ссылкой.
Функция СделатьОтносительным(База, Цель) Экспорт

	КомпонентыБазы = База.СнимокКомпонентов();
	КомпонентыЦели = Цель.СнимокКомпонентов();

	Если КомпонентыБазы.Схема = Неопределено Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыОшибокURL.БазаНеАбсолютная(),
			"База URI должна быть абсолютной"
		);
	КонецЕсли;

	ПризнакиЦели = Новый Структура(
		"ПутьПуст,ЗапросОпределен,ФрагментОпределен,ПортУказан",
		КомпонентыЦели.КодированныйПуть = "",
		КомпонентыЦели.КодированныйЗапрос <> Неопределено,
		КомпонентыЦели.КодированныйФрагмент <> Неопределено,
		КомпонентыЦели.ПортУказан
	);

	Нормализатор = Новый НормализаторURI;
	НормализованнаяБаза = Нормализатор.НормализоватьДляСхемы(База);
	НормализованнаяЦель = Нормализатор.НормализоватьДляСхемы(Цель);
	КомпонентыНормализованнойБазы = НормализованнаяБаза.СнимокКомпонентов();
	КомпонентыНормализованнойЦели = НормализованнаяЦель.СнимокКомпонентов();

	Если КомпонентыНормализованнойБазы.Схема <> КомпонентыНормализованнойЦели.Схема
		Или Не СерверныеЧастиСовпадают(
			КомпонентыНормализованнойБазы,
			КомпонентыНормализованнойЦели
		) Тогда
		Возврат НормализованнаяЦель;
	КонецЕсли;

	Кандидат = КандидатОдинаковогоПути(
		КомпонентыНормализованнойБазы,
		КомпонентыНормализованнойЦели,
		ПризнакиЦели
	);

	Если Кандидат <> Неопределено И КандидатПроходитПроверку(Кандидат, База, НормализованнаяЦель) Тогда
		Возврат РазобратьКандидат(Кандидат);
	КонецЕсли;

	Кандидат = КандидатОтносительногоПути(
		КомпонентыНормализованнойБазы,
		КомпонентыНормализованнойЦели,
		ПризнакиЦели
	);

	Если Кандидат <> Неопределено И КандидатПроходитПроверку(Кандидат, База, НормализованнаяЦель) Тогда
		Возврат РазобратьКандидат(Кандидат);
	КонецЕсли;

	Если КомпонентыНормализованнойЦели.СервернаяЧастьОпределена Тогда
		Кандидат = КандидатСервернойЧасти(КомпонентыНормализованнойЦели, ПризнакиЦели);

		Если КандидатПроходитПроверку(Кандидат, База, НормализованнаяЦель) Тогда
			Возврат РазобратьКандидат(Кандидат);
		КонецЕсли;
	КонецЕсли;

	Возврат НормализованнаяЦель;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СерверныеЧастиСовпадают(КомпонентыБазы, КомпонентыЦели)

	Если КомпонентыБазы.СервернаяЧастьОпределена <> КомпонентыЦели.СервернаяЧастьОпределена Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не КомпонентыБазы.СервернаяЧастьОпределена Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат КомпонентыБазы.ДанныеПользователяОпределены = КомпонентыЦели.ДанныеПользователяОпределены
		И КомпонентыБазы.КодированныеДанныеПользователя = КомпонентыЦели.КодированныеДанныеПользователя
		И КомпонентыБазы.КодированныйХост = КомпонентыЦели.КодированныйХост
		И КомпонентыБазы.ПортУказан = КомпонентыЦели.ПортУказан
		И КомпонентыБазы.ТекстПорта = КомпонентыЦели.ТекстПорта;

КонецФункции

Функция КандидатОдинаковогоПути(КомпонентыБазы, КомпонентыЦели, ПризнакиЦели)

	Если КомпонентыБазы.КодированныйПуть <> КомпонентыЦели.КодированныйПуть Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если КомпонентыБазы.КодированныйЗапрос = КомпонентыЦели.КодированныйЗапрос Тогда
		Кандидат = "";
	ИначеЕсли ПризнакиЦели.ЗапросОпределен Тогда
		Кандидат = "?" + КомпонентыЦели.ПредставлениеЗапроса;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Если ПризнакиЦели.ФрагментОпределен Тогда
		Кандидат = Кандидат + "#" + КомпонентыЦели.ПредставлениеФрагмента;
	КонецЕсли;

	Возврат Кандидат;

КонецФункции

Функция КандидатОтносительногоПути(КомпонентыБазы, КомпонентыЦели, ПризнакиЦели)

	Если ПризнакиЦели.ПутьПуст
		И КомпонентыБазы.КодированныйЗапрос <> Неопределено
		И Не ПризнакиЦели.ЗапросОпределен Тогда
		Возврат Неопределено;
	КонецЕсли;

	КаталогБазы = МодельПути(КомпонентыБазы.ПредставлениеПути);

	Если Не КаталогБазы.ЗавершающийСлеш И КаталогБазы.Сегменты.Количество() > 0 Тогда
		КаталогБазы.Сегменты.Удалить(КаталогБазы.Сегменты.Количество() - 1);
	КонецЕсли;

	МодельЦели = МодельПути(КомпонентыЦели.ПредставлениеПути);

	ОбщийПрефикс = 0;

	Если КаталогБазы.Корневой = МодельЦели.Корневой Тогда
		Предел = КаталогБазы.Сегменты.Количество();

		Если МодельЦели.Сегменты.Количество() < Предел Тогда
			Предел = МодельЦели.Сегменты.Количество();
		КонецЕсли;

		Пока ОбщийПрефикс < Предел
			И КаталогБазы.Сегменты[ОбщийПрефикс] = МодельЦели.Сегменты[ОбщийПрефикс] Цикл
			ОбщийПрефикс = ОбщийПрефикс + 1;
		КонецЦикла;
	КонецЕсли;

	СегментыКандидата = Новый Массив;

	Для Индекс = ОбщийПрефикс По КаталогБазы.Сегменты.Количество() - 1 Цикл
		СегментыКандидата.Добавить("..");
	КонецЦикла;

	Для Индекс = ОбщийПрефикс По МодельЦели.Сегменты.Количество() - 1 Цикл
		СегментыКандидата.Добавить(МодельЦели.Сегменты[Индекс]);
	КонецЦикла;

	Если СегментыКандидата.Количество() = 0 Тогда
		ПутьКандидата = ?(МодельЦели.ЗавершающийСлеш, "./", "");
	Иначе
		ПервыйСегмент = СегментыКандидата[0];

		Если ПервыйСегмент = "" Или СтрНайти(ПервыйСегмент, ":") > 0 Тогда
			СегментыКандидата.Вставить(0, ".");
		КонецЕсли;

		ПутьКандидата = ОбъединитьСегменты(СегментыКандидата);

		Если МодельЦели.ЗавершающийСлеш Тогда
			ПутьКандидата = ПутьКандидата + "/";
		КонецЕсли;
	КонецЕсли;

	Возврат ДобавитьЗапросИФрагмент(ПутьКандидата, КомпонентыЦели, ПризнакиЦели);

КонецФункции

Функция КандидатСервернойЧасти(КомпонентыЦели, ПризнакиЦели)

	Кандидат = "//" + Новый СборщикURL().СобратьСервернуюЧасть(КомпонентыЦели);

	Если Не ПризнакиЦели.ПутьПуст Тогда
		Кандидат = Кандидат + КомпонентыЦели.ПредставлениеПути;
	КонецЕсли;

	Возврат ДобавитьЗапросИФрагмент(Кандидат, КомпонентыЦели, ПризнакиЦели);

КонецФункции

Функция ДобавитьЗапросИФрагмент(Кандидат, КомпонентыЦели, ПризнакиЦели)

	Если ПризнакиЦели.ЗапросОпределен Тогда
		Кандидат = Кандидат + "?" + КомпонентыЦели.ПредставлениеЗапроса;
	КонецЕсли;

	Если ПризнакиЦели.ФрагментОпределен Тогда
		Кандидат = Кандидат + "#" + КомпонентыЦели.ПредставлениеФрагмента;
	КонецЕсли;

	Возврат Кандидат;

КонецФункции

Функция КандидатПроходитПроверку(Кандидат, База, НормализованнаяЦель)

	URLКандидата = РазобратьКандидат(Кандидат);
	Восстановленное = Новый РазрешительURI().Разрешить(База, URLКандидата);
	Проверка = Новый НормализаторURI().НормализоватьДляСхемы(Восстановленное);

	Возврат Проверка.КодированноеПредставление() = НормализованнаяЦель.КодированноеПредставление();

КонецФункции

Функция РазобратьКандидат(Кандидат)

	Возврат Новый URL(Кандидат);

КонецФункции

Функция МодельПути(Путь)

	Сегменты = Новый Массив;
	Корневой = Лев(Путь, 1) = "/";
	ЗавершающийСлеш = Путь <> "" И Прав(Путь, 1) = "/";

	Если Путь <> "" Тогда
		Сегменты = РазделитьНаСегменты(Путь);

		Если Корневой Тогда
			Сегменты.Удалить(0);
		КонецЕсли;

		Если ЗавершающийСлеш Тогда
			Сегменты.Удалить(Сегменты.Количество() - 1);
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Структура("Корневой,Сегменты,ЗавершающийСлеш", Корневой, Сегменты, ЗавершающийСлеш);

КонецФункции

Функция РазделитьНаСегменты(Путь)

	Результат = Новый Массив;
	НачалоСегмента = 1;

	Для Индекс = 1 По СтрДлина(Путь) Цикл
		Если Сред(Путь, Индекс, 1) = "/" Тогда
			Результат.Добавить(Сред(Путь, НачалоСегмента, Индекс - НачалоСегмента));
			НачалоСегмента = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Результат.Добавить(Сред(Путь, НачалоСегмента));

	Возврат Результат;

КонецФункции

Функция ОбъединитьСегменты(Сегменты)

	Возврат СтрСоединить(Сегменты, "/");

КонецФункции

#КонецОбласти
