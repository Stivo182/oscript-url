#Использовать errors

#Область ПрограммныйИнтерфейс

// Проверяет ограничения известной схемы URL.
//
// Параметры:
//  Ссылка - URL - Проверяемая ссылка.
//
// Исключения:
//  url.invalid_for_scheme - URL нарушает ограничения известной схемы.
Процедура Проверить(Ссылка) Экспорт

	Схема = Ссылка.Схема();

	Если Схема = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Схема = НРег(Схема);

	Если Не ИзвестнаяСетеваяСхема(Схема) Тогда
		Возврат;
	КонецЕсли;

	Если Ссылка.КодированнаяСервернаяЧасть() = Неопределено Тогда
		ВызватьОшибку(Схема, "не определена серверная часть");
	КонецЕсли;

	Если Ссылка.КодированныйХост() = "" Тогда
		ВызватьОшибку(Схема, "не заполнен хост");
	КонецЕсли;

	Если Ссылка.ТекстПорта() <> Неопределено
		И Не ДопустимыйСетевойПорт(Ссылка.ТекстПорта()) Тогда
		ВызватьОшибку(Схема, "порт находится вне диапазона 0..65535");
	КонецЕсли;

	Если (Схема = "ws" Или Схема = "wss")
		И Ссылка.КодированныеДанныеПользователя() <> Неопределено Тогда
		ВызватьОшибку(Схема, "данные пользователя запрещены");
	КонецЕсли;

	Если (Схема = "ws" Или Схема = "wss") И Ссылка.КодированныйФрагмент() <> Неопределено Тогда
		ВызватьОшибку(Схема, "фрагмент запрещен");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИзвестнаяСетеваяСхема(Схема)

	Возврат Схема = "http" Или Схема = "https"
		Или Схема = "ws" Или Схема = "wss" Или Схема = "ftp";

КонецФункции

Функция ДопустимыйСетевойПорт(ТекстПорта)

	Если ТекстПорта = "" Тогда
		Возврат Истина;
	КонецЕсли;

	Индекс = 1;
	Пока Индекс < СтрДлина(ТекстПорта) И Сред(ТекстПорта, Индекс, 1) = "0" Цикл
		Индекс = Индекс + 1;
	КонецЦикла;

	ЗначащаяЧасть = Сред(ТекстПорта, Индекс);

	Возврат СтрДлина(ЗначащаяЧасть) < 5
		Или СтрДлина(ЗначащаяЧасть) = 5 И ЗначащаяЧасть <= "65535";

КонецФункции

Процедура ВызватьОшибку(Схема, Причина)

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыйДляСхемы(),
		СтрШаблон("URL не соответствует ограничениям схемы %1: %2", Схема, Причина),
		Новый Структура("Схема,Причина", Схема, Причина)
	);

КонецПроцедуры

#КонецОбласти
