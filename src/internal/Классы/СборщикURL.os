#Использовать errors

#Область ПрограммныйИнтерфейс

// Проверяет компоненты и собирает из них строку URL.
//
// Параметры:
//  Компоненты - Структура, ФиксированнаяСтруктура - Снимок компонентов URL.
//
// Возвращаемое значение:
//  Строка - Проверенное представление URL.
//
// Исключения:
//  url.incompatible_components - Серверная часть и путь несовместимы.
//  url.invalid_syntax - Компоненты образуют недопустимое состояние.
//  url.invalid_scheme - Схема имеет недопустимый синтаксис.
//  url.invalid_percent_encoding - Компонент содержит недопустимую последовательность %HH.
//  url.invalid_authority - Данные пользователя или порт имеют недопустимый синтаксис.
//  url.invalid_host - Хост имеет недопустимый синтаксис.
Функция Собрать(Компоненты) Экспорт

	ПроверитьСовместимостьСервернойЧастиИПути(Компоненты);
	ПроверитьСинтаксисКомпонентов(Компоненты);
	Представление = СобратьСтроку(Компоненты);
	ПроверитьСогласованностьПредставлений(Компоненты, Представление);

	Возврат Представление;

КонецФункции

// Собирает серверную часть в исходном представлении без начального //.
//
// Параметры:
//  Компоненты - Структура, ФиксированнаяСтруктура - Снимок компонентов URL.
//
// Возвращаемое значение:
//  Строка, Неопределено - Серверная часть или Неопределено при её отсутствии.
Функция СобратьСервернуюЧасть(Компоненты) Экспорт

	Если Не Компоненты.СервернаяЧастьОпределена Тогда
		Возврат Неопределено;
	КонецЕсли;

	Фрагменты = Новый Массив;

	Если Компоненты.ДанныеПользователяОпределены Тогда
		Фрагменты.Добавить(Компоненты.ПредставлениеДанныхПользователя);
		Фрагменты.Добавить("@");
	КонецЕсли;

	Фрагменты.Добавить(Компоненты.ПредставлениеХоста);

	Если Компоненты.ПортУказан Тогда
		Фрагменты.Добавить(":");
		Фрагменты.Добавить(Компоненты.ТекстПорта);
	КонецЕсли;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьСинтаксисКомпонентов(Компоненты)

	Если Компоненты.Схема <> Неопределено Тогда
		РазборКомпонентовURL.ПодготовитьСхему(Компоненты.Схема);
	КонецЕсли;

	РазборКомпонентовURL.ПроверитьКодированныйПуть(Компоненты.КодированныйПуть);

	Если Компоненты.ЗапросОпределен Тогда
		РазборКомпонентовURL.ПроверитьКодированныйЗапрос(Компоненты.КодированныйЗапрос);
	КонецЕсли;

	Если Компоненты.ФрагментОпределен Тогда
		РазборКомпонентовURL.ПроверитьКодированныйФрагмент(Компоненты.КодированныйФрагмент);
	КонецЕсли;

	Если Не Компоненты.СервернаяЧастьОпределена Тогда
		Возврат;
	КонецЕсли;

	Если Компоненты.ДанныеПользователяОпределены Тогда
		РазборКомпонентовURL.ПроверитьКодированныеДанныеПользователя(
			Компоненты.КодированныеДанныеПользователя
		);
	КонецЕсли;

	РазборКомпонентовURL.ПроверитьКодированныйХост(Компоненты.КодированныйХост);

	Если Компоненты.ПортУказан Тогда
		РазборКомпонентовURL.ПодготовитьПорт(Компоненты.ТекстПорта);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСовместимостьСервернойЧастиИПути(Компоненты)

	Путь = Компоненты.КодированныйПуть;
	Несовместимы = Компоненты.СервернаяЧастьОпределена И Путь <> "" И Лев(Путь, 1) <> "/";
	Несовместимы = Несовместимы Или Не Компоненты.СервернаяЧастьОпределена И Лев(Путь, 2) = "//";

	Если Несовместимы Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыОшибокURL.НесовместимыеКомпоненты(),
			"Серверная часть и путь URL несовместимы"
		);
	КонецЕсли;

КонецПроцедуры

Функция СобратьСтроку(Компоненты)

	Фрагменты = Новый Массив;

	Если Компоненты.Схема <> Неопределено Тогда
		Фрагменты.Добавить(Компоненты.Схема);
		Фрагменты.Добавить(":");
	КонецЕсли;

	Если Компоненты.СервернаяЧастьОпределена Тогда
		Фрагменты.Добавить("//");
		Фрагменты.Добавить(СобратьСервернуюЧасть(Компоненты));
	КонецЕсли;

	Если ТребуетсяТочечныйСегментПередПутем(Компоненты) Тогда
		Фрагменты.Добавить("./");
	КонецЕсли;

	Фрагменты.Добавить(Компоненты.ПредставлениеПути);

	Если Компоненты.ЗапросОпределен Тогда
		Фрагменты.Добавить("?");
		Фрагменты.Добавить(Компоненты.ПредставлениеЗапроса);
	КонецЕсли;

	Если Компоненты.ФрагментОпределен Тогда
		Фрагменты.Добавить("#");
		Фрагменты.Добавить(Компоненты.ПредставлениеФрагмента);
	КонецЕсли;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Процедура ПроверитьСогласованностьПредставлений(Компоненты, Представление)

	КодированныеКомпоненты = КомпонентыСКодированнымиПредставлениями(Компоненты);
	КодированноеПредставление = СобратьСтроку(КодированныеКомпоненты);
	URLПредставления = Новый URL(Представление);
	КодированныйURL = Новый URL(КодированноеПредставление);

	Если URLПредставления.РавенПоКомпонентам(КодированныйURL) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыйСинтаксис(),
		"Представления компонентов URL не согласованы с кодированными значениями"
	);

КонецПроцедуры

Функция КомпонентыСКодированнымиПредставлениями(Компоненты)

	Результат = Новый Структура(Новый ФиксированнаяСтруктура(Компоненты));
	Результат.ПредставлениеДанныхПользователя = Компоненты.КодированныеДанныеПользователя;
	Результат.ПредставлениеХоста = Компоненты.КодированныйХост;
	Результат.ПредставлениеПути = Компоненты.КодированныйПуть;
	Результат.ПредставлениеЗапроса = Компоненты.КодированныйЗапрос;
	Результат.ПредставлениеФрагмента = Компоненты.КодированныйФрагмент;

	Возврат Результат;

КонецФункции

// RFC 3986 §4.2: двоеточие в первом сегменте без схемы неоднозначно и может быть принято за схему.
Функция ТребуетсяТочечныйСегментПередПутем(Компоненты)

	Если Компоненты.Схема <> Неопределено Или Компоненты.СервернаяЧастьОпределена Тогда
		Возврат Ложь;
	КонецЕсли;

	Путь = Компоненты.ПредставлениеПути;
	ПозицияРазделителя = СтрНайти(Путь, "/");
	Если ПозицияРазделителя = 0 Тогда
		ПервыйСегмент = Путь;
	Иначе
		ПервыйСегмент = Лев(Путь, ПозицияРазделителя - 1);
	КонецЕсли;

	Возврат СтрНайти(ПервыйСегмент, ":") > 0;

КонецФункции

#КонецОбласти
