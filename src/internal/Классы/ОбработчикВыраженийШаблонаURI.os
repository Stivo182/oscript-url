#Использовать errors

Перем _КодировщикКомпонентовURI; // КодировщикКомпонентовURI
Перем _ПреобразовательКодовыхТочекUnicode; // ПреобразовательКодовыхТочекUnicode
Перем _ПараметрыОператоров; // ФиксированноеСоответствие
Перем _НезарезервированныеСимволы; // Строка
Перем _НезарезервированныеИЗарезервированныеСимволы; // Строка

#Область ОбработчикиСобытий

// Создаёт обработчик выражений шаблона URI.
//
// Параметры:
//  КодировщикКомпонентовURI - КодировщикКомпонентовURI - Кодировщик UTF-8.
//  ПреобразовательКодовыхТочекUnicode - ПреобразовательКодовыхТочекUnicode - Преобразователь Unicode.
Процедура ПриСозданииОбъекта(КодировщикКомпонентовURI, ПреобразовательКодовыхТочекUnicode)

	_КодировщикКомпонентовURI = КодировщикКомпонентовURI;
	_ПреобразовательКодовыхТочекUnicode = ПреобразовательКодовыхТочекUnicode;
	_НезарезервированныеСимволы = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~";
	_НезарезервированныеИЗарезервированныеСимволы = _НезарезервированныеСимволы + ":/?#[]@!$&'()*+,;=";
	_ПараметрыОператоров = СоздатьПараметрыОператоров();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Подготавливает неизменяемые части разобранного шаблона к раскрытию.
//
// Параметры:
//  РазобранныйШаблон - ФиксированнаяСтруктура - Части и имена переменных.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Шаблон с подготовленными литералами и выражениями.
Функция Подготовить(РазобранныйШаблон) Экспорт

	Части = Новый Массив;
	Для Каждого Часть Из РазобранныйШаблон.Части Цикл
		Если Часть.Вид = "Литерал" Тогда
			Значение = Кодировать(Часть.Значение, Истина);
			Части.Добавить(Новый ФиксированнаяСтруктура("Вид,Значение", "Литерал", Значение));
		Иначе
			Значение = ПодготовитьВыражение(Часть.Значение);
			Части.Добавить(Новый ФиксированнаяСтруктура("Вид,Значение", "Выражение", Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат Новый ФиксированнаяСтруктура(
		"Части,ИменаПеременных,ИзвестныеИмена",
		Новый ФиксированныйМассив(Части),
		РазобранныйШаблон.ИменаПеременных,
		РазобранныйШаблон.ИзвестныеИмена
	);

КонецФункции

// Раскрывает подготовленный шаблон URI.
//
// Параметры:
//  ПодготовленныйШаблон - ФиксированнаяСтруктура - Кодированные части и имена переменных.
//  Значения - Соответствие, ФиксированноеСоответствие, Структура, ФиксированнаяСтруктура,
//             Неопределено - Именованные значения.
//
// Возвращаемое значение:
//  Строка - Кодированная URI-ссылка.
//
// Исключения:
//  argument.invalid_type - Передан недопустимый тип коллекции, ключа или значения.
//  argument.invalid_value.* - Значение нарушает ограничения раскрытия шаблона URI.
Функция Раскрыть(ПодготовленныйШаблон, Значения) Экспорт

	СнимокЗначений = СоздатьСнимокЗначений(ПодготовленныйШаблон, Значения);
	Фрагменты = Новый Массив;

	Для Каждого Часть Из ПодготовленныйШаблон.Части Цикл
		Если Часть.Вид = "Литерал" Тогда
			Фрагменты.Добавить(Часть.Значение);
		Иначе
			Фрагменты.Добавить(РаскрытьВыражение(Часть.Значение, СнимокЗначений));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область НормализацияЗначений

Функция СоздатьСнимокЗначений(ПодготовленныйШаблон, Значения)

	Снимок = Новый Соответствие;

	Если Значения = Неопределено Тогда
		Возврат Снимок;
	КонецЕсли;

	ВидКоллекции = ОпределитьВидЗначения(Значения);
	Если ВидКоллекции <> "Соответствие" И ВидКоллекции <> "Структура" Тогда
		ВызватьНеверныйТип(
			"Соответствие, ФиксированноеСоответствие, Структура, ФиксированнаяСтруктура",
			Значения
		);
	КонецЕсли;

	СырыеЗначения = Новый Соответствие;
	Для Каждого Пара Из Значения Цикл
		Если ТипЗнч(Пара.Ключ) <> Тип("Строка") Тогда
			ВызватьНеверныйТип("строковые ключи коллекции значений", Пара.Ключ);
		КонецЕсли;

		Если ПодготовленныйШаблон.ИзвестныеИмена.Получить(Пара.Ключ) <> Неопределено Тогда
			СырыеЗначения.Вставить(Пара.Ключ, Пара.Значение);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Имя Из ПодготовленныйШаблон.ИменаПеременных Цикл
		Значение = СырыеЗначения.Получить(Имя);
		НормализованноеЗначение = НормализоватьЗначение(Значение, Имя);
		Если НормализованноеЗначение <> Неопределено Тогда
			Снимок.Вставить(Имя, НормализованноеЗначение);
		КонецЕсли;
	КонецЦикла;

	Возврат Снимок;

КонецФункции

Функция НормализоватьЗначение(Значение, ИмяПеременной)

	ВидЗначения = ОпределитьВидЗначения(Значение);
	Если ВидЗначения = "Пусто" Тогда
		Возврат Неопределено;
	ИначеЕсли ВидЗначения = "Простое" Тогда
		СтроковоеЗначение = СтроковоеПредставление(Значение);
		ПроверитьКорректностьUnicode(СтроковоеЗначение, ИмяПеременной);
		Возврат НовоеЗначение("Простое", СтроковоеЗначение);
	ИначеЕсли ВидЗначения = "Список" Тогда
		Возврат НормализоватьСписок(Значение, ИмяПеременной);
	ИначеЕсли ВидЗначения = "Соответствие" Или ВидЗначения = "Структура" Тогда
		Возврат НормализоватьСоответствие(Значение, ИмяПеременной);
	КонецЕсли;

	ВызватьНеверныйТип(
		"Строка, Число, Булево, Дата, список или ассоциативное значение",
		Значение
	);

КонецФункции

Функция НормализоватьСписок(Список, ИмяПеременной)

	Значения = Новый Массив;
	Для Каждого Значение Из Список Цикл
		Нормализованное = НормализоватьСоставнуюЧасть(Значение, ИмяПеременной);
		Если Нормализованное <> Неопределено Тогда
			Значения.Добавить(Нормализованное);
		КонецЕсли;
	КонецЦикла;

	Если Значения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат НовоеЗначение("Список", Значения);

КонецФункции

Функция НормализоватьСоответствие(СоответствиеЗначений, ИмяПеременной)

	Пары = Новый Массив;
	АктивныеСтруктуры = Новый Соответствие;
	ЧастиКлюча = Новый Массив;
	Стек = Новый Массив;

	Если ОпределитьВидЗначения(СоответствиеЗначений) = "Структура" Тогда
		АктивныеСтруктуры.Вставить(СоответствиеЗначений, Истина);
	КонецЕсли;

	ДобавитьПарыВСтек(Стек, СоответствиеЗначений);
	Пока Стек.Количество() > 0 Цикл
		ИндексЗадачи = Стек.Количество() - 1;
		Задача = Стек[ИндексЗадачи];
		Стек.Удалить(ИндексЗадачи);

		Если Задача.Вид = "ЗавершениеСтруктуры" Тогда
			АктивныеСтруктуры.Удалить(Задача.Структура);
			ЧастиКлюча.Удалить(ЧастиКлюча.Количество() - 1);
			Продолжить;
		КонецЕсли;

		ОбработатьПару(
			Пары,
			Задача.Ключ,
			Задача.Значение,
			ИмяПеременной,
			АктивныеСтруктуры,
			ЧастиКлюча,
			Стек
		);
	КонецЦикла;

	Если Пары.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат НовоеЗначение("Соответствие", Пары);

КонецФункции

Процедура ДобавитьПарыВСтек(Стек, АссоциативноеЗначение)

	Задачи = Новый Массив;
	Для Каждого Пара Из АссоциативноеЗначение Цикл
		Задачи.Добавить(
			Новый ФиксированнаяСтруктура("Вид,Ключ,Значение", "Пара", Пара.Ключ, Пара.Значение)
		);
	КонецЦикла;

	Индекс = Задачи.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Стек.Добавить(Задачи[Индекс]);
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработатьПару(Пары, Ключ, Значение, ИмяПеременной, АктивныеСтруктуры, ЧастиКлюча, Стек)

	Если ТипЗнч(Ключ) <> Тип("Строка") Тогда
		ВызватьНеверныйТип("строковые ключи ассоциативного значения", Ключ);
	КонецЕсли;
	ПроверитьКорректностьUnicode(Ключ, ИмяПеременной);

	Если ОпределитьВидЗначения(Значение) = "Структура" Тогда
		Если АктивныеСтруктуры.Получить(Значение) <> Неопределено Тогда
			ВызватьНедопустимоеЗначение(
				"cyclic_structure",
				"вложенная структура не должна содержать циклические ссылки",
				ИмяПеременной
			);
		КонецЕсли;

		АктивныеСтруктуры.Вставить(Значение, Истина);
		ЧастиКлюча.Добавить(Ключ);
		Стек.Добавить(
			Новый ФиксированнаяСтруктура("Вид,Структура", "ЗавершениеСтруктуры", Значение)
		);
		ДобавитьПарыВСтек(Стек, Значение);
		Возврат;
	КонецЕсли;

	ЧастиКлюча.Добавить(Ключ);
	СоставнойКлюч = СтрСоединить(ЧастиКлюча, ".");
	ЧастиКлюча.Удалить(ЧастиКлюча.Количество() - 1);

	Нормализованное = НормализоватьСоставнуюЧасть(Значение, ИмяПеременной);
	Если Нормализованное <> Неопределено Тогда
		Пары.Добавить(
			Новый Структура("Ключ,Значение", СоставнойКлюч, Нормализованное)
		);
	КонецЕсли;

КонецПроцедуры

Функция НормализоватьСоставнуюЧасть(Значение, ИмяПеременной)

	ВидЗначения = ОпределитьВидЗначения(Значение);
	Если ВидЗначения = "Пусто" Тогда
		Возврат Неопределено;
	ИначеЕсли ВидЗначения = "Простое" Тогда
		СтроковоеЗначение = СтроковоеПредставление(Значение);
		ПроверитьКорректностьUnicode(СтроковоеЗначение, ИмяПеременной);
		Возврат СтроковоеЗначение;
	ИначеЕсли ВидЗначения = "Список"
		Или ВидЗначения = "Соответствие"
		Или ВидЗначения = "Структура" Тогда
		ВызватьНедопустимоеЗначение(
			"nested_composite",
			"вложенные списки и соответствия не поддерживаются",
			ИмяПеременной
		);
	КонецЕсли;

	ВызватьНеверныйТип("Строка, Число, Булево или Дата", Значение);

КонецФункции

Процедура ПроверитьКорректностьUnicode(Значение, ИмяПеременной)

	Индекс = 1;
	Пока Индекс <= СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Индекс);

		Если Код >= 55296 И Код <= 56319 Тогда // U+D800..U+DBFF, старший суррогат
			Если Индекс = СтрДлина(Значение) Тогда
				ВызватьНекорректныйUnicode(ИмяПеременной);
			КонецЕсли;

			СледующийКод = КодСимвола(Значение, Индекс + 1);
			Если СледующийКод < 56320 Или СледующийКод > 57343 Тогда // Не U+DC00..U+DFFF
				ВызватьНекорректныйUnicode(ИмяПеременной);
			КонецЕсли;

			Индекс = Индекс + 2;
		ИначеЕсли Код >= 56320 И Код <= 57343 Тогда // U+DC00..U+DFFF без старшего суррогата
			ВызватьНекорректныйUnicode(ИмяПеременной);
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция НовоеЗначение(Вид, Значение)

	Возврат Новый ФиксированнаяСтруктура("Вид,Значение", Вид, Значение);

КонецФункции

Функция СтроковоеПредставление(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат XMLСтрока(Значение);

КонецФункции

Функция ОпределитьВидЗначения(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "Пусто";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Дата") Тогда
		Возврат "Простое";
	ИначеЕсли ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Возврат "Список";
	ИначеЕсли ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Возврат "Структура";
	ИначеЕсли ТипЗначения = Тип("Соответствие")
		Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Возврат "Соответствие";
	КонецЕсли;

	Возврат "Недопустимое";

КонецФункции

#КонецОбласти

#Область РаскрытиеВыражений

Функция ПодготовитьВыражение(Выражение)

	Переменные = Новый Массив;
	Для Каждого Переменная Из Выражение.Переменные Цикл
		Переменные.Добавить(
			Новый ФиксированнаяСтруктура(
				"Имя,КодированноеИмя,Разворачивать,ДлинаПрефикса",
				Переменная.Имя,
				Кодировать(Переменная.Имя, Истина),
				Переменная.Разворачивать,
				Переменная.ДлинаПрефикса
			)
		);
	КонецЦикла;

	Возврат Новый ФиксированнаяСтруктура(
		"Оператор,Переменные,ПараметрыОператора",
		Выражение.Оператор,
		Новый ФиксированныйМассив(Переменные),
		ПолучитьПараметрыОператора(Выражение.Оператор)
	);

КонецФункции

Функция РаскрытьВыражение(Выражение, Значения)

	ПараметрыОператора = Выражение.ПараметрыОператора;
	РаскрытыеПеременные = Новый Массив;

	Для Каждого Переменная Из Выражение.Переменные Цикл
		Значение = Значения.Получить(Переменная.Имя);
		Если Значение <> Неопределено Тогда
			РаскрытыеПеременные.Добавить(
				РаскрытьПеременную(Переменная, Значение, ПараметрыОператора)
			);
		КонецЕсли;
	КонецЦикла;

	Если РаскрытыеПеременные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПараметрыОператора.Первый
		+ СтрСоединить(РаскрытыеПеременные, ПараметрыОператора.Разделитель);

КонецФункции

Функция РаскрытьПеременную(Переменная, Значение, ПараметрыОператора)

	Если Переменная.ДлинаПрефикса <> Неопределено И Значение.Вид <> "Простое" Тогда
		ВызватьНедопустимоеЗначение(
			"prefix_for_composite",
			"модификатор префикса допустим только для простого значения",
			Переменная.Имя
		);
	КонецЕсли;

	Если Значение.Вид = "Простое" Тогда
		Возврат РаскрытьПростоеЗначение(Переменная, Значение.Значение, ПараметрыОператора);
	ИначеЕсли Значение.Вид = "Список" Тогда
		Возврат РаскрытьСписок(Переменная, Значение.Значение, ПараметрыОператора);
	КонецЕсли;

	Возврат РаскрытьСоответствие(Переменная, Значение.Значение, ПараметрыОператора);

КонецФункции

Функция РаскрытьПростоеЗначение(Переменная, Знач Значение, ПараметрыОператора)

	Если Переменная.ДлинаПрефикса <> Неопределено Тогда
		Значение = ОграничитьПрефикс(Значение, Переменная.ДлинаПрефикса);
	КонецЕсли;

	КодированноеЗначение = Кодировать(Значение, ПараметрыОператора.РазрешатьЗарезервированные);
	Если Не ПараметрыОператора.РаскрыватьИмена Тогда
		Возврат КодированноеЗначение;
	КонецЕсли;

	КодированноеИмя = Переменная.КодированноеИмя;
	Если Значение = "" Тогда
		Возврат КодированноеИмя + ПараметрыОператора.СуффиксПустогоЗначения;
	КонецЕсли;

	Возврат КодированноеИмя + "=" + КодированноеЗначение;

КонецФункции

Функция РаскрытьСписок(Переменная, Список, ПараметрыОператора)

	КодированныеЗначения = Новый Массив;
	Если ПараметрыОператора.РаскрыватьИмена Тогда
		КодированноеИмя = Переменная.КодированноеИмя;
	КонецЕсли;

	Для Каждого Значение Из Список Цикл
		КодированноеЗначение = Кодировать(Значение, ПараметрыОператора.РазрешатьЗарезервированные);

		Если Переменная.Разворачивать И ПараметрыОператора.РаскрыватьИмена Тогда
			Если Значение = "" Тогда
				КодированныеЗначения.Добавить(
					КодированноеИмя + ПараметрыОператора.СуффиксПустогоЗначения
				);
			Иначе
				КодированныеЗначения.Добавить(КодированноеИмя + "=" + КодированноеЗначение);
			КонецЕсли;
		Иначе
			КодированныеЗначения.Добавить(КодированноеЗначение);
		КонецЕсли;
	КонецЦикла;

	Если Переменная.Разворачивать Тогда
		Возврат СтрСоединить(КодированныеЗначения, ПараметрыОператора.Разделитель);
	КонецЕсли;

	Результат = СтрСоединить(КодированныеЗначения, ",");
	Если ПараметрыОператора.РаскрыватьИмена Тогда
		Результат = КодированноеИмя + "=" + Результат;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция РаскрытьСоответствие(Переменная, Пары, ПараметрыОператора)

	КодированныеПары = Новый Массив;

	Для Каждого Пара Из Пары Цикл
		Ключ = Кодировать(Пара.Ключ, ПараметрыОператора.РазрешатьЗарезервированные);
		Значение = Кодировать(Пара.Значение, ПараметрыОператора.РазрешатьЗарезервированные);

		Если Переменная.Разворачивать Тогда
			Если Пара.Значение = ""
				И Не ПараметрыОператора.СохранятьРавноДляПустого Тогда
				КодированныеПары.Добавить(
					Ключ + ПараметрыОператора.СуффиксПустогоЗначения
				);
			Иначе
				КодированныеПары.Добавить(Ключ + "=" + Значение);
			КонецЕсли;
		Иначе
			КодированныеПары.Добавить(Ключ);
			КодированныеПары.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

	Разделитель = ?(Переменная.Разворачивать, ПараметрыОператора.Разделитель, ",");
	Результат = СтрСоединить(КодированныеПары, Разделитель);

	Если Не Переменная.Разворачивать И ПараметрыОператора.РаскрыватьИмена Тогда
		Результат = Переменная.КодированноеИмя + "=" + Результат;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СоздатьПараметрыОператоров()

	Параметры = Новый Соответствие;
	Параметры.Вставить("", СоздатьПараметрыОператора("", ",", Ложь, "", Ложь, Ложь));
	Параметры.Вставить("+", СоздатьПараметрыОператора("", ",", Ложь, "", Истина, Ложь));
	Параметры.Вставить("#", СоздатьПараметрыОператора("#", ",", Ложь, "", Истина, Ложь));
	Параметры.Вставить(".", СоздатьПараметрыОператора(".", ".", Ложь, "", Ложь, Ложь));
	Параметры.Вставить("/", СоздатьПараметрыОператора("/", "/", Ложь, "", Ложь, Ложь));
	Параметры.Вставить(";", СоздатьПараметрыОператора(";", ";", Истина, "", Ложь, Ложь));
	Параметры.Вставить("?", СоздатьПараметрыОператора("?", "&", Истина, "=", Ложь, Истина));
	Параметры.Вставить("&", СоздатьПараметрыОператора("&", "&", Истина, "=", Ложь, Истина));

	Возврат Новый ФиксированноеСоответствие(Параметры);

КонецФункции

Функция ПолучитьПараметрыОператора(Оператор)

	Возврат _ПараметрыОператоров.Получить(Оператор);

КонецФункции

Функция СоздатьПараметрыОператора(Первый, Разделитель, РаскрыватьИмена, СуффиксПустогоЗначения,
		РазрешатьЗарезервированные, СохранятьРавноДляПустого)

	Возврат Новый ФиксированнаяСтруктура(
		"Первый,Разделитель,РаскрыватьИмена,СуффиксПустогоЗначения,РазрешатьЗарезервированные,СохранятьРавноДляПустого",
		Первый,
		Разделитель,
		РаскрыватьИмена,
		СуффиксПустогоЗначения,
		РазрешатьЗарезервированные,
		СохранятьРавноДляПустого
	);

КонецФункции

#КонецОбласти

#Область Кодирование

Функция Кодировать(Значение, РазрешатьЗарезервированные)

	Если Не РазрешатьЗарезервированные Тогда
		Возврат _КодировщикКомпонентовURI.Кодировать(Значение, _НезарезервированныеСимволы);
	КонецЕсли;

	Если СтрНайти(Значение, "%") = 0 Тогда
		Возврат _КодировщикКомпонентовURI.Кодировать(
			Значение,
			_НезарезервированныеИЗарезервированныеСимволы
		);
	КонецЕсли;

	Фрагменты = Новый Массив;
	НачалоФрагмента = 1;
	Индекс = 1;

	Пока Индекс <= СтрДлина(Значение) Цикл
		Если ЭтоПроцентныйТриплет(Значение, Индекс) Тогда
			Если Индекс > НачалоФрагмента Тогда
				Фрагменты.Добавить(
					_КодировщикКомпонентовURI.Кодировать(
						Сред(Значение, НачалоФрагмента, Индекс - НачалоФрагмента),
						_НезарезервированныеИЗарезервированныеСимволы
					)
				);
			КонецЕсли;

			Фрагменты.Добавить(Сред(Значение, Индекс, 3));
			Индекс = Индекс + 3;
			НачалоФрагмента = Индекс;
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Если НачалоФрагмента <= СтрДлина(Значение) Тогда
		Фрагменты.Добавить(
			_КодировщикКомпонентовURI.Кодировать(
				Сред(Значение, НачалоФрагмента),
				_НезарезервированныеИЗарезервированныеСимволы
			)
		);
	КонецЕсли;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Функция ОграничитьПрефикс(Значение, МаксимальнаяДлина)

	Фрагменты = Новый Массив;
	Индекс = 1;
	Количество = 0;

	Пока Индекс <= СтрДлина(Значение) И Количество < МаксимальнаяДлина Цикл
		ДлинаПроцентногоСимвола = ДлинаПроцентногоСимвола(Значение, Индекс);

		Если ДлинаПроцентногоСимвола > 0 Тогда
			Фрагменты.Добавить(Сред(Значение, Индекс, ДлинаПроцентногоСимвола));
			Индекс = Индекс + ДлинаПроцентногоСимвола;
		Иначе
			Код = КодСимвола(Значение, Индекс);
			ДлинаСимвола = ?(Код >= 55296 И Код <= 56319, 2, 1); // U+D800..U+DBFF, старший суррогат
			Фрагменты.Добавить(Сред(Значение, Индекс, ДлинаСимвола));
			Индекс = Индекс + ДлинаСимвола;
		КонецЕсли;

		Количество = Количество + 1;
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Функция ДлинаПроцентногоСимвола(Значение, Индекс)

	Если Не ЭтоПроцентныйТриплет(Значение, Индекс) Тогда
		Возврат 0;
	КонецЕсли;

	ПервыйБайт = _КодировщикКомпонентовURI.ЗначениеШестнадцатеричногоБайта(
		Сред(Значение, Индекс + 1, 2)
	);

	Если ПервыйБайт <= 127 Тогда // 00..7F, один байт UTF-8
		КоличествоБайтов = 1;
	ИначеЕсли ПервыйБайт >= 194 И ПервыйБайт <= 223 Тогда // C2..DF, начало двухбайтовой последовательности
		КоличествоБайтов = 2;
	ИначеЕсли ПервыйБайт >= 224 И ПервыйБайт <= 239 Тогда // E0..EF, начало трёхбайтовой последовательности
		КоличествоБайтов = 3;
	ИначеЕсли ПервыйБайт >= 240 И ПервыйБайт <= 244 Тогда // F0..F4, начало четырёхбайтовой последовательности
		КоличествоБайтов = 4;
	Иначе
		Возврат 3;
	КонецЕсли;

	Для НомерБайта = 1 По КоличествоБайтов - 1 Цикл
		Если Не ЭтоПроцентныйТриплет(Значение, Индекс + НомерБайта * 3) Тогда
			Возврат 3;
		КонецЕсли;
	КонецЦикла;

	Длина = КоличествоБайтов * 3;
	Попытка
		Данные = _КодировщикКомпонентовURI.ДекодироватьВБайты(Сред(Значение, Индекс, Длина));
		Декодированное = _КодировщикКомпонентовURI.ДекодироватьСтрогийUTF8(Данные);
		Если _ПреобразовательКодовыхТочекUnicode.ИзСтроки(Декодированное).Количество() <> 1 Тогда
			Возврат 3;
		КонецЕсли;
	Исключение
		Возврат 3;
	КонецПопытки;

	Возврат Длина;

КонецФункции

Функция ЭтоПроцентныйТриплет(Значение, Индекс)

	Возврат Индекс + 2 <= СтрДлина(Значение)
		И Сред(Значение, Индекс, 1) = "%"
		И _КодировщикКомпонентовURI.ЗначениеШестнадцатеричногоБайта(
			Сред(Значение, Индекс + 1, 2)
		) <> Неопределено;

КонецФункции

#КонецОбласти

#Область Ошибки

Процедура ВызватьНекорректныйUnicode(ИмяПеременной)

	ВызватьНедопустимоеЗначение(
		"invalid_unicode",
		"строка должна содержать корректные скалярные значения Unicode",
		ИмяПеременной
	);

КонецПроцедуры

Процедура ВызватьНеверныйТип(ОжидаемыйТип, Значение)

	ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
		"Значения",
		ОжидаемыйТип,
		Значение
	);

КонецПроцедуры

Процедура ВызватьНедопустимоеЗначение(УточнениеКода, Ожидание, ИмяПеременной)

	ДанныеОшибки = Новый Структура("ИмяПеременной,Ожидание", ИмяПеременной, Ожидание);

	Сообщение = СтрШаблон(
		"Недопустимое значение переменной шаблона URI ""%1"": %2",
		ИмяПеременной,
		Ожидание
	);

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента() + "." + УточнениеКода,
		Сообщение,
		ДанныеОшибки
	);

КонецПроцедуры

#КонецОбласти

#КонецОбласти
