#Использовать errors

Перем _ИмяФайла; // Строка

#Область ОбработчикиСобытий

// Создаёт читатель нормативных данных IDNA.
//
// Параметры:
//  ИмяФайла - Строка, Неопределено - Необязательный путь к контейнеру данных.
//
// Исключения:
//  argument.invalid_type - ИмяФайла имеет недопустимый тип.
Процедура ПриСозданииОбъекта(ИмяФайла = Неопределено)

	Если ИмяФайла = Неопределено Тогда
		_ИмяФайла = ОбъединитьПути(
			ТекущийСценарий().Каталог,
			"..",
			"Данные",
			"ДанныеIDNA.bin"
		);
	Иначе
		ПроверкаАргументов.ПроверитьТип("ИмяФайла", ИмяФайла, Тип("Строка"));
		_ИмяФайла = ИмяФайла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает сопоставления UTS #46.
//
// Возвращаемое значение:
//  БуферДвоичныхДанных - Сопоставления UTS #46.
//
// Исключения:
//  idna.data.invalid - Контейнер данных IDNA отсутствует, недоступен или повреждён.
Функция ПолучитьСопоставления() Экспорт

	Возврат ПолучитьСекцию(1);

КонецФункции

// Возвращает данные канонической нормализации Unicode.
//
// Возвращаемое значение:
//  БуферДвоичныхДанных - Данные канонической нормализации.
//
// Исключения:
//  idna.data.invalid - Контейнер данных IDNA отсутствует, недоступен или повреждён.
Функция ПолучитьНормализацию() Экспорт

	Возврат ПолучитьСекцию(2);

КонецФункции

// Возвращает диапазоны быстрой проверки NFC.
//
// Возвращаемое значение:
//  БуферДвоичныхДанных - Диапазоны быстрой проверки NFC.
//
// Исключения:
//  idna.data.invalid - Контейнер данных IDNA отсутствует, недоступен или повреждён.
Функция ПолучитьБыструюПроверкуNFC() Экспорт

	Возврат ПолучитьСекцию(3);

КонецФункции

// Возвращает классы комбинирования Unicode.
//
// Возвращаемое значение:
//  БуферДвоичныхДанных - Классы комбинирования Unicode.
//
// Исключения:
//  idna.data.invalid - Контейнер данных IDNA отсутствует, недоступен или повреждён.
Функция ПолучитьКлассыКомбинирования() Экспорт

	Возврат ПолучитьСекцию(4);

КонецФункции

// Возвращает категории меток Unicode.
//
// Возвращаемое значение:
//  БуферДвоичныхДанных - Категории меток Unicode.
//
// Исключения:
//  idna.data.invalid - Контейнер данных IDNA отсутствует, недоступен или повреждён.
Функция ПолучитьКатегорииМеток() Экспорт

	Возврат ПолучитьСекцию(5);

КонецФункции

// Возвращает исключения канонической композиции Unicode.
//
// Возвращаемое значение:
//  БуферДвоичныхДанных - Исключения канонической композиции.
//
// Исключения:
//  idna.data.invalid - Контейнер данных IDNA отсутствует, недоступен или повреждён.
Функция ПолучитьИсключенияКомпозиции() Экспорт

	Возврат ПолучитьСекцию(6);

КонецФункции

// Возвращает классы направления Unicode.
//
// Возвращаемое значение:
//  БуферДвоичныхДанных - Классы направления Unicode.
//
// Исключения:
//  idna.data.invalid - Контейнер данных IDNA отсутствует, недоступен или повреждён.
Функция ПолучитьКлассыНаправления() Экспорт

	Возврат ПолучитьСекцию(7);

КонецФункции

// Возвращает диапазоны двунаправленного письма в доменах.
//
// Возвращаемое значение:
//  БуферДвоичныхДанных - Диапазоны двунаправленного письма.
//
// Исключения:
//  idna.data.invalid - Контейнер данных IDNA отсутствует, недоступен или повреждён.
Функция ПолучитьНаправленияДоменов() Экспорт

	Возврат ПолучитьСекцию(8);

КонецФункции

// Возвращает типы соединения Unicode.
//
// Возвращаемое значение:
//  БуферДвоичныхДанных - Типы соединения Unicode.
//
// Исключения:
//  idna.data.invalid - Контейнер данных IDNA отсутствует, недоступен или повреждён.
Функция ПолучитьТипыСоединения() Экспорт

	Возврат ПолучитьСекцию(9);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает одну секцию нормативных данных IDNA.
//
// Параметры:
//  Идентификатор - Число - Номер секции от 1 до 9.
//
// Возвращаемое значение:
//  БуферДвоичныхДанных - Данные выбранной секции только для чтения.
Функция ПолучитьСекцию(Идентификатор)

	Поток = Неопределено;
	Попытка
		Поток = Новый ФайловыйПоток(
			_ИмяФайла,
			РежимОткрытияФайла.Открыть,
			ДоступКФайлу.Чтение
		);
		Результат = ПрочитатьСекциюИзКонтейнера(Поток, Идентификатор);
		Поток.Закрыть();
	Исключение
		Причина = ИнформацияОбОшибке();
		ЗакрытьПотокБезОшибки(Поток);
		ДанныеОшибки = Новый Структура("ИмяФайла,Идентификатор", _ИмяФайла, Идентификатор);
		ВызватьИсключение ФабрикаОшибок.Обернуть(
			Причина,
			КодыОшибокURL.НедопустимыеДанныеIDNA(),
			"Невозможно прочитать нормативные данные IDNA",
			ДанныеОшибки
		);
	КонецПопытки;
	Возврат Результат;

КонецФункции

Функция ПрочитатьСекциюИзКонтейнера(Поток, Идентификатор)

	СигнатураКонтейнера = 826426441; // ASCII: IDB1.
	ВерсияФормата = 2;
	РазмерЗаголовка = 16;
	РазмерЗаписиКаталога = 44;
	КоличествоСекций = 9;
	СмещениеДанных = РазмерЗаголовка + КоличествоСекций * РазмерЗаписиКаталога;
	Заголовок = ПрочитатьБуфер(Поток, РазмерЗаголовка);

	Если Заголовок.ПрочитатьЦелое32(0) <> СигнатураКонтейнера
		Или Заголовок.ПрочитатьЦелое16(4) <> ВерсияФормата
		Или Заголовок.ПрочитатьЦелое16(6) <> РазмерЗаписиКаталога
		Или Заголовок.ПрочитатьЦелое32(8) <> КоличествоСекций
		Или Заголовок.ПрочитатьЦелое32(12) <> СмещениеДанных Тогда
		ВызватьНедопустимыеДанныеIDNA("Некорректный формат ДанныеIDNA.bin");
	КонецЕсли;

	ВыбраннаяЗапись = Неопределено;
	ОжидаемоеСмещение = СмещениеДанных;

	Для Индекс = 0 По КоличествоСекций - 1 Цикл
		ЗаписьКаталога = ПрочитатьБуфер(Поток, РазмерЗаписиКаталога);
		ИдентификаторЗаписи = ЗаписьКаталога.ПрочитатьЦелое16(0);
		Смещение = ЗаписьКаталога.ПрочитатьЦелое32(4);
		Размер = ЗаписьКаталога.ПрочитатьЦелое32(8);

		Если ИдентификаторЗаписи <> Индекс + 1
			Или ЗаписьКаталога.ПрочитатьЦелое16(2) <> 0
			Или Смещение <> ОжидаемоеСмещение
			Или Размер <= 0
			Или Размер > Поток.Размер() - Смещение Тогда
			ВызватьНедопустимыеДанныеIDNA("Поврежден каталог ДанныеIDNA.bin");
		КонецЕсли;

		ОжидаемоеСмещение = Смещение + Размер;

		Если ИдентификаторЗаписи = Идентификатор Тогда
			ВыбраннаяЗапись = ЗаписьКаталога;
		КонецЕсли;
	КонецЦикла;

	Если ОжидаемоеСмещение <> Поток.Размер() Тогда
		ВызватьНедопустимыеДанныеIDNA("Поврежден каталог ДанныеIDNA.bin");
	КонецЕсли;

	Если ВыбраннаяЗапись <> Неопределено Тогда
		Смещение = ВыбраннаяЗапись.ПрочитатьЦелое32(4);
		Размер = ВыбраннаяЗапись.ПрочитатьЦелое32(8);
		Поток.Перейти(Смещение);
		Результат = ПрочитатьБуфер(Поток, Размер);
		ПроверитьSHA256(Результат, ВыбраннаяЗапись);
		ПроверитьСтруктуруСекции(Идентификатор, Результат);
		Возврат Результат;
	КонецЕсли;

	ВызватьНедопустимыеДанныеIDNA(
		СтрШаблон("Секция данных IDNA %1 не найдена", Идентификатор),
		Новый Структура("Идентификатор", Идентификатор)
	);

КонецФункции

Процедура ПроверитьSHA256(Буфер, ЗаписьКаталога)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер));
	ФактическийХеш = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Хеширование.ХешСумма);

	Для Индекс = 0 По ФактическийХеш.Размер - 1 Цикл
		Если ФактическийХеш[Индекс] <> ЗаписьКаталога[Индекс + 12] Тогда
			ВызватьНедопустимыеДанныеIDNA("Повреждена секция ДанныеIDNA.bin");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьСтруктуруСекции(Идентификатор, Таблица)

	Если Идентификатор = 1 Тогда
		ПроверитьТаблицуСопоставлений(Таблица);
	ИначеЕсли Идентификатор = 2 Тогда
		ПроверитьТаблицуНормализации(Таблица);
	ИначеЕсли Идентификатор = 3 Или Идентификатор = 6 Или Идентификатор = 8 Тогда
		ПроверитьТаблицуДиапазонов(Таблица, 8, 0);
	ИначеЕсли Идентификатор = 4 Тогда
		ПроверитьТаблицуКлассовКомбинирования(Таблица);
	ИначеЕсли Идентификатор = 5 Тогда
		ПроверитьТаблицуКодовыхТочек(Таблица, 4);
	ИначеЕсли Идентификатор = 7 Тогда
		ПроверитьТаблицуДиапазонов(Таблица, 12, 23);
	ИначеЕсли Идентификатор = 9 Тогда
		ПроверитьТаблицуДиапазонов(Таблица, 12, 6);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьТаблицуСопоставлений(Таблица)

	Если Таблица.Размер < 16
		Или Таблица.ПрочитатьЦелое32(0) <> 827212873 // ASCII: IDN1.
		Или Таблица.ПрочитатьЦелое16(4) <> 1
		Или Таблица.ПрочитатьЦелое16(6) <> 16 Тогда
		ВызватьНедопустимыеДанныеIDNA("Повреждена таблица сопоставлений IDNA");
	КонецЕсли;

	КоличествоЗаписей = Таблица.ПрочитатьЦелое32(8);
	СмещениеПула = Таблица.ПрочитатьЦелое32(12);

	Если КоличествоЗаписей <= 0
		Или СмещениеПула <> 16 + КоличествоЗаписей * 16
		Или СмещениеПула > Таблица.Размер Тогда
		ВызватьНедопустимыеДанныеIDNA("Повреждены размеры таблицы сопоставлений IDNA");
	КонецЕсли;

	ПредыдущийКонец = Неопределено;
	ОжидаемоеСмещение = 0;

	Для Индекс = 0 По КоличествоЗаписей - 1 Цикл
		СмещениеЗаписи = 16 + Индекс * 16;
		НачалоДиапазона = Таблица.ПрочитатьЦелое32(СмещениеЗаписи);
		КонецДиапазона = Таблица.ПрочитатьЦелое32(СмещениеЗаписи + 4);
		КодСтатуса = Таблица[СмещениеЗаписи + 8];
		КоличествоТочек = Таблица.ПрочитатьЦелое16(СмещениеЗаписи + 10);
		Смещение = Таблица.ПрочитатьЦелое32(СмещениеЗаписи + 12);

		Если Не ДопустимыйДиапазонКодовыхТочек(НачалоДиапазона, КонецДиапазона, ПредыдущийКонец)
			Или КодСтатуса < 1 Или КодСтатуса > 7
			Или Таблица[СмещениеЗаписи + 9] <> 0
			Или Смещение <> ОжидаемоеСмещение
			Или СмещениеПула + Смещение + КоличествоТочек * 4 > Таблица.Размер Тогда
			ВызватьНедопустимыеДанныеIDNA("Повреждена запись таблицы сопоставлений IDNA");
		КонецЕсли;

		ПроверитьПулКодовыхТочек(Таблица, СмещениеПула + Смещение, КоличествоТочек);

		ПредыдущийКонец = КонецДиапазона;
		ОжидаемоеСмещение = ОжидаемоеСмещение + КоличествоТочек * 4;
	КонецЦикла;

	Если СмещениеПула + ОжидаемоеСмещение <> Таблица.Размер Тогда
		ВызватьНедопустимыеДанныеIDNA("Поврежден пул таблицы сопоставлений IDNA");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьТаблицуНормализации(Таблица)

	Если Таблица.Размер < 8 Тогда
		ВызватьНедопустимыеДанныеIDNA("Повреждена таблица нормализации Unicode");
	КонецЕсли;

	КоличествоЗаписей = Таблица.ПрочитатьЦелое32(0);
	СмещениеПула = Таблица.ПрочитатьЦелое32(4);

	Если КоличествоЗаписей < 0
		Или СмещениеПула <> 8 + КоличествоЗаписей * 12
		Или СмещениеПула > Таблица.Размер Тогда
		ВызватьНедопустимыеДанныеIDNA("Повреждены размеры таблицы нормализации Unicode");
	КонецЕсли;

	ПредыдущаяТочка = Неопределено;
	ОжидаемоеСмещение = 0;

	Для Индекс = 0 По КоличествоЗаписей - 1 Цикл
		СмещениеЗаписи = 8 + Индекс * 12;
		КодоваяТочка = Таблица.ПрочитатьЦелое32(СмещениеЗаписи);
		Класс = Таблица.ПрочитатьЦелое16(СмещениеЗаписи + 4);
		КоличествоТочек = Таблица[СмещениеЗаписи + 7];
		Смещение = Таблица.ПрочитатьЦелое32(СмещениеЗаписи + 8);

		Если Не ДопустимоеСкалярноеЗначение(КодоваяТочка)
			Или ПредыдущаяТочка <> Неопределено И КодоваяТочка <= ПредыдущаяТочка
			Или Класс < 0 Или Класс > 254
			Или Таблица[СмещениеЗаписи + 6] > 1
			Или Смещение <> ОжидаемоеСмещение
			Или СмещениеПула + Смещение + КоличествоТочек * 4 > Таблица.Размер Тогда
			ВызватьНедопустимыеДанныеIDNA("Повреждена запись таблицы нормализации Unicode");
		КонецЕсли;

		ПроверитьПулКодовыхТочек(Таблица, СмещениеПула + Смещение, КоличествоТочек);

		ПредыдущаяТочка = КодоваяТочка;
		ОжидаемоеСмещение = ОжидаемоеСмещение + КоличествоТочек * 4;
	КонецЦикла;

	Если СмещениеПула + ОжидаемоеСмещение <> Таблица.Размер Тогда
		ВызватьНедопустимыеДанныеIDNA("Поврежден пул таблицы нормализации Unicode");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьТаблицуДиапазонов(Таблица, РазмерЗаписи, МаксимальныйКодЗначения)

	КоличествоЗаписей = ПроверитьРазмерТаблицы(Таблица, РазмерЗаписи);
	ПредыдущийКонец = Неопределено;

	Для Индекс = 0 По КоличествоЗаписей - 1 Цикл
		Смещение = 4 + Индекс * РазмерЗаписи;
		НачалоДиапазона = Таблица.ПрочитатьЦелое32(Смещение);
		КонецДиапазона = Таблица.ПрочитатьЦелое32(Смещение + 4);

		Если Не ДопустимыйДиапазон(НачалоДиапазона, КонецДиапазона, ПредыдущийКонец) Тогда
			ВызватьНедопустимыеДанныеIDNA("Повреждена таблица диапазонов Unicode");
		КонецЕсли;

		Если МаксимальныйКодЗначения > 0 Тогда
			КодЗначения = Таблица[Смещение + 8];

			Если КодЗначения = 0
				Или КодЗначения > МаксимальныйКодЗначения
				Или Таблица[Смещение + 9] <> 0
				Или Таблица[Смещение + 10] <> 0
				Или Таблица[Смещение + 11] <> 0 Тогда
				ВызватьНедопустимыеДанныеIDNA("Неизвестный код значения Unicode");
			КонецЕсли;
		КонецЕсли;

		ПредыдущийКонец = КонецДиапазона;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьТаблицуКлассовКомбинирования(Таблица)

	КоличествоЗаписей = ПроверитьРазмерТаблицы(Таблица, 8);
	ПредыдущаяТочка = Неопределено;

	Для Индекс = 0 По КоличествоЗаписей - 1 Цикл
		Смещение = 4 + Индекс * 8;
		КодоваяТочка = Таблица.ПрочитатьЦелое32(Смещение);
		Класс = Таблица.ПрочитатьЦелое16(Смещение + 4);

		Если Не ДопустимоеСкалярноеЗначение(КодоваяТочка)
			Или ПредыдущаяТочка <> Неопределено И КодоваяТочка <= ПредыдущаяТочка
			Или Класс = 0 Или Класс > 254
			Или Таблица[Смещение + 6] <> 0 Или Таблица[Смещение + 7] <> 0 Тогда
			ВызватьНедопустимыеДанныеIDNA("Повреждена таблица классов комбинирования Unicode");
		КонецЕсли;

		ПредыдущаяТочка = КодоваяТочка;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьТаблицуКодовыхТочек(Таблица, РазмерЗаписи)

	КоличествоЗаписей = ПроверитьРазмерТаблицы(Таблица, РазмерЗаписи);
	ПредыдущаяТочка = Неопределено;

	Для Индекс = 0 По КоличествоЗаписей - 1 Цикл
		КодоваяТочка = Таблица.ПрочитатьЦелое32(4 + Индекс * РазмерЗаписи);

		Если Не ДопустимоеСкалярноеЗначение(КодоваяТочка)
			Или ПредыдущаяТочка <> Неопределено И КодоваяТочка <= ПредыдущаяТочка Тогда
			ВызватьНедопустимыеДанныеIDNA("Повреждена таблица кодовых точек Unicode");
		КонецЕсли;

		ПредыдущаяТочка = КодоваяТочка;
	КонецЦикла;

КонецПроцедуры

Функция ПроверитьРазмерТаблицы(Таблица, РазмерЗаписи)

	Если Таблица.Размер < 4 Тогда
		ВызватьНедопустимыеДанныеIDNA("Повреждена двоичная таблица Unicode");
	КонецЕсли;

	КоличествоЗаписей = Таблица.ПрочитатьЦелое32(0);

	Если КоличествоЗаписей < 0 Или Таблица.Размер <> 4 + КоличествоЗаписей * РазмерЗаписи Тогда
		ВызватьНедопустимыеДанныеIDNA("Повреждены размеры двоичной таблицы Unicode");
	КонецЕсли;

	Возврат КоличествоЗаписей;

КонецФункции

Процедура ПроверитьПулКодовыхТочек(Таблица, Смещение, КоличествоТочек)

	Для Индекс = 0 По КоличествоТочек - 1 Цикл
		Если Не ДопустимоеСкалярноеЗначение(Таблица.ПрочитатьЦелое32(Смещение + Индекс * 4)) Тогда
			ВызватьНедопустимыеДанныеIDNA("Пул содержит недопустимую кодовую точку Unicode");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ДопустимыйДиапазон(НачалоДиапазона, КонецДиапазона, ПредыдущийКонец)

	Возврат ДопустимоеСкалярноеЗначение(НачалоДиапазона)
		И ДопустимоеСкалярноеЗначение(КонецДиапазона)
		И НачалоДиапазона <= КонецДиапазона
		И (ПредыдущийКонец = Неопределено Или НачалоДиапазона > ПредыдущийКонец);

КонецФункции

Функция ДопустимыйДиапазонКодовыхТочек(НачалоДиапазона, КонецДиапазона, ПредыдущийКонец)

	Возврат ДопустимаяКодоваяТочка(НачалоДиапазона)
		И ДопустимаяКодоваяТочка(КонецДиапазона)
		И НачалоДиапазона <= КонецДиапазона
		И (ПредыдущийКонец = Неопределено Или НачалоДиапазона > ПредыдущийКонец);

КонецФункции

Функция ДопустимаяКодоваяТочка(КодоваяТочка)

	Возврат КодоваяТочка >= 0 И КодоваяТочка <= 1114111;

КонецФункции

Функция ДопустимоеСкалярноеЗначение(КодоваяТочка)

	Возврат ДопустимаяКодоваяТочка(КодоваяТочка)
		И Не (КодоваяТочка >= 55296 И КодоваяТочка <= 57343);

КонецФункции

Функция ПрочитатьБуфер(Поток, Размер)

	Буфер = Новый БуферДвоичныхДанных(Размер);

	Если Поток.Прочитать(Буфер, 0, Размер) <> Размер Тогда
		ВызватьНедопустимыеДанныеIDNA("Неожиданный конец ДанныеIDNA.bin");
	КонецЕсли;

	Буфер.УстановитьТолькоЧтение();
	Возврат Буфер;

КонецФункции

Процедура ЗакрытьПотокБезОшибки(Поток)

	Если Поток = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Поток.Закрыть();
	Исключение
		// Ошибка закрытия не должна скрывать исходную ошибку чтения.
	КонецПопытки;

КонецПроцедуры

Процедура ВызватьНедопустимыеДанныеIDNA(Сообщение, Данные = Неопределено)

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыеДанныеIDNA(),
		Сообщение,
		Данные
	);

КонецПроцедуры

#КонецОбласти
