Перем _КлассыКомбинирования; // Соответствие, Неопределено
Перем _КатегорииМеток; // Соответствие, Неопределено
Перем _Разложения; // Соответствие, Неопределено
Перем _Композиции; // Соответствие, Неопределено
Перем _НачалаБыстройПроверкиNFC; // Массив, Неопределено
Перем _КонцыБыстройПроверкиNFC; // Массив, Неопределено
Перем _БлокировкаИнициализации; // БлокировкаРесурса
Перем _ЧитательДанных; // ЧитательДанныхIDNA
Перем _ПреобразовательКодовыхТочекUnicode; // ПреобразовательКодовыхТочекUnicode

#Область ОбработчикиСобытий

// Создаёт нормализатор строк Unicode.
//
// Параметры:
//  ПреобразовательКодовыхТочекUnicode - ПреобразовательКодовыхТочекUnicode - Преобразователь точек.
Процедура ПриСозданииОбъекта(ПреобразовательКодовыхТочекUnicode)

	_ПреобразовательКодовыхТочекUnicode = ПреобразовательКодовыхТочекUnicode;
	_ЧитательДанных = Новый ЧитательДанныхIDNA;
	_БлокировкаИнициализации = Новый БлокировкаРесурса;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Приводит строку Unicode к канонической форме NFC.
//
// Параметры:
//  Значение - Строка - Нормализуемая строка.
//
// Возвращаемое значение:
//  Строка, Неопределено - Строка в NFC или Неопределено для некорректной последовательности UTF-16.
Функция ПривестиКNFC(Значение) Экспорт

	КодовыеТочки = _ПреобразовательКодовыхТочекUnicode.ИзСтроки(Значение);

	Если КодовыеТочки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ЭтоNFCПоБыстройПроверке(КодовыеТочки) Тогда
		Возврат Значение;
	КонецЕсли;

	ИнициализироватьТаблицы();
	РазложенныеТочки = Новый Массив;

	Для Каждого КодоваяТочка Из КодовыеТочки Цикл
		ДобавитьКаноническоеРазложение(КодоваяТочка, РазложенныеТочки);
	КонецЦикла;

	УпорядочитьКомбинируемыеТочки(РазложенныеТочки);
	Возврат _ПреобразовательКодовыхТочекUnicode.ВСтроку(СоставитьКодовыеТочки(РазложенныеТочки));

КонецФункции

// Возвращает канонический класс комбинирования кодовой точки Unicode.
//
// Параметры:
//  КодоваяТочка - Число - Кодовая точка Unicode.
//
// Возвращаемое значение:
//  Число - Канонический класс комбинирования.
Функция КлассКомбинирования(КодоваяТочка) Экспорт

	ИнициализироватьКлассыКомбинирования();
	Класс = _КлассыКомбинирования.Получить(КодоваяТочка);
	Возврат ?(Класс = Неопределено, 0, Класс);

КонецФункции

// Проверяет принадлежность кодовой точки к общей категории Unicode M (Mark).
//
// Параметры:
//  КодоваяТочка - Число - Кодовая точка Unicode.
//
// Возвращаемое значение:
//  Булево - Истина, если кодовая точка относится к категории Mn, Mc или Me.
Функция ЭтоКомбинирующийСимвол(КодоваяТочка) Экспорт

	ИнициализироватьКатегорииМеток();
	Возврат _КатегорииМеток.Получить(КодоваяТочка) <> Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоNFCПоБыстройПроверке(КодовыеТочки)

	ИнициализироватьБыструюПроверкуNFC();
	ИнициализироватьКлассыКомбинирования();
	ПредыдущийКласс = 0;

	Для Каждого КодоваяТочка Из КодовыеТочки Цикл
		Если _ПреобразовательКодовыхТочекUnicode.ИндексДиапазона(
			КодоваяТочка,
			_НачалаБыстройПроверкиNFC,
			_КонцыБыстройПроверкиNFC
		) <> Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Класс = _КлассыКомбинирования.Получить(КодоваяТочка);
		Класс = ?(Класс = Неопределено, 0, Класс);

		Если Класс = 0 Тогда
			ПредыдущийКласс = 0;
		ИначеЕсли Класс < ПредыдущийКласс Тогда
			Возврат Ложь;
		Иначе
			ПредыдущийКласс = Класс;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура ИнициализироватьБыструюПроверкуNFC()

	_БлокировкаИнициализации.Заблокировать();
	Попытка
		Если _НачалаБыстройПроверкиNFC <> Неопределено Тогда
			_БлокировкаИнициализации.Разблокировать();
			Возврат;
		КонецЕсли;

		Начала = Новый Массив;
		Концы = Новый Массив;
		Таблица = _ЧитательДанных.ПолучитьБыструюПроверкуNFC();

		Для Индекс = 0 По Таблица.ПрочитатьЦелое32(0) - 1 Цикл
			Смещение = 4 + Индекс * 8;
			Начала.Добавить(Таблица.ПрочитатьЦелое32(Смещение));
			Концы.Добавить(Таблица.ПрочитатьЦелое32(Смещение + 4));
		КонецЦикла;

		_НачалаБыстройПроверкиNFC = Начала;
		_КонцыБыстройПроверкиNFC = Концы;
	Исключение
		_БлокировкаИнициализации.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	_БлокировкаИнициализации.Разблокировать();

КонецПроцедуры

Процедура ИнициализироватьКлассыКомбинирования()

	_БлокировкаИнициализации.Заблокировать();
	Попытка
		Если _КлассыКомбинирования <> Неопределено Тогда
			_БлокировкаИнициализации.Разблокировать();
			Возврат;
		КонецЕсли;

		Классы = Новый Соответствие;
		Таблица = _ЧитательДанных.ПолучитьКлассыКомбинирования();

		Для Индекс = 0 По Таблица.ПрочитатьЦелое32(0) - 1 Цикл
			Смещение = 4 + Индекс * 8;
			Классы.Вставить(
				Таблица.ПрочитатьЦелое32(Смещение),
				Таблица.ПрочитатьЦелое16(Смещение + 4)
			);
		КонецЦикла;

		_КлассыКомбинирования = Классы;
	Исключение
		_БлокировкаИнициализации.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	_БлокировкаИнициализации.Разблокировать();

КонецПроцедуры

Процедура ИнициализироватьКатегорииМеток()

	_БлокировкаИнициализации.Заблокировать();
	Попытка
		Если _КатегорииМеток <> Неопределено Тогда
			_БлокировкаИнициализации.Разблокировать();
			Возврат;
		КонецЕсли;

		Категории = Новый Соответствие;
		Таблица = _ЧитательДанных.ПолучитьКатегорииМеток();

		Для Индекс = 0 По Таблица.ПрочитатьЦелое32(0) - 1 Цикл
			Категории.Вставить(Таблица.ПрочитатьЦелое32(4 + Индекс * 4), Истина);
		КонецЦикла;

		_КатегорииМеток = Категории;
	Исключение
		_БлокировкаИнициализации.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	_БлокировкаИнициализации.Разблокировать();

КонецПроцедуры

Процедура ИнициализироватьТаблицы()

	_БлокировкаИнициализации.Заблокировать();
	Попытка
		Если _Разложения <> Неопределено Тогда
			_БлокировкаИнициализации.Разблокировать();
			Возврат;
		КонецЕсли;

		КлассыКомбинирования = Новый Соответствие;
		КатегорииМеток = Новый Соответствие;
		Разложения = Новый Соответствие;
		Композиции = Новый Соответствие;
		Исключения = ПолучитьИсключенияКомпозиции();

		Таблица = _ЧитательДанных.ПолучитьНормализацию();
		СмещениеПула = Таблица.ПрочитатьЦелое32(4);

		Для Индекс = 0 По Таблица.ПрочитатьЦелое32(0) - 1 Цикл
			СмещениеЗаписи = 8 + Индекс * 12;
			КодоваяТочка = Таблица.ПрочитатьЦелое32(СмещениеЗаписи);
			КлассТочки = Таблица.ПрочитатьЦелое16(СмещениеЗаписи + 4);

			Если КлассТочки <> 0 Тогда
				КлассыКомбинирования.Вставить(КодоваяТочка, КлассТочки);
			КонецЕсли;

			Если Таблица[СмещениеЗаписи + 6] = 1 Тогда
				КатегорииМеток.Вставить(КодоваяТочка, Истина);
			КонецЕсли;

			КоличествоТочек = Таблица[СмещениеЗаписи + 7];

			Если КоличествоТочек > 0 Тогда
				Разложение = Новый Массив;
				СмещениеРазложения = СмещениеПула + Таблица.ПрочитатьЦелое32(СмещениеЗаписи + 8);

				Для ИндексТочки = 0 По КоличествоТочек - 1 Цикл
					Разложение.Добавить(Таблица.ПрочитатьЦелое32(СмещениеРазложения + ИндексТочки * 4));
				КонецЦикла;

				Разложения.Вставить(КодоваяТочка, Разложение);

				Если Разложение.Количество() = 2
					И Исключения.Получить(КодоваяТочка) = Неопределено
					И КлассыКомбинирования.Получить(Разложение[0]) = Неопределено Тогда
					Композиции.Вставить(КлючКомпозиции(Разложение[0], Разложение[1]), КодоваяТочка);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		_КлассыКомбинирования = КлассыКомбинирования;
		_КатегорииМеток = КатегорииМеток;
		_Разложения = Разложения;
		_Композиции = Композиции;
	Исключение
		_БлокировкаИнициализации.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	_БлокировкаИнициализации.Разблокировать();

КонецПроцедуры

Функция ПолучитьИсключенияКомпозиции()

	Исключения = Новый Соответствие;
	Таблица = _ЧитательДанных.ПолучитьИсключенияКомпозиции();

	Для Индекс = 0 По Таблица.ПрочитатьЦелое32(0) - 1 Цикл
		Смещение = 4 + Индекс * 8;
		Начало = Таблица.ПрочитатьЦелое32(Смещение);
		Конец = Таблица.ПрочитатьЦелое32(Смещение + 4);

		Для КодоваяТочка = Начало По Конец Цикл
			Исключения.Вставить(КодоваяТочка, Истина);
		КонецЦикла;
	КонецЦикла;

	Возврат Исключения;

КонецФункции

Процедура ДобавитьКаноническоеРазложение(КодоваяТочка, Результат)

	Если КодоваяТочка >= 44032 И КодоваяТочка <= 55203 Тогда
		ДобавитьРазложениеХангыльскогоСлога(КодоваяТочка, Результат);
		Возврат;
	КонецЕсли;

	Разложение = _Разложения.Получить(КодоваяТочка);

	Если Разложение = Неопределено Тогда
		Результат.Добавить(КодоваяТочка);
		Возврат;
	КонецЕсли;

	Для Каждого ТочкаРазложения Из Разложение Цикл
		ДобавитьКаноническоеРазложение(ТочкаРазложения, Результат);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьРазложениеХангыльскогоСлога(КодоваяТочка, Результат)

	ИндексСлога = КодоваяТочка - 44032;
	Результат.Добавить(4352 + Цел(ИндексСлога / 588));
	Результат.Добавить(4449 + Цел((ИндексСлога % 588) / 28));
	ИндексЗавершающей = ИндексСлога % 28;

	Если ИндексЗавершающей <> 0 Тогда
		Результат.Добавить(4519 + ИндексЗавершающей);
	КонецЕсли;

КонецПроцедуры

Процедура УпорядочитьКомбинируемыеТочки(КодовыеТочки)

	Индекс = 0;

	Пока Индекс < КодовыеТочки.Количество() Цикл
		Если КлассКомбинирования(КодовыеТочки[Индекс]) = 0 Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		НачалоПоследовательности = Индекс;

		Пока Индекс < КодовыеТочки.Количество()
			И КлассКомбинирования(КодовыеТочки[Индекс]) <> 0 Цикл
			Индекс = Индекс + 1;
		КонецЦикла;

		УпорядочитьПоследовательностьПоКлассу(
			КодовыеТочки,
			НачалоПоследовательности,
			Индекс - 1
		);
	КонецЦикла;

КонецПроцедуры

Процедура УпорядочитьПоследовательностьПоКлассу(КодовыеТочки, Начало, Конец)

	Корзины = Новый Соответствие;

	Для Индекс = Начало По Конец Цикл
		КодоваяТочка = КодовыеТочки[Индекс];
		Класс = КлассКомбинирования(КодоваяТочка);
		Корзина = Корзины.Получить(Класс);

		Если Корзина = Неопределено Тогда
			Корзина = Новый Массив;
			Корзины.Вставить(Класс, Корзина);
		КонецЕсли;

		Корзина.Добавить(КодоваяТочка);
	КонецЦикла;

	Индекс = Начало;

	Для Класс = 1 По 255 Цикл
		Корзина = Корзины.Получить(Класс);

		Если Корзина = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого КодоваяТочка Из Корзина Цикл
			КодовыеТочки[Индекс] = КодоваяТочка;
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция СоставитьКодовыеТочки(КодовыеТочки)

	Если КодовыеТочки.Количество() = 0 Тогда
		Возврат КодовыеТочки;
	КонецЕсли;

	Результат = Новый Массив;
	Результат.Добавить(КодовыеТочки[0]);
	ПозицияНачальнойТочки = 0;
	НачальнаяТочка = КодовыеТочки[0];
	ПредыдущийКласс = 0;

	Для Индекс = 1 По КодовыеТочки.Количество() - 1 Цикл
		КодоваяТочка = КодовыеТочки[Индекс];
		ТекущийКласс = КлассКомбинирования(КодоваяТочка);
		СоставнаяТочка = ПолучитьСоставнуюТочку(НачальнаяТочка, КодоваяТочка);

		Если СоставнаяТочка <> Неопределено
			И (ПредыдущийКласс < ТекущийКласс Или ПредыдущийКласс = 0) Тогда
			Результат[ПозицияНачальнойТочки] = СоставнаяТочка;
			НачальнаяТочка = СоставнаяТочка;
		Иначе
			Если ТекущийКласс = 0 Тогда
				ПозицияНачальнойТочки = Результат.Количество();
				НачальнаяТочка = КодоваяТочка;
			КонецЕсли;

			Результат.Добавить(КодоваяТочка);
			ПредыдущийКласс = ТекущийКласс;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьСоставнуюТочку(НачальнаяТочка, КодоваяТочка)

	СоставнаяТочка = СоставитьХангыльскиеТочки(НачальнаяТочка, КодоваяТочка);

	Если СоставнаяТочка <> Неопределено Тогда
		Возврат СоставнаяТочка;
	КонецЕсли;

	Возврат _Композиции.Получить(КлючКомпозиции(НачальнаяТочка, КодоваяТочка));

КонецФункции

Функция СоставитьХангыльскиеТочки(НачальнаяТочка, КодоваяТочка)

	Если НачальнаяТочка >= 4352 И НачальнаяТочка < 4371
		И КодоваяТочка >= 4449 И КодоваяТочка < 4470 Тогда
		Возврат 44032 + (НачальнаяТочка - 4352) * 588 + (КодоваяТочка - 4449) * 28;
	КонецЕсли;

	ИндексСлога = НачальнаяТочка - 44032;

	Если ИндексСлога >= 0 И ИндексСлога < 11172 И ИндексСлога % 28 = 0
		И КодоваяТочка > 4519 И КодоваяТочка < 4547 Тогда
		Возврат НачальнаяТочка + КодоваяТочка - 4519;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция КлючКомпозиции(ПерваяТочка, ВтораяТочка)

	Возврат Формат(ПерваяТочка, "ЧГ=0") + ":" + Формат(ВтораяТочка, "ЧГ=0");

КонецФункции

#КонецОбласти
