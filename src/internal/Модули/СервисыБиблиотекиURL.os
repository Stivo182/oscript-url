#Область СлужебныеПроцедурыИФункции

Функция ПолучитьИлиСоздатьСервис(ИмяКласса)

	// StructureImpl хранит значение как управляемую ссылку в List<IValue>.
	// По модели памяти .NET запись такой ссылки атомарна и публикует доступное через нее состояние объекта.
	// Зависимые чтения упорядочены, поэтому готовый сервис можно вернуть без захвата блокировки.
	// См. https://github.com/dotnet/runtime/blob/main/docs/design/specs/Memory-model.md#object-assignment
	// Ссылка после публикации не изменяется. При отсутствии сервиса блокировка и повторная проверка
	// гарантируют создание единственного экземпляра.
	Сервис = _Сервисы[ИмяКласса];
	Если Сервис <> Неопределено Тогда
		Возврат Сервис;
	КонецЕсли;

	Блокировка = ПолучитьБлокировкуСервиса(ИмяКласса);
	Блокировка.Заблокировать();

	Попытка
		Сервис = _Сервисы[ИмяКласса];
		Если Сервис = Неопределено Тогда
			Сервис = Новый(ИмяКласса, ПараметрыКонструктораСервиса(ИмяКласса));
			_Сервисы[ИмяКласса] = Сервис;
		КонецЕсли;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();
	Возврат Сервис;

КонецФункции

Функция ПараметрыКонструктораСервиса(ИмяКласса)

	Параметры = Новый Массив;

	Если ИмяКласса = "КлассификаторХостаURI"
		Или ИмяКласса = "КодировщикКомпонентовURI" Тогда
		Параметры.Добавить(ПроверяющийСинтаксисURI());
	ИначеЕсли ИмяКласса = "КодировщикPunycode" Тогда
		Параметры.Добавить(ПреобразовательКодовыхТочекUnicode());
	ИначеЕсли ИмяКласса = "НормализаторURI" Тогда
		Параметры.Добавить(ОпределительСтандартногоПортаURI());
		Параметры.Добавить(КодировщикКомпонентовURI());
	ИначеЕсли ИмяКласса = "НормализаторСтрокUnicode" Тогда
		Параметры.Добавить(ПреобразовательКодовыхТочекUnicode());
	ИначеЕсли ИмяКласса = "ПарсерIRI" Тогда
		Параметры.Добавить(ПроверяющийСинтаксисURI());
		Параметры.Добавить(КодировщикКомпонентаIRI());
		Параметры.Добавить(КлассификаторХостаURI());
	ИначеЕсли ИмяКласса = "ПреобразовательДоменов" Тогда
		Параметры.Добавить(ПреобразовательКодовыхТочекUnicode());
		Параметры.Добавить(НормализаторСтрокUnicode());
		Параметры.Добавить(КодировщикPunycode());
	ИначеЕсли ИмяКласса = "РазборщикКомпонентовURL" Тогда
		Параметры.Добавить(КодировщикКомпонентовURI());
		Параметры.Добавить(ПроверяющийСинтаксисURI());
		Параметры.Добавить(КодировщикКомпонентаIRI());
		Параметры.Добавить(КлассификаторХостаURI());
	ИначеЕсли ИмяКласса = "РазрешительURI" Тогда
		Параметры.Добавить(СборщикURL());
	ИначеЕсли ИмяКласса = "РелятивизаторURI" Тогда
		Параметры.Добавить(НормализаторURI());
		Параметры.Добавить(СборщикURL());
		Параметры.Добавить(РазрешительURI());
	ИначеЕсли ИмяКласса = "СборщикURL" Тогда
		Параметры.Добавить(РазборщикКомпонентовURL());
	КонецЕсли;

	Возврат Параметры;

КонецФункции

Функция ПолучитьБлокировкуСервиса(ИмяКласса)

	Блокировка = _БлокировкиСервисов[ИмяКласса];
	Если Блокировка <> Неопределено Тогда
		Возврат Блокировка;
	КонецЕсли;

	_БлокировкаПула.Заблокировать();

	Попытка
		Блокировка = _БлокировкиСервисов[ИмяКласса];
		Если Блокировка = Неопределено Тогда
			Блокировка = Новый БлокировкаРесурса;
			_БлокировкиСервисов[ИмяКласса] = Блокировка;
		КонецЕсли;
	Исключение
		_БлокировкаПула.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаПула.Разблокировать();
	Возврат Блокировка;

КонецФункции

Процедура ИнициализироватьПулыСервисов()

	ИменаСервисов = "КодировщикКомпонентовURI, ПреобразовательКодовыхТочекUnicode, НормализаторСтрокUnicode, "
		+ "ПреобразовательДоменов, РазборщикКомпонентовURL, ПроверяющийСинтаксисURI, КлассификаторХостаURI, "
		+ "КодировщикPunycode, КодировщикКомпонентаIRI, НормализаторURI, ОпределительСтандартногоПортаURI, "
		+ "ПарсерIRI, ПроверяющийСхемыURL, РазрешительURI, РелятивизаторURI, СборщикURL, СравнивательURL";

	_Сервисы = Новый Структура(ИменаСервисов);
	_БлокировкиСервисов = Новый Структура(ИменаСервисов);
	_БлокировкаПула = Новый БлокировкаРесурса;

КонецПроцедуры

#КонецОбласти

ИнициализироватьПулыСервисов();
