#Использовать errors

Перем _ТаблицаСопоставлений; // БуферДвоичныхДанных, Неопределено
Перем _КоличествоСопоставлений; // Число, Неопределено
Перем _СмещениеПулаСопоставлений; // Число, Неопределено
Перем _НачалаКлассовНаправления; // Массив, Неопределено
Перем _КонцыКлассовНаправления; // Массив, Неопределено
Перем _КлассыНаправления; // Массив, Неопределено
Перем _НачалаТиповСоединения; // Массив, Неопределено
Перем _КонцыТиповСоединения; // Массив, Неопределено
Перем _ТипыСоединения; // Массив, Неопределено
Перем _НачалаНаправленийДоменов; // Массив, Неопределено
Перем _КонцыНаправленийДоменов; // Массив, Неопределено
Перем _БлокировкаИнициализации; // БлокировкаРесурса
Перем _Кодировщик; // КодировщикPunycode
Перем _ЧитательДанных; // ЧитательДанныхIDNA

#Область ПрограммныйИнтерфейс

// Преобразует международное доменное имя в ASCII-совместимое представление по UTS #46.
//
// Параметры:
//  Домен - Строка - Доменное имя в Unicode или ASCII.
//  ПереходнаяОбработка - Булево - Применять переходные сопоставления UTS #46.
//  ПроверятьДефисы - Булево - Проверять положение дефисов по правилу CheckHyphens UTS #46.
//
// Возвращаемое значение:
//  Строка - Доменное имя в ASCII-совместимом представлении.
//
// Исключения:
//  argument.invalid_type - Недопустимый тип имеет один из аргументов: Домен, ПереходнаяОбработка или ПроверятьДефисы.
//  argument.invalid_value - Домен не является допустимым международным доменным именем.
//  idna.data.invalid - Встроенные данные IDNA повреждены или несовместимы.
Функция Кодировать(Домен, ПереходнаяОбработка = Ложь, ПроверятьДефисы = Ложь) Экспорт

	ПроверкаАргументов.ПроверитьТип("Домен", Домен, Тип("Строка"));
	ПроверкаАргументов.ПроверитьТип("ПереходнаяОбработка", ПереходнаяОбработка, Тип("Булево"));
	ПроверкаАргументов.ПроверитьТип("ПроверятьДефисы", ПроверятьДефисы, Тип("Булево"));

	Результат = ПопытатьсяКодироватьДомен(Домен, ПереходнаяОбработка, ПроверятьДефисы);

	Если Результат = Неопределено Тогда
		ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента(
			"Домен",
			"допустимое международное доменное имя"
		);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Преобразует ASCII-совместимое доменное имя в представление Unicode по UTS #46.
// При ошибке преобразования возвращает входное значение без изменений, как java.net.IDN.toUnicode().
//
// Параметры:
//  Домен - Строка - Доменное имя в ASCII-совместимом представлении.
//
// Возвращаемое значение:
//  Строка - Доменное имя в Unicode или исходное значение при ошибке преобразования.
//
// Исключения:
//  argument.invalid_type - Домен имеет недопустимый тип.
//  idna.data.invalid - Встроенные данные IDNA повреждены или несовместимы.
Функция Декодировать(Домен) Экспорт

	ПроверкаАргументов.ПроверитьТип("Домен", Домен, Тип("Строка"));

	Результат = ПопытатьсяДекодироватьДомен(Домен);

	Возврат ?(Результат = Неопределено, Домен, Результат);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПопытатьсяКодироватьДомен(Домен, ПереходнаяОбработка, ПроверятьДефисы)

	Метки = ПодготовитьМеткиДомена(Домен, ПереходнаяОбработка);

	Если Метки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = КодироватьМеткиДомена(Метки, ПроверятьДефисы);

	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СтрСоединить(Результат.КодированныеМетки, ".");

КонецФункции

Функция ПопытатьсяДекодироватьДомен(Домен)

	Метки = ПодготовитьМеткиДомена(Домен, Ложь);

	Если Метки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЛогическиеМетки = ДекодироватьМеткиДомена(Метки);

	Если ЛогическиеМетки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СтрокаДоменаИзМеток(ЛогическиеМетки);

КонецФункции

Функция ПодготовитьМеткиДомена(Домен, ПереходнаяОбработка)

	СопоставленныеТочки = СопоставитьДомен(Домен, ПереходнаяОбработка);

	Если СопоставленныеТочки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	НормализованныйДомен = НормализацияСтрокUnicode.ПривестиКNFC(
		КодовыеТочкиUnicode.ВСтроку(СопоставленныеТочки)
	);

	Если НормализованныйДомен = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	КодовыеТочки = КодовыеТочкиUnicode.ИзСтроки(НормализованныйДомен);

	Если КодовыеТочки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат РазделитьНаМетки(КодовыеТочки);

КонецФункции

Функция КодироватьМеткиДомена(Метки, ПроверятьДефисы)

	ЛогическиеМетки = Новый Массив;
	КодированныеМетки = Новый Массив;

	Для Каждого Метка Из Метки Цикл
		РезультатМетки = КодироватьМеткуДомена(Метка);

		Если РезультатМетки = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		ЛогическиеМетки.Добавить(РезультатМетки.ЛогическаяМетка);
		КодированныеМетки.Добавить(РезультатМетки.КодированнаяМетка);
	КонецЦикла;

	Если Не ДопустимыеМетки(ЛогическиеМетки) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ПроверятьДефисы И Не ДопустимыеДефисыМеток(ЛогическиеМетки) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура(
		"ЛогическиеМетки,КодированныеМетки",
		ЛогическиеМетки,
		КодированныеМетки
	);

КонецФункции

Функция КодироватьМеткуДомена(Метка)

	Если НачинаетсяСПрефиксаPunycode(Метка) Тогда
		ЛогическаяМетка = ДекодироватьAMетку(Метка);

		Если ЛогическаяМетка = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		КодированнаяМетка = НРег(КодовыеТочкиUnicode.ВСтроку(Метка));
	Иначе
		ЛогическаяМетка = Метка;
		КодированнаяМетка = КодовыеТочкиUnicode.ВСтроку(Метка);

		Если СодержитНеASCII(Метка) Тогда
			ПолезнаяНагрузка = Кодировщик().Кодировать(КодированнаяМетка);

			Если ПолезнаяНагрузка = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;

			КодированнаяМетка = "xn--" + ПолезнаяНагрузка;
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Структура(
		"ЛогическаяМетка,КодированнаяМетка",
		ЛогическаяМетка,
		КодированнаяМетка
	);

КонецФункции

Функция ДекодироватьМеткиДомена(Метки)

	Результат = Новый Массив;

	Для Каждого Метка Из Метки Цикл
		Если НачинаетсяСПрефиксаPunycode(Метка) Тогда
			Метка = ДекодироватьAMетку(Метка);

			Если Метка = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;

		Результат.Добавить(Метка);
	КонецЦикла;

	Если Не ДопустимыеМетки(Результат) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СтрокаДоменаИзМеток(Метки)

	Фрагменты = Новый Массив;

	Для Каждого Метка Из Метки Цикл
		Фрагменты.Добавить(КодовыеТочкиUnicode.ВСтроку(Метка));
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, ".");

КонецФункции

Функция СопоставитьДомен(Домен, ПереходнаяОбработка)

	ИнициализироватьТаблицыСопоставлений();
	КодовыеТочки = КодовыеТочкиUnicode.ИзСтроки(Домен);

	Если КодовыеТочки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Массив;

	Для Каждого КодоваяТочка Из КодовыеТочки Цикл
		Если Не ДобавитьСопоставленнуюКодовуюТочку(
			КодоваяТочка,
			Результат,
			ПереходнаяОбработка
		) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ДобавитьСопоставленнуюКодовуюТочку(КодоваяТочка, Результат, ПереходнаяОбработка)

	СмещениеЗаписи = СмещениеЗаписиСопоставления(КодоваяТочка);

	Если СмещениеЗаписи = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	// UTS #46 требует при переходной обработке напрямую сопоставлять LATIN CAPITAL LETTER SHARP S с "ss".
	Если КодоваяТочка = 7838 И ПереходнаяОбработка Тогда
		Результат.Добавить(115);
		Результат.Добавить(115);
		Возврат Истина;
	КонецЕсли;

	КодСтатуса = _ТаблицаСопоставлений[СмещениеЗаписи + 8];
	// Статусы UTS #46: 2 - ignored, 3 - mapped, 4 - deviation, 5 - disallowed, 7 - disallowed_STD3_mapped.
	Если КодСтатуса = 5 Тогда
		Возврат Ложь;
	ИначеЕсли КодСтатуса = 2 Тогда
		Возврат Истина;
	ИначеЕсли КодСтатуса = 3
		Или КодСтатуса = 7
		Или КодСтатуса = 4 И ПереходнаяОбработка Тогда
		ДобавитьТочкиСопоставления(СмещениеЗаписи, Результат);
	Иначе
		Результат.Добавить(КодоваяТочка);
	КонецЕсли;

	Возврат Истина;

КонецФункции

Процедура ИнициализироватьТаблицыСопоставлений()

	_БлокировкаИнициализации.Заблокировать();
	Попытка
		Если _ТаблицаСопоставлений <> Неопределено Тогда
			_БлокировкаИнициализации.Разблокировать();
			Возврат;
		КонецЕсли;

		ТаблицаСопоставлений = ЧитательДанных().ПолучитьСопоставления();
		ПроверитьДвоичнуюТаблицуСопоставлений(ТаблицаСопоставлений);

		_КоличествоСопоставлений = ТаблицаСопоставлений.ПрочитатьЦелое32(8);
		_СмещениеПулаСопоставлений = ТаблицаСопоставлений.ПрочитатьЦелое32(12);
		_ТаблицаСопоставлений = ТаблицаСопоставлений;
	Исключение
		_БлокировкаИнициализации.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	_БлокировкаИнициализации.Разблокировать();

КонецПроцедуры

Процедура ПроверитьДвоичнуюТаблицуСопоставлений(Таблица)

	Если Таблица.Размер < 16
		Или Таблица.ПрочитатьЦелое32(0) <> 827212873 // ASCII: IDN1.
		Или Таблица.ПрочитатьЦелое16(4) <> 1
		Или Таблица.ПрочитатьЦелое16(6) <> 16 Тогда
		ВызватьНедопустимыеДанныеIDNA("Повреждена двоичная таблица сопоставлений IDNA");
	КонецЕсли;

	КоличествоЗаписей = Таблица.ПрочитатьЦелое32(8);
	СмещениеПула = Таблица.ПрочитатьЦелое32(12);

	Если КоличествоЗаписей = 0
		Или СмещениеПула <> 16 + КоличествоЗаписей * 16
		Или СмещениеПула > Таблица.Размер Тогда
		ВызватьНедопустимыеДанныеIDNA("Повреждены размеры двоичной таблицы сопоставлений IDNA");
	КонецЕсли;

КонецПроцедуры

Функция СмещениеЗаписиСопоставления(КодоваяТочка)

	ЛеваяГраница = 0;
	ПраваяГраница = _КоличествоСопоставлений - 1;

	Пока ЛеваяГраница <= ПраваяГраница Цикл
		Середина = Цел((ЛеваяГраница + ПраваяГраница) / 2);
		СмещениеЗаписи = 16 + Середина * 16;
		Начало = _ТаблицаСопоставлений.ПрочитатьЦелое32(СмещениеЗаписи);
		Конец = _ТаблицаСопоставлений.ПрочитатьЦелое32(СмещениеЗаписи + 4);

		Если КодоваяТочка < Начало Тогда
			ПраваяГраница = Середина - 1;
		ИначеЕсли КодоваяТочка > Конец Тогда
			ЛеваяГраница = Середина + 1;
		Иначе
			Возврат СмещениеЗаписи;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ДобавитьТочкиСопоставления(СмещениеЗаписи, Результат)

	КоличествоТочек = _ТаблицаСопоставлений.ПрочитатьЦелое16(СмещениеЗаписи + 10);
	Смещение = _ТаблицаСопоставлений.ПрочитатьЦелое32(СмещениеЗаписи + 12);
	Начало = _СмещениеПулаСопоставлений + Смещение;

	Если Начало + КоличествоТочек * 4 > _ТаблицаСопоставлений.Размер Тогда
		ВызватьНедопустимыеДанныеIDNA("Повреждено сопоставление в двоичной таблице IDNA");
	КонецЕсли;

	Для Индекс = 0 По КоличествоТочек - 1 Цикл
		Результат.Добавить(_ТаблицаСопоставлений.ПрочитатьЦелое32(Начало + Индекс * 4));
	КонецЦикла;

КонецПроцедуры

Процедура ИнициализироватьТаблицуНаправления()

	_БлокировкаИнициализации.Заблокировать();
	Попытка
		Если _НачалаКлассовНаправления <> Неопределено Тогда
			_БлокировкаИнициализации.Разблокировать();
			Возврат;
		КонецЕсли;

		НачалаКлассовНаправления = Новый Массив;
		КонцыКлассовНаправления = Новый Массив;
		КлассыНаправления = Новый Массив;
		Таблица = ЧитательДанных().ПолучитьКлассыНаправления();
		КлассыПоКоду = СтрРазделить(
			"L,R,AL,EN,ES,ET,AN,CS,B,S,WS,ON,NSM,BN,LRE,LRO,RLE,RLO,PDF,LRI,RLI,FSI,PDI",
			","
		);
		ПрочитатьДиапазоныСоЗначениями(
			Таблица,
			КлассыПоКоду,
			НачалаКлассовНаправления,
			КонцыКлассовНаправления,
			КлассыНаправления,
			"класса направления Unicode"
		);

		_НачалаКлассовНаправления = НачалаКлассовНаправления;
		_КонцыКлассовНаправления = КонцыКлассовНаправления;
		_КлассыНаправления = КлассыНаправления;
	Исключение
		_БлокировкаИнициализации.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	_БлокировкаИнициализации.Разблокировать();

КонецПроцедуры

Процедура ИнициализироватьТаблицуНаправленийДоменов()

	_БлокировкаИнициализации.Заблокировать();
	Попытка
		Если _НачалаНаправленийДоменов <> Неопределено Тогда
			_БлокировкаИнициализации.Разблокировать();
			Возврат;
		КонецЕсли;

		НачалаНаправленийДоменов = Новый Массив;
		КонцыНаправленийДоменов = Новый Массив;
		Таблица = ЧитательДанных().ПолучитьНаправленияДоменов();
		ПрочитатьДиапазоны(Таблица, 8, НачалаНаправленийДоменов, КонцыНаправленийДоменов);

		_НачалаНаправленийДоменов = НачалаНаправленийДоменов;
		_КонцыНаправленийДоменов = КонцыНаправленийДоменов;
	Исключение
		_БлокировкаИнициализации.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	_БлокировкаИнициализации.Разблокировать();

КонецПроцедуры

Процедура ИнициализироватьТаблицуСоединений()

	_БлокировкаИнициализации.Заблокировать();
	Попытка
		Если _НачалаТиповСоединения <> Неопределено Тогда
			_БлокировкаИнициализации.Разблокировать();
			Возврат;
		КонецЕсли;

		НачалаТиповСоединения = Новый Массив;
		КонцыТиповСоединения = Новый Массив;
		ТипыСоединения = Новый Массив;
		Таблица = ЧитательДанных().ПолучитьТипыСоединения();
		ПрочитатьДиапазоныСоЗначениями(
			Таблица,
			СтрРазделить("U,R,L,D,C,T", ","),
			НачалаТиповСоединения,
			КонцыТиповСоединения,
			ТипыСоединения,
			"типа соединения Unicode"
		);

		_НачалаТиповСоединения = НачалаТиповСоединения;
		_КонцыТиповСоединения = КонцыТиповСоединения;
		_ТипыСоединения = ТипыСоединения;
	Исключение
		_БлокировкаИнициализации.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	_БлокировкаИнициализации.Разблокировать();

КонецПроцедуры

Процедура ПрочитатьДиапазоны(Таблица, РазмерЗаписи, Начала, Концы)

	Для Индекс = 0 По Таблица.ПрочитатьЦелое32(0) - 1 Цикл
		Смещение = 4 + Индекс * РазмерЗаписи;
		Начала.Добавить(Таблица.ПрочитатьЦелое32(Смещение));
		Концы.Добавить(Таблица.ПрочитатьЦелое32(Смещение + 4));
	КонецЦикла;

КонецПроцедуры

Процедура ПрочитатьДиапазоныСоЗначениями(Таблица, ЗначенияПоКоду, Начала, Концы, Значения, НазваниеЗначения)

	ПрочитатьДиапазоны(Таблица, 12, Начала, Концы);

	Для Индекс = 0 По Таблица.ПрочитатьЦелое32(0) - 1 Цикл
		Смещение = 4 + Индекс * 12;
		КодЗначения = Таблица[Смещение + 8];

		Если КодЗначения = 0 Или КодЗначения > ЗначенияПоКоду.Количество() Тогда
			ВызватьНедопустимыеДанныеIDNA(СтрШаблон("Неизвестный код %1", НазваниеЗначения));
		КонецЕсли;

		Значения.Добавить(ЗначенияПоКоду[КодЗначения - 1]);
	КонецЦикла;

КонецПроцедуры

Процедура ВызватьНедопустимыеДанныеIDNA(Сообщение)

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимыеДанныеIDNA(),
		Сообщение
	);

КонецПроцедуры

Функция ДопустимыеМетки(Метки)

	ИнициализироватьТаблицыСопоставлений();

	Для Каждого Метка Из Метки Цикл
		Если Не ДопустимаяМетка(Метка) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Если Не ЭтоДоменСДвунаправленнымПисьмом(Метки) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Метка Из Метки Цикл
		Если Метка.Количество() > 0 И Не ДопустимоеДвунаправленноеПисьмо(Метка) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ДопустимаяМетка(Метка)

	Если Метка.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Если НормализацияСтрокUnicode.ЭтоКомбинирующийСимвол(Метка[0]) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НачинаетсяСПрефиксаPunycode(Метка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ДопустимыеКодовыеТочкиМетки(Метка);

КонецФункции

Функция ДопустимыеДефисыМеток(Метки)

	Для Каждого Метка Из Метки Цикл
		Если Метка.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Метка[0] = 45 Или Метка[Метка.ВГраница()] = 45 Тогда
			Возврат Ложь;
		КонецЕсли;

		Если Метка.Количество() >= 4 И Метка[2] = 45 И Метка[3] = 45 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ДопустимыеКодовыеТочкиМетки(Метка)

	Для Индекс = 0 По Метка.Количество() - 1 Цикл
		КодоваяТочка = Метка[Индекс];
		СмещениеЗаписи = СмещениеЗаписиСопоставления(КодоваяТочка);

		Если СмещениеЗаписи = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		КодСтатуса = _ТаблицаСопоставлений[СмещениеЗаписи + 8];
		// Допустимые статусы UTS #46: 1 - valid, 4 - deviation, 6 - disallowed_STD3_valid.
		Если Не (КодСтатуса = 1 Или КодСтатуса = 4 Или КодСтатуса = 6) Тогда
			Возврат Ложь;
		КонецЕсли;

		Если (КодоваяТочка = 8204 Или КодоваяТочка = 8205)
			И Не ДопустимыйСоединитель(Метка, Индекс) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ДопустимыйСоединитель(Метка, Индекс)

	Если Индекс > 0 И НормализацияСтрокUnicode.КлассКомбинирования(Метка[Индекс - 1]) = 9 Тогда
		Возврат Истина;
	КонецЕсли;

	Если Метка[Индекс] = 8205 Тогда
		Возврат Ложь;
	КонецЕсли;

	ПредыдущийТип = ПредыдущийЗначимыйТипСоединения(Метка, Индекс - 1);
	СледующийТип = СледующийЗначимыйТипСоединения(Метка, Индекс + 1);
	Возврат (ПредыдущийТип = "L" Или ПредыдущийТип = "D")
		И (СледующийТип = "R" Или СледующийТип = "D");

КонецФункции

Функция ПредыдущийЗначимыйТипСоединения(Метка, Индекс)

	Пока Индекс >= 0 Цикл
		Тип = ТипСоединения(Метка[Индекс]);

		Если Тип <> "T" Тогда
			Возврат Тип;
		КонецЕсли;

		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат "U";

КонецФункции

Функция СледующийЗначимыйТипСоединения(Метка, Индекс)

	Пока Индекс < Метка.Количество() Цикл
		Тип = ТипСоединения(Метка[Индекс]);

		Если Тип <> "T" Тогда
			Возврат Тип;
		КонецЕсли;

		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат "U";

КонецФункции

Функция ТипСоединения(КодоваяТочка)

	ИнициализироватьТаблицуСоединений();
	Индекс = КодовыеТочкиUnicode.ИндексДиапазона(
		КодоваяТочка,
		_НачалаТиповСоединения,
		_КонцыТиповСоединения
	);

	Возврат ?(Индекс = Неопределено, "U", _ТипыСоединения[Индекс]);

КонецФункции

Функция ЭтоДоменСДвунаправленнымПисьмом(Метки)

	ИнициализироватьТаблицуНаправленийДоменов();

	Для Каждого Метка Из Метки Цикл
		Для Каждого КодоваяТочка Из Метка Цикл
			Если КодовыеТочкиUnicode.ИндексДиапазона(
				КодоваяТочка,
				_НачалаНаправленийДоменов,
				_КонцыНаправленийДоменов
			) <> Неопределено Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ДопустимоеДвунаправленноеПисьмо(Метка)

	ПервыйКласс = КлассНаправления(Метка[0]);
	Правила = ПравилаДвунаправленногоПисьма(ПервыйКласс);

	Если Правила = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СоответствуетПравиламДвунаправленногоПисьма(Метка, ПервыйКласс, Правила);

КонецФункции

Функция ПравилаДвунаправленногоПисьма(ПервыйКласс)

	Если ПервыйКласс = "L" Тогда
		Возврат Новый Структура(
			"ДопустимыеКлассы,ДопустимыеПоследниеКлассы",
			"|L|EN|ES|CS|ET|ON|BN|NSM|",
			"|L|EN|"
		);
	ИначеЕсли ПервыйКласс = "R" Или ПервыйКласс = "AL" Тогда
		Возврат Новый Структура(
			"ДопустимыеКлассы,ДопустимыеПоследниеКлассы",
			"|R|AL|AN|EN|ES|CS|ET|ON|BN|NSM|",
			"|R|AL|EN|AN|"
		);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция СоответствуетПравиламДвунаправленногоПисьма(Метка, ПервыйКласс, Правила)

	ЕстьЕвропейскаяЦифра = Ложь;
	ЕстьАрабскаяЦифра = Ложь;
	ПоследнийКласс = ПервыйКласс;

	Для Каждого КодоваяТочка Из Метка Цикл
		Класс = КлассНаправления(КодоваяТочка);

		Если СтрНайти(Правила.ДопустимыеКлассы, "|" + Класс + "|") = 0 Тогда
			Возврат Ложь;
		КонецЕсли;

		Если Класс = "EN" Тогда
			ЕстьЕвропейскаяЦифра = Истина;
		ИначеЕсли Класс = "AN" Тогда
			ЕстьАрабскаяЦифра = Истина;
		КонецЕсли;

		Если Класс <> "NSM" Тогда
			ПоследнийКласс = Класс;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрНайти(Правила.ДопустимыеПоследниеКлассы, "|" + ПоследнийКласс + "|") > 0
		И Не (ЕстьЕвропейскаяЦифра И ЕстьАрабскаяЦифра);

КонецФункции

Функция КлассНаправления(КодоваяТочка)

	ИнициализироватьТаблицуНаправления();
	Индекс = КодовыеТочкиUnicode.ИндексДиапазона(
		КодоваяТочка,
		_НачалаКлассовНаправления,
		_КонцыКлассовНаправления
	);
	Возврат ?(Индекс = Неопределено, "L", _КлассыНаправления[Индекс]);

КонецФункции

Функция ДекодироватьAMетку(Метка)

	СтрокаМетки = КодовыеТочкиUnicode.ВСтроку(Метка);
	ПолезнаяНагрузка = Сред(СтрокаМетки, 5);

	Если ПустаяСтрока(ПолезнаяНагрузка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДекодированнаяСтрока = Кодировщик().Декодировать(ПолезнаяНагрузка);

	Если ДекодированнаяСтрока = Неопределено
		Или НРег(Кодировщик().Кодировать(ДекодированнаяСтрока)) <> НРег(ПолезнаяНагрузка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДекодированныеТочки = КодовыеТочкиUnicode.ИзСтроки(ДекодированнаяСтрока);

	Если Не СодержитНеASCII(ДекодированныеТочки) Тогда
		Возврат Неопределено;
	КонецЕсли;

	НормализованнаяСтрока = НормализацияСтрокUnicode.ПривестиКNFC(ДекодированнаяСтрока);

	Если НормализованнаяСтрока <> ДекодированнаяСтрока Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ДекодированныеТочки;

КонецФункции

Функция НачинаетсяСПрефиксаPunycode(Метка)

	Если Метка.Количество() < 4 Тогда
		Возврат Ложь;
	КонецЕсли;

	Префикс = Новый Массив;
	Префикс.Добавить(Метка[0]);
	Префикс.Добавить(Метка[1]);
	Префикс.Добавить(Метка[2]);
	Префикс.Добавить(Метка[3]);

	Возврат НРег(КодовыеТочкиUnicode.ВСтроку(Префикс)) = "xn--";

КонецФункции

Функция РазделитьНаМетки(КодовыеТочки)

	Метки = Новый Массив;
	ТекущаяМетка = Новый Массив;

	Для Каждого КодоваяТочка Из КодовыеТочки Цикл
		Если КодоваяТочка = 46 Тогда
			Метки.Добавить(ТекущаяМетка);
			ТекущаяМетка = Новый Массив;
		Иначе
			ТекущаяМетка.Добавить(КодоваяТочка);
		КонецЕсли;
	КонецЦикла;

	Метки.Добавить(ТекущаяМетка);

	Возврат Метки;

КонецФункции

Функция СодержитНеASCII(КодовыеТочки)

	Для Каждого КодоваяТочка Из КодовыеТочки Цикл
		Если КодоваяТочка > 127 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция Кодировщик()

	Если _Кодировщик <> Неопределено Тогда
		Возврат _Кодировщик;
	КонецЕсли;

	_БлокировкаИнициализации.Заблокировать();
	Попытка
		Если _Кодировщик = Неопределено Тогда
			_Кодировщик = Новый КодировщикPunycode;
		КонецЕсли;
	Исключение
		_БлокировкаИнициализации.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	_БлокировкаИнициализации.Разблокировать();

	Возврат _Кодировщик;

КонецФункции

// Вызывается только при удерживаемой блокировке инициализации.
Функция ЧитательДанных()

	Если _ЧитательДанных = Неопределено Тогда
		_ЧитательДанных = Новый ЧитательДанныхIDNA;
	КонецЕсли;

	Возврат _ЧитательДанных;

КонецФункции

#КонецОбласти

_БлокировкаИнициализации = Новый БлокировкаРесурса;
