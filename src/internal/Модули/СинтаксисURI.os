#Область ПрограммныйИнтерфейс

// Проверяет синтаксис схемы по RFC 3986 §3.1.
//
// Параметры:
//  Значение - Строка - Проверяемая схема.
//
// Возвращаемое значение:
//  Булево - Истина, если схема синтаксически допустима.
Функция ЭтоДопустимаяСхема(Значение) Экспорт

	Если Значение = "" Или Не ЭтоБукваASCII(Лев(Значение, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 2 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);

		Если Не ЭтоБукваASCII(Символ)
			И Не ЭтоЦифраASCII(Символ)
			И СтрНайти("+.-", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверяет принадлежность символа латинским буквам ASCII.
//
// Параметры:
//  Символ - Строка - Проверяемый символ.
//
// Возвращаемое значение:
//  Булево - Истина для латинской буквы ASCII.
Функция ЭтоБукваASCII(Символ) Экспорт

	Код = КодСимвола(Символ);
	Возврат Код >= 65 И Код <= 90 Или Код >= 97 И Код <= 122;

КонецФункции

// Проверяет принадлежность символа цифрам ASCII.
//
// Параметры:
//  Символ - Строка - Проверяемый символ.
//
// Возвращаемое значение:
//  Булево - Истина для цифры ASCII.
Функция ЭтоЦифраASCII(Символ) Экспорт

	Код = КодСимвола(Символ);
	Возврат Код >= 48 И Код <= 57;

КонецФункции

// Проверяет принадлежность символа шестнадцатеричным цифрам ASCII.
//
// Параметры:
//  Символ - Строка - Проверяемый символ.
//
// Возвращаемое значение:
//  Булево - Истина для шестнадцатеричной цифры ASCII.
Функция ЭтоШестнадцатеричныйСимвол(Символ) Экспорт

	Код = КодСимвола(Символ);
	Возврат ЭтоЦифраASCII(Символ)
		Или Код >= 65 И Код <= 70
		Или Код >= 97 И Код <= 102;

КонецФункции

// Проверяет, состоит ли значение только из цифр ASCII.
//
// Параметры:
//  Значение - Строка, Неопределено - Проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если все символы являются цифрами ASCII.
Функция ТолькоЦифрыASCII(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если Не ЭтоЦифраASCII(Сред(Значение, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверяет наличие символов вне ASCII.
//
// Параметры:
//  Значение - Строка - Проверяемая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если найден символ вне ASCII.
Функция СодержитСимволыВнеASCII(Значение) Экспорт

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если КодСимвола(Сред(Значение, Индекс, 1)) > 127 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Возвращает допустимые символы зарегистрированного имени.
//
// Возвращаемое значение:
//  Строка - Набор допустимых символов.
Функция ДопустимыеСимволыЗарегистрированногоИмени() Экспорт

	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;=";

КонецФункции

// Возвращает допустимые символы пути.
//
// Возвращаемое значение:
//  Строка - Набор допустимых символов.
Функция ДопустимыеСимволыПути() Экспорт

	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;=:@/";

КонецФункции

// Возвращает допустимые символы сегмента пути.
//
// Возвращаемое значение:
//  Строка - Набор допустимых символов.
Функция ДопустимыеСимволыСегментаПути() Экспорт

	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;=:@";

КонецФункции

// Возвращает допустимые символы имени пользователя.
//
// Возвращаемое значение:
//  Строка - Набор допустимых символов.
Функция ДопустимыеСимволыИмениПользователя() Экспорт

	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;=";

КонецФункции

// Возвращает допустимые символы данных пользователя.
//
// Возвращаемое значение:
//  Строка - Набор допустимых символов.
Функция ДопустимыеСимволыДанныхПользователя() Экспорт

	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;=:";

КонецФункции

// Возвращает допустимые символы запроса и фрагмента.
//
// Возвращаемое значение:
//  Строка - Набор допустимых символов.
Функция ДопустимыеСимволыЗапросаИФрагмента() Экспорт

	Возврат ДопустимыеСимволыПути() + "?";

КонецФункции

#КонецОбласти
