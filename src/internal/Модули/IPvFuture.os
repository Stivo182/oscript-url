#Область СлужебныйПрограммныйИнтерфейс

// Проверяет соответствие текста синтаксису IPvFuture из RFC 3986 §3.2.2.
//
// Параметры:
//  Значение - Строка - Текст IPvFuture без квадратных скобок.
//
// Возвращаемое значение:
//  Булево - Истина, если текст является допустимым IPvFuture.
Функция ЭтоДопустимый(Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) < 4 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ВРег(Лев(Значение, 1)) <> "V" Тогда
		Возврат Ложь;
	КонецЕсли;

	ПозицияТочки = СтрНайти(Значение, ".");
	Если ПозицияТочки = 2 Или ПозицияТочки = 0 Или ПозицияТочки = СтрДлина(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 2 По ПозицияТочки - 1 Цикл
		Если Не ЯвляетсяHexСимволом(Сред(Значение, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Для Индекс = ПозицияТочки + 1 По СтрДлина(Значение) Цикл
		Если Не ЯвляетсяДопустимымСимволомАдреса(Сред(Значение, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЯвляетсяHexСимволом(Символ)

	Возврат СтрНайти("0123456789ABCDEF", ВРег(Символ)) > 0;

КонецФункции

Функция ЯвляетсяДопустимымСимволомАдреса(Символ)

	ДопустимыеСимволы = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
		+ "-._~!$&'()*+,;=:";
	Возврат СтрНайти(ДопустимыеСимволы, Символ) > 0;

КонецФункции

#КонецОбласти
