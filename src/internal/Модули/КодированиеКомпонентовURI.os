#Использовать errors

#Область ПрограммныйИнтерфейс

// Преобразует шестнадцатеричный символ ASCII в число.
//
// Параметры:
//  Символ - Строка - Шестнадцатеричный символ.
//
// Возвращаемое значение:
//  Число, Неопределено - Значение от 0 до 15 или Неопределено для недопустимого символа.
Функция ЗначениеШестнадцатеричногоСимвола(Символ) Экспорт

	Код = КодСимвола(Символ);

	Если Код >= 48 И Код <= 57 Тогда
		Возврат Код - 48;
	ИначеЕсли Код >= 65 И Код <= 70 Тогда
		Возврат Код - 55;
	ИначеЕсли Код >= 97 И Код <= 102 Тогда
		Возврат Код - 87;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Преобразует два шестнадцатеричных символа ASCII в байт.
//
// Параметры:
//  Представление - Строка - Два шестнадцатеричных символа.
//
// Возвращаемое значение:
//  Число, Неопределено - Значение байта или Неопределено для недопустимого представления.
Функция ЗначениеШестнадцатеричногоБайта(Представление) Экспорт

	Если СтрДлина(Представление) <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	СтаршийРазряд = ЗначениеШестнадцатеричногоСимвола(Лев(Представление, 1));
	МладшийРазряд = ЗначениеШестнадцатеричногоСимвола(Прав(Представление, 1));

	Если СтаршийРазряд = Неопределено Или МладшийРазряд = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СтаршийРазряд * 16 + МладшийРазряд;

КонецФункции

// Преобразует байт в два шестнадцатеричных символа верхнего регистра.
//
// Параметры:
//  Байт - Число - Значение от 0 до 255.
//
// Возвращаемое значение:
//  Строка, Неопределено - Два символа или Неопределено для значения вне диапазона байта.
Функция ШестнадцатеричноеПредставлениеБайта(Байт) Экспорт

	Если Байт < 0 Или Байт > 255 Или Цел(Байт) <> Байт Тогда
		Возврат Неопределено;
	КонецЕсли;

	ШестнадцатеричныеЦифры = "0123456789ABCDEF";
	СтаршийРазряд = Цел(Байт / 16);
	МладшийРазряд = Байт - СтаршийРазряд * 16;

	Возврат Сред(ШестнадцатеричныеЦифры, СтаршийРазряд + 1, 1)
		+ Сред(ШестнадцатеричныеЦифры, МладшийРазряд + 1, 1);

КонецФункции

Функция Кодировать(Значение, РазрешенныеСимволы) Экспорт

	Данные = ПолучитьДвоичныеДанныеИзСтроки(
		Значение,
		КодировкаТекста.UTF8,
		Ложь
	);
	HexСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(Данные);
	Фрагменты = Новый Массив;

	Индекс = 1;

	Пока Индекс <= СтрДлина(HexСтрока) Цикл
		Байт = Сред(HexСтрока, Индекс, 2);

		Если ЗначениеШестнадцатеричногоБайта(Байт) <= 127 Тогда
			Символ = Символ(ЗначениеШестнадцатеричногоБайта(Байт));

			Если СтрНайти(РазрешенныеСимволы, Символ) > 0 Тогда
				Фрагменты.Добавить(Символ);
			Иначе
				Фрагменты.Добавить("%" + Байт);
			КонецЕсли;
		Иначе
			Фрагменты.Добавить("%" + Байт);
		КонецЕсли;

		Индекс = Индекс + 2;
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

// Преобразует символы Unicode в UTF-8 и записывает каждый полученный байт как `%HH`.
// Допустимые символы ASCII и готовые последовательности `%HH` сохраняются.
//
// Параметры:
//  Значение - Строка - Проверенное представление компонента IRI с символами Unicode.
//
// Возвращаемое значение:
//  Строка - ASCII-представление компонента URI.
Функция КодироватьСимволыUnicode(Значение) Экспорт

	ДопустимыеСимволыASCII = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
		+ "-._~!$&'()*+,;=:/?@[]%";
	Возврат Кодировать(Значение, ДопустимыеСимволыASCII);

КонецФункции

Функция КодироватьФорму(Значение) Экспорт

	Данные = ПолучитьДвоичныеДанныеИзСтроки(
		Значение,
		КодировкаТекста.UTF8,
		Ложь
	);
	HexСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(Данные);
	Фрагменты = Новый Массив;

	Индекс = 1;

	Пока Индекс <= СтрДлина(HexСтрока) Цикл
		Байт = Сред(HexСтрока, Индекс, 2);
		Символ = Символ(ЗначениеШестнадцатеричногоБайта(Байт));

		Если Байт = "20" Тогда
			Фрагменты.Добавить("+");
		ИначеЕсли ДопустимыйСимволФормы(Символ) Тогда
			Фрагменты.Добавить(Символ);
		Иначе
			Фрагменты.Добавить("%" + Байт);
		КонецЕсли;

		Индекс = Индекс + 2;
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Функция ДекодироватьВБайты(Значение) Экспорт

	ФрагментыHexСтроки = Новый Массив;
	Индекс = 1;

	Пока Индекс <= СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);
		HexСимвола = HexСтрокаASCIIСимвола(Символ);

		Если HexСимвола = "25" Тогда
			Если Индекс + 2 > СтрДлина(Значение) Тогда
				ВызватьНекорректноеПроцентноеКодирование();
			КонецЕсли;

			СтаршийРазряд = Сред(Значение, Индекс + 1, 1);
			МладшийРазряд = Сред(Значение, Индекс + 2, 1);

			Если Не СинтаксисURI.ЭтоШестнадцатеричныйСимвол(СтаршийРазряд)
				Или Не СинтаксисURI.ЭтоШестнадцатеричныйСимвол(МладшийРазряд) Тогда
				ВызватьНекорректноеПроцентноеКодирование();
			КонецЕсли;

			ФрагментыHexСтроки.Добавить(ВРег(СтаршийРазряд) + ВРег(МладшийРазряд));
			Индекс = Индекс + 3;
		Иначе
			ФрагментыHexСтроки.Добавить(HexСимвола);
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	HexСтрока = СтрСоединить(ФрагментыHexСтроки, "");
	Возврат ПолучитьДвоичныеДанныеИзHexСтроки(HexСтрока);

КонецФункции

Функция ДекодироватьСтрогийUTF8(Данные) Экспорт

	HexСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(Данные);
	Байты = БайтыИзHexСтроки(HexСтрока);
	Индекс = 0;

	Пока Индекс < Байты.Количество() Цикл
		ПервыйБайт = Байты[Индекс];

		Если ПервыйБайт <= 127 Тогда
			Индекс = Индекс + 1;
		ИначеЕсли ПервыйБайт >= 194 И ПервыйБайт <= 223 Тогда
			ПроверитьПродолжениеUTF8(Байты, Индекс, 1);
			Индекс = Индекс + 2;
		ИначеЕсли ПервыйБайт = 224 Тогда
			ПроверитьБайтыUTF8(Байты, Индекс, 2, 160, 191);
			Индекс = Индекс + 3;
		ИначеЕсли ПервыйБайт >= 225 И ПервыйБайт <= 236 Или ПервыйБайт >= 238 И ПервыйБайт <= 239 Тогда
			ПроверитьПродолжениеUTF8(Байты, Индекс, 2);
			Индекс = Индекс + 3;
		ИначеЕсли ПервыйБайт = 237 Тогда
			ПроверитьБайтыUTF8(Байты, Индекс, 2, 128, 159);
			Индекс = Индекс + 3;
		ИначеЕсли ПервыйБайт = 240 Тогда
			ПроверитьБайтыUTF8(Байты, Индекс, 3, 144, 191);
			Индекс = Индекс + 4;
		ИначеЕсли ПервыйБайт >= 241 И ПервыйБайт <= 243 Тогда
			ПроверитьПродолжениеUTF8(Байты, Индекс, 3);
			Индекс = Индекс + 4;
		ИначеЕсли ПервыйБайт = 244 Тогда
			ПроверитьБайтыUTF8(Байты, Индекс, 3, 128, 143);
			Индекс = Индекс + 4;
		Иначе
			ВызватьНекорректныйUTF8();
		КонецЕсли;
	КонецЦикла;

	Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);

КонецФункции

Функция ДекодироватьФорму(Значение) Экспорт

	ИсходныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Значение, КодировкаТекста.UTF8, Ложь);
	ИсходнаяHexСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(ИсходныеДанные);
	ФрагментыHexСтроки = Новый Массив;
	Индекс = 1;

	Пока Индекс <= СтрДлина(ИсходнаяHexСтрока) Цикл
		HexСимвола = Сред(ИсходнаяHexСтрока, Индекс, 2);

		Если HexСимвола = "2B" Тогда
			ФрагментыHexСтроки.Добавить("20");
			Индекс = Индекс + 2;
		ИначеЕсли HexСимвола = "25" И Индекс + 4 <= СтрДлина(ИсходнаяHexСтрока) Тогда
			СтаршийБайт = Сред(ИсходнаяHexСтрока, Индекс + 2, 2);
			МладшийБайт = Сред(ИсходнаяHexСтрока, Индекс + 4, 2);

			Если ЗначениеШестнадцатеричногоБайта(СтаршийБайт) <= 127
				И ЗначениеШестнадцатеричногоБайта(МладшийБайт) <= 127 Тогда
				СтаршийРазряд = Символ(
					ЗначениеШестнадцатеричногоБайта(СтаршийБайт)
				);
				МладшийРазряд = Символ(
					ЗначениеШестнадцатеричногоБайта(МладшийБайт)
				);

				Если СинтаксисURI.ЭтоШестнадцатеричныйСимвол(СтаршийРазряд)
					И СинтаксисURI.ЭтоШестнадцатеричныйСимвол(МладшийРазряд) Тогда
					ФрагментыHexСтроки.Добавить(ВРег(СтаршийРазряд) + ВРег(МладшийРазряд));
					Индекс = Индекс + 6;
				Иначе
					ФрагментыHexСтроки.Добавить(HexСимвола);
					Индекс = Индекс + 2;
				КонецЕсли;
			Иначе
				ФрагментыHexСтроки.Добавить(HexСимвола);
				Индекс = Индекс + 2;
			КонецЕсли;
		Иначе
			ФрагментыHexСтроки.Добавить(HexСимвола);
			Индекс = Индекс + 2;
		КонецЕсли;
	КонецЦикла;

	HexСтрока = СтрСоединить(ФрагментыHexСтроки, "");
	Данные = ПолучитьДвоичныеДанныеИзHexСтроки(HexСтрока);
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8NoBOM);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция HexСтрокаASCIIСимвола(Символ)

	Код = КодСимвола(Символ);

	Если Код > 127 Тогда
		ПроверкаАргументов.ПроверитьДопустимость("Значение", Ложь, "ASCII string");
	КонецЕсли;

	Возврат ШестнадцатеричноеПредставлениеБайта(Код);

КонецФункции

Функция ДопустимыйСимволФормы(Символ)

	Возврат СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789*-._", Символ) > 0;

КонецФункции

Функция БайтыИзHexСтроки(HexСтрока)

	Результат = Новый Массив;
	Индекс = 1;

	Пока Индекс <= СтрДлина(HexСтрока) Цикл
		Результат.Добавить(
			ЗначениеШестнадцатеричногоБайта(Сред(HexСтрока, Индекс, 2))
		);
		Индекс = Индекс + 2;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ПроверитьПродолжениеUTF8(Байты, Индекс, КоличествоПродолжений)

	Если Индекс + КоличествоПродолжений >= Байты.Количество() Тогда
		ВызватьНекорректныйUTF8();
	КонецЕсли;

	Для Смещение = 1 По КоличествоПродолжений Цикл
		Если Байты[Индекс + Смещение] < 128 Или Байты[Индекс + Смещение] > 191 Тогда
			ВызватьНекорректныйUTF8();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьБайтыUTF8(Байты, Индекс, КоличествоПродолжений, МинВторойБайт, МаксВторойБайт)

	Если Индекс + КоличествоПродолжений >= Байты.Количество() Тогда
		ВызватьНекорректныйUTF8();
	КонецЕсли;

	Если Байты[Индекс + 1] < МинВторойБайт Или Байты[Индекс + 1] > МаксВторойБайт Тогда
		ВызватьНекорректныйUTF8();
	КонецЕсли;

	Для Смещение = 2 По КоличествоПродолжений Цикл
		Если Байты[Индекс + Смещение] < 128 Или Байты[Индекс + Смещение] > 191 Тогда
			ВызватьНекорректныйUTF8();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ВызватьНекорректноеПроцентноеКодирование()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыОшибокURL.НедопустимоеПроцентноеКодирование(),
		"Некорректное процентное кодирование URI"
	);

КонецПроцедуры

Процедура ВызватьНекорректныйUTF8()

	ВызватьИсключение ПостроителиСтандартныхОшибок.ДанныеНеСоответствуютКодировке(
		"Данные URI",
		"UTF-8"
	).Построить();

КонецПроцедуры

#КонецОбласти
