#Область ПрограммныйИнтерфейс

// Возвращает код ошибки URI с недопустимым синтаксисом.
//
// Возвращаемое значение:
//  Строка - Код ошибки некорректного синтаксиса URI.
Функция НедопустимыйСинтаксисURI() Экспорт

	Возврат "uri.invalid_syntax";

КонецФункции

// Возвращает код ошибки URI с недопустимым синтаксисом схемы.
//
// Возвращаемое значение:
//  Строка - Код ошибки некорректного синтаксиса схемы URI.
Функция НедопустимаяСхемаURI() Экспорт

	Возврат "uri.invalid_scheme";

КонецФункции

// Возвращает код ошибки URI с недопустимым percent triplet.
//
// Возвращаемое значение:
//  Строка - Код ошибки некорректного percent triplet URI.
Функция НедопустимоеПроцентноеКодированиеURI() Экспорт

	Возврат "uri.invalid_percent_encoding";

КонецФункции

// Возвращает код ошибки URI с некорректной серверной частью.
//
// Возвращаемое значение:
//  Строка - Код ошибки некорректной authority URI.
Функция НедопустимаяСервернаяЧастьURI() Экспорт

	Возврат "uri.invalid_authority";

КонецФункции

// Возвращает код ошибки URI с некорректным хостом.
//
// Возвращаемое значение:
//  Строка - Код ошибки некорректного host URI.
Функция НедопустимыйХостURI() Экспорт

	Возврат "uri.invalid_host";

КонецФункции

// Возвращает код ошибки URI с некорректным IPv6 literal.
//
// Возвращаемое значение:
//  Строка - Код ошибки некорректного IPv6 literal.
Функция НедопустимыйIPv6() Экспорт

	Возврат "uri.invalid_ipv6";

КонецФункции

// Возвращает код ошибки URI с некорректным IPvFuture literal.
//
// Возвращаемое значение:
//  Строка - Код ошибки некорректного IPvFuture literal.
Функция НедопустимыйIPvFuture() Экспорт

	Возврат "uri.invalid_ipvfuture";

КонецФункции

// Возвращает код ошибки разрешения URI с относительной базой.
//
// Возвращаемое значение:
//  Строка - Код ошибки относительной базы URI resolution.
Функция БазаURIНеАбсолютная() Экспорт

	Возврат "uri.base_not_absolute";

КонецФункции

// Возвращает код ошибки относительного URL без базы.
//
// Возвращаемое значение:
//  Строка - Код ошибки relative URL без base.
Функция ОтносительныйURLБезБазы() Экспорт

	Возврат "url.relative_without_base";

КонецФункции

// Возвращает код ошибки URL с относительной базой.
//
// Возвращаемое значение:
//  Строка - Код ошибки относительной базы URL.
Функция БазаURLНеАбсолютная() Экспорт

	Возврат "url.base_not_absolute";

КонецФункции

// Возвращает код ошибки несовместимых изменяемых компонентов URL.
//
// Возвращаемое значение:
//  Строка - Код ошибки несовместимых mutable-компонентов URL.
Функция НесовместимыеКомпонентыURL() Экспорт

	Возврат "url.incompatible_components";

КонецФункции

// Возвращает код ошибки недопустимого компонента URL.
//
// Возвращаемое значение:
//  Строка - Код ошибки некорректного URL component.
Функция НедопустимыйКомпонентURL() Экспорт

	Возврат "url.invalid_component";

КонецФункции

// Возвращает код ошибки неподдерживаемого Unicode-хоста URL.
//
// Возвращаемое значение:
//  Строка - Код ошибки неподдерживаемого Unicode host.
Функция UnicodeХостНеПоддерживается() Экспорт

	Возврат "url.unsupported_unicode_host";

КонецФункции

// Возвращает код ошибки переполнения числового порта URL.
//
// Возвращаемое значение:
//  Строка - Код ошибки переполнения числового представления порта.
Функция ПереполнениеЧисловогоПорта() Экспорт

	Возврат "url.port.numeric_overflow";

КонецФункции

#КонецОбласти
