#Область ПрограммныйИнтерфейс

// Возвращает код ошибки URI с недопустимым синтаксисом.
//
// Возвращаемое значение:
//  Строка - Код ошибки некорректного синтаксиса URI.
Функция НедопустимыйСинтаксис() Экспорт

	Возврат "url.invalid_syntax";

КонецФункции

// Возвращает код ошибки URI с недопустимым синтаксисом схемы.
//
// Возвращаемое значение:
//  Строка - Код ошибки некорректного синтаксиса схемы URI.
Функция НедопустимаяСхема() Экспорт

	Возврат "url.invalid_scheme";

КонецФункции

// Возвращает код ошибки URI с недопустимой процентной последовательностью.
//
// Возвращаемое значение:
//  Строка - Код ошибки некорректной процентной последовательности URI.
Функция НедопустимоеПроцентноеКодирование() Экспорт

	Возврат "url.invalid_percent_encoding";

КонецФункции

// Возвращает код ошибки URI с некорректной серверной частью.
//
// Возвращаемое значение:
//  Строка - Код ошибки некорректной серверной части URI.
Функция НедопустимаяСервернаяЧасть() Экспорт

	Возврат "url.invalid_authority";

КонецФункции

// Возвращает код ошибки URI с некорректным хостом.
//
// Возвращаемое значение:
//  Строка - Код ошибки некорректного хоста URI.
Функция НедопустимыйХост() Экспорт

	Возврат "url.invalid_host";

КонецФункции

// Возвращает код ошибки операции URL с относительной базой.
//
// Возвращаемое значение:
//  Строка - Код ошибки относительной базы URL.
Функция БазаНеАбсолютная() Экспорт

	Возврат "url.base_not_absolute";

КонецФункции

// Возвращает код ошибки несовместимых изменяемых компонентов URL.
//
// Возвращаемое значение:
//  Строка - Код ошибки несовместимых изменяемых компонентов URL.
Функция НесовместимыеКомпоненты() Экспорт

	Возврат "url.incompatible_components";

КонецФункции

// Возвращает код ошибки переполнения числового порта URL.
//
// Возвращаемое значение:
//  Строка - Код ошибки переполнения числового представления порта.
Функция ПереполнениеЧисловогоПорта() Экспорт

	Возврат "url.port.numeric_overflow";

КонецФункции

// Возвращает код ошибки несоответствия URI ограничениям конкретной схемы.
//
// Возвращаемое значение:
//  Строка - Код ошибки проверки конкретной URI-схемы.
Функция НедопустимыйДляСхемы() Экспорт

	Возврат "url.invalid_for_scheme";

КонецФункции

// Возвращает код ошибки нормативных данных IDNA.
//
// Возвращаемое значение:
//  Строка - Код ошибки чтения или проверки нормативных данных IDNA.
Функция НедопустимыеДанныеIDNA() Экспорт

	Возврат "idna.data.invalid";

КонецФункции

#КонецОбласти
