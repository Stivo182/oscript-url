#Область ПрограммныйИнтерфейс

// Возвращает формат параметров с процентным кодированием по профилю RFC 3986.
//
// Возвращаемое значение:
//  Строка - Формат параметров URL.
Функция RFC3986() Экспорт

	Возврат "RFC3986";

КонецФункции

// Возвращает формат параметров application/x-www-form-urlencoded.
//
// Возвращаемое значение:
//  Строка - Формат параметров URL.
Функция ВебФорма() Экспорт

	Возврат "FormUrlEncoded";

КонецФункции

#КонецОбласти
