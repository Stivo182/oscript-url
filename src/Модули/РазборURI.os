#Использовать errors

#Область ПрограммныйИнтерфейс

// Разбирает URI-ссылку без исключения для ожидаемой ошибки входных данных.
//
// Параметры:
//  Значение - Строка - Разбираемая URI-ссылка.
//
// Возвращаемое значение:
//  URI, Неопределено - Разобранная ссылка или Неопределено при ожидаемой ошибке входных данных.
//
// Исключения:
//  Повторно вызывает неожиданную внутреннюю ошибку без машинного кода.
Функция ПопытатьсяРазобрать(Значение) Экспорт

	Попытка
		Возврат Новый URI(Значение);
	Исключение
		КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());

		Если КодОшибки = Неопределено Или КодОшибки = "" Тогда
			ВызватьИсключение;
		КонецЕсли;

		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Проверяет, является ли значение корректной URI-ссылкой.
//
// Параметры:
//  Значение - Строка - Проверяемая URI-ссылка.
//
// Возвращаемое значение:
//  Булево - Истина, если значение успешно разобрано.
//
// Исключения:
//  Повторно вызывает неожиданную внутреннюю ошибку без машинного кода.
Функция ЭтоКорректнаяСсылка(Значение) Экспорт

	Возврат ПопытатьсяРазобрать(Значение) <> Неопределено;

КонецФункции

#КонецОбласти
