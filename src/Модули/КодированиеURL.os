#Использовать errors
#Использовать "../internal"

#Область ПрограммныйИнтерфейс

// Кодирует строку как сегмент пути URI согласно RFC 3986 §3.3.
//
// Параметры:
//  Значение - Строка - Кодируемое значение.
//
// Возвращаемое значение:
//  Строка - Значение с процентным кодированием в UTF-8.
Функция КодироватьСегментПути(Значение) Экспорт

	ПроверитьСтроковыйАргумент(Значение);
	Возврат КодированиеКомпонентовURI.Кодировать(Значение, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
		+ "0123456789-._~!$&'()*+,;=:@");

КонецФункции

// Кодирует строку как путь URI согласно RFC 3986 §3.3.
//
// Параметры:
//  Значение - Строка - Кодируемое значение.
//
// Возвращаемое значение:
//  Строка - Значение с процентным кодированием в UTF-8.
Функция КодироватьПуть(Значение) Экспорт

	ПроверитьСтроковыйАргумент(Значение);
	Возврат КодированиеКомпонентовURI.Кодировать(Значение, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
		+ "0123456789-._~!$&'()*+,;=:@/");

КонецФункции

// Кодирует строку как запрос URI согласно RFC 3986 §3.4.
//
// Параметры:
//  Значение - Строка - Кодируемое значение.
//
// Возвращаемое значение:
//  Строка - Значение с процентным кодированием в UTF-8.
Функция КодироватьЗапрос(Значение) Экспорт

	ПроверитьСтроковыйАргумент(Значение);
	Возврат КодироватьЗапросИлиФрагмент(Значение);

КонецФункции

// Кодирует строку как фрагмент URI согласно RFC 3986 §3.5.
//
// Параметры:
//  Значение - Строка - Кодируемое значение.
//
// Возвращаемое значение:
//  Строка - Значение с процентным кодированием в UTF-8.
Функция КодироватьФрагмент(Значение) Экспорт

	ПроверитьСтроковыйАргумент(Значение);
	Возврат КодироватьЗапросИлиФрагмент(Значение);

КонецФункции

// Кодирует данные пользователя URI согласно RFC 3986 §3.2.1.
//
// Параметры:
//  Значение - Строка - Кодируемое значение.
//
// Возвращаемое значение:
//  Строка - Значение с процентным кодированием в UTF-8.
Функция КодироватьДанныеПользователя(Значение) Экспорт

	ПроверитьСтроковыйАргумент(Значение);
	Возврат КодированиеКомпонентовURI.Кодировать(Значение, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
		+ "0123456789-._~!$&'()*+,;=:");

КонецФункции

// Кодирует имя пользователя URI.
//
// Параметры:
//  Значение - Строка - Кодируемое значение.
//
// Возвращаемое значение:
//  Строка - Значение с процентным кодированием в UTF-8.
Функция КодироватьИмяПользователя(Значение) Экспорт

	ПроверитьСтроковыйАргумент(Значение);
	Возврат КодированиеКомпонентовURI.Кодировать(Значение, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
		+ "0123456789-._~!$&'()*+,;=");

КонецФункции

// Кодирует пароль URI.
//
// Параметры:
//  Значение - Строка - Кодируемое значение.
//
// Возвращаемое значение:
//  Строка - Значение с процентным кодированием в UTF-8.
Функция КодироватьПароль(Значение) Экспорт

	ПроверитьСтроковыйАргумент(Значение);
	Возврат КодированиеКомпонентовURI.Кодировать(Значение, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
		+ "0123456789-._~!$&'()*+,;=:");

КонецФункции

// Декодирует ASCII-строку с процентным кодированием в последовательность байтов.
//
// Параметры:
//  Значение - Строка - ASCII-строка с процентным кодированием.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Декодированная последовательность байтов.
Функция ДекодироватьВБайты(Значение) Экспорт

	ПроверитьСтроковыйАргумент(Значение);
	Возврат КодированиеКомпонентовURI.ДекодироватьВБайты(Значение);

КонецФункции

// Декодирует ASCII-строку с процентным кодированием как строгий UTF-8.
//
// Параметры:
//  Значение - Строка - ASCII-строка с процентным кодированием.
//
// Возвращаемое значение:
//  Строка - Строка, декодированная из UTF-8.
Функция ДекодироватьUTF8(Значение) Экспорт

	ПроверитьСтроковыйАргумент(Значение);
	Данные = КодированиеКомпонентовURI.ДекодироватьВБайты(Значение);
	Возврат КодированиеКомпонентовURI.ДекодироватьСтрогийUTF8(Данные);

КонецФункции

// Кодирует параметр application/x-www-form-urlencoded по WHATWG URL §5.
//
// Параметры:
//  Значение - Строка - Кодируемое значение.
//
// Возвращаемое значение:
//  Строка - Представление параметра application/x-www-form-urlencoded в UTF-8.
Функция КодироватьПараметрФормы(Значение) Экспорт

	ПроверитьСтроковыйАргумент(Значение);
	Возврат КодированиеКомпонентовURI.КодироватьФорму(Значение);

КонецФункции

// Декодирует параметр application/x-www-form-urlencoded по WHATWG URL §5.
//
// Параметры:
//  Значение - Строка - Значение параметра application/x-www-form-urlencoded.
//
// Возвращаемое значение:
//  Строка - Декодированное значение с заменой некорректного UTF-8.
Функция ДекодироватьПараметрФормы(Значение) Экспорт

	ПроверитьСтроковыйАргумент(Значение);
	Возврат КодированиеКомпонентовURI.ДекодироватьФорму(Значение);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьСтроковыйАргумент(Значение)

	ПроверкаАргументов.ПроверитьТип("Значение", Значение, Тип("Строка"));

КонецПроцедуры

Функция КодироватьЗапросИлиФрагмент(Значение)

	Возврат КодированиеКомпонентовURI.Кодировать(Значение, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
		+ "0123456789-._~!$&'()*+,;=:@/?");

КонецФункции

#КонецОбласти
