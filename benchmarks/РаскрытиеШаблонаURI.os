#Использовать "../src"

Перем _Представление; // Строка
Перем _Значения; // ФиксированноеСоответствие
Перем _СоставныеЗначения; // ФиксированноеСоответствие
Перем _Шаблон; // ШаблонURI
Перем _СоставнойШаблон; // ШаблонURI
Перем _ПодготовленныйШаблон; // ФиксированнаяСтруктура
Перем _ПодготовленныйСоставнойШаблон; // ФиксированнаяСтруктура
Перем _РазобранныйШаблон; // ФиксированнаяСтруктура
Перем _РаскрытоеПредставление; // Строка
Перем _ОбработчикВыражений; // ОбработчикВыраженийШаблонаURI
Перем _Разборщик; // РазборщикШаблонаURI
Перем _Результат; // Строка, ШаблонURI, URL

#Область ОбработчикиСобытий

// Подготавливает шаблоны и значения для раскрытия.
&МониторингПамяти
Процедура ПриСозданииОбъекта()

	_ОбработчикВыражений = СервисыБиблиотекиURL.ОбработчикВыраженийШаблонаURI();
	_Разборщик = СервисыБиблиотекиURL.РазборщикШаблонаURI();

	_Представление = "https://api.example.com/users/{id}{?page,filter}";

	Значения = Новый Соответствие;
	Значения.Вставить("id", "Иван/42");
	Значения.Вставить("page", 2);
	Значения.Вставить("filter", "active users");
	_Значения = Новый ФиксированноеСоответствие(Значения);

	Сегменты = Новый Массив;
	Сегменты.Добавить("catalog");
	Сегменты.Добавить("Иван/42");
	Сегменты.Добавить("orders");

	Фильтр = Новый Соответствие;
	Фильтр.Вставить("status", "active");
	Фильтр.Вставить("role", "site admin");

	Поля = Новый Массив;
	Поля.Добавить("id");
	Поля.Добавить("name");
	Поля.Добавить("created at");

	СоставныеЗначения = Новый Соответствие;
	СоставныеЗначения.Вставить("segments", Новый ФиксированныйМассив(Сегменты));
	СоставныеЗначения.Вставить("filter", Новый ФиксированноеСоответствие(Фильтр));
	СоставныеЗначения.Вставить("fields", Новый ФиксированныйМассив(Поля));
	_СоставныеЗначения = Новый ФиксированноеСоответствие(СоставныеЗначения);

	_Шаблон = Новый ШаблонURI(_Представление);
	_СоставнойШаблон = Новый ШаблонURI("{/segments*}{?filter*,fields*}");

	_РазобранныйШаблон = _Разборщик.Разобрать(_Представление);
	_ПодготовленныйШаблон = _ОбработчикВыражений.Подготовить(_РазобранныйШаблон);
	_ПодготовленныйСоставнойШаблон = _ОбработчикВыражений.Подготовить(
		_Разборщик.Разобрать("{/segments*}{?filter*,fields*}")
	);
	_РаскрытоеПредставление = _ОбработчикВыражений.Раскрыть(_ПодготовленныйШаблон, _Значения);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Измеряет создание и разбор шаблона URI.
&Бенчмарк(Наименование = "Создать шаблон URI")
Процедура СоздатьШаблонURI() Экспорт
	_Результат = Новый ШаблонURI(_Представление);
КонецПроцедуры

// Измеряет разбор шаблона без подготовки литералов и выражений.
&Бенчмарк(Наименование = "Разобрать шаблон URI")
Процедура РазобратьШаблонURI() Экспорт
	_Результат = _Разборщик.Разобрать(_Представление);
КонецПроцедуры

// Измеряет подготовку ранее разобранного шаблона.
&Бенчмарк(Наименование = "Подготовить шаблон URI")
Процедура ПодготовитьШаблонURI() Экспорт
	_Результат = _ОбработчикВыражений.Подготовить(_РазобранныйШаблон);
КонецПроцедуры

// Измеряет создание и одно раскрытие шаблона.
&Бенчмарк(Наименование = "Создать и раскрыть шаблон URI")
Процедура СоздатьИРаскрытьШаблонURI() Экспорт
	_Результат = Новый ШаблонURI(_Представление).Раскрыть(_Значения);
КонецПроцедуры

// Измеряет повторное раскрытие заранее созданного шаблона URI.
&Бенчмарк(Наименование = "Раскрыть шаблон URI")
Процедура РаскрытьШаблонURI() Экспорт
	_Результат = _Шаблон.Раскрыть(_Значения);
КонецПроцедуры

// Измеряет раскрытие списков и ассоциативных значений уровня 4.
&Бенчмарк(Наименование = "Раскрыть составные значения")
Процедура РаскрытьСоставныеЗначения() Экспорт
	_Результат = _СоставнойШаблон.Раскрыть(_СоставныеЗначения);
КонецПроцедуры

// Измеряет раскрытие простых значений без разбора итогового URL.
&Бенчмарк(Наименование = "Раскрыть шаблон URI в строку")
Процедура РаскрытьШаблонURIВСтроку() Экспорт
	_Результат = _ОбработчикВыражений.Раскрыть(
		_ПодготовленныйШаблон,
		_Значения
	);
КонецПроцедуры

// Измеряет раскрытие составных значений без разбора итогового URL.
&Бенчмарк(Наименование = "Раскрыть составные значения в строку")
Процедура РаскрытьСоставныеЗначенияВСтроку() Экспорт
	_Результат = _ОбработчикВыражений.Раскрыть(
		_ПодготовленныйСоставнойШаблон,
		_СоставныеЗначения
	);
КонецПроцедуры

// Измеряет разбор URL из заранее раскрытой строки.
&Бенчмарк(Наименование = "Создать URL из раскрытой строки")
Процедура СоздатьURLИзРаскрытойСтроки() Экспорт
	_Результат = Новый URL(_РаскрытоеПредставление);
КонецПроцедуры

#КонецОбласти
