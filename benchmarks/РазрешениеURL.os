#Использовать "../src"

Перем _ИсходнаяБаза; // Строка
Перем _ОтносительнаяСсылка; // Строка
Перем _База; // URL
Перем _Результат; // URL

#Область ОбработчикиСобытий

// Подготавливает строки базового URL и относительной ссылки.
&МониторингПамяти
Процедура ПриСозданииОбъекта()

	_ИсходнаяБаза = "https://example.com/api/v1/catalog/items/index.html?lang=ru#list";
	_ОтносительнаяСсылка = "../../users/42/orders?include=items#latest";

КонецПроцедуры

// Создаёт базовый URL перед запуском кейса.
//
// Параметры:
//  Контекст - Произвольный - Контекст кейса benchos.
&ПередКаждымКейсом
Процедура ПодготовитьБазу(Контекст) Экспорт // BSLLS:UnusedParameters-off
	_База = Новый URL(_ИсходнаяБаза);
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Измеряет разрешение относительной ссылки по RFC 3986, раздел 5.2.
//
// Ссылки:
//  RFC 3986, раздел 5.2 - разрешение относительных ссылок:
//  https://www.rfc-editor.org/rfc/rfc3986.html#section-5.2
&Бенчмарк
Процедура РазрешитьОтносительнуюСсылку() Экспорт
	_Результат = _База.Разрешить(_ОтносительнаяСсылка);
КонецПроцедуры

#КонецОбласти
