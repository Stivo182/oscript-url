#Использовать "../src"

Перем _Адрес; // URL
Перем _Путь; // Строка
Перем _Запрос; // Строка
Перем _Результат; // URL

#Область ОбработчикиСобытий

// Подготавливает значения компонентов URL.
&МониторингПамяти
Процедура ПриСозданииОбъекта()

	_Путь = "/каталог с пробелом/товары%со скидкой/новинки и предложения";
	_Запрос = "поиск=товары со скидкой&фильтр=новинки%акции&сортировка=сначала популярные";

КонецПроцедуры

// Создаёт URL перед запуском кейса.
//
// Параметры:
//  Контекст - Произвольный - Контекст кейса benchos.
&ПередКаждымКейсом
Процедура ПодготовитьАдрес(Контекст) Экспорт // BSLLS:UnusedParameters-off
	_Адрес = Новый URL("https://example.com/old?old=1#fragment");
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Измеряет установку декодированного пути с Unicode и символами для процентного кодирования.
&Бенчмарк
Процедура УстановитьДекодированныйПуть() Экспорт
	_Результат = _Адрес.УстановитьПуть(_Путь);
КонецПроцедуры

// Измеряет установку декодированного запроса с Unicode и символами для процентного кодирования.
&Бенчмарк
Процедура УстановитьДекодированныйЗапрос() Экспорт
	_Результат = _Адрес.УстановитьСтрокуЗапроса(_Запрос);
КонецПроцедуры

#КонецОбласти
