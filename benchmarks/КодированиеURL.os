#Использовать "../src"

Перем _Значение; // Строка
Перем _Результат; // Строка

#Область ОбработчикиСобытий

// Подготавливает строку с ASCII, Unicode и символами для процентного кодирования.
&МониторингПамяти
Процедура ПриСозданииОбъекта()

	_Значение = "каталог с пробелом/товары%со скидкой?поиск=новинки и предложения";

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Измеряет процентное кодирование сегмента пути.
&Бенчмарк
Процедура КодироватьСегментПути() Экспорт
	_Результат = КодированиеURL.КодироватьСегментПути(_Значение);
КонецПроцедуры

// Измеряет кодирование параметра application/x-www-form-urlencoded.
&Бенчмарк
Процедура КодироватьПараметрФормы() Экспорт
	_Результат = КодированиеURL.КодироватьПараметрФормы(_Значение);
КонецПроцедуры

#КонецОбласти
