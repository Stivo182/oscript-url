#Использовать "../src"

Перем _ASCIIАдрес; // Строка
Перем _UnicodeАдрес; // Строка
Перем _Результат; // URL

#Область ОбработчикиСобытий

// Подготавливает входные строки для разбора URL.
&МониторингПамяти
Процедура ПриСозданииОбъекта()

	_ASCIIАдрес = "https://user:password@example.com:8443/api/v1/items?q=hello%20world&page=2#result";
	_UnicodeАдрес = "https://пользователь:пароль@пример.рф:8443/каталог/товары?q=поиск&page=2#результат";

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Измеряет разбор URL, состоящего из символов ASCII.
&Бенчмарк
Процедура РазобратьASCIIURL() Экспорт
	_Результат = Новый URL(_ASCIIАдрес);
КонецПроцедуры

// Измеряет разбор URL с Unicode и интернационализированным доменным именем.
&Бенчмарк
Процедура РазобратьUnicodeURL() Экспорт
	_Результат = Новый URL(_UnicodeАдрес);
КонецПроцедуры

#КонецОбласти
