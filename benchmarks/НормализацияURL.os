#Использовать "../src"

Перем _ИсходнаяСтрока; // Строка
Перем _Адрес; // URL
Перем _Результат; // URL

#Область ОбработчикиСобытий

// Подготавливает исходную строку URL.
&МониторингПамяти
Процедура ПриСозданииОбъекта()
	_ИсходнаяСтрока = "HTTP://Example.COM:80/a/./b/../c/%7euser?q=%D1%82%D0%B5%D1%81%D1%82#%41";
КонецПроцедуры

// Создаёт исходный URL перед запуском кейса.
//
// Параметры:
//  Контекст - Произвольный - Контекст кейса benchos.
&ПередКаждымКейсом
Процедура ПодготовитьАдрес(Контекст) Экспорт // BSLLS:UnusedParameters-off
	_Адрес = Новый URL(_ИсходнаяСтрока);
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Измеряет нормализацию URL по RFC 3986.
//
// Ссылки:
//  RFC 3986, раздел 6.2.2 - нормализация синтаксиса:
//  https://www.rfc-editor.org/rfc/rfc3986.html#section-6.2.2
&Бенчмарк
Процедура НормализоватьURL() Экспорт
	_Результат = _Адрес.Нормализованный();
КонецПроцедуры

#КонецОбласти
