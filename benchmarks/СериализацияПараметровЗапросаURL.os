#Использовать "../src"

Перем _ИсходнаяСтрока; // Строка
Перем _Параметры; // ПараметрыЗапросаURL
Перем _Результат; // Строка

#Область ОбработчикиСобытий

// Подготавливает исходную строку параметров запроса.
&МониторингПамяти
Процедура ПриСозданииОбъекта()

	_ИсходнаяСтрока = "q=hello+world&page=2&include=orders&include=contacts&sort=-created_at&lang=ru";

КонецПроцедуры

// Создаёт коллекцию параметров перед запуском кейса.
//
// Параметры:
//  Контекст - Произвольный - Контекст кейса benchos.
&ПередКаждымКейсом
Процедура ПодготовитьПараметры(Контекст) Экспорт // BSLLS:UnusedParameters-off
	_Параметры = Новый ПараметрыЗапросаURL(_ИсходнаяСтрока);
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Измеряет сериализацию параметров в application/x-www-form-urlencoded.
&Бенчмарк
Процедура СериализоватьПараметрыЗапроса() Экспорт
	_Результат = _Параметры.ВСтроку();
КонецПроцедуры

#КонецОбласти
