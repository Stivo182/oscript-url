// Формирует автономный модуль нормативных данных IDNA для Unicode 17.0.0.
//
// Использование:
//  oscript tools/СформироватьДанныеIDNA.os <каталог> [модуль] [двоичный файл]
//
// В исходном каталоге должны находиться IdnaMappingTable.txt, UnicodeData.txt, ReadMe.txt,
// DerivedNormalizationProps.txt, DerivedBidiClass.txt и DerivedJoiningType.txt.

Процедура СформироватьДанные()

	ВерсияUnicode = "17.0.0";
	Аргументы = АргументыКоманднойСтроки;

	Если Аргументы.Количество() = 0 Тогда
		ВызватьИсключение "Не указан каталог исходных файлов Unicode";
	КонецЕсли;

	КаталогИсточников = Аргументы[0];

	Если Аргументы.Количество() > 1 Тогда
		ИмяВыходногоФайла = Аргументы[1];
	Иначе
		ИмяВыходногоФайла = ОбъединитьПути(
			ТекущийКаталог(),
			"src/internal/Классы/ЧитательДанныхIDNA.os"
		);
	КонецЕсли;

	Если Аргументы.Количество() > 2 Тогда
		ИмяДвоичногоФайла = Аргументы[2];
	Иначе
		ИмяДвоичногоФайла = ОбъединитьПути(
			ТекущийКаталог(),
			"src/internal/Данные/ДанныеIDNA.bin"
		);
	КонецЕсли;

	ПроверитьИсходныеФайлы(КаталогИсточников);
	ПроверитьВерсииИсходныхФайлов(КаталогИсточников, ВерсияUnicode);

	ТаблицаСопоставлений = ПолучитьТаблицуСопоставлений(КаталогИсточников);
	ТаблицаНормализации = ПолучитьТаблицуНормализации(КаталогИсточников);
	Сообщить("Подготовлена таблица нормализации");
	ТаблицаБыстройПроверкиNFC = ПолучитьТаблицуБыстройПроверкиNFC(КаталогИсточников);
	ТаблицаКлассовКомбинирования = ПолучитьТаблицуКлассовКомбинирования(КаталогИсточников);
	ТаблицаКатегорийМеток = ПолучитьТаблицуКатегорийМеток(КаталогИсточников);
	ТаблицаИсключений = ПолучитьТаблицуИсключений(КаталогИсточников);
	ТаблицаНаправлений = ПолучитьТаблицуНаправлений(КаталогИсточников);
	ТаблицаНаправленийДоменов = ПолучитьТаблицуНаправленийДоменов(КаталогИсточников);
	Сообщить("Подготовлена таблица классов направления");
	ТаблицаСоединений = ПолучитьТаблицуСоединений(КаталогИсточников);
	Сообщить("Подготовлена таблица типов соединения");
	КодыКлассовНаправления = ПолучитьКодыЗначений(
		"L,R,AL,EN,ES,ET,AN,CS,B,S,WS,ON,NSM,BN,LRE,LRO,RLE,RLO,PDF,LRI,RLI,FSI,PDI"
	);
	КодыТиповСоединения = ПолучитьКодыЗначений("U,R,L,D,C,T");
	Секции = Новый Массив;
	Секции.Добавить(СформироватьДвоичнуюТаблицуСопоставлений(ТаблицаСопоставлений));
	Секции.Добавить(СформироватьДвоичнуюТаблицуНормализации(ТаблицаНормализации));
	Секции.Добавить(СформироватьДвоичныеДиапазоны(ТаблицаБыстройПроверкиNFC));
	Секции.Добавить(СформироватьДвоичныеКлассыКомбинирования(ТаблицаКлассовКомбинирования));
	Секции.Добавить(СформироватьДвоичныеКодовыеТочки(ТаблицаКатегорийМеток));
	Секции.Добавить(СформироватьДвоичныеДиапазоны(ТаблицаИсключений));
	Секции.Добавить(СформироватьДвоичныеДиапазоныСоЗначением(
		ТаблицаНаправлений,
		КодыКлассовНаправления,
		"класс направления Unicode"
	));
	Секции.Добавить(СформироватьДвоичныеДиапазоны(ТаблицаНаправленийДоменов));
	Секции.Добавить(СформироватьДвоичныеДиапазоныСоЗначением(
		ТаблицаСоединений,
		КодыТиповСоединения,
		"тип соединения Unicode"
	));
	ЗаписатьДвоичнуюТаблицу(ИмяДвоичногоФайла, СформироватьКонтейнер(Секции));

	ЗаписатьМодульДанных(ИмяВыходногоФайла, ВерсияUnicode);

	Сообщить(СтрШаблон("Сформирован файл %1", ИмяВыходногоФайла));
	Сообщить(СтрШаблон("Сформирован файл %1", ИмяДвоичногоФайла));

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьИсходныеФайлы(КаталогИсточников)

	ИменаФайлов = Новый Массив;
	ИменаФайлов.Добавить("IdnaMappingTable.txt");
	ИменаФайлов.Добавить("UnicodeData.txt");
	ИменаФайлов.Добавить("ReadMe.txt");
	ИменаФайлов.Добавить("DerivedNormalizationProps.txt");
	ИменаФайлов.Добавить("DerivedBidiClass.txt");
	ИменаФайлов.Добавить("DerivedJoiningType.txt");

	Для Каждого ИмяФайла Из ИменаФайлов Цикл
		ПолноеИмя = ОбъединитьПути(КаталогИсточников, ИмяФайла);

		Если Не Новый Файл(ПолноеИмя).Существует() Тогда
			ВызватьИсключение СтрШаблон("Не найден исходный файл %1", ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьВерсииИсходныхФайлов(КаталогИсточников, ВерсияUnicode)

	ПроверитьМаркерВерсии(
		ОбъединитьПути(КаталогИсточников, "IdnaMappingTable.txt"),
		"Version: " + ВерсияUnicode,
		ВерсияUnicode
	);
	ПроверитьМаркерВерсии(
		ОбъединитьПути(КаталогИсточников, "ReadMe.txt"),
		"Version " + ВерсияUnicode,
		ВерсияUnicode
	);
	ПроверитьМаркерВерсии(
		ОбъединитьПути(КаталогИсточников, "DerivedNormalizationProps.txt"),
		"DerivedNormalizationProps-" + ВерсияUnicode + ".txt",
		ВерсияUnicode
	);
	ПроверитьМаркерВерсии(
		ОбъединитьПути(КаталогИсточников, "DerivedBidiClass.txt"),
		"DerivedBidiClass-" + ВерсияUnicode + ".txt",
		ВерсияUnicode
	);
	ПроверитьМаркерВерсии(
		ОбъединитьПути(КаталогИсточников, "DerivedJoiningType.txt"),
		"DerivedJoiningType-" + ВерсияUnicode + ".txt",
		ВерсияUnicode
	);
	ПроверитьХешФайла(
		ОбъединитьПути(КаталогИсточников, "UnicodeData.txt"),
		"2E1EFC1DCB59C575EEDF5CCAE60F95229F706EE6D031835247D843C11D96470C",
		ВерсияUnicode
	);

КонецПроцедуры

Процедура ПроверитьХешФайла(ИмяФайла, ОжидаемыйХеш, ВерсияUnicode)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.ДобавитьФайл(ИмяФайла);

	Если ВРег(Хеширование.ХешСуммаСтрокой) <> ОжидаемыйХеш Тогда
		ВызватьИсключение СтрШаблон(
			"Файл %1 не соответствует UnicodeData.txt версии %2",
			ИмяФайла,
			ВерсияUnicode
		);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьМаркерВерсии(ИмяФайла, МаркерВерсии, ВерсияUnicode)

	Чтение = Новый ЧтениеТекста(ИмяФайла);
	МаркерНайден = Ложь;

	Пока Истина Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();

		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Если СтрНайти(СтрокаФайла, МаркерВерсии) > 0 Тогда
			МаркерНайден = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Чтение.Закрыть();

	Если Не МаркерНайден Тогда
		ВызватьИсключение СтрШаблон(
			"Файл %1 не относится к Unicode %2",
			ИмяФайла,
			ВерсияUnicode
		);
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьТаблицуСопоставлений(КаталогИсточников)

	Строки = Новый Массив;
	ИмяФайла = ОбъединитьПути(КаталогИсточников, "IdnaMappingTable.txt");
	Чтение = Новый ЧтениеТекста(ИмяФайла);

	Пока Истина Цикл
		СодержимоеСтроки = ПрочитатьСледующуюЗначащуюСтроку(Чтение);

		Если СодержимоеСтроки = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Поля = СтрРазделить(СодержимоеСтроки, ";", Истина);
		Диапазон = СокрЛП(Поля[0]);
		Статус = СокрЛП(Поля[1]);
		Сопоставление = ?(Поля.Количество() > 2, СокрЛП(Поля[2]), "");

		Если ПустаяСтрока(Сопоставление) Тогда
			Строки.Добавить(СтрШаблон("%1;%2", Диапазон, Статус));
		Иначе
			Строки.Добавить(СтрШаблон("%1;%2;%3", Диапазон, Статус, Сопоставление));
		КонецЕсли;
	КонецЦикла;

	Чтение.Закрыть();

	Возврат Строки;

КонецФункции

Функция СформироватьДвоичнуюТаблицуСопоставлений(Строки)

	РазмерЗаголовка = 16;
	РазмерЗаписи = 16;
	КоличествоТочекСопоставлений = 0;

	Для Каждого СтрокаТаблицы Из Строки Цикл
		Поля = СтрРазделить(СтрокаТаблицы, ";", Истина);

		Если Поля.Количество() > 2 И Не ПустаяСтрока(Поля[2]) Тогда
			КоличествоТочекСопоставлений = КоличествоТочекСопоставлений
				+ СтрРазделить(СокрЛП(Поля[2]), " ", Ложь).Количество();
		КонецЕсли;
	КонецЦикла;

	СмещениеПула = РазмерЗаголовка + Строки.Количество() * РазмерЗаписи;
	РазмерБуфера = СмещениеПула + КоличествоТочекСопоставлений * 4;
	Буфер = Новый БуферДвоичныхДанных(РазмерБуфера);
	Буфер.ЗаписатьЦелое32(0, 827212873); // ASCII: IDN1.
	Буфер.ЗаписатьЦелое16(4, 1);
	Буфер.ЗаписатьЦелое16(6, РазмерЗаписи);
	Буфер.ЗаписатьЦелое32(8, Строки.Количество());
	Буфер.ЗаписатьЦелое32(12, СмещениеПула);

	СмещениеСопоставления = 0;

	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		Поля = СтрРазделить(Строки[Индекс], ";", Истина);
		Границы = ГраницыДиапазона(Поля[0]);
		ТочкиСопоставления = ПолучитьТочкиСопоставления(Поля);
		СмещениеЗаписи = РазмерЗаголовка + Индекс * РазмерЗаписи;
		Буфер.ЗаписатьЦелое32(СмещениеЗаписи, Границы[0]);
		Буфер.ЗаписатьЦелое32(СмещениеЗаписи + 4, Границы[1]);
		Буфер[СмещениеЗаписи + 8] = КодСтатусаСопоставления(Поля[1]);
		Буфер.ЗаписатьЦелое16(СмещениеЗаписи + 10, ТочкиСопоставления.Количество());
		Буфер.ЗаписатьЦелое32(СмещениеЗаписи + 12, СмещениеСопоставления);

		Для Каждого КодоваяТочка Из ТочкиСопоставления Цикл
			Буфер.ЗаписатьЦелое32(СмещениеПула + СмещениеСопоставления, КодоваяТочка);
			СмещениеСопоставления = СмещениеСопоставления + 4;
		КонецЦикла;
	КонецЦикла;

	Возврат Буфер;

КонецФункции

Процедура ЗаписатьДвоичнуюТаблицу(ИмяФайла, Буфер)

	СоздатьКаталог(Новый Файл(ИмяФайла).Путь);
	Данные = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);
	Данные.Записать(ИмяФайла);

КонецПроцедуры

Функция СформироватьКонтейнер(Секции)

	РазмерЗаголовка = 16;
	РазмерЗаписиКаталога = 44;
	СмещениеДанных = РазмерЗаголовка + Секции.Количество() * РазмерЗаписиКаталога;
	РазмерБуфера = СмещениеДанных;

	Для Каждого Секция Из Секции Цикл
		РазмерБуфера = РазмерБуфера + Секция.Размер;
	КонецЦикла;

	Буфер = Новый БуферДвоичныхДанных(РазмерБуфера);
	Буфер.ЗаписатьЦелое32(0, 826426441); // ASCII: IDB1.
	Буфер.ЗаписатьЦелое16(4, 2);
	Буфер.ЗаписатьЦелое16(6, РазмерЗаписиКаталога);
	Буфер.ЗаписатьЦелое32(8, Секции.Количество());
	Буфер.ЗаписатьЦелое32(12, СмещениеДанных);

	Для Индекс = 0 По Секции.Количество() - 1 Цикл
		СмещениеЗаписи = РазмерЗаголовка + Индекс * РазмерЗаписиКаталога;
		Буфер.ЗаписатьЦелое16(СмещениеЗаписи, Индекс + 1);
		Буфер.ЗаписатьЦелое32(СмещениеЗаписи + 4, СмещениеДанных);
		Буфер.ЗаписатьЦелое32(СмещениеЗаписи + 8, Секции[Индекс].Размер);
		Буфер.Записать(СмещениеЗаписи + 12, ВычислитьSHA256(Секции[Индекс]));
		Буфер.Записать(СмещениеДанных, Секции[Индекс]);
		СмещениеДанных = СмещениеДанных + Секции[Индекс].Размер;
	КонецЦикла;

	Возврат Буфер;

КонецФункции

Функция ВычислитьSHA256(Буфер)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер));
	Возврат ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Хеширование.ХешСумма);

КонецФункции

Функция СформироватьДвоичнуюТаблицуНормализации(Строки)

	РазмерЗаписи = 12;
	КоличествоТочекРазложения = 0;

	Для Каждого СтрокаТаблицы Из Строки Цикл
		Поля = СтрРазделить(СтрокаТаблицы, ";", Истина);

		Если Не ПустаяСтрока(Поля[2]) Тогда
			КоличествоТочекРазложения = КоличествоТочекРазложения
				+ СтрРазделить(Поля[2], " ", Ложь).Количество();
		КонецЕсли;
	КонецЦикла;

	СмещениеПула = 8 + Строки.Количество() * РазмерЗаписи;
	Буфер = Новый БуферДвоичныхДанных(СмещениеПула + КоличествоТочекРазложения * 4);
	Буфер.ЗаписатьЦелое32(0, Строки.Количество());
	Буфер.ЗаписатьЦелое32(4, СмещениеПула);
	СмещениеРазложения = 0;

	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		Поля = СтрРазделить(Строки[Индекс], ";", Истина);
		ТочкиРазложения = КодовыеТочкиИзHexСтроки(Поля[2]);
		СмещениеЗаписи = 8 + Индекс * РазмерЗаписи;
		Буфер.ЗаписатьЦелое32(СмещениеЗаписи, ЧислоИзHexСтроки(Поля[0]));
		Буфер.ЗаписатьЦелое16(СмещениеЗаписи + 4, Число(Поля[1]));
		Буфер[СмещениеЗаписи + 6] = ?(Поля[3] = "M", 1, 0);
		Буфер[СмещениеЗаписи + 7] = ТочкиРазложения.Количество();
		Буфер.ЗаписатьЦелое32(СмещениеЗаписи + 8, СмещениеРазложения);

		Для Каждого КодоваяТочка Из ТочкиРазложения Цикл
			Буфер.ЗаписатьЦелое32(СмещениеПула + СмещениеРазложения, КодоваяТочка);
			СмещениеРазложения = СмещениеРазложения + 4;
		КонецЦикла;
	КонецЦикла;

	Возврат Буфер;

КонецФункции

Функция СформироватьДвоичныеДиапазоны(Строки)

	Буфер = Новый БуферДвоичныхДанных(4 + Строки.Количество() * 8);
	Буфер.ЗаписатьЦелое32(0, Строки.Количество());

	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		Поля = СтрРазделить(Строки[Индекс], ";", Истина);
		Границы = ГраницыДиапазона(Поля[0]);
		СмещениеЗаписи = 4 + Индекс * 8;
		Буфер.ЗаписатьЦелое32(СмещениеЗаписи, Границы[0]);
		Буфер.ЗаписатьЦелое32(СмещениеЗаписи + 4, Границы[1]);
	КонецЦикла;

	Возврат Буфер;

КонецФункции

Функция СформироватьДвоичныеКлассыКомбинирования(Строки)

	Буфер = Новый БуферДвоичныхДанных(4 + Строки.Количество() * 8);
	Буфер.ЗаписатьЦелое32(0, Строки.Количество());

	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		Поля = СтрРазделить(Строки[Индекс], ";", Истина);
		СмещениеЗаписи = 4 + Индекс * 8;
		Буфер.ЗаписатьЦелое32(СмещениеЗаписи, ЧислоИзHexСтроки(Поля[0]));
		Буфер.ЗаписатьЦелое16(СмещениеЗаписи + 4, Число(Поля[1]));
	КонецЦикла;

	Возврат Буфер;

КонецФункции

Функция СформироватьДвоичныеКодовыеТочки(Строки)

	Буфер = Новый БуферДвоичныхДанных(4 + Строки.Количество() * 4);
	Буфер.ЗаписатьЦелое32(0, Строки.Количество());

	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		Буфер.ЗаписатьЦелое32(4 + Индекс * 4, ЧислоИзHexСтроки(Строки[Индекс]));
	КонецЦикла;

	Возврат Буфер;

КонецФункции

Функция СформироватьДвоичныеДиапазоныСоЗначением(Строки, КодыЗначений, НазваниеЗначения)

	Буфер = Новый БуферДвоичныхДанных(4 + Строки.Количество() * 12);
	Буфер.ЗаписатьЦелое32(0, Строки.Количество());

	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		Поля = СтрРазделить(Строки[Индекс], ";", Истина);
		Границы = ГраницыДиапазона(Поля[0]);
		СмещениеЗаписи = 4 + Индекс * 12;
		Буфер.ЗаписатьЦелое32(СмещениеЗаписи, Границы[0]);
		Буфер.ЗаписатьЦелое32(СмещениеЗаписи + 4, Границы[1]);
		КодЗначения = КодыЗначений.Получить(Поля[1]);

		Если КодЗначения = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Неизвестный %1: %2", НазваниеЗначения, Поля[1]);
		КонецЕсли;

		Буфер[СмещениеЗаписи + 8] = КодЗначения;
	КонецЦикла;

	Возврат Буфер;

КонецФункции

Функция КодовыеТочкиИзHexСтроки(Значение)

	Результат = Новый Массив;

	Если Не ПустаяСтрока(Значение) Тогда
		Для Каждого HexКод Из СтрРазделить(Значение, " ", Ложь) Цикл
			Результат.Добавить(ЧислоИзHexСтроки(HexКод));
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПолучитьКодыЗначений(Значения)

	Результат = Новый Соответствие;
	Код = 1;

	Для Каждого Значение Из СтрРазделить(Значения, ",") Цикл
		Результат.Вставить(Значение, Код);
		Код = Код + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьТочкиСопоставления(Поля)

	Результат = Новый Массив;

	Если Поля.Количество() <= 2 Или ПустаяСтрока(Поля[2]) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого HexКод Из СтрРазделить(СокрЛП(Поля[2]), " ", Ложь) Цикл
		Результат.Добавить(ЧислоИзHexСтроки(HexКод));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КодСтатусаСопоставления(Статус)

	Если Статус = "valid" Тогда
		Возврат 1;
	ИначеЕсли Статус = "ignored" Тогда
		Возврат 2;
	ИначеЕсли Статус = "mapped" Тогда
		Возврат 3;
	ИначеЕсли Статус = "deviation" Тогда
		Возврат 4;
	ИначеЕсли Статус = "disallowed" Тогда
		Возврат 5;
	ИначеЕсли Статус = "disallowed_STD3_valid" Тогда
		Возврат 6;
	ИначеЕсли Статус = "disallowed_STD3_mapped" Тогда
		Возврат 7;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Неизвестный статус сопоставления IDNA: %1", Статус);

КонецФункции

Функция ПолучитьТаблицуБыстройПроверкиNFC(КаталогИсточников)

	Записи = Новый ТаблицаЗначений;
	Записи.Колонки.Добавить("Начало");
	Записи.Колонки.Добавить("Значение");
	ИмяФайла = ОбъединитьПути(КаталогИсточников, "DerivedNormalizationProps.txt");
	Чтение = Новый ЧтениеТекста(ИмяФайла);

	Пока Истина Цикл
		СодержимоеСтроки = ПрочитатьСледующуюЗначащуюСтроку(Чтение);

		Если СодержимоеСтроки = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Поля = СтрРазделить(СодержимоеСтроки, ";", Истина);

		Если Поля.Количество() >= 3 И СокрЛП(Поля[1]) = "NFC_QC" Тогда
			Диапазон = СокрЛП(Поля[0]);
			Запись = Записи.Добавить();
			Запись.Начало = НачалоДиапазона(Диапазон);
			Запись.Значение = СтрШаблон("%1;%2", Диапазон, СокрЛП(Поля[2]));
		КонецЕсли;
	КонецЦикла;

	Чтение.Закрыть();
	Записи.Сортировать("Начало Возр");

	Возврат ЗначенияТаблицы(Записи);

КонецФункции

Функция ПолучитьТаблицуКлассовКомбинирования(КаталогИсточников)

	Строки = Новый Массив;
	ИмяФайла = ОбъединитьПути(КаталогИсточников, "UnicodeData.txt");
	Чтение = Новый ЧтениеТекста(ИмяФайла);

	Пока Истина Цикл
		СодержимоеСтроки = ПрочитатьСледующуюЗначащуюСтроку(Чтение);

		Если СодержимоеСтроки = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Поля = СтрРазделить(СодержимоеСтроки, ";", Истина);
		Класс = СокрЛП(Поля[3]);

		Если Класс <> "0" Тогда
			Строки.Добавить(СтрШаблон("%1;%2", СокрЛП(Поля[0]), Класс));
		КонецЕсли;
	КонецЦикла;

	Чтение.Закрыть();

	Возврат Строки;

КонецФункции

Функция ПолучитьТаблицуКатегорийМеток(КаталогИсточников)

	Строки = Новый Массив;
	ИмяФайла = ОбъединитьПути(КаталогИсточников, "UnicodeData.txt");
	Чтение = Новый ЧтениеТекста(ИмяФайла);

	Пока Истина Цикл
		СодержимоеСтроки = ПрочитатьСледующуюЗначащуюСтроку(Чтение);

		Если СодержимоеСтроки = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Поля = СтрРазделить(СодержимоеСтроки, ";", Истина);

		Если Лев(СокрЛП(Поля[2]), 1) = "M" Тогда
			Строки.Добавить(СокрЛП(Поля[0]));
		КонецЕсли;
	КонецЦикла;

	Чтение.Закрыть();

	Возврат Строки;

КонецФункции

Функция ПолучитьТаблицуНаправленийДоменов(КаталогИсточников)

	Записи = Новый ТаблицаЗначений;
	Записи.Колонки.Добавить("Начало");
	Записи.Колонки.Добавить("Значение");
	ИмяФайла = ОбъединитьПути(КаталогИсточников, "DerivedBidiClass.txt");
	Чтение = Новый ЧтениеТекста(ИмяФайла);

	Пока Истина Цикл
		СодержимоеСтроки = ПрочитатьСледующуюЗначащуюСтроку(Чтение);

		Если СодержимоеСтроки = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Поля = СтрРазделить(СодержимоеСтроки, ";", Истина);
		Класс = СокрЛП(Поля[1]);

		Если Класс = "R" Или Класс = "AL" Или Класс = "AN" Тогда
			Диапазон = СокрЛП(Поля[0]);
			Запись = Записи.Добавить();
			Запись.Начало = НачалоДиапазона(Диапазон);
			Запись.Значение = Диапазон;
		КонецЕсли;
	КонецЦикла;

	Чтение.Закрыть();
	Записи.Сортировать("Начало Возр");

	Возврат ЗначенияТаблицы(Записи);

КонецФункции

Функция ПолучитьТаблицуНормализации(КаталогИсточников)

	Строки = Новый Массив;
	ИмяФайла = ОбъединитьПути(КаталогИсточников, "UnicodeData.txt");
	Чтение = Новый ЧтениеТекста(ИмяФайла);

	Пока Истина Цикл
		СодержимоеСтроки = ПрочитатьСледующуюЗначащуюСтроку(Чтение);

		Если СодержимоеСтроки = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Поля = СтрРазделить(СодержимоеСтроки, ";", Истина);
		КодоваяТочка = СокрЛП(Поля[0]);
		Категория = СокрЛП(Поля[2]);
		КлассКомбинирования = СокрЛП(Поля[3]);
		Разложение = СокрЛП(Поля[5]);

		Если Лев(Разложение, 1) = "<" Тогда
			Разложение = "";
		КонецЕсли;

		ЭтоМетка = Лев(Категория, 1) = "M";

		Если КлассКомбинирования <> "0" Или Не ПустаяСтрока(Разложение) Или ЭтоМетка Тогда
			МаркерМетки = ?(ЭтоМетка, "M", "");
			Строки.Добавить(СтрШаблон(
				"%1;%2;%3;%4",
				КодоваяТочка,
				КлассКомбинирования,
				Разложение,
				МаркерМетки
			));
		КонецЕсли;
	КонецЦикла;

	Чтение.Закрыть();

	Возврат Строки;

КонецФункции

Функция ПолучитьТаблицуИсключений(КаталогИсточников)

	Строки = Новый Массив;
	ИмяФайла = ОбъединитьПути(КаталогИсточников, "DerivedNormalizationProps.txt");
	Чтение = Новый ЧтениеТекста(ИмяФайла);

	Пока Истина Цикл
		СодержимоеСтроки = ПрочитатьСледующуюЗначащуюСтроку(Чтение);

		Если СодержимоеСтроки = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Поля = СтрРазделить(СодержимоеСтроки, ";", Истина);

		Если Поля.Количество() > 1 И СокрЛП(Поля[1]) = "Full_Composition_Exclusion" Тогда
			Строки.Добавить(СокрЛП(Поля[0]));
		КонецЕсли;
	КонецЦикла;

	Чтение.Закрыть();

	Возврат Строки;

КонецФункции

Функция ПолучитьТаблицуНаправлений(КаталогИсточников)

	ИмяФайла = ОбъединитьПути(КаталогИсточников, "DerivedBidiClass.txt");
	Записи = Новый ТаблицаЗначений;
	Записи.Колонки.Добавить("Начало");
	Записи.Колонки.Добавить("Значение");

	Чтение = Новый ЧтениеТекста(ИмяФайла);

	Пока Истина Цикл
		СодержимоеСтроки = ПрочитатьСледующуюЗначащуюСтроку(Чтение);

		Если СодержимоеСтроки = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Поля = СтрРазделить(СодержимоеСтроки, ";", Истина);
		Диапазон = СокрЛП(Поля[0]);
		Класс = СокрЛП(Поля[1]);
		Запись = Записи.Добавить();
		Запись.Начало = НачалоДиапазона(Диапазон);
		Запись.Значение = СтрШаблон("%1;%2", Диапазон, Класс);
	КонецЦикла;

	Чтение.Закрыть();

	Записи.Сортировать("Начало Возр");
	Возврат ЗначенияТаблицы(Записи);

КонецФункции

Функция ПолучитьТаблицуСоединений(КаталогИсточников)

	ИмяФайла = ОбъединитьПути(КаталогИсточников, "DerivedJoiningType.txt");
	Записи = Новый ТаблицаЗначений;
	Записи.Колонки.Добавить("Начало");
	Записи.Колонки.Добавить("Значение");

	Чтение = Новый ЧтениеТекста(ИмяФайла);

	Пока Истина Цикл
		СодержимоеСтроки = ПрочитатьСледующуюЗначащуюСтроку(Чтение);

		Если СодержимоеСтроки = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Поля = СтрРазделить(СодержимоеСтроки, ";", Истина);
		Диапазон = СокрЛП(Поля[0]);
		Тип = СокрЛП(Поля[1]);
		Запись = Записи.Добавить();
		Запись.Начало = НачалоДиапазона(Диапазон);
		Запись.Значение = СтрШаблон("%1;%2", Диапазон, Тип);
	КонецЦикла;

	Чтение.Закрыть();

	Записи.Сортировать("Начало Возр");
	Возврат ЗначенияТаблицы(Записи);

КонецФункции

Функция ПрочитатьСледующуюЗначащуюСтроку(Чтение)

	Пока Истина Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();

		Если СтрокаФайла = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		ПозицияКомментария = СтрНайти(СтрокаФайла, "#");

		Если ПозицияКомментария > 0 Тогда
			СтрокаФайла = Лев(СтрокаФайла, ПозицияКомментария - 1);
		КонецЕсли;

		СтрокаФайла = СокрЛП(СтрокаФайла);

		Если Не ПустаяСтрока(СтрокаФайла) Тогда
			Возврат СтрокаФайла;
		КонецЕсли;
	КонецЦикла;

КонецФункции

Функция ЗначенияТаблицы(Таблица)

	Результат = Новый Массив;

	Для Каждого Запись Из Таблица Цикл
		Результат.Добавить(Запись.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НачалоДиапазона(Диапазон)

	Возврат ГраницыДиапазона(Диапазон)[0];

КонецФункции

Функция ГраницыДиапазона(Диапазон)

	Части = СтрРазделить(Диапазон, "..", Ложь);
	Результат = Новый Массив;
	Результат.Добавить(ЧислоИзHexСтроки(Части[0]));

	Если Части.Количество() = 1 Тогда
		Результат.Добавить(Результат[0]);
	Иначе
		Результат.Добавить(ЧислоИзHexСтроки(Части[1]));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЧислоИзHexСтроки(HexСтрока)

	Результат = 0;

	Для Позиция = 1 По СтрДлина(HexСтрока) Цикл
		Код = КодСимвола(Сред(HexСтрока, Позиция, 1));
		// Коды ASCII: 0-9 - 48-57, A-F - 65-70, a-f - 97-102.
		Если Код >= 48 И Код <= 57 Тогда
			Цифра = Код - 48;
		ИначеЕсли Код >= 65 И Код <= 70 Тогда
			Цифра = Код - 55;
		Иначе
			Цифра = Код - 87;
		КонецЕсли;

		Результат = Результат * 16 + Цифра;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаписатьМодульДанных(ИмяФайла, ВерсияUnicode)

	ИмяШаблона = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"Шаблоны",
		"ЧитательДанныхIDNA.os"
	);
	СоздатьКаталог(Новый Файл(ИмяФайла).Путь);
	Чтение = Новый ЧтениеТекста(ИмяШаблона);
	Запись = Новый ЗаписьТекста;
	Запись.Открыть(ИмяФайла, КодировкаТекста.UTF8);

	Пока Истина Цикл
		СтрокаШаблона = Чтение.ПрочитатьСтроку();

		Если СтрокаШаблона = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Запись.ЗаписатьСтроку(СтрЗаменить(СтрокаШаблона, "@ВерсияUnicode@", ВерсияUnicode));
	КонецЦикла;

	Чтение.Закрыть();
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти

СформироватьДанные();
