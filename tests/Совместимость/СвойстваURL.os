#Использовать asserts
#Использовать "../../src"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("http://host")
&ИсточникЗначение("http://host/")
&ИсточникЗначение("file:///C:/a%20b.txt")
&ИсточникЗначение("mailto:user@example.com")
&ИсточникЗначение("urn:isbn:9780140328721")
&ИсточникЗначение("//user:pass@host:080/p?q#f")
&ИсточникЗначение("/a%2Fb/c")
&ИсточникЗначение("?q=go+language")
&ИсточникЗначение("#a%20b")
Процедура ТестДолжен_ИдемпотентноСериализоватьURL(ИсходнаяСтрока) Экспорт

	// Подготовка
	ПервыйРезультат = Новый URL(ИсходнаяСтрока);

	// Действие
	ВторойРезультат = Новый URL(ПервыйРезультат.ВСтроку());

	// Проверка
	Ожидаем.Что(ВторойРезультат.ВСтроку()).Равно(ПервыйРезультат.ВСтроку());
	Ожидаем.Что(ВторойРезультат.РавенПоКомпонентам(ПервыйРезультат)).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("HTTP://EXAMPLE.COM:080/a/../b")
&ИсточникЗначение("https://example.com:443/a%2fb")
&ИсточникЗначение("ftp://EXAMPLE.COM:021/a/./b")
&ИсточникЗначение("x://Host/a/../../b")
&ИсточникЗначение("mailto:a/./b")
&ИсточникЗначение("/a/b/../c")
&ИсточникЗначение("../a/./b")
&ИсточникЗначение("//EXAMPLE.COM/a")
Процедура ТестДолжен_ИдемпотентноНормализоватьURL(ИсходнаяСтрока) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие
	ПервыйРезультат = Адрес.Нормализованный();
	ВторойРезультат = ПервыйРезультат.Нормализованный();

	// Проверка
	Ожидаем.Что(ВторойРезультат.ВСтроку()).Равно(ПервыйРезультат.ВСтроку());

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение("abcXYZ012")
&ИсточникЗначение("-._~")
&ИсточникЗначение("!$&'()*+,;=:@")
&ИсточникЗначение("/?#% ")
&ИсточникЗначение("Файл")
&ИсточникЗначение("a/b")
&ИсточникЗначение("a%2Fb")
Процедура ТестДолжен_ОбратимоКодироватьСегментПути(ИсходнаяСтрока) Экспорт

	// Подготовка
	// Исходная строка передана параметром теста.

	// Действие
	КодированнаяСтрока = КодированиеURL.КодироватьСегментПути(ИсходнаяСтрока);
	Результат = КодированиеURL.ДекодироватьUTF8(КодированнаяСтрока);

	// Проверка
	Ожидаем.Что(Результат).Равно(ИсходнаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение("/a/b")
&ИсточникЗначение("a b/c d")
&ИсточникЗначение("a:b@c/d")
&ИсточникЗначение("a?b#c")
&ИсточникЗначение("/Файл/я")
&ИсточникЗначение("//a///b")
&ИсточникЗначение("a%2Fb")
Процедура ТестДолжен_ОбратимоКодироватьПуть(ИсходнаяСтрока) Экспорт

	// Подготовка
	// Исходная строка передана параметром теста.

	// Действие
	КодированнаяСтрока = КодированиеURL.КодироватьПуть(ИсходнаяСтрока);
	Результат = КодированиеURL.ДекодироватьUTF8(КодированнаяСтрока);

	// Проверка
	Ожидаем.Что(Результат).Равно(ИсходнаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение("abcXYZ012")
&ИсточникЗначение("a b")
&ИсточникЗначение("a+b")
&ИсточникЗначение("a&b=c")
&ИсточникЗначение("*-._")
&ИсточникЗначение("Файл")
&ИсточникЗначение("%/?#")
Процедура ТестДолжен_ОбратимоКодироватьПараметрФормы(ИсходнаяСтрока) Экспорт

	// Подготовка
	// Исходная строка передана параметром теста.

	// Действие
	КодированнаяСтрока = КодированиеURL.КодироватьПараметрФормы(ИсходнаяСтрока);
	Результат = КодированиеURL.ДекодироватьПараметрФормы(КодированнаяСтрока);

	// Проверка
	Ожидаем.Что(Результат).Равно(ИсходнаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение("a=1")
&ИсточникЗначение("a=1&a=2")
&ИсточникЗначение("a=1&&b=2&")
&ИсточникЗначение("flag")
&ИсточникЗначение("a=%ZZ")
&ИсточникЗначение("q=a+b")
&ИсточникЗначение("ключ=значение")
Процедура ТестДолжен_ИдемпотентноСериализоватьПараметрыЗапроса(ИсходнаяСтрока) Экспорт

	// Подготовка
	ПервыеПараметры = Новый ПараметрыЗапросаURL(ИсходнаяСтрока);

	// Действие
	ВторыеПараметры = Новый ПараметрыЗапросаURL(ПервыеПараметры.ВСтроку());

	// Проверка
	Ожидаем.Что(ВторыеПараметры.ВСтроку()).Равно(ПервыеПараметры.ВСтроку());

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("http://a/b/c", "../d")
&ИсточникЗначение("http://a/b/c", "/d")
&ИсточникЗначение("http://a/b/c?q", "?x")
&ИсточникЗначение("http://a/b/c#f", "#g")
&ИсточникЗначение("http://a/a%2Fb/c", "../d")
&ИсточникЗначение("https://a/b", "//other/c")
&ИсточникЗначение("file:///C:/a/b", "../c")
&ИсточникЗначение("x:a/b/c", "../d")
Процедура ТестДолжен_СохранитьБазуПриРазрешении(СтрокаБазы, СтрокаСсылки) Экспорт

	// Подготовка
	База = Новый URL(СтрокаБазы);

	// Действие
	Результат = База.Разрешить(СтрокаСсылки);

	// Проверка
	Ожидаем.Что(База.ВСтроку()).Равно(СтрокаБазы);
	Ожидаем.Что(ТипЗнч(Результат)).Равно(Тип("URL"));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("http://host/a", "/b")
&ИсточникЗначение("http://host/a?q", "/b")
&ИсточникЗначение("http://host/a#f", "/b")
&ИсточникЗначение("//host/a", "/b")
&ИсточникЗначение("file:///C:/a", "/C:/b")
&ИсточникЗначение("mailto:a", "b")
&ИсточникЗначение("/a", "/b")
&ИсточникЗначение("a/b", "c/d")
Процедура ТестДолжен_СохранитьОригиналПриИзмененииКопии(ИсходнаяСтрока, НовыйПуть) Экспорт

	// Подготовка
	Оригинал = Новый URL(ИсходнаяСтрока);
	Копия = Оригинал.Скопировать();

	// Действие
	Копия.УстановитьПуть(НовыйПуть);

	// Проверка
	Ожидаем.Что(Оригинал.ВСтроку()).Равно(ИсходнаяСтрока);
	Ожидаем.Что(Копия.Путь()).Равно(НовыйПуть);
	Ожидаем.Что(Копия).ЭтоНе().Идентично(Оригинал);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("/a", Неопределено, Неопределено)
&ИсточникЗначение("/a?", "", Неопределено)
&ИсточникЗначение("/a#", Неопределено, "")
&ИсточникЗначение("/a?#", "", "")
&ИсточникЗначение("?", "", Неопределено)
&ИсточникЗначение("#", Неопределено, "")
&ИсточникЗначение("?#", "", "")
&ИсточникЗначение("", Неопределено, Неопределено)
Процедура ТестДолжен_СохранитьПустыеИОтсутствующиеКомпоненты(
	ИсходнаяСтрока, ОжидаемыйЗапрос, ОжидаемыйФрагмент
) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие
	Копия = Новый URL(Адрес.ВСтроку());

	// Проверка
	Ожидаем.Что(Копия.КодированныйЗапрос()).Равно(ОжидаемыйЗапрос);
	Ожидаем.Что(Копия.КодированныйФрагмент()).Равно(ОжидаемыйФрагмент);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение("http://host")
&ИсточникЗначение("HTTP://EXAMPLE.COM/a%2f")
&ИсточникЗначение("mailto:user@example.com")
&ИсточникЗначение("//user:pass@host:080/p?q#f")
&ИсточникЗначение("/a/b/../c")
&ИсточникЗначение("?q=Ф")
&ИсточникЗначение("#a%20b")
Процедура ТестДолжен_СохранитьРефлексивностьСравнения(ИсходнаяСтрока) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие и Проверка
	Ожидаем.Что(Адрес.Равен(Адрес)).ЭтоИстина();
	Ожидаем.Что(Адрес.РавенПоКомпонентам(Адрес)).ЭтоИстина();
	Ожидаем.Что(Адрес.Сравнить(Адрес)).Равно(0);

КонецПроцедуры

#КонецОбласти
