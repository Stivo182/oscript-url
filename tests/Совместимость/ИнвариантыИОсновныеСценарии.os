#Использовать asserts
#Использовать "../../src"

#Область Тесты

&Тест
Процедура ТестДолжен_СохранятьПредставлениеПриРазбореИКопированииURL() Экспорт

	// Подготовка
	Примеры = Новый Массив;
	Примеры.Добавить("../a?x=1");
	Примеры.Добавить("HTTP://Example.COM/a%2Fb");
	Примеры.Добавить("scheme://user:pass@[2001:db8::1]:80/p?#");

	Для Каждого Представление Из Примеры Цикл
		// Действие
		Первый = Новый URL(Представление);
		Второй = Новый URL(Первый.ВСтроку());
		Третий = Новый URL(Второй);

		// Проверка
		Ожидаем.Что(Первый.ВСтроку()).Равно(Представление);
		Ожидаем.Что(Второй.ВСтроку()).Равно(Представление);
		Ожидаем.Что(Третий.ВСтроку()).Равно(Представление);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранятьОсновныеИнвариантыURL() Экспорт

	// Подготовка
	Примеры = Новый Массив;
	Примеры.Добавить("https://example.com/a?x=1");
	Примеры.Добавить("x:/root");
	Примеры.Добавить("http://user:pass@example.com:80/?");
	ОтносительнаяСсылка = Новый URL("../relative");

	// Действие и Проверка
	Ожидаем.Что(ОтносительнаяСсылка.ЯвляетсяАбсолютным()).ЭтоЛожь();

	Для Каждого Представление Из Примеры Цикл
		Адрес = Новый URL(Представление);
		Снимок = Адрес.Скопировать();
		Копия = Адрес.Скопировать();
		Параметры = Адрес.ПараметрыЗапроса();

		// Действие
		Копия.УстановитьФрагмент("copy");
		Адрес.УстановитьКодированнуюСтрокуЗапроса("live=1");

		// Проверка
		Ожидаем.Что(Снимок.ЯвляетсяАбсолютным()).ЭтоИстина();
		Ожидаем.Что(Новый URL(Адрес.ВСтроку()).ЯвляетсяАбсолютным()).ЭтоИстина();
		Ожидаем.Что(Снимок.ВСтроку()).Равно(Представление);
		Ожидаем.Что(Копия.ВСтроку() = Представление).ЭтоЛожь();
		Ожидаем.Что(Параметры.Получить("live")).Равно("1");
		Параметры.Установить("live", "2");
		Ожидаем.Что(Адрес.КодированнаяСтрокаЗапроса()).Равно("live=2");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыполнятьОсновнойПользовательскийСценарий() Экспорт

	// Подготовка
	Ссылка = Новый URL("../users?page=1");
	База = Новый URL("https://api.example.com/v1/");
	Адрес = Новый URL(Ссылка, База);

	// Действие
	Адрес.УстановитьДанныеПользователя("api:secret");
	Адрес.ДобавитьСегментПути("Иван Петров");
	Адрес.ПараметрыЗапроса()
		.Установить("page", "2")
		.Добавить("include", "orders")
		.Добавить("include", "contacts");
	Результат = Адрес.Скопировать();
	Адрес.ПараметрыЗапроса().Установить("page", "3");

	// Проверка
	Ожидаем.Что(Результат.ДанныеПользователя()).Равно("api:secret");
	Ожидаем.Что(Результат.Путь()).Равно("/users/Иван Петров");
	Ожидаем.Что(Результат.КодированнаяСтрокаЗапроса()).Равно("page=2&include=orders&include=contacts");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранятьИсходныйURLПриКопировании() Экспорт

	// Подготовка
	Исходный = Новый URL("https://example.com/api/users?page=1");
	Адрес = Новый URL(Исходный);

	// Действие
	Адрес.ПараметрыЗапроса().Установить("page", "2");
	Результат = Адрес.Скопировать();

	// Проверка
	Ожидаем.Что(Исходный.ВСтроку()).Равно("https://example.com/api/users?page=1");
	Ожидаем.Что(Результат.ВСтроку()).Равно("https://example.com/api/users?page=2");

КонецПроцедуры

#КонецОбласти
