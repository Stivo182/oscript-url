#Использовать asserts
#Использовать "../../src"

#Область Тесты

&Тест
Процедура ТестДолжен_СохранятьОсновныеИнвариантыURI() Экспорт

	// Подготовка
	Примеры = Новый Массив;
	Примеры.Добавить("../a?x=1");
	Примеры.Добавить("HTTP://Example.COM/a%2Fb");
	Примеры.Добавить("scheme://user:pass@[2001:db8::1]:80/p?#");

	Для Каждого Представление Из Примеры Цикл
		// Действие
		Первый = Новый URI(Представление);
		Второй = Новый URI(Первый.ВСтроку());
		Третий = Новый URI(Второй);

		// Проверка
		Ожидаем.Что(Первый.ВСтроку()).Равно(Представление);
		Ожидаем.Что(Первый.Равно(Первый)).ЭтоИстина();
		Ожидаем.Что(Первый.Равно(Второй)).ЭтоИстина();
		Ожидаем.Что(Второй.Равно(Первый)).ЭтоИстина();
		Ожидаем.Что(Первый.Равно(Третий)).ЭтоИстина();
		Ожидаем.Что(Первый.Эквивалентен(Первый)).ЭтоИстина();
		Ожидаем.Что(Первый.Эквивалентен(Второй)).ЭтоИстина();
		Ожидаем.Что(Второй.Эквивалентен(Первый)).ЭтоИстина();
		Ожидаем.Что(Первый.Эквивалентен(Третий)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранятьОсновныеИнвариантыURL() Экспорт

	// Подготовка
	Примеры = Новый Массив;
	Примеры.Добавить("https://example.com/a?x=1");
	Примеры.Добавить("x:/root");
	Примеры.Добавить("http://user:pass@example.com:80/?");

	Для Каждого Представление Из Примеры Цикл
		Адрес = Новый URL(Представление);
		Снимок = Адрес.URI();
		Копия = Адрес.Скопировать();
		Параметры = Адрес.ПараметрыЗапроса();

		// Действие
		Копия.УстановитьФрагмент("copy");
		Адрес.УстановитьКодированныйЗапрос("live=1");

		// Проверка
		Ожидаем.Что(Снимок.ЭтоАбсолютный()).ЭтоИстина();
		Ожидаем.Что(Новый URI(Адрес.ВСтроку()).ЭтоАбсолютный()).ЭтоИстина();
		Ожидаем.Что(Снимок.ВСтроку()).Равно(Представление);
		Ожидаем.Что(Копия.ВСтроку() = Представление).ЭтоЛожь();
		Ожидаем.Что(Параметры.Получить("live")).Равно("1");
		Параметры.Установить("live", "2");
		Ожидаем.Что(Адрес.КодированныйЗапрос()).Равно("live=2");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыполнятьОсновнойПользовательскийСценарий() Экспорт

	// Подготовка
	Ссылка = Новый URI("../users?page=1");
	База = Новый URL("https://api.example.com/v1/");
	Адрес = Новый URL(Ссылка, База);

	// Действие
	Адрес.УстановитьИмяПользователя("api");
	Адрес.УстановитьПароль("secret");
	Адрес.ДобавитьСегментПути("Иван Петров");
	Адрес.ПараметрыЗапроса()
		.Установить("page", "2")
		.Добавить("include", "orders")
		.Добавить("include", "contacts");
	Результат = Адрес.URI();
	Адрес.ПараметрыЗапроса().Установить("page", "3");

	// Проверка
	Ожидаем.Что(Результат.ИмяПользователя()).Равно("api");
	Ожидаем.Что(Результат.Пароль()).Равно("secret");
	Ожидаем.Что(Результат.Путь()).Равно("/users/Иван Петров");
	Ожидаем.Что(Результат.КодированныйЗапрос()).Равно("page=2&include=orders&include=contacts");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешатьURIЗначения() Экспорт

	// Подготовка
	Ссылка = Новый URI("../users?page=2");
	База = Новый URI("https://example.com/api/v1/");

	// Действие
	Абсолютный = База.Разрешить(Ссылка);

	// Проверка
	Ожидаем.Что(Абсолютный.ВСтроку()).Равно("https://example.com/api/users?page=2");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранятьИсходныйURIПриПреобразованииЧерезURL() Экспорт

	// Подготовка
	Исходный = Новый URI("https://example.com/api/users?page=1");
	Адрес = Новый URL(Исходный);

	// Действие
	Адрес.ПараметрыЗапроса().Установить("page", "2");
	Результат = Адрес.URI();

	// Проверка
	Ожидаем.Что(Исходный.ВСтроку()).Равно("https://example.com/api/users?page=1");
	Ожидаем.Что(Результат.ВСтроку()).Равно("https://example.com/api/users?page=2");

КонецПроцедуры

#КонецОбласти
