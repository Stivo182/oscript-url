	Ожидаем.Что(КодыОшибокURL.НедопустимаяСервернаяЧастьURI()).Равно("uri.invalid_authority");
	Ожидаем.Что(КодыОшибокURL.НедопустимыйХостURI()).Равно("uri.invalid_host");
	Ожидаем.Что(КодыОшибокURL.НедопустимыйIPv6()).Равно("uri.invalid_ipv6");
	Ожидаем.Что(КодыОшибокURL.НедопустимыйIPvFuture()).Равно("uri.invalid_ipvfuture");
	Ожидаем.Что(КодыОшибокURL.БазаURIНеАбсолютная()).Равно("uri.base_not_absolute");
