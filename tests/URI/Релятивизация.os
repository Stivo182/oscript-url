Перем _ОтносительнаяБаза; // URI

#Область Тесты

&Тест
Процедура ТестДолжен_РелятивизироватьСостоянияURIКлассом() Экспорт

	// Подготовка
	Парсер = Новый ПарсерIRI;
	База = Парсер.Разобрать("http://e/a/");
	Цель = Парсер.Разобрать("http://e/a/b");

	// Действие
	Релятивизатор = Новый РелятивизаторURI;
	Результат = Релятивизатор.СделатьОтносительным(База, Цель);

	// Проверка
	Ожидаем.Что(ТипЗнч(Результат)).Равно(Тип("СостояниеURI"));
	Ожидаем.Что(Результат.ВСтроку()).Равно("b");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("http://e/a/", "http://e/a/b", "b")
&ИсточникЗначение("http://e/a/", "http://e/a/b:c", "./b:c")
&ИсточникЗначение("http://e/a/b/", "http://e/a/c/", "../c/")
&ИсточникЗначение("http://e/a/b/file", "http://e/a/c/file2", "../c/file2")
&ИсточникЗначение("http://e/a?x", "http://e/a", "a")
&ИсточникЗначение("http://e?x", "http://e", "//e")
&ИсточникЗначение("http://e/a", "http://e/a?y", "?y")
&ИсточникЗначение("http://e/a?x", "http://e/a?", "?")
&ИсточникЗначение("http://e/a?x", "http://e/a?x#f", "#f")
&ИсточникЗначение("http://e/a?x#old", "http://e/a?x", "")
&ИсточникЗначение("http://e/a/", "https://e/a/b", "https://e/a/b")
&ИсточникЗначение("http://user@e/a/", "http://other@e/a/b", "http://other@e/a/b")
&ИсточникЗначение("http://e:80/a/", "http://e/a/b", "b")
&ИсточникЗначение("http://e/a/b", "http://e/a/", "./")
&ИсточникЗначение("http://e/a/", "http://e/a/", "")
&ИсточникЗначение("http://e/a/", "http://e/a/?", "?")
&ИсточникЗначение("http://e/a/?x", "http://e/a/", "./")
&ИсточникЗначение("http://e/a/b/", "http://e/a/b/c?x#f", "c?x#f")
Процедура ТестДолжен_ВыбратьТочныйВариантВУстановленномПорядке(
	СтрокаБазы,
	СтрокаЦели,
	ОжидаемаяСтрока
) Экспорт

	// Подготовка
	База = Новый URI(СтрокаБазы);
	Цель = Новый URI(СтрокаЦели);

	// Действие
	Результат = База.СделатьОтносительным(Цель);

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно(ОжидаемаяСтрока);
	Ожидаем.Что(База.Разрешить(Результат).ЭквивалентенДляСхемы(Цель)).ЭтоИстина();
	Ожидаем.Что(База.ВСтроку()).Равно(СтрокаБазы);
	Ожидаем.Что(Цель.ВСтроку()).Равно(СтрокаЦели);
	Ожидаем.Что(Результат).ЭтоНе().Идентично(Цель);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("http://e/a/", "http://other/a/b", "http://other/a/b")
&ИсточникЗначение("http://e:/a/", "http://e/a/b", "b")
&ИсточникЗначение("http://[2001:DB8::1]/a/", "http://[2001:db8::1]/a/b", "b")
&ИсточникЗначение("x://[v1.ABC]/a/", "x://[v1.abc]/a/b", "b")
&ИсточникЗначение("x:a/b/c", "x:a/d", "../d")
&ИсточникЗначение("x:/a/b", "x:a/c", "x:a/c")
&ИсточникЗначение("x:a/b", "x:/a/c", "../a/c")
&ИсточникЗначение("http://e/a//b/file", "http://e/a//c", "../c")
&ИсточникЗначение("http://e/a/file", "http://e/a//c", ".//c")
&ИсточникЗначение("http://e/a%2Fb/c", "http://e/a%2Fb/d", "d")
&ИсточникЗначение("http://e/a/", "http://e/a/b%3Ac", "b%3Ac")
&ИсточникЗначение("http://e/a/", "http://e/a/./b", "b")
&ИсточникЗначение("http://e/a/", "http://e/a/%2E/b", "b")
&ИсточникЗначение("http://%75ser@e/a", "http://user@e/b", "b")
&ИсточникЗначение("HTTP://e/a/", "http://e/a/b", "b")
&ИсточникЗначение("x:/a/", "x:///a/b", "x:///a/b")
&ИсточникЗначение("x:///a/", "x:///a/b", "b")
&ИсточникЗначение("http://e:8080/a/", "http://e:8080/a/b", "b")
&ИсточникЗначение("http://e:8080/a/", "http://e:8081/a/b", "http://e:8081/a/b")
&ИсточникЗначение("x://e:/a/", "x://e/a/b", "b")
&ИсточникЗначение("x://e:/a/", "x://e:/a/b", "b")
&ИсточникЗначение("http://e/a/b/c/d/", "http://e/a/e", "../../../e")
&ИсточникЗначение("http://e/a/#old", "http://e/a/#", "#")
Процедура ТестДолжен_ПокрытьОбязательныеСлучаиРелятивизации(
	СтрокаБазы,
	СтрокаЦели,
	ОжидаемаяСтрока
) Экспорт

	// Подготовка
	База = Новый URI(СтрокаБазы);
	Цель = Новый URI(СтрокаЦели);

	// Действие
	ПервыйРезультат = База.СделатьОтносительным(Цель);
	ВторойРезультат = База.СделатьОтносительным(СтрокаЦели);

	// Проверка
	Ожидаем.Что(ПервыйРезультат.ВСтроку()).Равно(ОжидаемаяСтрока);
	Ожидаем.Что(ВторойРезультат.ВСтроку()).Равно(ОжидаемаяСтрока);
	Ожидаем.Что(База.Разрешить(ПервыйРезультат).ЭквивалентенДляСхемы(Цель)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьОтносительнуюБазу() Экспорт

	// Подготовка
	_ОтносительнаяБаза = Новый URI("a/b");

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "СделатьОтносительнымСОтносительнойБазой"),
		"uri.base_not_absolute"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьДанныеОбОтносительнойЦели() Экспорт

	// Подготовка
	База = Новый URI("http://e/a/");

	// Действие и Проверка
	Попытка
		База.СделатьОтносительным("a/b");
	Исключение
		Разбор = ДиагностикаОшибок.Разобрать(ИнформацияОбОшибке());
		Ожидаем.Что(Разбор.КодОшибки()).Равно("argument.invalid_value");
		Ожидаем.Что(Разбор.Данные().ИмяАргумента).Равно("Цель");
		Ожидаем.Что(Разбор.Данные().Ожидание).Равно("абсолютный URI");
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение для относительной цели";

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1)
&ИсточникЗначение(Null)
&ИсточникЗначение(Неопределено)
Процедура ТестДолжен_СообщитьИмяНедопустимогоАргументаЦели(Цель) Экспорт

	// Подготовка
	База = Новый URI("http://e/a/");

	// Действие и Проверка
	Попытка
		База.СделатьОтносительным(Цель);
	Исключение
		Разбор = ДиагностикаОшибок.Разобрать(ИнформацияОбОшибке());
		Ожидаем.Что(Разбор.КодОшибки()).Равно("argument.invalid_type");
		Ожидаем.Что(Разбор.Данные().ИмяАргумента).Равно("Цель");
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение недопустимого типа цели";

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СделатьОтносительнымСОтносительнойБазой() Экспорт

	_ОтносительнаяБаза.СделатьОтносительным("http://e/a");

КонецПроцедуры

#КонецОбласти
