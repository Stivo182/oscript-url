#Использовать asserts
#Использовать "../../src"
#Использовать "../fixtures"

Перем _УриСОшибкойКодировки; // URI

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("https://user%20name:p%3Aa@exa%6Dple.com:080/a%20b?q=%7E#f%20g")
&ИсточникЗначение("https://[2001:db8::1]/")
Процедура ТестДолжен_ВернутьДекодированныеКомпоненты(ИсходнаяСтрока) Экспорт

	// Подготовка
	Ури = Новый URI(ИсходнаяСтрока);

	// Действие и Проверка
	Если ИсходнаяСтрока = "https://[2001:db8::1]/" Тогда
		Ожидаем.Что(Ури.Хост()).Равно("[2001:db8::1]");
		Ожидаем.Что(Ури.СервернаяЧасть()).Равно("[2001:db8::1]");
		Возврат;
	КонецЕсли;

	Ожидаем.Что(Ури.ДанныеПользователя()).Равно("user name:p:a");
	Ожидаем.Что(Ури.КодированноеИмяПользователя()).Равно("user%20name");
	Ожидаем.Что(Ури.КодированныйПароль()).Равно("p%3Aa");
	Ожидаем.Что(Ури.ИмяПользователя()).Равно("user name");
	Ожидаем.Что(Ури.Пароль()).Равно("p:a");
	Ожидаем.Что(Ури.Хост()).Равно("example.com");
	Ожидаем.Что(Ури.СервернаяЧасть()).Равно("user name:p:a@example.com:080");
	Ожидаем.Что(Ури.Путь()).Равно("/a b");
	Ожидаем.Что(Ури.Запрос()).Равно("q=~");
	Ожидаем.Что(Ури.Фрагмент()).Равно("f g");
	Ожидаем.Что(Ури.ПутьИЗапрос()).Равно("/a%20b?q=%7E");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://host/", Неопределено, Неопределено, Неопределено, Неопределено)
&ИсточникЗначение("https://user@host/", "user", Неопределено, "user", Неопределено)
&ИсточникЗначение("https://user:@host/", "user", "", "user", "")
&ИсточникЗначение("https://:pass@host/", "", "pass", "", "pass")
&ИсточникЗначение("https://@host/", "", Неопределено, "", Неопределено)
&ИсточникЗначение("https://user:p:a@host/", "user", "p:a", "user", "p:a")
&ИсточникЗначение("https://user%3Aname:p@host/", "user%3Aname", "p", "user:name", "p")
Процедура ТестДолжен_ВыделитьИмяПользователяИПароль(ИсходнаяСтрока, ОжидаемоеКодированноеИмя,
	ОжидаемыйКодированныйПароль, ОжидаемоеИмя, ОжидаемыйПароль) Экспорт

	// Подготовка
	Ури = Новый URI(ИсходнаяСтрока);

	// Действие
	КодированноеИмя = Ури.КодированноеИмяПользователя();
	КодированныйПароль = Ури.КодированныйПароль();
	Имя = Ури.ИмяПользователя();
	Пароль = Ури.Пароль();

	// Проверка
	Ожидаем.Что(КодированноеИмя).Равно(ОжидаемоеКодированноеИмя);
	Ожидаем.Что(КодированныйПароль).Равно(ОжидаемыйКодированныйПароль);
	Ожидаем.Что(Имя).Равно(ОжидаемоеИмя);
	Ожидаем.Что(Пароль).Равно(ОжидаемыйПароль);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("/a", Неопределено, Неопределено, "/a")
&ИсточникЗначение("/a?", "", Неопределено, "/a?")
&ИсточникЗначение("/a#", Неопределено, "", "/a")
&ИсточникЗначение("/a?#", "", "", "/a?")
Процедура ТестДолжен_РазличитьПустыеИОтсутствующиеДекодированныеЗапросИФрагмент(
	ИсходнаяСтрока, ОжидаемыйЗапрос, ОжидаемыйФрагмент, ОжидаемыйПутьИЗапрос
) Экспорт

	// Подготовка
	Ури = Новый URI(ИсходнаяСтрока);

	// Действие и Проверка
	Ожидаем.Что(Ури.Запрос()).Равно(ОжидаемыйЗапрос);
	Ожидаем.Что(Ури.Фрагмент()).Равно(ОжидаемыйФрагмент);
	Ожидаем.Что(Ури.ПутьИЗапрос()).Равно(ОжидаемыйПутьИЗапрос);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьДоступККодированнымКомпонентамПриОшибкеКодировки() Экспорт

	// Подготовка
	_УриСОшибкойКодировки = Новый URI("/%FF?q=%FF#%FF");

	// Действие и Проверка
	Ожидаем.Что(_УриСОшибкойКодировки.КодированныйПуть()).Равно("/%FF");
	Ожидаем.Что(_УриСОшибкойКодировки.КодированныйЗапрос()).Равно("q=%FF");
	Ожидаем.Что(_УриСОшибкойКодировки.КодированныйФрагмент()).Равно("%FF");
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "ПолучитьДекодированныйПутьСОшибкойКодировки"),
		"encoding.invalid"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДекодироватьAMеткиИЛогическиСохранитьНекорректнуюAMетку() Экспорт

	// Подготовка
	ДопустимыйУри = Новый URI("https://xn--e1afmkfd.xn--p1ai/");
	НекорректнаяМеткаУри = Новый URI("https://xn--invalid-/");

	// Действие
	ДопустимыйХост = ДопустимыйУри.Хост();
	НекорректныйХост = НекорректнаяМеткаУри.Хост();

	// Проверка
	Ожидаем.Что(ДопустимыйХост).Равно("пример.рф");
	Ожидаем.Что(НекорректныйХост).Равно("xn--invalid-");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьРегистрОбычныхМетокПриДекодированииPunycode() Экспорт

	// Подготовка
	Ури = Новый URI("https://EXAMPLE.xn--e1afmkfd/");

	// Действие
	Хост = Ури.Хост();

	// Проверка
	Ожидаем.Что(Хост).Равно("EXAMPLE.пример");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПолучитьДекодированныйПутьСОшибкойКодировки() Экспорт

	_УриСОшибкойКодировки.Путь();

КонецПроцедуры

#КонецОбласти
