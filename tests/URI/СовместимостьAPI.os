#Использовать asserts
#Использовать "../../src"

#Область Тесты

&Тест
Процедура ТестДолжен_БезИсключенияРазобратьКорректнуюСсылку() Экспорт

	// Подготовка
	Значение = "https://пример.рф/путь";

	// Действие
	Результат = РазборURI.ПопытатьсяРазобрать(Значение);

	// Проверка
	Ожидаем.Что(ТипЗнч(Результат)).Равно(Тип("URI"));
	Ожидаем.Что(Результат.ВСтроку()).Равно(Значение);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеопределеноБезИсключения() Экспорт

	// Подготовка
	Значение = "/%ZZ";

	// Действие
	Результат = РазборURI.ПопытатьсяРазобрать(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно(Неопределено);
	Ожидаем.Что(РазборURI.ЭтоКорректнаяСсылка(Значение)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеопределеноДляНеправильногоТипа() Экспорт

	// Подготовка
	Значение = 42;

	// Действие
	Результат = РазборURI.ПопытатьсяРазобрать(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://example.com/", "RegName")
&ИсточникЗначение("https://127.0.0.1/", "IPv4")
&ИсточникЗначение("https://[2001:db8::1]/", "IPv6")
&ИсточникЗначение("x://[v1.example]/", "IPvFuture")
Процедура ТестДолжен_ВернутьПубличныйВидХоста(Значение, ОжидаемыйВид) Экспорт

	// Подготовка
	Ури = Новый URI(Значение);

	// Действие и Проверка
	Ожидаем.Что(Ури.ВидХоста()).Равно(ОжидаемыйВид);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДелегироватьВидХостаURL() Экспорт

	// Подготовка
	Адрес = Новый URL("https://[2001:db8::1]/");

	// Действие и Проверка
	Ожидаем.Что(Адрес.ВидХоста()).Равно(ВидыХостаURI.IPv6());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредоставитьКонстантыВидовХоста() Экспорт

	// Действие и Проверка
	Ожидаем.Что(ВидыХостаURI.ЗарегистрированноеИмя()).Равно("RegName");
	Ожидаем.Что(ВидыХостаURI.IPv4()).Равно("IPv4");
	Ожидаем.Что(ВидыХостаURI.IPv6()).Равно("IPv6");
	Ожидаем.Что(ВидыХостаURI.IPvFuture()).Равно("IPvFuture");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличитьОтсутствующийИПустойХост() Экспорт

	// Подготовка
	БезСервернойЧасти = Новый URI("path");
	СПустойСервернойЧастью = Новый URI("//");

	// Действие и Проверка
	Ожидаем.Что(БезСервернойЧасти.ВидХоста()).Равно(Неопределено);
	Ожидаем.Что(СПустойСервернойЧастью.ВидХоста()).Равно(ВидыХостаURI.ЗарегистрированноеИмя());

КонецПроцедуры

#КонецОбласти
