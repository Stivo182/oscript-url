#Использовать asserts
#Использовать "../../src"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("scheme:/p", Неопределено, Неопределено, Неопределено, "/p", Ложь, Ложь, Ложь)
&ИсточникЗначение("scheme:///p", "", "", Неопределено, "/p", Истина, Ложь, Ложь)
&ИсточникЗначение("scheme://@/p", "@", "", Неопределено, "/p", Истина, Истина, Ложь)
&ИсточникЗначение("scheme://host:/p", "host:", "host", "", "/p", Истина, Ложь, Истина)
Процедура ТестДолжен_СохранитьСостояниеСервернойЧасти(
	ИсходнаяСтрока,
	ОжидаемаяСервернаяЧасть,
	ОжидаемыйХост,
	ОжидаемыйПорт,
	ОжидаемыйПуть,
	ОжидаетсяСервернаяЧасть,
	ОжидаютсяДанныеПользователя,
	ОжидаетсяПорт
) Экспорт

	// Действие
	Ури = Новый URI(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Ури.КодированнаяСервернаяЧасть()).Равно(ОжидаемаяСервернаяЧасть);
	Ожидаем.Что(Ури.КодированныйХост()).Равно(ОжидаемыйХост);
	Ожидаем.Что(Ури.ТекстПорта()).Равно(ОжидаемыйПорт);
	Ожидаем.Что(Ури.КодированныйПуть()).Равно(ОжидаемыйПуть);
	Ожидаем.Что(Ури.СервернаяЧастьОпределена()).Равно(ОжидаетсяСервернаяЧасть);
	Ожидаем.Что(Ури.ДанныеПользователяОпределены()).Равно(ОжидаютсяДанныеПользователя);
	Ожидаем.Что(Ури.ПортУказан()).Равно(ОжидаетсяПорт);
	ПроверитьПовторныйРазборБезПотерь(Ури);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличатьОтсутствующийИПустойПорт() Экспорт

	// Действие
	БезПорта = Новый URI("scheme://host/p");
	ПустойПорт = Новый URI("scheme://host:/p");

	// Проверка
	Ожидаем.Что(БезПорта.ПортУказан()).ЭтоЛожь();
	Ожидаем.Что(БезПорта.ТекстПорта()).Равно(Неопределено);
	Ожидаем.Что(ПустойПорт.ПортУказан()).ЭтоИстина();
	Ожидаем.Что(ПустойПорт.ТекстПорта()).Равно("");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://example.com/path", "/path", Неопределено, Неопределено)
&ИсточникЗначение("https://example.com/path?", "/path", "", Неопределено)
&ИсточникЗначение("https://example.com/path#", "/path", Неопределено, "")
&ИсточникЗначение("https://example.com/path?#", "/path", "", "")
&ИсточникЗначение("https://example.com?", "", "", Неопределено)
&ИсточникЗначение("https://example.com#", "", Неопределено, "")
&ИсточникЗначение("https://example.com?#", "", "", "")
Процедура ТестДолжен_РазличатьОтсутствующиеИПустыеЗапросИФрагмент(
	ИсходнаяСтрока, ОжидаемыйПуть, ОжидаемыйЗапрос, ОжидаемыйФрагмент
) Экспорт

	// Действие
	Ури = Новый URI(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Ури.КодированныйПуть()).Равно(ОжидаемыйПуть);
	Ожидаем.Что(Ури.КодированныйЗапрос()).Равно(ОжидаемыйЗапрос);
	Ожидаем.Что(Ури.КодированныйФрагмент()).Равно(ОжидаемыйФрагмент);
	Ожидаем.Что(Ури.ВСтроку()).Равно(ИсходнаяСтрока);
	ПроверитьПовторныйРазборБезПотерь(Ури);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://user@host/", "user")
&ИсточникЗначение("https://user:@host/", "user:")
&ИсточникЗначение("https://:pass@host/", ":pass")
&ИсточникЗначение("https://@host/", "")
&ИсточникЗначение("https://user:p:a@host/", "user:p:a")
&ИсточникЗначение("https://user%3Aname:p@host/", "user%3Aname:p")
Процедура ТестДолжен_СохранитьКодированныеДанныеПользователя(ИсходнаяСтрока, ОжидаемыеДанныеПользователя) Экспорт

	// Действие
	Ури = Новый URI(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Ури.ДанныеПользователяОпределены()).ЭтоИстина();
	Ожидаем.Что(Ури.КодированныеДанныеПользователя()).Равно(ОжидаемыеДанныеПользователя);
	Ожидаем.Что(Ури.ВСтроку()).Равно(ИсходнаяСтрока);
	ПроверитьПовторныйРазборБезПотерь(Ури);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПовторныйРазборБезПотерь(Ури)

	Копия = Новый URI(Ури.ВСтроку());
	Ожидаем.Что(Копия.ВСтроку()).Равно(Ури.ВСтроку());

КонецПроцедуры

#КонецОбласти
