#Использовать asserts
#Использовать "../../src"
#Использовать "../fixtures"

Перем _УриСПереполненнымПортом; // URI

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("host", Ложь, Неопределено, Неопределено)
&ИсточникЗначение("host:", Истина, "", Неопределено)
&ИсточникЗначение("host:0", Истина, "0", 0)
&ИсточникЗначение("host:000", Истина, "000", 0)
&ИсточникЗначение("host:080", Истина, "080", 80)
&ИсточникЗначение("host:65535", Истина, "65535", 65535)
&ИсточникЗначение("host:65536", Истина, "65536", 65536)
Процедура ТестДолжен_ВернутьСемантикуТекстаПорта(СервернаяЧасть, ОжидаетсяПорт,
	ОжидаемыйТекстПорта, ОжидаемыйПорт) Экспорт

	// Подготовка
	Ури = Новый URI("x://" + СервернаяЧасть + "/");

	// Действие
	Порт = Ури.Порт();

	// Проверка
	Ожидаем.Что(Ури.ПортУказан()).Равно(ОжидаетсяПорт);
	Ожидаем.Что(Ури.ТекстПорта()).Равно(ОжидаемыйТекстПорта);
	Ожидаем.Что(Порт).Равно(ОжидаемыйПорт);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьТекстПортаПриЧисловомПереполнении() Экспорт

	// Подготовка
	_УриСПереполненнымПортом = Новый URI("x://host:999999999999999999999999999999999999/");

	// Действие и Проверка
	Ожидаем.Что(_УриСПереполненнымПортом.ТекстПорта()).Равно("999999999999999999999999999999999999");
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "ПолучитьПереполненныйПорт"),
		"url.port.numeric_overflow"
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("http://e", 80)
&ИсточникЗначение("http://e:", 80)
&ИсточникЗначение("http://e:80", 80)
&ИсточникЗначение("http://e:080", 80)
&ИсточникЗначение("http://e:00080", 80)
&ИсточникЗначение("https://e", 443)
&ИсточникЗначение("ftp://e", 21)
&ИсточникЗначение("x://e", Неопределено)
Процедура ТестДолжен_ОпределитьСтандартныйИЭффективныйПорт(ИсходнаяСтрока, ОжидаемыйПорт) Экспорт

	// Подготовка
	Ури = Новый URI(ИсходнаяСтрока);

	// Действие и Проверка
	Ожидаем.Что(Ури.ЭффективныйПорт()).Равно(ОжидаемыйПорт);
	Если ОжидаемыйПорт = Неопределено Тогда
		Ожидаем.Что(Ури.ИспользуетСтандартныйПорт()).ЭтоЛожь();
	Иначе
		Ожидаем.Что(Ури.ИспользуетСтандартныйПорт()).ЭтоИстина();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПолучитьПереполненныйПорт() Экспорт

	_УриСПереполненнымПортом.Порт();

КонецПроцедуры

#КонецОбласти
