#Использовать asserts
#Использовать "../../src"
#Использовать "../../src/internal"
#Использовать "../fixtures"

Перем _НедопустимыйURI; // Строка

#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьИсходноеНаписаниеURI() Экспорт

	// Подготовка
	ИсходнаяСтрока = "HTTP://User%3AName@EXAMPLE.COM:080/a%2fb?x=%7e#F";

	// Действие
	Ури = Новый URI(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Ури.ВСтроку()).Равно(ИсходнаяСтрока);
	Ожидаем.Что(Ури.КодированныйЗапрос()).Равно("x=%7e");
	ПроверитьПовторныйРазборБезПотерь(Ури);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("", Неопределено, "", Ложь, Неопределено, Неопределено)
&ИсточникЗначение("mailto:user@example.com", "mailto", "user@example.com", Ложь, Неопределено, Неопределено)
&ИсточникЗначение("/path", Неопределено, "/path", Ложь, Неопределено, Неопределено)
&ИсточникЗначение("//example.com/path", Неопределено, "/path", Истина, Неопределено, Неопределено)
&ИсточникЗначение("https://example.com/", "https", "/", Истина, Неопределено, Неопределено)
&ИсточникЗначение("https://example.com", "https", "", Истина, Неопределено, Неопределено)
&ИсточникЗначение("?x=1", Неопределено, "", Ложь, "x=1", Неопределено)
&ИсточникЗначение("#top", Неопределено, "", Ложь, Неопределено, "top")
Процедура ТестДолжен_РазобратьСтруктурныеФормыURI(
	ИсходнаяСтрока, ОжидаемаяСхема, ОжидаемыйПуть, ОжидаетсяСервернаяЧасть, ОжидаемыйЗапрос, ОжидаемыйФрагмент
) Экспорт

	// Действие
	Ури = Новый URI(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Ури.ВСтроку()).Равно(ИсходнаяСтрока);
	Ожидаем.Что(Ури.Схема()).Равно(ОжидаемаяСхема);
	Ожидаем.Что(Ури.КодированныйПуть()).Равно(ОжидаемыйПуть);
	Ожидаем.Что(Ури.СервернаяЧастьОпределена()).Равно(ОжидаетсяСервернаяЧасть);
	Ожидаем.Что(Ури.КодированныйЗапрос()).Равно(ОжидаемыйЗапрос);
	Ожидаем.Что(Ури.КодированныйФрагмент()).Равно(ОжидаемыйФрагмент);
	ПроверитьПовторныйРазборБезПотерь(Ури);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНезависимоеСостояниеURIИзВнутреннегоПарсера() Экспорт

	// Подготовка
	Парсер = Новый ПарсерURIВнутренний;

	// Действие
	Состояние = Парсер.Разобрать("https://example.com/path?");
	Копия = Состояние.Скопировать();
	Состояние.ПроверитьИнварианты();
	Копия.ПроверитьИнварианты();

	// Проверка
	Ожидаем.Что(ТипЗнч(Состояние)).Равно(Тип("СостояниеURI"));
	Ожидаем.Что(Копия).ЭтоНе().Идентично(Состояние);
	Ожидаем.Что(Копия.ВСтроку()).Равно(Состояние.ВСтроку());

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСчитатьКодированныйСлешРазделителемПути() Экспорт

	// Подготовка
	ИсходнаяСтрока = "/a%2Fb/c";

	// Действие
	Ури = Новый URI(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Ури.КодированныйПуть()).Равно(ИсходнаяСтрока);
	Ожидаем.Что(Ури.ВСтроку()).Равно(ИсходнаяСтрока);
	ПроверитьПовторныйРазборБезПотерь(Ури);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("/тест", "uri.invalid_syntax")
&ИсточникЗначение("https://пример.рф/", "uri.invalid_syntax")
&ИсточникЗначение("/%", "uri.invalid_percent_encoding")
&ИсточникЗначение("/%1", "uri.invalid_percent_encoding")
&ИсточникЗначение("/%ZZ", "uri.invalid_percent_encoding")
Процедура ТестДолжен_ОтклонитьНедопустимуюИсходнуюСтрокуURI(Значение, ОжидаемыйКодОшибки) Экспорт

	// Подготовка
	_НедопустимыйURI = Значение;

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "СоздатьНедопустимыйURI"),
		ОжидаемыйКодОшибки
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьНедопустимыйURI() Экспорт

	Ури = Новый URI(_НедопустимыйURI);

КонецПроцедуры

Процедура ПроверитьПовторныйРазборБезПотерь(Ури)

	Копия = Новый URI(Ури.ВСтроку());
	Ожидаем.Что(Копия.ВСтроку()).Равно(Ури.ВСтроку());

КонецПроцедуры

#КонецОбласти
