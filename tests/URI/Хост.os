&Тест
Процедура ТестДолжен_ЭкспортироватьРазличныеВидыХоста() Экспорт

	// Подготовка
	Виды = Новый Соответствие;

	// Действие
	Виды.Вставить(ВидыХостаURI.РегИмя(), Истина);
	Виды.Вставить(ВидыХостаURI.IPv4(), Истина);
	Виды.Вставить(ВидыХостаURI.IPv6(), Истина);
	Виды.Вставить(ВидыХостаURI.IPvFuture(), Истина);

	// Проверка
	Ожидаем.Что(Виды.Количество()).Равно(4);

КонецПроцедуры

