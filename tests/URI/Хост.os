#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("::")
&ИсточникЗначение("::1")
&ИсточникЗначение("2001:db8::1")
&ИсточникЗначение("1:2:3:4:5:6:7:8")
&ИсточникЗначение("::1:2:3:4:5:6:7")
&ИсточникЗначение("1::3:4:5:6:7:8")
&ИсточникЗначение("1:2::4:5:6:7:8")
&ИсточникЗначение("1:2:3::5:6:7:8")
&ИсточникЗначение("1:2:3:4::6:7:8")
&ИсточникЗначение("1:2:3:4:5::7:8")
&ИсточникЗначение("1:2:3:4:5:6::8")
&ИсточникЗначение("1:2:3:4:5:6:7::")
&ИсточникЗначение("::ffff:192.0.2.1")
Процедура ТестДолжен_КлассифицироватьВсеФормыIPv6ИзRFC3986(Значение) Экспорт

	// Подготовка
	// Значение передано параметром теста.

	// Действие
	Результат = КлассификаторХостаURI.Классифицировать("[" + Значение + "]");

	// Проверка
	Ожидаем.Что(Результат).Равно(ВидыХостаURI.IPv6());

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("1::2::3")
&ИсточникЗначение("1:2:3:4:5:6:7:8:9")
&ИсточникЗначение("1:2:3:4:5:6:7")
&ИсточникЗначение("1:2:3:4:5:6:7:zzzz")
&ИсточникЗначение("::ffff:192.168.001.1")
&ИсточникЗначение("fe80::1%25eth0")
Процедура ТестДолжен_ОтклонитьХостСНедопустимымIPv6(Значение) Экспорт

	// Подготовка
	// Значение передано параметром теста.

	// Действие
	Результат = КлассификаторХостаURI.Классифицировать("[" + Значение + "]");

	// Проверка
	Ожидаем.Что(Результат).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("v1.foo")
&ИсточникЗначение("V1.foo")
&ИсточникЗначение("vF.abc:!$&'()*+,;=")
Процедура ТестДолжен_ПринятьДопустимыйIPvFuture(Значение) Экспорт

	// Подготовка
	// Значение передано параметром теста.

	// Действие
	Результат = IPvFuture.ЭтоДопустимый(Значение);

	// Проверка
	Ожидаем.Что(Результат).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("v.foo")
&ИсточникЗначение("v1.")
&ИсточникЗначение("v1.foo%")
&ИсточникЗначение("v1.foo/bar")
