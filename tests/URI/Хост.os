КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеопределеноДляНеСтроковогоХоста() Экспорт

	// Подготовка
	НеСтроковыеЗначения = Новый Массив;
	НеСтроковыеЗначения.Добавить(Неопределено);
	НеСтроковыеЗначения.Добавить(Null);
	НеСтроковыеЗначения.Добавить(42);

	// Действие и Проверка
	Для Каждого Значение Из НеСтроковыеЗначения Цикл
		Ожидаем.Что(КлассификаторХостаURI.Классифицировать(Значение)).Равно(Неопределено);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЯвляетсяСтрогимIPv4(Значение)

	Попытка
		Адрес = Новый IPАдрес(Значение);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Адрес.ЭтоIPv4();

КонецФункции

#КонецОбласти
