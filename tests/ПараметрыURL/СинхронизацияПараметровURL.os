#Использовать asserts
#Использовать "../../src"

#Область Тесты

&Тест
Процедура ТестДолжен_СвязыватьПараметрыСURLЧерезКонструктор() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/?a=1");
	Параметры = Новый ПараметрыURL("a=1", Адрес);

	// Действие
	Адрес.УстановитьКодированныйЗапрос("b=2");

	// Проверка
	Ожидаем.Что(Параметры.Получить("b")).Равно("2");
	Ожидаем.Что(Параметры.Есть("a")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СинхронизироватьНесколькоФасадовПараметровЗапроса() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/?a=1");
	ПервыйФасад = Адрес.ПараметрыЗапроса();
	ВторойФасад = Адрес.ПараметрыЗапроса();

	// Действие
	ПервыйФасад.Добавить("a", "2");
	Значения = ВторойФасад.ПолучитьВсе("a");

	// Проверка
	Ожидаем.Что(Значения.Количество()).Равно(2);
	Ожидаем.Что(Значения[0]).Равно("1");
	Ожидаем.Что(Значения[1]).Равно("2");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбновлятьСтарыйФасадПослеПрямойУстановкиЗапроса() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/?a=1");
	Параметры = Адрес.ПараметрыЗапроса();

	// Действие
	Адрес.УстановитьКодированныйЗапрос("b=3");
	Значение = Параметры.Получить("b");
	СтарыйПараметрСуществует = Параметры.Есть("a");

	// Проверка
	Ожидаем.Что(Значение).Равно("3");
	Ожидаем.Что(СтарыйПараметрСуществует).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеМенятьЗапросПриЧтенииИНормализоватьЕгоПриМутации() Экспорт

	// Подготовка
	Адрес = Новый URL("https://e/?a=hello%20world&flag");
	Параметры = Адрес.ПараметрыЗапроса();

	// Действие
	Параметры.Количество();
	Параметры.Есть("a");
	Параметры.Получить("a");
	Параметры.ПолучитьВсе("a");
	Параметры.ВСтроку();
	ПослеЧтения = Адрес.ВСтроку();
	Параметры.Добавить("b", "x");
	ПослеМутации = Адрес.ВСтроку();

	// Проверка
	Ожидаем.Что(ПослеЧтения).Равно("https://e/?a=hello%20world&flag");
	Ожидаем.Что(ПослеМутации).Равно("https://e/?a=hello+world&flag=&b=x");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалятьКомпонентЗапросаПослеУдаленияПоследнейПары() Экспорт

	// Подготовка
	Адрес = Новый URL("https://e/?a=1");

	// Действие
	Адрес.ПараметрыЗапроса().Удалить("a");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://e/");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалятьПустойКомпонентЗапросаПриСортировке() Экспорт

	// Подготовка
	Адрес = Новый URL("https://e/?");

	// Действие
	Адрес.ПараметрыЗапроса().Сортировать();

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://e/");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СериализоватьФлагПриУдаленииОтсутствующегоПараметра() Экспорт

	// Подготовка
	Адрес = Новый URL("https://e/?flag");

	// Действие
	Адрес.ПараметрыЗапроса().Удалить("missing");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://e/?flag=");

КонецПроцедуры

#КонецОбласти
