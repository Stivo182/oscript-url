#Использовать asserts
#Использовать "../../src"

#Область Тесты

&Тест
Процедура ТестДолжен_СохранятьДубликаты() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыURL("a=1&a=2&b=3");

	// Действие
	ПараметрСуществует = Параметры.Есть("a");
	Значение = Параметры.Получить("a");
	ВсеЗначения = Параметры.ПолучитьВсе("a");
	ТипЗначений = ТипЗнч(ВсеЗначения);

	// Проверка
	Ожидаем.Что(ПараметрСуществует).ЭтоИстина();
	Ожидаем.Что(Значение).Равно("1");
	Ожидаем.Что(ТипЗначений).Равно(Тип("ФиксированныйМассив"));
	Ожидаем.Что(ВсеЗначения[0]).Равно("1");
	Ожидаем.Что(ВсеЗначения[1]).Равно("2");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьКаждуюПаруСДубликатами() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыURL("a=1&a=2&b=3");

	// Действие
	Количество = Параметры.Количество();

	// Проверка
	Ожидаем.Что(Количество).Равно(3);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавлятьДубликатВКонец() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыURL("a=1&b=2");

	// Действие
	Параметры.Добавить("a", "3");
	СтрокаПараметров = Параметры.ВСтроку();

	// Проверка
	Ожидаем.Что(СтрокаПараметров).Равно("a=1&b=2&a=3");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СравниватьИменаСУчетомРегистра() Экспорт

	// Подготовка
	ПараметрыДляПроверкиНаличия = Новый ПараметрыURL("a=1");
	ПараметрыДляУдаления = Новый ПараметрыURL("a=1&A=2");

	// Действие
	ЕстьСтрочноеИмя = ПараметрыДляПроверкиНаличия.Есть("a");
	ЕстьПрописноеИмя = ПараметрыДляПроверкиНаличия.Есть("A");
	ПараметрыДляУдаления.Удалить("a");
	СтрокаПараметров = ПараметрыДляУдаления.ВСтроку();

	// Проверка
	Ожидаем.Что(ЕстьСтрочноеИмя).ЭтоИстина();
	Ожидаем.Что(ЕстьПрописноеИмя).ЭтоЛожь();
	Ожидаем.Что(СтрокаПараметров).Равно("A=2");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаменятьДубликаты() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыURL("x=1&a=old&b=2&a=other");

	// Действие
	Параметры.Установить("a", "new");

	// Проверка
	Ожидаем.Что(Параметры.ВСтроку()).Равно("x=1&a=new&b=2");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалятьВсеПарыСИменем() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыURL("a=1&b=2&a=3");

	// Действие
	Параметры.Удалить("a");

	// Проверка
	Ожидаем.Что(Параметры.ВСтроку()).Равно("b=2");
	Ожидаем.Что(Параметры.Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчищатьКоллекцию() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыURL("a=1&b=2&a=3");

	// Действие
	Параметры.Очистить();

	// Проверка
	Ожидаем.Что(Параметры.ВСтроку()).Равно("");
	Ожидаем.Что(Параметры.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавлятьПриУстановкеНового() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыURL("a=1");

	// Действие
	Параметры.Установить("b", "2");

	// Проверка
	Ожидаем.Что(Параметры.ВСтроку())
		.Равно("a=1&b=2");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьПустойМассив() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыURL("a=1");

	// Действие
	Значения = Параметры.ПолучитьВсе("b");
	ТипЗначений = ТипЗнч(Значения);

	// Проверка
	Ожидаем.Что(ТипЗначений)
		.Равно(Тип("ФиксированныйМассив"));
	Ожидаем.Что(Значения.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьНезависимыеМассивы() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыURL("a=1&a=2");

	// Действие
	ПервыйМассив = Параметры.ПолучитьВсе("a");
	ВторойМассив = Параметры.ПолучитьВсе("a");

	// Проверка
	Ожидаем.Что(ПервыйМассив)
		.ЭтоНе()
		.Идентично(ВторойМассив);
	Ожидаем.Что(ПервыйМассив[0]).Равно("1");
	Ожидаем.Что(ВторойМассив[1]).Равно("2");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СтабильноСортироватьПоUTF16() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыURL(
		"b=1&a=first&%F0%90%80%80=astral&%EE%80%80=private&a=second&A=upper"
	);

	// Действие
	Параметры.Сортировать();

	// Проверка
	Ожидаем.Что(Параметры.ВСтроку()).Равно(
		"A=upper&a=first&a=second&b=1&%F0%90%80%80=astral&%EE%80%80=private"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СортироватьASCIIПоКодовымЕдиницамUTF16() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыURL(
		"a=lower&A=upper&Z=zed&b=bee&e=e&%C3%A9=accent"
	);

	// Действие
	Параметры.Сортировать();
	СтрокаПараметров = Параметры.ВСтроку();

	// Проверка
	Ожидаем.Что(СтрокаПараметров)
		.Равно("A=upper&Z=zed&a=lower&b=bee&e=e&%C3%A9=accent");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьНовыйПорядокПослеСортировки() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыURL("b=1&a=first&a=second");

	// Действие
	Параметры.Сортировать();
	Параметры.Установить("a", "new");
	Параметры.Добавить("a", "last");
	СтрокаПараметров = Параметры.ВСтроку();
	Значения = Параметры.ПолучитьВсе("a");

	// Проверка
	Ожидаем.Что(СтрокаПараметров)
		.Равно("a=new&b=1&a=last");
	Ожидаем.Что(Значения[0]).Равно("new");
	Ожидаем.Что(Значения[1]).Равно("last");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьНезависимыеКопииПары() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыURL("a=1");
	Копии = Параметры.КакМассив();

	// Действие
	Копии[0].Значение = "изменено";
	Копии.Добавить(Новый Структура("Имя,Значение", "b", "2"));

	// Проверка
	Ожидаем.Что(Параметры.ВСтроку()).Равно("a=1");
	Ожидаем.Что(Копии.Количество()).Равно(2);

КонецПроцедуры

#КонецОбласти
