	ИначеЕсли ВидПоследовательности = "Младший" Тогда
		_НедопустимыйIRI = "/" + Символ(56320);
	Иначе
		_НедопустимыйIRI = "/" + Символ(55296) + "a";
	КонецЕсли;

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
