&Тест
Процедура ТестДолжен_СохранитьIRIПриРазрешенииОтносительнойСсылки() Экспорт

	// Подготовка
	База = Новый URL("https://пример.рф/каталог/");

	// Действие
	Результат = База.Разрешить("файл");

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно("https://пример.рф/каталог/файл");
	Ожидаем.Что(Результат.КодированноеПредставление()).Равно(
		"https://%D0%BF%D1%80%D0%B8%D0%BC%D0%B5%D1%80.%D1%80%D1%84/"
			+ "%D0%BA%D0%B0%D1%82%D0%B0%D0%BB%D0%BE%D0%B3/%D1%84%D0%B0%D0%B9%D0%BB"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьСимволыUnicodeПриУстановкеДекодированныхКомпонентовURL() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/");

	// Действие
	Адрес
		.УстановитьДанныеПользователя("имя:пароль")
		.УстановитьХост("пример.рф")
		.УстановитьПуть("/путь")
		.УстановитьСтрокуЗапроса("ключ=я")
		.УстановитьФрагмент("часть");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://имя:пароль@пример.рф/путь?ключ=я#часть");
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно(
		"https://%D0%B8%D0%BC%D1%8F:%D0%BF%D0%B0%D1%80%D0%BE%D0%BB%D1%8C"
			+ "@%D0%BF%D1%80%D0%B8%D0%BC%D0%B5%D1%80.%D1%80%D1%84/%D0%BF%D1%83%D1%82%D1%8C"
			+ "?%D0%BA%D0%BB%D1%8E%D1%87=%D1%8F#%D1%87%D0%B0%D1%81%D1%82%D1%8C"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьСимволыUnicodeПриИзмененииИмениИПароля() Экспорт

	// Подготовка
	Адрес = Новый URL("https://old:secret@host/");

	// Действие
	Адрес.УстановитьДанныеПользователя("имя:пароль");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://имя:пароль@host/");
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно(
		"https://%D0%B8%D0%BC%D1%8F:%D0%BF%D0%B0%D1%80%D0%BE%D0%BB%D1%8C@host/"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьСимволыUnicodeПриДобавленииСегментовПути() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/путь");
	Сегменты = Новый Массив;
	Сегменты.Добавить("раз");
	Сегменты.Добавить("два");

	// Действие
	Адрес.ДобавитьСегментПути("файл/имя").ДобавитьСегментыПути(Сегменты);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/путь/файл%2Fимя/раз/два");
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно(
		"https://host/%D0%BF%D1%83%D1%82%D1%8C/%D1%84%D0%B0%D0%B9%D0%BB%2F%D0%B8%D0%BC%D1%8F/"
			+ "%D1%80%D0%B0%D0%B7/%D0%B4%D0%B2%D0%B0"
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьНедопустимыйIRI() Экспорт

	Адрес = Новый URL(_НедопустимыйIRI);

КонецПроцедуры

Процедура УстановитьНедопустимыйКомпонент() Экспорт

	Если _ИмяМетодаУстановки = "ДанныеПользователя" Тогда
		_АдресДляИзменения.УстановитьДанныеПользователя(_ЗначениеКомпонента);
	ИначеЕсли _ИмяМетодаУстановки = "Путь" Тогда
		_АдресДляИзменения.УстановитьПуть(_ЗначениеКомпонента);
	ИначеЕсли _ИмяМетодаУстановки = "Запрос" Тогда
		_АдресДляИзменения.УстановитьСтрокуЗапроса(_ЗначениеКомпонента);
	Иначе
		_АдресДляИзменения.УстановитьФрагмент(_ЗначениеКомпонента);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
