#Использовать asserts
#Использовать "../../src"
#Использовать "../fixtures"

Перем _НедопустимыйIRI; // Строка
Перем _АдресДляИзменения; // URL
Перем _ЗначениеКомпонента; // Строка
Перем _ИмяМетодаУстановки; // Строка

#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьIRIИВернутьКодированноеПредставление() Экспорт

	// Подготовка
	ИсходнаяСтрока = "https://пример.рф/путь?q=я#я";
	ОжидаемоеПредставление = "https://%D0%BF%D1%80%D0%B8%D0%BC%D0%B5%D1%80.%D1%80%D1%84/"
		+ "%D0%BF%D1%83%D1%82%D1%8C?q=%D1%8F#%D1%8F";

	// Действие
	Адрес = Новый URL(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно(ОжидаемоеПредставление);
	Ожидаем.Что(Адрес.Хост()).Равно("пример.рф");
	Ожидаем.Что(Адрес.КодированныйХост()).Равно("%D0%BF%D1%80%D0%B8%D0%BC%D0%B5%D1%80.%D1%80%D1%84");
	Ожидаем.Что(Адрес.Путь()).Равно("/путь");
	Ожидаем.Что(Адрес.КодированныйПуть()).Равно("/%D0%BF%D1%83%D1%82%D1%8C");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПроцентноеКодированиеВХостеССимволамиUnicode() Экспорт

	// Подготовка
	ИсходнаяСтрока = "http://пример.%72%66/";

	// Действие
	Адрес = Новый URL(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);
	Ожидаем.Что(Адрес.КодированныйХост()).Равно("%D0%BF%D1%80%D0%B8%D0%BC%D0%B5%D1%80.%72%66");
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно(
		"http://%D0%BF%D1%80%D0%B8%D0%BC%D0%B5%D1%80.%72%66/"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбработатьСимволыUnicodeИПроцентноеКодированиеВОднойМеткеХоста() Экспорт

	// Подготовка
	ИсходнаяСтрока = "http://пример%72.рф/";
	ОжидаемыйХост = "%D0%BF%D1%80%D0%B8%D0%BC%D0%B5%D1%80%72.%D1%80%D1%84";

	// Действие
	Адрес = Новый URL(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);
	Ожидаем.Что(Адрес.КодированныйХост()).Равно(ОжидаемыйХост);
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно("http://" + ОжидаемыйХост + "/");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ДанныеПользователя", "Частная")
&ИсточникЗначение("Путь", "Частная")
&ИсточникЗначение("Фрагмент", "Частная")
&ИсточникЗначение("Запрос", "НеСимвол")
Процедура ТестДолжен_ОтклонитьНедопустимуюКодовуюТочкуПриУстановкеДекодированногоКомпонента(
	ИмяМетодаУстановки,
	ВидКодовойТочки
) Экспорт

	// Подготовка
	_АдресДляИзменения = Новый URL("https://host/");
	_ИмяМетодаУстановки = ИмяМетодаУстановки;
	_ЗначениеКомпонента = ?(ВидКодовойТочки = "Частная", Символ(57344), Символ(65535));

	Если ИмяМетодаУстановки = "Путь" Тогда
		_ЗначениеКомпонента = "/" + _ЗначениеКомпонента;
	КонецЕсли;

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "УстановитьНедопустимыйКомпонент"),
		"url.invalid_syntax"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьIRIПриПостроенииОтносительнойСсылки() Экспорт

	// Подготовка
	База = Новый URL("https://пример.рф/каталог/");
	Цель = Новый URL("https://пример.рф/каталог/файл");

	// Действие
	Результат = База.СделатьОтносительным(Цель);

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно("файл");
	Ожидаем.Что(Результат.КодированноеПредставление()).Равно("%D1%84%D0%B0%D0%B9%D0%BB");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьIRIЭквивалентнымКодированномуURI() Экспорт

	// Подготовка
	IRI = Новый URL("https://пример.рф/путь");
	КодированныйURI = Новый URL(
		"https://%D0%BF%D1%80%D0%B8%D0%BC%D0%B5%D1%80.%D1%80%D1%84/%D0%BF%D1%83%D1%82%D1%8C"
	);

	// Действие
	Результат = IRI.Эквивалентен(КодированныйURI);

	// Проверка
	Ожидаем.Что(Результат).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьСимволыUnicodeПриНормализацииIRI() Экспорт

	// Подготовка
	Адрес = Новый URL("HTTPS://пример.рф/a/../путь");

	// Действие
	Результат = Адрес.Нормализованный();

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно("https://пример.рф/путь");
	Ожидаем.Что(Результат.КодированноеПредставление()).Равно(
		"https://%D0%BF%D1%80%D0%B8%D0%BC%D0%B5%D1%80.%D1%80%D1%84/%D0%BF%D1%83%D1%82%D1%8C"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьЧастнуюКодовуюТочкуТолькоВЗапросе() Экспорт

	// Подготовка
	ЧастнаяКодоваяТочка = Символ(57344);

	// Действие
	Адрес = Новый URL("/?q=" + ЧастнаяКодоваяТочка);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("/?q=" + ЧастнаяКодоваяТочка);
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно("/?q=%EE%80%80");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Частная")
&ИсточникЗначение("НеСимвол")
Процедура ТестДолжен_ОтклонитьНедопустимуюКодовуюТочкуВПути(ВидКодовойТочки) Экспорт

	// Подготовка
	Если ВидКодовойТочки = "Частная" Тогда
		_НедопустимыйIRI = "/" + Символ(57344);
	Иначе
		_НедопустимыйIRI = "/" + Символ(65535);
	КонецЕсли;

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "СоздатьНедопустимыйIRI"),
		"url.invalid_syntax"
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Пробел")
&ИсточникЗначение("ОбратныйСлеш")
&ИсточникЗначение("Управляющий")
Процедура ТестДолжен_ОтклонитьНедопустимыйНекодированныйСимволASCII(ВидСимвола) Экспорт

	// Подготовка
	Если ВидСимвола = "Пробел" Тогда
		_НедопустимыйIRI = "/a b";
	ИначеЕсли ВидСимвола = "ОбратныйСлеш" Тогда
		_НедопустимыйIRI = "/a" + Символ(92) + "b";
	Иначе
		_НедопустимыйIRI = "/a" + Символ(1) + "b";
	КонецЕсли;

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "СоздатьНедопустимыйIRI"),
		"url.invalid_syntax"
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Пробел")
&ИсточникЗначение("ОбратныйСлеш")
&ИсточникЗначение("Управляющий")
Процедура ТестДолжен_ОтклонитьНедопустимыйНекодированныйСимволASCIIВМеждународномХосте(
	ВидСимвола
) Экспорт

	// Подготовка
	Если ВидСимвола = "Пробел" Тогда
		_НедопустимыйIRI = "http://пример .рф/";
	ИначеЕсли ВидСимвола = "ОбратныйСлеш" Тогда
		_НедопустимыйIRI = "http://пример" + Символ(92) + ".рф/";
	Иначе
		_НедопустимыйIRI = "http://пример" + Символ(1) + ".рф/";
	КонецЕсли;

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "СоздатьНедопустимыйIRI"),
		"url.invalid_host"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КодироватьСимволВнеBMPКакПоследовательностьUTF8() Экспорт

	// Подготовка
	СимволВнеBMP = Символ(55296) + Символ(57088);

	// Действие
	Адрес = Новый URL("/" + СимволВнеBMP);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("/" + СимволВнеBMP);
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно("/%F0%90%8C%80");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Старший")
&ИсточникЗначение("Младший")
&ИсточникЗначение("НарушеннаяПара")
Процедура ТестДолжен_ОтклонитьНекорректнуюПоследовательностьСуррогатов(ВидПоследовательности) Экспорт

	// Подготовка
	Если ВидПоследовательности = "Старший" Тогда
