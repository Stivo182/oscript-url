#Использовать asserts
#Использовать "../../src"

Перем _Кодировщик; // КодировщикPunycode

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

КонецПроцедуры

&ПередВсеми
Процедура ПередВсемиТестами() Экспорт

	_Кодировщик = СервисыБиблиотекиURL.КодировщикPunycode();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("", "")
&ИсточникЗначение("abc", "abc-")
&ИсточникЗначение("bücher", "bcher-kva")
&ИсточникЗначение("пример", "e1afmkfd")
&ИсточникЗначение("例え", "r8jz45g")
Процедура ТестДолжен_КодироватьUnicodeМеткуПоRFC3492(Значение, ОжидаемоеЗначение) Экспорт

	// Действие
	Результат = _Кодировщик.Кодировать(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемоеЗначение);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("", "")
&ИсточникЗначение("abc-", "abc")
&ИсточникЗначение("bcher-kva", "bücher")
&ИсточникЗначение("e1afmkfd", "пример")
&ИсточникЗначение("r8jz45g", "例え")
Процедура ТестДолжен_ДекодироватьPunycodeМеткуПоRFC3492(Значение, ОжидаемоеЗначение) Экспорт

	// Действие
	Результат = _Кодировщик.Декодировать(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемоеЗначение);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьВедущийРазделительИПереполнение() Экспорт

	// Действие
	ВедущийРазделитель = _Кодировщик.Декодировать("-");
	Переполнение = _Кодировщик.Декодировать("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz");

	// Проверка
	Ожидаем.Что(ВедущийРазделитель).Равно(Неопределено);
	Ожидаем.Что(Переполнение).Равно(Неопределено);

КонецПроцедуры

#КонецОбласти
