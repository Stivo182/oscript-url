#Использовать asserts
#Использовать errors
#Использовать "../../src"

#Область Тесты

&Тест
Процедура ТестДолжен_СоответствоватьНормативнымПримерамUTS46() Экспорт

	// Подготовка
	ИмяФайла = ОбъединитьПути(ТекущийКаталог(), "tests/fixtures/idna/IdnaTestV2.txt");
	Несоответствия = Новый Массив;

	// Действие
	ВерсияСоответствует = ЭтоНормативныеПримерыВерсии(ИмяФайла, "17.0.0");
	ХешСоответствует = ХешФайла(ИмяФайла)
		= "BEB5D0BE20E896189B03209A82FDC34F06351502BBD4B8E2523583FC2954D9CF";
	КоличествоПроверенныхПримеров = ПроверитьНормативныеПримеры(ИмяФайла, Несоответствия);

	// Проверка
	Ожидаем.Что(ВерсияСоответствует).Равно(Истина);
	Ожидаем.Что(ХешСоответствует).Равно(Истина);
	Ожидаем.Что(КоличествоПроверенныхПримеров).Больше(6000);
	Ожидаем.Что(СтрСоединить(Несоответствия, Символы.ПС)).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЧитатьНормативныеПримерыПриСовместномДоступе() Экспорт

	// Подготовка
	ИмяФайла = ОбъединитьПути(ТекущийКаталог(), "tests/fixtures/idna/IdnaTestV2.txt");
	КонтрольноеЧтение = Новый ЧтениеТекста(ИмяФайла, , , , Ложь);
	ОписаниеОшибкиЧтения = "";

	// Действие
	Попытка
		ЭтоНормативныеПримерыВерсии(ИмяФайла, "17.0.0");
	Исключение
		ОписаниеОшибкиЧтения = ОписаниеОшибки();
	КонецПопытки;
	КонтрольноеЧтение.Закрыть();

	// Проверка
	Ожидаем.Что(ОписаниеОшибкиЧтения).Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ХешФайла(ИмяФайла)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.ДобавитьФайл(ИмяФайла);
	Возврат ВРег(Хеширование.ХешСуммаСтрокой);

КонецФункции

Функция ЭтоНормативныеПримерыВерсии(ИмяФайла, ВерсияUnicode)

	Чтение = Новый ЧтениеТекста(ИмяФайла, , , , Ложь);
	МаркерВерсии = "# Version: " + ВерсияUnicode;

	Пока Истина Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();

		Если СтрокаФайла = Неопределено Или Лев(СтрокаФайла, 1) <> "#" Тогда
			Прервать;
		КонецЕсли;

		Если СокрЛП(СтрокаФайла) = МаркерВерсии Тогда
			Чтение.Закрыть();
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Чтение.Закрыть();

	Возврат Ложь;

КонецФункции

Функция ПроверитьНормативныеПримеры(ИмяФайла, Несоответствия)

	Чтение = Новый ЧтениеТекста(ИмяФайла, , , , Ложь);
	НомерСтроки = 0;
	КоличествоПроверенныхПримеров = 0;

	Пока Истина Цикл
		СтрокаТеста = Чтение.ПрочитатьСтроку();

		Если СтрокаТеста = Неопределено Тогда
			Прервать;
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;
		КоличествоПроверенныхПримеров = КоличествоПроверенныхПримеров
			+ ПроверитьСтрокуТеста(СтрокаТеста, НомерСтроки, Несоответствия);
	КонецЦикла;

	Чтение.Закрыть();
	Возврат КоличествоПроверенныхПримеров;

КонецФункции

Функция ПроверитьСтрокуТеста(СтрокаТеста, НомерСтроки, Несоответствия)

	ПозицияКомментария = СтрНайти(СтрокаТеста, "#");

	Если ПозицияКомментария > 0 Тогда
		СтрокаТеста = Лев(СтрокаТеста, ПозицияКомментария - 1);
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(СтрокаТеста)) Тогда
		Возврат 0;
	КонецЕсли;

	Поля = СтрРазделить(СтрокаТеста, ";", Истина);

	Если Поля.Количество() < 7 Тогда
		ДобавитьНесоответствие(Несоответствия, НомерСтроки, "неполная строка теста");
		Возврат 0;
	КонецЕсли;

	ИсходнаяСтрока = ДекодироватьПоле(Поля[0]);

	Если ИсходнаяСтрока = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ОжидаемыйUnicode = ЗначениеПоляИлиИсходное(Поля[1], ИсходнаяСтрока);
	СтатусUnicode = СокрЛП(Поля[2]);
	ОжидаемыйASCII = ЗначениеПоляИлиИсходное(Поля[3], ОжидаемыйUnicode);
	СтатусASCII = СокрЛП(Поля[4]);
	ОжидаемыйПереходныйASCII = ЗначениеПоляИлиИсходное(Поля[5], ОжидаемыйASCII);
	СтатусПереходногоASCII = СокрЛП(Поля[6]);

	Если ПустаяСтрока(СтатусASCII) Тогда
		СтатусASCII = СтатусUnicode;
	КонецЕсли;

	Если ПустаяСтрока(СтатусПереходногоASCII) Тогда
		СтатусПереходногоASCII = СтатусASCII;
	КонецЕсли;

	ПроверитьРезультат(
		ДекодироватьДляПроверки(ИсходнаяСтрока, СтатусUnicode),
		ОжидаемыйUnicode,
		СтатусUnicode,
		НомерСтроки,
		"ДекодироватьДомен",
		Несоответствия
	);
	ПроверитьРезультат(
		КодироватьДляПроверки(ИсходнаяСтрока, Ложь),
		ОжидаемыйASCII,
		СтатусASCII,
		НомерСтроки,
		"КодироватьДомен",
		Несоответствия
	);
	ПроверитьРезультат(
		КодироватьДляПроверки(ИсходнаяСтрока, Истина),
		ОжидаемыйПереходныйASCII,
		СтатусПереходногоASCII,
		НомерСтроки,
		"КодироватьДоменПереходно",
		Несоответствия
	);
	Возврат 1;

КонецФункции

Функция ДекодироватьДляПроверки(Домен, Статус)

	Результат = СервисыБиблиотекиURL.ПреобразовательДоменов().Декодировать(Домен);

	Если ЕстьУчитываемаяОшибка(Статус) И Результат = Домен Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция КодироватьДляПроверки(Домен, ПереходнаяОбработка)

	Попытка
		Возврат СервисыБиблиотекиURL.ПреобразовательДоменов().Кодировать(Домен, ПереходнаяОбработка);
	Исключение
		Если ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке()) = "argument.invalid_value" Тогда
			Возврат Неопределено;
		КонецЕсли;

		ВызватьИсключение;
	КонецПопытки;

КонецФункции

Процедура ПроверитьРезультат(Результат, ОжидаемоеЗначение, Статус, НомерСтроки, ИмяМетода, Несоответствия)

	Если ЕстьУчитываемаяОшибка(Статус) Тогда
		Если Результат <> Неопределено Тогда
			ДобавитьНесоответствие(
				Несоответствия,
				НомерСтроки,
				СтрШаблон("%1: ожидалась ошибка, получено '%2'", ИмяМетода, Результат)
			);
		КонецЕсли;

		Возврат;
	КонецЕсли;

	Если Результат <> ОжидаемоеЗначение Тогда
		ДобавитьНесоответствие(
			Несоответствия,
			НомерСтроки,
			СтрШаблон("%1: ожидалось '%2', получено '%3'", ИмяМетода, ОжидаемоеЗначение, Результат)
		);
	КонецЕсли;

КонецПроцедуры

Функция ЕстьУчитываемаяОшибка(Статус)

	Статус = СтрЗаменить(СтрЗаменить(Статус, "[", ""), "]", "");

	Если ПустаяСтрока(СокрЛП(Статус)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого КодОшибки Из СтрРазделить(Статус, ",", Ложь) Цикл
		КодОшибки = СокрЛП(КодОшибки);

		Если Не ИгнорируемаяОшибка(КодОшибки) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ИгнорируемаяОшибка(КодОшибки)

	// Параметры библиотеки: CheckHyphens=false, VerifyDnsLength=false, UseSTD3ASCIIRules=false.
	// X4_2 относится к пустой метке, которую допускает нестрогая обработка адресов WHATWG.
	Возврат КодОшибки = "V2"
		Или КодОшибки = "V3"
		Или КодОшибки = "A4_1"
		Или КодОшибки = "A4_2"
		Или КодОшибки = "X4_2"
		Или КодОшибки = "U1";

КонецФункции

Функция ЗначениеПоляИлиИсходное(Поле, ИсходноеЗначение)

	Если ПустаяСтрока(СокрЛП(Поле)) Тогда
		Возврат ИсходноеЗначение;
	КонецЕсли;

	Возврат ДекодироватьПоле(Поле);

КонецФункции

Функция ДекодироватьПоле(Поле)

	Поле = СокрЛП(Поле);

	Если Поле = """""" Тогда
		Возврат "";
	КонецЕсли;

	Фрагменты = Новый Массив;
	Позиция = 1;

	Пока Позиция <= СтрДлина(Поле) Цикл
		СимволПоля = Сред(Поле, Позиция, 1);

		Если СимволПоля <> "\" Тогда
			Фрагменты.Добавить(СимволПоля);
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Если Сред(Поле, Позиция + 1, 1) = "u" Тогда
			HexКод = Сред(Поле, Позиция + 2, 4);
			Позиция = Позиция + 6;
		ИначеЕсли Сред(Поле, Позиция + 1, 2) = "x{" Тогда
			НачалоКода = Позиция + 3;
			КонецКода = НачалоКода + СтрНайти(Сред(Поле, НачалоКода), "}") - 1;
			HexКод = Сред(Поле, Позиция + 3, КонецКода - Позиция - 3);
			Позиция = КонецКода + 1;
		Иначе
			Фрагменты.Добавить(СимволПоля);
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Код = ЧислоИзHexСтроки(HexКод);

		Если Код >= 55296 И Код <= 57343 Тогда
			// OneScript не гарантирует сохранение заведомо некорректных последовательностей UTF-16.
			Возврат Неопределено;
		КонецЕсли;

		ДобавитьСимволПоКоду(Фрагменты, Код);
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Функция ЧислоИзHexСтроки(HexСтрока)

	Результат = 0;

	Для Позиция = 1 По СтрДлина(HexСтрока) Цикл
		Код = КодСимвола(Сред(HexСтрока, Позиция, 1));
		// Коды ASCII: 0-9 - 48-57, A-F - 65-70, a-f - 97-102.
		Если Код >= 48 И Код <= 57 Тогда
			Цифра = Код - 48;
		ИначеЕсли Код >= 65 И Код <= 70 Тогда
			Цифра = Код - 55;
		Иначе
			Цифра = Код - 87;
		КонецЕсли;

		Результат = Результат * 16 + Цифра;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьСимволПоКоду(Фрагменты, Код)

	Если Код <= 65535 Тогда
		Фрагменты.Добавить(Символ(Код));
		Возврат;
	КонецЕсли;

	Код = Код - 65536;
	Фрагменты.Добавить(Символ(55296 + Цел(Код / 1024)));
	Фрагменты.Добавить(Символ(56320 + Код % 1024));

КонецПроцедуры

Процедура ДобавитьНесоответствие(Несоответствия, НомерСтроки, Описание)

	Если Несоответствия.Количество() < 30 Тогда
		Несоответствия.Добавить(СтрШаблон("Строка %1: %2", НомерСтроки, Описание));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
