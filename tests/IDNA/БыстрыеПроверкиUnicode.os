Процедура ПроверитьОшибкуПоврежденныхДанных(ИмяДействия)

	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, ИмяДействия),
		"idna.data.invalid"
	);

КонецПроцедуры

Процедура ПодготовитьЧитательПоврежденнойСекции(Идентификатор, Секция)

	_ИмяВременногоФайла = ПолучитьИмяВременногоФайла("bin");
	Контейнер = СформироватьКонтейнер(Идентификатор, Секция);
	Данные = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Контейнер);
	Данные.Записать(_ИмяВременногоФайла);
	_ЧитательДанных = Новый ЧитательДанныхIDNA(_ИмяВременногоФайла);

КонецПроцедуры

Процедура ПодготовитьЧитательПоврежденногоКаталога(ВидПовреждения)

	_ИмяВременногоФайла = ПолучитьИмяВременногоФайла("bin");
	Контейнер = СформироватьКонтейнер(1, СоздатьТаблицуСопоставлений(1));
	СмещениеПоследнейЗаписи = 16 + 8 * 44;

	Если ВидПовреждения = "ПовторяющийсяИдентификатор" Тогда
		Контейнер.ЗаписатьЦелое16(СмещениеПоследнейЗаписи, 1);
	ИначеЕсли ВидПовреждения = "НулевойИдентификатор" Тогда
		Контейнер.ЗаписатьЦелое16(СмещениеПоследнейЗаписи, 0);
	ИначеЕсли ВидПовреждения = "ИдентификаторЗаПределамиКаталога" Тогда
		Контейнер.ЗаписатьЦелое16(СмещениеПоследнейЗаписи, 10);
	ИначеЕсли ВидПовреждения = "НенулевыеЗарезервированныеБайты" Тогда
		Контейнер[СмещениеПоследнейЗаписи + 2] = 1;
	ИначеЕсли ВидПовреждения = "ПересекающиесяСекции" Тогда
		СмещениеПредыдущейЗаписи = СмещениеПоследнейЗаписи - 44;
		СмещениеПредыдущейСекции = Контейнер.ПрочитатьЦелое32(СмещениеПредыдущейЗаписи + 4);
		Контейнер.ЗаписатьЦелое32(СмещениеПоследнейЗаписи + 4, СмещениеПредыдущейСекции);
	ИначеЕсли ВидПовреждения = "ПромежутокМеждуСекциями" Тогда
		СмещениеПредыдущейЗаписи = СмещениеПоследнейЗаписи - 44;
		Контейнер.ЗаписатьЦелое32(СмещениеПредыдущейЗаписи + 8, 3);
	ИначеЕсли ВидПовреждения = "ЛишниеДанныеВКонце" Тогда
		Контейнер.ЗаписатьЦелое32(СмещениеПоследнейЗаписи + 8, 3);
	ИначеЕсли ВидПовреждения = "НулеваяДлинаСекции" Тогда
		Контейнер.ЗаписатьЦелое32(СмещениеПоследнейЗаписи + 8, 0);
	КонецЕсли;

	Данные = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Контейнер);
	Данные.Записать(_ИмяВременногоФайла);
	_ЧитательДанных = Новый ЧитательДанныхIDNA(_ИмяВременногоФайла);

КонецПроцедуры

Функция СформироватьКонтейнер(Идентификатор, ПоврежденнаяСекция)

	КоличествоСекций = 9;
	РазмерЗаголовка = 16;
	РазмерЗаписиКаталога = 44;
	СмещениеДанных = РазмерЗаголовка + КоличествоСекций * РазмерЗаписиКаталога;
	Секции = Новый Массив;
	РазмерКонтейнера = СмещениеДанных;

	Для НомерСекции = 1 По КоличествоСекций Цикл
		Секция = ?(НомерСекции = Идентификатор, ПоврежденнаяСекция, Новый БуферДвоичныхДанных(4));
		Секции.Добавить(Секция);
		РазмерКонтейнера = РазмерКонтейнера + Секция.Размер;
	КонецЦикла;

	Контейнер = Новый БуферДвоичныхДанных(РазмерКонтейнера);
	Контейнер.ЗаписатьЦелое32(0, 826426441); // ASCII: IDB1.
	Контейнер.ЗаписатьЦелое16(4, 2);
	Контейнер.ЗаписатьЦелое16(6, РазмерЗаписиКаталога);
	Контейнер.ЗаписатьЦелое32(8, КоличествоСекций);
	Контейнер.ЗаписатьЦелое32(12, СмещениеДанных);

	Для Индекс = 0 По Секции.ВГраница() Цикл
		Секция = Секции[Индекс];
		СмещениеЗаписи = РазмерЗаголовка + Индекс * РазмерЗаписиКаталога;
		Контейнер.ЗаписатьЦелое16(СмещениеЗаписи, Индекс + 1);
		Контейнер.ЗаписатьЦелое32(СмещениеЗаписи + 4, СмещениеДанных);
		Контейнер.ЗаписатьЦелое32(СмещениеЗаписи + 8, Секция.Размер);
		Контейнер.Записать(СмещениеЗаписи + 12, ВычислитьSHA256(Секция));
		Контейнер.Записать(СмещениеДанных, Секция);
		СмещениеДанных = СмещениеДанных + Секция.Размер;
	КонецЦикла;

	Возврат Контейнер;

КонецФункции

Функция СоздатьТаблицуСопоставлений(КодСтатуса, КоличествоТочек = 0)

	Таблица = Новый БуферДвоичныхДанных(32 + КоличествоТочек * 4);
	Таблица.ЗаписатьЦелое32(0, 827212873); // ASCII: IDN1.
	Таблица.ЗаписатьЦелое16(4, 1);
	Таблица.ЗаписатьЦелое16(6, 16);
	Таблица.ЗаписатьЦелое32(8, 1);
	Таблица.ЗаписатьЦелое32(12, 32);
	Таблица[24] = КодСтатуса;
	Таблица.ЗаписатьЦелое16(26, КоличествоТочек);

	Возврат Таблица;

КонецФункции

Функция СоздатьЗаписьНормализации(КодоваяТочка, Класс)

	Таблица = Новый БуферДвоичныхДанных(20);
	Таблица.ЗаписатьЦелое32(0, 1);
	Таблица.ЗаписатьЦелое32(4, 20);
	Таблица.ЗаписатьЦелое32(8, КодоваяТочка);
	Таблица.ЗаписатьЦелое16(12, Класс);
	Возврат Таблица;

КонецФункции

Функция СоздатьСекциюСОдиночнымСуррогатом(Идентификатор)

	Если Идентификатор = 2 Тогда
		Возврат СоздатьЗаписьНормализации(55296, 0);
	КонецЕсли;

	Размер = ?(Идентификатор = 4, 12, 8);
	Таблица = Новый БуферДвоичныхДанных(Размер);
	Таблица.ЗаписатьЦелое32(0, 1);
	Таблица.ЗаписатьЦелое32(4, 55296);

	Если Идентификатор = 4 Тогда
		Таблица.ЗаписатьЦелое16(8, 230);
	КонецЕсли;

	Возврат Таблица;

КонецФункции

Функция СоздатьДиапазонСОдиночнымСуррогатом(Идентификатор)

	Размер = ?(Идентификатор = 3 Или Идентификатор = 8, 12, 16);
	Таблица = Новый БуферДвоичныхДанных(Размер);
	Таблица.ЗаписатьЦелое32(0, 1);
	Таблица.ЗаписатьЦелое32(4, 55296);
	Таблица.ЗаписатьЦелое32(8, 55296);

	Если Размер = 16 Тогда
		Таблица[12] = 1;
	КонецЕсли;

	Возврат Таблица;

КонецФункции

Функция ВычислитьSHA256(Буфер)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер));
	Возврат ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Хеширование.ХешСумма);

КонецФункции

#КонецОбласти
