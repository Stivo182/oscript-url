#Использовать asserts
#Использовать errors
#Использовать "../../src"

Перем _ЧитательДанных; // ЧитательДанныхIDNA

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

КонецПроцедуры

&ПередВсеми
Процедура ПередВсемиТестами() Экспорт

	_ЧитательДанных = Новый ЧитательДанныхIDNA;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПредоставлятьПредметныйДоступКСекциямUnicode() Экспорт

	// Действие
	Сопоставления = _ЧитательДанных.ПолучитьСопоставления();
	ПроверкаNFC = _ЧитательДанных.ПолучитьБыструюПроверкуNFC();
	КлассыКомбинирования = _ЧитательДанных.ПолучитьКлассыКомбинирования();
	КатегорииМеток = _ЧитательДанных.ПолучитьКатегорииМеток();
	НаправленияДоменов = _ЧитательДанных.ПолучитьНаправленияДоменов();

	// Проверка
	Ожидаем.Что(Сопоставления.ПрочитатьЦелое32(0)).Равно(827212873); // ASCII: IDN1.
	Ожидаем.Что(ПроверкаNFC.Размер > 4).Равно(Истина);
	Ожидаем.Что(КлассыКомбинирования.Размер > 4).Равно(Истина);
	Ожидаем.Что(КатегорииМеток.Размер > 4).Равно(Истина);
	Ожидаем.Что(НаправленияДоменов.Размер > 4).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоставлятьДвоичныйКонтейнерДанныхIDNA() Экспорт

	// Подготовка
	КаталогИсходников = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "src");
	ИмяФайла = ОбъединитьПути(КаталогИсходников, "internal", "Данные", "ДанныеIDNA.bin");

	// Действие
	Данные = Новый ДвоичныеДанные(ИмяФайла);
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);

	// Проверка
	Ожидаем.Что(Буфер.Размер > 16).Равно(Истина);
	Ожидаем.Что(Буфер.ПрочитатьЦелое32(0)).Равно(826426441); // ASCII: IDB1.
	Ожидаем.Что(Буфер.ПрочитатьЦелое16(4)).Равно(2);
	Ожидаем.Что(Буфер.ПрочитатьЦелое16(6)).Равно(44);
	Ожидаем.Что(Буфер.ПрочитатьЦелое32(8)).Равно(9);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоставлятьЛицензиюUnicodeВМодулеДанных() Экспорт

	// Подготовка
	КаталогИсходников = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "src");
	ИмяФайла = ОбъединитьПути(КаталогИсходников, "internal", "Классы", "ЧитательДанныхIDNA.os");
	Чтение = Новый ЧтениеТекста(ИмяФайла);

	// Действие
	ТекстМодуля = Чтение.Прочитать();
	Чтение.Закрыть();

	// Проверка
	Ожидаем.Что(СтрНайти(ТекстМодуля, "UNICODE LICENSE V3") > 0).Равно(Истина);
	Ожидаем.Что(СтрНайти(ТекстМодуля, "Copyright © 1991-2026 Unicode, Inc.") > 0).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеГенерироватьЧитательДанныхИзШаблона() Экспорт

	// Подготовка
	КореньПроекта = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..");
	ИмяШаблона = ОбъединитьПути(КореньПроекта, "tools", "Шаблоны", "ЧитательДанныхIDNA.os");
	КаталогКлассов = ОбъединитьПути(КореньПроекта, "src", "internal", "Классы");
	ИмяЧитателя = ОбъединитьПути(КаталогКлассов, "ЧитательДанныхIDNA.os");
	ИмяГенератора = ОбъединитьПути(КореньПроекта, "tools", "СформироватьДанныеIDNA.os");

	// Действие
	ШаблонСуществует = Новый Файл(ИмяШаблона).Существует();
	ТекстЧитателя = ПрочитатьТекстовыйФайл(ИмяЧитателя);
	ТекстГенератора = ПрочитатьТекстовыйФайл(ИмяГенератора);

	// Проверка
	Ожидаем.Что(ШаблонСуществует).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(ТекстЧитателя, "Функция ВерсияUnicode()") = 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТекстГенератора, "ЗаписатьМодульДанных") = 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСтруктурированнуюОшибкуДляНедоступныхДанных() Экспорт

	// Подготовка
	НесуществующийФайл = ОбъединитьПути(ТекущийСценарий().Каталог, "ОтсутствующиеДанныеIDNA.bin");
	Читатель = Новый ЧитательДанныхIDNA(НесуществующийФайл);

	// Действие
	Попытка
		Читатель.ПолучитьСопоставления();
	Исключение
		КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Проверка
	Ожидаем.Что(КодОшибки).Равно(КодыОшибокURL.НедопустимыеДанныеIDNA());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьТекстовыйФайл(ИмяФайла)

	Чтение = Новый ЧтениеТекста(ИмяФайла);
	Результат = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

#КонецОбласти
