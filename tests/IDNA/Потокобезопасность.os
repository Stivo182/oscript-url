#Использовать asserts
#Использовать "../../src"

Перем _БлокировкаСтарта; // БлокировкаРесурса
Перем _КоличествоГотовых; // Число
Перем _НачатьПроверку; // Булево

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

КонецПроцедуры

&ПередВсеми
Процедура ПередВсемиТестами() Экспорт

	_БлокировкаСтарта = Новый БлокировкаРесурса;
	_КоличествоГотовых = 0;
	_НачатьПроверку = Ложь;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПотокобезопасноИнициализироватьТаблицыUnicode() Экспорт

	// Подготовка
	КоличествоЗаданий = 12;
	Менеджер = Новый МенеджерФоновыхЗаданий;
	Задания = Новый Массив;

	Для НомерЗадания = 0 По КоличествоЗаданий - 1 Цикл
		Параметры = Новый Массив;
		Параметры.Добавить(НомерЗадания);
		Задания.Добавить(Менеджер.Выполнить(ЭтотОбъект, "ПроверитьIDNAВПотоке", Параметры, Истина));
	КонецЦикла;

	ДождатьсяГотовностиЗаданий(КоличествоЗаданий);

	// Действие
	РазрешитьПроверку();
	Менеджер.ОжидатьЗавершенияЗадач();

	// Проверка
	Для Каждого Задание Из Задания Цикл
		Ожидаем.Что(Задание.Результат).Равно(Истина);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьIDNAВПотоке(НомерЗадания) Экспорт

	СообщитьОГотовности();
	ДождатьсяРазрешенияПроверки();

	ВариантПроверки = НомерЗадания % 4;

	Если ВариантПроверки = 0 Тогда
		Возврат ОбработкаДоменовIDNA.КодироватьДомен("пример.рф") = "xn--e1afmkfd.xn--p1ai";
	ИначеЕсли ВариантПроверки = 1 Тогда
		Возврат НормализацияСтрокUnicode.ПривестиКNFC("ü") = "ü";
	ИначеЕсли ВариантПроверки = 2 Тогда
		Возврат ОбработкаДоменовIDNA.КодироватьДомен("مثال") <> Неопределено;
	Иначе
		Возврат ОбработкаДоменовIDNA.КодироватьДомен("a" + Символ(8204) + "b") = Неопределено;
	КонецЕсли;

КонецФункции

Процедура ДождатьсяГотовностиЗаданий(КоличествоЗаданий)

	Для НомерПопытки = 1 По 10000 Цикл
		_БлокировкаСтарта.Заблокировать();
		ВсеГотовы = _КоличествоГотовых = КоличествоЗаданий;
		_БлокировкаСтарта.Разблокировать();

		Если ВсеГотовы Тогда
			Возврат;
		КонецЕсли;

		Приостановить(1);
	КонецЦикла;

	ВызватьИсключение "Не все фоновые задания подготовились к проверке";

КонецПроцедуры

Процедура СообщитьОГотовности()

	_БлокировкаСтарта.Заблокировать();
	_КоличествоГотовых = _КоличествоГотовых + 1;
	_БлокировкаСтарта.Разблокировать();

КонецПроцедуры

Процедура ДождатьсяРазрешенияПроверки()

	Пока Истина Цикл
		_БлокировкаСтарта.Заблокировать();
		НачатьПроверку = _НачатьПроверку;
		_БлокировкаСтарта.Разблокировать();

		Если НачатьПроверку Тогда
			Возврат;
		КонецЕсли;

		Приостановить(1);
	КонецЦикла;

КонецПроцедуры

Процедура РазрешитьПроверку()

	_БлокировкаСтарта.Заблокировать();
	_НачатьПроверку = Истина;
	_БлокировкаСтарта.Разблокировать();

КонецПроцедуры

#КонецОбласти
