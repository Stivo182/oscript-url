#Использовать asserts
#Использовать "../../src"

Перем _ЧитательДанных; // ЧитательДанныхIDNA

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

КонецПроцедуры

&ПередВсеми
Процедура ПередВсемиТестами() Экспорт

	_ЧитательДанных = Новый ЧитательДанныхIDNA;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("ü", "ü")
&ИсточникЗначение("Å", "Å")
&ИсточникЗначение("가", "가")
&ИсточникЗначение("😀", "😀")
Процедура ТестДолжен_ПривестиСтрокуККаноническойФормеNFC(Значение, ОжидаемоеЗначение) Экспорт

	// Действие
	Результат = НормализацияСтрокUnicode.ПривестиКNFC(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемоеЗначение);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСоставлятьИсключенныеКомбинируемыеПоследовательности() Экспорт

	// Подготовка
	ПроверяемыеЗначения = Новый Массив;
	ДобавитьПроверяемоеЗначение(ПроверяемыеЗначения, 836, 776, 769);
	ДобавитьПроверяемоеЗначение(ПроверяемыеЗначения, 3955, 3953, 3954);
	ДобавитьПроверяемоеЗначение(ПроверяемыеЗначения, 3957, 3953, 3956);
	ДобавитьПроверяемоеЗначение(ПроверяемыеЗначения, 3969, 3953, 3968);

	// Действие и Проверка
	Для Каждого ПроверяемоеЗначение Из ПроверяемыеЗначения Цикл
		Результат = НормализацияСтрокUnicode.ПривестиКNFC(ПроверяемоеЗначение.ИсходнаяСтрока);
		Ожидаем.Что(Результат).Равно(ПроверяемоеЗначение.ОжидаемаяСтрока);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ХранитьПолныеИсключенияКаноническойКомпозиции() Экспорт

	// Действие
	Исключения = _ЧитательДанных.ПолучитьИсключенияКомпозиции();

	// Проверка
	Ожидаем.Что(СодержитКодовуюТочку(Исключения, 835)).Равно(Истина);
	Ожидаем.Что(СодержитКодовуюТочку(Исключения, 3955)).Равно(Истина);
	Ожидаем.Что(СодержитКодовуюТочку(Исключения, 3957)).Равно(Истина);
	Ожидаем.Что(СодержитКодовуюТочку(Исключения, 3969)).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоответствоватьНормативнымПримерамNFC() Экспорт

	// Подготовка
	ИмяФайла = ОбъединитьПути(ТекущийКаталог(), "tests/fixtures/idna/NormalizationTest.txt");
	Несоответствия = Новый Массив;

	// Действие
	Количество = ПроверитьНормативныеПримерыNFC(ИмяФайла, Несоответствия);
	ХешСоответствует = ХешФайла(ИмяФайла)
		= "5019FFD530751A741900C849C0E010332F142A3612234639BD200B82138A87DB";

	// Проверка
	Ожидаем.Что(ХешСоответствует).Равно(Истина);
	Ожидаем.Что(Количество).Больше(20000);
	Ожидаем.Что(СтрСоединить(Несоответствия, Символы.ПС)).Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СодержитКодовуюТочку(Таблица, КодоваяТочка)

	Для Индекс = 0 По Таблица.ПрочитатьЦелое32(0) - 1 Цикл
		Смещение = 4 + Индекс * 8;

		Если КодоваяТочка >= Таблица.ПрочитатьЦелое32(Смещение)
			И КодоваяТочка <= Таблица.ПрочитатьЦелое32(Смещение + 4) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ПроверитьНормативныеПримерыNFC(ИмяФайла, Несоответствия)

	Чтение = Новый ЧтениеТекста(ИмяФайла);
	Количество = 0;

	Пока Истина Цикл
		СтрокаТеста = Чтение.ПрочитатьСтроку();

		Если СтрокаТеста = Неопределено Тогда
			Прервать;
		КонецЕсли;

		ПозицияКомментария = СтрНайти(СтрокаТеста, "#");

		Если ПозицияКомментария > 0 Тогда
			СтрокаТеста = Лев(СтрокаТеста, ПозицияКомментария - 1);
		КонецЕсли;

		Поля = СтрРазделить(СтрокаТеста, ";", Истина);

		Если Поля.Количество() < 5 Тогда
			Продолжить;
		КонецЕсли;

		C1 = СтрокаИзHexКодов(Поля[0]);
		C2 = СтрокаИзHexКодов(Поля[1]);
		C3 = СтрокаИзHexКодов(Поля[2]);
		C4 = СтрокаИзHexКодов(Поля[3]);
		C5 = СтрокаИзHexКодов(Поля[4]);
		ПроверитьNFC(C1, C2, Количество, "c1", Несоответствия);
		ПроверитьNFC(C2, C2, Количество, "c2", Несоответствия);
		ПроверитьNFC(C3, C2, Количество, "c3", Несоответствия);
		ПроверитьNFC(C4, C4, Количество, "c4", Несоответствия);
		ПроверитьNFC(C5, C4, Количество, "c5", Несоответствия);
		Количество = Количество + 1;
	КонецЦикла;

	Чтение.Закрыть();
	Возврат Количество;

КонецФункции

Процедура ПроверитьNFC(Исходное, Ожидаемое, Номер, Поле, Несоответствия)

	Если НормализацияСтрокUnicode.ПривестиКNFC(Исходное) <> Ожидаемое И Несоответствия.Количество() < 20 Тогда
		Несоответствия.Добавить(СтрШаблон("Пример %1, поле %2", Номер, Поле));
	КонецЕсли;

КонецПроцедуры

Функция ХешФайла(ИмяФайла)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.ДобавитьФайл(ИмяФайла);
	Возврат ВРег(Хеширование.ХешСуммаСтрокой);

КонецФункции

Функция СтрокаИзHexКодов(Поле)

	Фрагменты = Новый Массив;

	Для Каждого HexКод Из СтрРазделить(СокрЛП(Поле), " ", Ложь) Цикл
		ДобавитьСимволПоКоду(Фрагменты, ЧислоИзHexСтроки(HexКод));
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Функция ЧислоИзHexСтроки(HexСтрока)

	Результат = 0;

	Для Позиция = 1 По СтрДлина(HexСтрока) Цикл
		Код = КодСимвола(Сред(HexСтрока, Позиция, 1));
		// Коды ASCII: 0-9 - 48-57, A-F - 65-70.
		Цифра = ?(Код <= 57, Код - 48, Код - 55);
		Результат = Результат * 16 + Цифра;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьСимволПоКоду(Фрагменты, Код)

	Если Код <= 65535 Тогда
		Фрагменты.Добавить(Символ(Код));
		Возврат;
	КонецЕсли;

	Код = Код - 65536;
	Фрагменты.Добавить(Символ(55296 + Цел(Код / 1024)));
	Фрагменты.Добавить(Символ(56320 + Код % 1024));

КонецПроцедуры

Процедура ДобавитьПроверяемоеЗначение(ПроверяемыеЗначения, ИсходныйКод, ПервыйКод, ВторойКод)

	ПроверяемоеЗначение = Новый Структура;
	ПроверяемоеЗначение.Вставить("ИсходнаяСтрока", Символ(ИсходныйКод));
	ПроверяемоеЗначение.Вставить("ОжидаемаяСтрока", Символ(ПервыйКод) + Символ(ВторойКод));
	ПроверяемыеЗначения.Добавить(ПроверяемоеЗначение);

КонецПроцедуры

#КонецОбласти
