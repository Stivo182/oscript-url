&ИсточникЗначение("%80")
&ИсточникЗначение("%F5%80%80%80")
&ИсточникЗначение("%FF")
&ИсточникЗначение("%E0%80%80")
&ИсточникЗначение("%F0%80%80%80")
&ИсточникЗначение("%E1%80%41")
&ИсточникЗначение("%F1%80%80%41")
&ИсточникЗначение("%E1")
&ИсточникЗначение("%E1%80")
&ИсточникЗначение("%F1")
&ИсточникЗначение("%F1%80")
&ИсточникЗначение("%F1%80%80")
&ИсточникЗначение("%ED%A0%80")
&ИсточникЗначение("%F4%90%80%80")
Процедура ТестДолжен_ОтклонятьНекорректныйUTF8(Значение) Экспорт

	_ЗначениеДляОшибки = Значение;

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "ДекодироватьНекорректныйUTF8"),
		"encoding.invalid"
	);

КонецПроцедуры

