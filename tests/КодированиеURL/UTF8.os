Перем _ЗначениеДляОшибки; // Строка

#Область Тесты

&Тест
Процедура ТестДолжен_ДекодироватьПроцентныеБайтыБезПроверкиUTF8() Экспорт

	// Действие
	Результат = КодированиеURL.ДекодироватьВБайты("A%FF");

	// Проверка
	Ожидаем.Что(Base64Строка(Результат)).Равно("Qf8=");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("%00%7f%ff", "007FFF")
&ИсточникЗначение("A%00%7fB%ff", "41007F42FF")
Процедура ТестДолжен_СохранятьГраницыИБуквальныйASCIIПриДекодированииБайтов(
	Значение,
	ОжидаемаяHexСтрока
) Экспорт

	// Действие
	Данные = КодированиеURL.ДекодироватьВБайты(Значение);

	// Проверка
	Ожидаем.Что(ПолучитьHexСтрокуИзДвоичныхДанных(Данные)).Равно(ОжидаемаяHexСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("%")
&ИсточникЗначение("%1")
&ИсточникЗначение("%ZZ")
Процедура ТестДолжен_ОтклонятьНекорректноеПроцентноеКодирование(Значение) Экспорт

	_ЗначениеДляОшибки = Значение;

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "ДекодироватьНекорректноеПроцентноеКодирование"),
		"url.invalid_percent_encoding"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонятьНеASCIIСтрокуПриДекодированииБайтов() Экспорт

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
