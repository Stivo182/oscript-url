КонецПроцедуры

&Тест
Процедура ТестДолжен_ДекодироватьКорректныйUTF8() Экспорт

	// Действие
	Результат = КодированиеURL.ДекодироватьUTF8("%D0%A4%F0%9F%98%80");

	// Проверка
	Ожидаем.Что(Результат).Равно("Ф😀");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("%C2%80", "C280")
&ИсточникЗначение("%DF%BF", "DFBF")
&ИсточникЗначение("%E0%A0%80", "E0A080")
&ИсточникЗначение("%ED%9F%BF", "ED9FBF")
&ИсточникЗначение("%F0%90%80%80", "F0908080")
&ИсточникЗначение("%F4%8F%BF%BF", "F48FBFBF")
Процедура ТестДолжен_ДекодироватьГраничныеКорректныеПоследовательностиUTF8(
	Значение,
	ОжидаемаяHexСтрока
) Экспорт

	// Действие
	Результат = КодированиеURL.ДекодироватьUTF8(Значение);
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Результат, КодировкаТекста.UTF8, Ложь);

	// Проверка
	Ожидаем.Что(ПолучитьHexСтрокуИзДвоичныхДанных(Данные)).Равно(ОжидаемаяHexСтрока);

КонецПроцедуры

