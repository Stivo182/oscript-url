#Использовать asserts
#Использовать "../../src"
#Использовать "../fixtures"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("a + b", "a+%2B+b")
&ИсточникЗначение("AZaz09*-._", "AZaz09*-._")
&ИсточникЗначение("~!()'%Ф", "%7E%21%28%29%27%25%D0%A4")
Процедура ТестДолжен_КодироватьПараметрФормы(Значение, ОжидаемоеЗначение) Экспорт

	// Действие
	Результат = КодированиеURL.КодироватьПараметрФормы(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемоеЗначение);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("a+%2B+b", "a + b")
&ИсточникЗначение("%FF", "�")
&ИсточникЗначение("%C0%AF", "��")
&ИсточникЗначение("%", "%")
&ИсточникЗначение("%ZZ", "%ZZ")
Процедура ТестДолжен_ФорсированноДекодироватьПараметрФормы(Значение, ОжидаемоеЗначение) Экспорт

	// Действие
	Результат = КодированиеURL.ДекодироватьПараметрФормы(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемоеЗначение);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Ф", "Ф")
&ИсточникЗначение("Ф%20a", "Ф a")
Процедура ТестДолжен_ДекодироватьRawUnicodeВПараметреФормы(Значение, ОжидаемоеЗначение) Экспорт

	// Действие
	Результат = КодированиеURL.ДекодироватьПараметрФормы(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемоеЗначение);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранятьНачальныйBOMПриДекодированииПараметраФормы() Экспорт

	// Действие
	Результат = КодированиеURL.ДекодироватьПараметрФормы("%EF%BB%BFa");
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Результат, КодировкаТекста.UTF8, Ложь);

	// Проверка
	Ожидаем.Что(ПолучитьHexСтрокуИзДвоичныхДанных(Данные)).Равно("EFBBBF61");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонятьНедопустимыеТипыВFormAPI() Экспорт

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "КодироватьФормуСNull"),
		"argument.invalid_type"
	);
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "ДекодироватьФормуСНеопределено"),
		"argument.invalid_type"
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура КодироватьФормуСNull() Экспорт

	КодированиеURL.КодироватьПараметрФормы(Null);

КонецПроцедуры

Процедура ДекодироватьФормуСНеопределено() Экспорт

	КодированиеURL.ДекодироватьПараметрФормы(Неопределено);

КонецПроцедуры

#КонецОбласти
