#Использовать asserts
#Использовать "../../src"
#Использовать "../fixtures"

#Область Тесты

&Тест
Процедура ТестДолжен_ОбратимоКодироватьВсеЗначимыеСимволыСегмента() Экспорт

	// Подготовка
	ИсходнаяСтрока = "AZaz09-._~!$&'()*+,;=:@/?#% Ф";

	// Действие
	КодированнаяСтрока = КодированиеURL.КодироватьСегментПути(ИсходнаяСтрока);
	ДекодированнаяСтрока = КодированиеURL.ДекодироватьUTF8(КодированнаяСтрока);

	// Проверка
	Ожидаем.Что(ДекодированнаяСтрока).Равно(ИсходнаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КодироватьСегментПутиПоRFC3986() Экспорт

	// Подготовка
	Значение = "AZaz09-._~!$&'()*+,;=:@/?#% Ф";

	// Действие
	Результат = КодированиеURL.КодироватьСегментПути(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно("AZaz09-._~!$&'()*+,;=:@%2F%3F%23%25%20%D0%A4");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КодироватьПутьПоRFC3986() Экспорт

	// Подготовка
	Значение = "/a b/:@?%#";

	// Действие
	Результат = КодированиеURL.КодироватьПуть(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно("/a%20b/:@%3F%25%23");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("q=a+b#c", "q=a+b%23c")
&ИсточникЗначение("/:@?%#", "/:@?%25%23")
Процедура ТестДолжен_КодироватьСтрокуЗапросаИФрагментПоRFC3986(
	Значение, ОжидаемоеЗначение
) Экспорт

	// Действие и Проверка
	Ожидаем.Что(КодированиеURL.КодироватьСтрокуЗапроса(Значение)).Равно(ОжидаемоеЗначение);
	Ожидаем.Что(КодированиеURL.КодироватьФрагмент(Значение)).Равно(ОжидаемоеЗначение);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КодироватьДанныеПользователяПоRFC3986() Экспорт

	// Подготовка
	Значение = "AZaz09-._~!$&'()*+,;=:@/?#%";

	// Действие
	Результат = КодированиеURL.КодироватьДанныеПользователя(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно("AZaz09-._~!$&'()*+,;=:%40%2F%3F%23%25");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КодироватьUnicodeВЗапросеИФрагменте() Экспорт

	// Действие и Проверка
	Ожидаем.Что(КодированиеURL.КодироватьСтрокуЗапроса("Ф")).Равно("%D0%A4");
	Ожидаем.Что(КодированиеURL.КодироватьФрагмент("Ф")).Равно("%D0%A4");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КодироватьИмяПользователяПоRFC3986() Экспорт

	// Подготовка
	Значение = "AZaz09-._~!$&'()*+,;=:@";

	// Действие
	Результат = КодированиеURL.КодироватьИмяПользователя(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно("AZaz09-._~!$&'()*+,;=%3A%40");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КодироватьПарольПоRFC3986() Экспорт

	// Подготовка
	Значение = "AZaz09-._~!$&'()*+,;=:@";

	// Действие
	Результат = КодированиеURL.КодироватьПароль(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно("AZaz09-._~!$&'()*+,;=:%40");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонятьNullВИнтерфейсеКодирования() Экспорт

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "КодироватьСегментСNull"),
		"argument.invalid_type"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонятьНеопределеноВИнтерфейсеКодирования() Экспорт

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "КодироватьПутьСНеопределено"),
		"argument.invalid_type"
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура КодироватьСегментСNull() Экспорт

	КодированиеURL.КодироватьСегментПути(Null);

КонецПроцедуры

Процедура КодироватьПутьСНеопределено() Экспорт

	КодированиеURL.КодироватьПуть(Неопределено);

КонецПроцедуры

#КонецОбласти
