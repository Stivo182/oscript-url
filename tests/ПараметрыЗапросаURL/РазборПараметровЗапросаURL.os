#Использовать "../fixtures"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("a=1", "a=1")
&ИсточникЗначение("a=1&a=2", "a=1&a=2")
&ИсточникЗначение("a=1&&b=2&", "a=1&b=2")
&ИсточникЗначение("&&", "")
&ИсточникЗначение("flag", "flag=")
&ИсточникЗначение("flag=", "flag=")
&ИсточникЗначение("a=%", "a=%25")
&ИсточникЗначение("a=%ZZ", "a=%25ZZ")
&ИсточникЗначение("a=%FF", "a=%EF%BF%BD")
&ИсточникЗначение("q=a+b", "q=a+b")
&ИсточникЗначение("q=a%2Bb", "q=a%2Bb")
Процедура ТестДолжен_РазбиратьВходы(Вход, Ожидание) Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL(Вход);

	// Действие
	ФактическаяСтрока = Параметры.ВСтроку();

	// Проверка
	Ожидаем.Что(ФактическаяСтрока)
		.Равно(Ожидание);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропускатьПустыеЧастиФормы() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL("&&");

	// Действие
	Количество = Параметры.Количество();
	Значение = Параметры.Получить("отсутствует");

	// Проверка
	Ожидаем.Что(Количество).Равно(0);
	Ожидаем.Что(Значение).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("СоздатьСNull")
&ИсточникЗначение("СоздатьСНеопределено")
&ИсточникЗначение("СоздатьСНевернымВладельцем")
&ИсточникЗначение("ЕстьСNull")
&ИсточникЗначение("ЕстьСНеопределено")
&ИсточникЗначение("ПолучитьСNull")
&ИсточникЗначение("ПолучитьСНеопределено")
&ИсточникЗначение("ПолучитьВсеСNull")
&ИсточникЗначение("ПолучитьВсеСНеопределено")
&ИсточникЗначение("ДобавитьИмяСNull")
&ИсточникЗначение("ДобавитьИмяСНеопределено")
&ИсточникЗначение("ДобавитьЗначениеСNull")
&ИсточникЗначение("ДобавитьЗначениеСНеопределено")
&ИсточникЗначение("УстановитьИмяСNull")
&ИсточникЗначение("УстановитьИмяСНеопределено")
&ИсточникЗначение("УстановитьЗначениеСNull")
&ИсточникЗначение("УстановитьЗначениеСНеопределено")
&ИсточникЗначение("УдалитьСNull")
&ИсточникЗначение("УдалитьСНеопределено")
Процедура ТестДолжен_ОтклонятьНеверныеТипы(ИмяМетода) Экспорт

	// Подготовка
	Действие = Новый Действие(ЭтотОбъект, ИмяМетода);

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Действие,
		"argument.invalid_type"
	);

КонецПроцедуры

#КонецОбласти

