#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьСтроковыеЗначенияФорматов() Экспорт

	// Действие
	RFC3986 = ФорматыПараметровЗапросаURL.RFC3986();
	ВебФорма = ФорматыПараметровЗапросаURL.ВебФорма();

	// Проверка
	Ожидаем.Что(RFC3986).Равно("RFC3986");
	Ожидаем.Что(ВебФорма).Равно("FormUrlEncoded");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьRFC3986ПоУмолчанию() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL;
	Параметры.Добавить("q", "hello world");

	// Действие
	Результат = Параметры.ВСтроку();

	// Проверка
	Ожидаем.Что(Результат).Равно("q=hello%20world");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НормализоватьПараметрБезЗначенияВебФормы() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL(
		Неопределено,
		ФорматыПараметровЗапросаURL.ВебФорма()
	);

	// Действие
	Параметры.Добавить("flag");

	// Проверка
	Ожидаем.Что(Параметры.Получить("flag")).Равно("");
	Ожидаем.Что(Параметры.ВСтроку()).Равно("flag=");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьФорматВНезависимойКопииURL() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/?q=hello+world");
	Адрес.ПараметрыЗапроса().РазобратьКак(
		ФорматыПараметровЗапросаURL.ВебФорма()
	);

	// Действие
	Копия = Адрес.Скопировать();
	Копия.ПараметрыЗапроса().Добавить("copy", "two words");

	// Проверка
	Ожидаем.Что(Копия.ВСтроку()).Равно(
		"https://example.com/?q=hello+world&copy=two+words"
	);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://example.com/?q=hello+world");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьФорматВКонструктореКопииURL() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/?q=hello+world");
	Адрес.ПараметрыЗапроса().РазобратьКак(
		ФорматыПараметровЗапросаURL.ВебФорма()
	);

	// Действие
	Копия = Новый URL(Адрес);
	Копия.ПараметрыЗапроса().Добавить("copy", "two words");

	// Проверка
	Ожидаем.Что(Копия.ВСтроку()).Равно(
		"https://example.com/?q=hello+world&copy=two+words"
	);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://example.com/?q=hello+world");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьФорматПриНормализацииURL() Экспорт

	// Подготовка
	Адрес = Новый URL("HTTPS://EXAMPLE.COM/a/../?q=hello+world");
	Адрес.ПараметрыЗапроса().РазобратьКак(
		ФорматыПараметровЗапросаURL.ВебФорма()
	);

	// Действие
	Результат = Адрес.НормализованныйДляСхемы();
	Результат.ПараметрыЗапроса().Добавить("page", "two words");

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно(
		"https://example.com/?q=hello+world&page=two+words"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НаследоватьФорматИсточникаЗапросаПриРазрешении() Экспорт

	// Подготовка
	База = Новый URL("https://example.com/a/?base=hello+world");
	База.ПараметрыЗапроса().РазобратьКак(
		ФорматыПараметровЗапросаURL.ВебФорма()
	);
	Ссылка = Новый URL("?ref=two+words");
	Ссылка.ПараметрыЗапроса().РазобратьКак(
		ФорматыПараметровЗапросаURL.ВебФорма()
	);

	// Действие
	ИзБазы = База.Разрешить("#part");
	ИзСсылки = База.Разрешить(Ссылка);
	ИзБазы.ПараметрыЗапроса().Добавить("next", "a b");
	ИзСсылки.ПараметрыЗапроса().Добавить("next", "a b");

	// Проверка
	Ожидаем.Что(ИзБазы.ВСтроку()).Равно(
		"https://example.com/a/?base=hello+world&next=a+b#part"
	);
	Ожидаем.Что(ИзСсылки.ВСтроку()).Равно(
		"https://example.com/a/?ref=two+words&next=a+b"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьФорматЦелиПриРелятивизации() Экспорт

	// Подготовка
	База = Новый URL("https://example.com/a/");
	Цель = Новый URL("https://example.com/a/b?q=hello+world");
	Цель.ПараметрыЗапроса().РазобратьКак(
		ФорматыПараметровЗапросаURL.ВебФорма()
	);

	// Действие
	Результат = База.СделатьОтносительным(Цель);
	Результат.ПараметрыЗапроса().Добавить("next", "a b");

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно("b?q=hello+world&next=a+b");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СкопироватьПарыИФорматВURL() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/?old=1");
	ПараметрыАдреса = Адрес.ПараметрыЗапроса();
	Источник = Новый ПараметрыЗапросаURL(
		"q=hello+world",
		ФорматыПараметровЗапросаURL.ВебФорма()
	);

	// Действие
	Адрес.УстановитьПараметрыЗапроса(Источник);
	ПараметрыАдреса.Добавить("page", "two words");

	// Проверка
	Ожидаем.Что(Адрес.ПараметрыЗапроса()).Идентично(ПараметрыАдреса);
	Ожидаем.Что(Адрес.ВСтроку()).Равно(
		"https://example.com/?q=hello+world&page=two+words"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СвязатьОдинОбъектПараметровСURL() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/?q=a+b");
	ПерваяСсылка = Адрес.ПараметрыЗапроса();

	// Действие
	ВтораяСсылка = Адрес.ПараметрыЗапроса();
	ПерваяСсылка
		.РазобратьКак(ФорматыПараметровЗапросаURL.ВебФорма())
		.Добавить("page", 2);

	// Проверка
	Ожидаем.Что(ВтораяСсылка).Идентично(ПерваяСсылка);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://example.com/?q=a+b&page=2");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьФорматБезСозданияЗапроса() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL;

	// Действие
	Результат = Параметры.УстановитьКодированнуюСтроку(
		Неопределено,
		ФорматыПараметровЗапросаURL.ВебФорма()
	);
	СтрокаДоДобавления = Параметры.КодированнаяСтрока();
	Параметры.Добавить("q", "hello world");

	// Проверка
	Ожидаем.Что(Результат).Идентично(Параметры);
	Ожидаем.Что(СтрокаДоДобавления).Равно(Неопределено);
	Ожидаем.Что(Параметры.ВСтроку()).Равно("q=hello+world");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьТекущуюСтрокуКакВебФорму() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL("q=a+b");
	ИсходнаяСтрока = Параметры.КодированнаяСтрока();

	// Действие
	Результат = Параметры.РазобратьКак(
		ФорматыПараметровЗапросаURL.ВебФорма()
	);

	// Проверка
	Ожидаем.Что(Результат).Идентично(Параметры);
	Ожидаем.Что(Параметры.Получить("q")).Равно("a b");
	Ожидаем.Что(Параметры.КодированнаяСтрока()).Равно(ИсходнаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьФорматИКодированнуюСтроку() Экспорт

	// Подготовка
	Формат = ФорматыПараметровЗапросаURL.ВебФорма();

	// Действие
	Параметры = Новый ПараметрыЗапросаURL("q=%68ello+world", Формат);

	// Проверка
	Ожидаем.Что(Параметры.ТекущийФормат()).Равно(Формат);
	Ожидаем.Что(Параметры.КодированнаяСтрока()).Равно("q=%68ello+world");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьИСериализоватьВебФорму() Экспорт

	// Подготовка
	Формат = ФорматыПараметровЗапросаURL.ВебФорма();

	// Действие
	Параметры = Новый ПараметрыЗапросаURL("q=hello+world&flag", Формат);

	// Проверка
	Ожидаем.Что(Параметры.Получить("q")).Равно("hello world");
	Ожидаем.Что(Параметры.Получить("flag")).Равно("");
	Ожидаем.Что(Параметры.ВСтроку()).Равно("q=hello+world&flag=");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КодироватьСпециальныеСимволыПоФормату() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL;
	Параметры.Добавить("q", "a b+~*");

	// Действие
	RFC3986 = Параметры.ВСтроку();
	ВебФорма = Параметры.ВСтроку(ФорматыПараметровЗапросаURL.ВебФорма());

	// Проверка
	Ожидаем.Что(RFC3986).Равно("q=a%20b%2B~%2A");
	Ожидаем.Что(ВебФорма).Равно("q=a+b%2B%7E*");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СериализоватьВДругомФорматеБезИзмененияСостояния() Экспорт

	// Подготовка
	Формат = ФорматыПараметровЗапросаURL.ВебФорма();
	Параметры = Новый ПараметрыЗапросаURL("q=%68ello+world", Формат);

	// Действие
	Результат = Параметры.ВСтроку(ФорматыПараметровЗапросаURL.RFC3986());

	// Проверка
	Ожидаем.Что(Результат).Равно("q=hello%20world");
	Ожидаем.Что(Параметры.ТекущийФормат()).Равно(Формат);
	Ожидаем.Что(Параметры.КодированнаяСтрока()).Равно("q=%68ello+world");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличатьОтсутствующийИПустойЗапрос() Экспорт

	// Подготовка
	БезЗапроса = Новый ПараметрыЗапросаURL;
	ПустойЗапрос = Новый ПараметрыЗапросаURL("");

	// Действие
	СтрокаБезЗапроса = БезЗапроса.ВСтроку();
	СтрокаПустогоЗапроса = ПустойЗапрос.ВСтроку();

	// Проверка
	Ожидаем.Что(БезЗапроса.КодированнаяСтрока()).Равно(Неопределено);
	Ожидаем.Что(ПустойЗапрос.КодированнаяСтрока()).Равно("");
	Ожидаем.Что(СтрокаБезЗапроса).Равно("");
	Ожидаем.Что(СтрокаПустогоЗапроса).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаменитьСтрокуИФормат() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL("q=old");
	Формат = ФорматыПараметровЗапросаURL.ВебФорма();

	// Действие
	Результат = Параметры.УстановитьКодированнуюСтроку("q=new+value", Формат);

	// Проверка
	Ожидаем.Что(Результат).Идентично(Параметры);
	Ожидаем.Что(Параметры.Получить("q")).Равно("new value");
	Ожидаем.Что(Параметры.ТекущийФормат()).Равно(Формат);
	Ожидаем.Что(Параметры.КодированнаяСтрока()).Равно("q=new+value");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьФорматПриПрямойУстановкеЗапросаURL() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/?q=old+value");
	Параметры = Адрес.ПараметрыЗапроса();
	Параметры.РазобратьКак(ФорматыПараметровЗапросаURL.ВебФорма());

	// Действие
	Адрес.УстановитьКодированнуюСтрокуЗапроса("q=new+value");
	Параметры.Добавить("next", "a b");

	// Проверка
	Ожидаем.Что(Адрес.ПараметрыЗапроса()).Идентично(Параметры);
	Ожидаем.Что(Параметры.Получить("q")).Равно("new value");
	Ожидаем.Что(Адрес.ВСтроку()).Равно(
		"https://example.com/?q=new+value&next=a+b"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_АтомарноОтклонитьНеизвестныйФормат() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL("q=a+b");
	КодОшибки = Неопределено;

	// Действие
	Попытка
		Параметры.РазобратьКак("Unknown");
	Исключение
		КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("argument.invalid_value");
	Ожидаем.Что(Параметры.ТекущийФормат()).Равно(
		ФорматыПараметровЗапросаURL.RFC3986()
	);
	Ожидаем.Что(Параметры.КодированнаяСтрока()).Равно("q=a+b");
	Ожидаем.Что(Параметры.Получить("q")).Равно("a+b");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеопределенныйФорматПовторногоРазбора() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL("q=a+b");
	КодОшибки = Неопределено;

	// Действие
	Попытка
		Параметры.РазобратьКак(Неопределено);
	Исключение
		КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("argument.invalid_type");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НормализоватьНекорректныйПроцентВСвязаннойКоллекции() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/?q=old");
	Параметры = Адрес.ПараметрыЗапроса();

	// Действие
	Параметры.УстановитьКодированнуюСтроку("q=%");

	// Проверка
	Ожидаем.Что(Параметры.Получить("q")).Равно("%");
	Ожидаем.Что(Параметры.ИсходнаяСтрока()).Равно("q=%");
	Ожидаем.Что(Параметры.КодированнаяСтрока()).Равно("q=%25");
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://example.com/?q=%");
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно("https://example.com/?q=%25");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьИсходнуюИКодированнуюСтроки() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL("q=привет");

	// Действие
	ИсходнаяСтрока = Параметры.ИсходнаяСтрока();
	КодированнаяСтрока = Параметры.КодированнаяСтрока();

	// Проверка
	Ожидаем.Что(ИсходнаяСтрока).Равно("q=привет");
	Ожидаем.Что(КодированнаяСтрока).Равно(
		"q=%D0%BF%D1%80%D0%B8%D0%B2%D0%B5%D1%82"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НормализоватьНекорректныйПроцентВАвтономнойКоллекции() Экспорт

