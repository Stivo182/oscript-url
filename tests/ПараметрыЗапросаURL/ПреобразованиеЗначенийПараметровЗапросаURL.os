#Область Тесты

&Тест
Процедура ТестДолжен_ПреобразоватьЗначенияПриДобавлении() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL;
	Идентификатор = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000001");

	// Действие
	Параметры
		.Добавить("Строка", "исходная строка")
		.Добавить("Истина", Истина)
		.Добавить("Ложь", Ложь)
		.Добавить("Целое", 12345)
		.Добавить("Дробное", 12345.6789)
		.Добавить("Дата", '20260906123456')
		.Добавить("Остальное", Идентификатор);

	// Проверка
	Ожидаем.Что(Параметры.Получить("Строка")).Равно("исходная строка");
	Ожидаем.Что(Параметры.Получить("Истина")).Равно("true");
	Ожидаем.Что(Параметры.Получить("Ложь")).Равно("false");
	Ожидаем.Что(Параметры.Получить("Целое")).Равно("12345");
	Ожидаем.Что(Параметры.Получить("Дробное")).Равно("12345.6789");
	Ожидаем.Что(Параметры.Получить("Дата")).Равно("2026-09-06T12:34:56");
	Ожидаем.Что(Параметры.Получить("Остальное")).Равно("00000000-0000-0000-0000-000000000001");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПреобразоватьЗначениеПриУстановке() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL("a=old&a=duplicate&b=2");

	// Действие
	Параметры.Установить("a", 12345.6789);

	// Проверка
	Ожидаем.Что(Параметры.ВСтроку()).Равно("a=12345.6789&b=2");
	Ожидаем.Что(Параметры.ПолучитьВсе("a").Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СинхронизироватьПреобразованноеЗначениеСURL() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/");
	Параметры = Адрес.ПараметрыЗапроса();

	// Действие
	Параметры.Добавить("date", '20260906123456');

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://example.com/?date=2026-09-06T12%3A34%3A56");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавитьПараметрСНеопределеннымЗначениемБезЗнакаРавно() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL;

	// Действие
	Параметры.Добавить("name", Неопределено);

	// Проверка
	Ожидаем.Что(Параметры.ВСтроку()).Равно("name");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавитьПараметрыБезЗначения() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL;

	// Действие
	Параметры
		.Добавить("explicit", Неопределено)
		.Добавить("implicit");

	// Проверка
	Ожидаем.Что(Параметры.ВСтроку()).Равно("explicit&implicit");
	Ожидаем.Что(Параметры.Содержит("explicit")).ЭтоИстина();
	Ожидаем.Что(Параметры.Получить("explicit")).ЕстьНеопределено();

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьПараметрСНеопределеннымЗначениемБезЗнакаРавно() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL("name=old&name=duplicate");

	// Действие
	Параметры.Установить("name", Неопределено);

	// Проверка
	Ожидаем.Что(Параметры.ВСтроку()).Равно("name");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьПараметрБезЗначения() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL("flag=old&flag=duplicate&empty=");

	// Действие
	Параметры.Установить("flag");

	// Проверка
	Ожидаем.Что(Параметры.ВСтроку()).Равно("flag&empty=");
	Ожидаем.Что(Параметры.ПолучитьВсе("flag").Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличатьОтсутствующееИПустоеЗначения() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL("flag&empty=");

	// Действие
	ЗначениеФлага = Параметры.Получить("flag");
	ПустоеЗначение = Параметры.Получить("empty");
	ВсеЗначенияФлага = Параметры.ПолучитьВсе("flag");
	Пары = Параметры.ВМассив();
	СтрокаПараметров = Параметры.ВСтроку();

	// Проверка
	Ожидаем.Что(ЗначениеФлага).ЕстьНеопределено();
	Ожидаем.Что(ПустоеЗначение).Равно("");
	Ожидаем.Что(ВсеЗначенияФлага[0]).ЕстьНеопределено();
	Ожидаем.Что(Пары[0].Значение).ЕстьНеопределено();
	Ожидаем.Что(СтрокаПараметров).Равно("flag&empty=");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьДобавлениеБезымянногоПараметраБезЗначения() Экспорт

	// Подготовка
	Действие = Новый Действие(ЭтотОбъект, "ДобавитьБезымянныйПараметрБезЗначения");

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(Действие, "argument.invalid_value");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьУстановкуБезымянногоПараметраБезЗначения() Экспорт

	// Подготовка
	Действие = Новый Действие(ЭтотОбъект, "УстановитьБезымянныйПараметрБезЗначения");

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(Действие, "argument.invalid_value");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьДопустимыеТипыПриОтклоненииNull() Экспорт

	// Подготовка
	Параметры = Новый ПараметрыЗапросаURL;
	СнимокОшибки = Неопределено;

	// Действие
	Попытка
		Параметры.Добавить("имя", Null);
	Исключение
		СнимокОшибки = ДиагностикаОшибок.НайтиПервую(ИнформацияОбОшибке(), "argument.invalid_type");
	КонецПопытки;

	// Проверка
	Ожидаем.Что(СнимокОшибки).Существует();
	Ожидаем.Что(СнимокОшибки.Данные().ОжидаемыйТип).Равно("Произвольный, кроме Null");

КонецПроцедуры

