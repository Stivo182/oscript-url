#Использовать asserts
#Использовать errors
#Использовать "../../src"
#Использовать "../fixtures"

Перем _Адрес; // URL
Перем _Значение; // Произвольный

#Область Тесты

&Тест
Процедура ТестДолжен_УстановитьСхемуБезНормализацииРегистра() Экспорт

	// Подготовка
	Адрес = Новый URL("x://host/a");

	// Действие
	Результат = Адрес.УстановитьСхему("HTTP");

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("HTTP://host/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_АтомарноОтклонитьНедопустимуюСхему() Экспорт

	// Подготовка
	Адрес = Новый URL("x://host/a");
	_Адрес = Адрес;
	_Значение = "1http";
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "УстановитьСхемуДляТеста"),
		"uri.invalid_scheme"
	);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("x:", "", "x://host")
&ИсточникЗначение("x:/a", "/a", "x://host/a")
&ИсточникЗначение("x://old//a", "//a", "x://host//a")
Процедура ТестДолжен_УстановитьСервернуюЧастьДляСовместимогоПути(
	ИсходнаяСтрока, ОжидаемыйПуть, ОжидаемаяСтрока
) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие
	Результат = Адрес.УстановитьСервернуюЧасть("host");

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.КодированныйПуть()).Равно(ОжидаемыйПуть);
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("x://host", "x:")
&ИсточникЗначение("x://host/a", "x:/a")
Процедура ТестДолжен_ОчиститьСервернуюЧастьДляСовместимогоПути(
	ИсходнаяСтрока, ОжидаемаяСтрока
) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие
	Результат = Адрес.ОчиститьСервернуюЧасть();

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеИзменитьПутьБезКорняПриОчисткеОтсутствующейСервернойЧасти() Экспорт

	// Подготовка
	Адрес = Новый URL("x:a");

	// Действие
	Результат = Адрес.ОчиститьСервернуюЧасть();

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("x:a");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("", "x://host")
&ИсточникЗначение("/a", "x://host/a")
&ИсточникЗначение("//a", "x://host//a")
Процедура ТестДолжен_УстановитьСовместимыйПутьПриСервернойЧасти(
	Путь, ОжидаемаяСтрока
) Экспорт

	// Подготовка
	Адрес = Новый URL("x://host/old");

	// Действие
	Результат = Адрес.УстановитьПуть(Путь);

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_АтомарноОтклонитьПутьБезКорняПриСервернойЧасти() Экспорт

	// Подготовка
	Адрес = Новый URL("x://host/");
	_Адрес = Адрес;
	_Значение = "abc";
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "УстановитьПутьДляТеста"),
		"url.incompatible_components"
	);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

