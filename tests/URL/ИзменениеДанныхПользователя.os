#Использовать asserts
#Использовать errors
#Использовать "../../src"
#Использовать "../fixtures"

Перем _Адрес; // URL
Перем _Значение; // Произвольный

#Область Тесты

&Тест
Процедура ТестДолжен_КодироватьДекодированныеДанныеПользователя() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a");

	// Действие
	Результат = Адрес.УстановитьДанныеПользователя("user@example:pass word");

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://user%40example:pass%20word@host/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьИсходноеНаписаниеКодированныхДанныхПользователя() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a");

	// Действие
	Адрес.УстановитьКодированныеДанныеПользователя("u%73er:p%40ss");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://u%73er:p%40ss@host/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПарольПриУстановкеИмениПользователя() Экспорт

	// Подготовка
	Адрес = Новый URL("https://old:se%63ret@host/a");

	// Действие
	Адрес.УстановитьИмяПользователя("user:name");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://user%3Aname:se%63ret@host/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьДанныеПользователяВместеСПаролем() Экспорт

	// Подготовка
	Адрес = Новый URL("https://user:secret@host/a");

	// Действие
	Адрес.УстановитьИмяПользователя(Неопределено);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьТолькоПароль() Экспорт

	// Подготовка
	Адрес = Новый URL("https://user:secret@host/a");

	// Действие
	Адрес.УстановитьПароль(Неопределено);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://user@host/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьЯвноПустойПароль() Экспорт

	// Подготовка
	Адрес = Новый URL("https://user@host/a");

	// Действие
	Адрес.УстановитьПароль("");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://user:@host/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьПустоеИмяПриУстановкеПароля() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a");

	// Действие
	Адрес.УстановитьПароль("secret");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://:secret@host/a");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ДанныеПользователя", "x://user@/a")
&ИсточникЗначение("ИмяПользователя", "x://user@/a")
&ИсточникЗначение("Пароль", "x://:pass@/a")
Процедура ТестДолжен_АвтоматическиСоздатьСервернуюЧастьДляДанныхПользователя(
	Операция, ОжидаемаяСтрока
) Экспорт

	// Подготовка
	Адрес = Новый URL("x:/a");

	// Действие
	Если Операция = "ДанныеПользователя" Тогда
		Адрес.УстановитьДанныеПользователя("user");
	ИначеЕсли Операция = "ИмяПользователя" Тогда
		Адрес.УстановитьИмяПользователя("user");
	Иначе
		Адрес.УстановитьПароль("pass");
	КонецЕсли;

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСоздатьСервернуюЧастьПриУдаленииДанныхПользователя() Экспорт

	// Подготовка
	Адрес = Новый URL("x:/a");

	// Действие
	Адрес.УстановитьДанныеПользователя(Неопределено)
		.УстановитьИмяПользователя(Неопределено)
		.УстановитьПароль(Неопределено);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("x:/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_АтомарноОтклонитьНедопустимыеКодированныеДанныеПользователя() Экспорт

	// Подготовка
	Адрес = Новый URL("https://old:pass@host/a");
	_Адрес = Адрес;
	_Значение = "new@name";
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "УстановитьКодированныеДанныеПользователяДляТеста"),
		"url.invalid_authority"
	);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьКодированныеДанныеПользователяДляТеста() Экспорт

	_Адрес.УстановитьКодированныеДанныеПользователя(_Значение);

КонецПроцедуры

#КонецОбласти
