#Использовать asserts
#Использовать "../../src"

#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьПустуюОтносительнуюСсылкуПоУмолчанию() Экспорт

	// Действие
	Адрес = Новый URL;

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("");
	Ожидаем.Что(Адрес.ЯвляетсяОтносительным()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОтносительнуюСсылкуБезБазы() Экспорт

	// Действие
	Адрес = Новый URL("../images/logo.svg?size=2#preview");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("../images/logo.svg?size=2#preview");
	Ожидаем.Что(Адрес.ЯвляетсяОтносительным()).Равно(Истина);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://example.com/path", Истина)
&ИсточникЗначение("urn:isbn:9780140328721", Истина)
&ИсточникЗначение("//example.com/path", Ложь)
&ИсточникЗначение("../path", Ложь)
&ИсточникЗначение("", Ложь)
Процедура ТестДолжен_ОпределитьАбсолютностьСсылки(СтрокаАдреса, ОжидаетсяАбсолютный) Экспорт

	// Подготовка
	Адрес = Новый URL(СтрокаАдреса);

	// Действие
	Результат = Адрес.ЯвляетсяАбсолютным();

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаетсяАбсолютный);
	Ожидаем.Что(Адрес.ЯвляетсяОтносительным()).Равно(Не ОжидаетсяАбсолютный);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИзменитьОтносительнуюСсылку() Экспорт

	// Подготовка
	Адрес = Новый URL("../old?before=1#old");

	// Действие
	Адрес.УстановитьПуть("../new file");
	Адрес.УстановитьЗапрос("after=2");
	Адрес.УстановитьФрагмент("new");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("../new%20file?after=2#new");
	Ожидаем.Что(Адрес.ЯвляетсяОтносительным()).Равно(Истина);

КонецПроцедуры

#КонецОбласти
