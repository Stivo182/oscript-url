#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("HTTP://%45XAMPLE.COM/%7euser", "http://example.com/~user")
&ИсточникЗначение("X://[2001:DB8::A]/%2f?%2a#%41", "x://[2001:db8::a]/%2F?%2A#A")
&ИсточникЗначение("x://EXAMPLE%2f.COM/", "x://example%2F.com/")
&ИсточникЗначение("http://e:80?#", "http://e:80?#")
&ИсточникЗначение("x://host:", "x://host")
&ИсточникЗначение("//host:/path", "//host/path")
&ИсточникЗначение(".", "./")
&ИсточникЗначение("./", "./")
&ИсточникЗначение("..", "../")
&ИсточникЗначение("../", "../")
&ИсточникЗначение("../a", "../a")
&ИсточникЗначение("../../a", "../../a")
&ИсточникЗначение("a/.", "a/")
&ИсточникЗначение("a/./b", "a/b")
&ИсточникЗначение("a/..", "./")
&ИсточникЗначение("a/../", "./")
&ИсточникЗначение("a/../b", "b")
&ИсточникЗначение("a/../../b", "../b")
&ИсточникЗначение("a/b/../../c", "c")
&ИсточникЗначение(".//a", ".//a")
&ИсточникЗначение("a/.//b", "a//b")
&ИсточникЗначение("a/..//b", ".//b")
&ИсточникЗначение("a//../b", "a/b")
&ИсточникЗначение("x/../a:b", "./a:b")
&ИсточникЗначение("./a:b", "./a:b")
Процедура ТестДолжен_НормализоватьURLСсылку(ИсходнаяСтрока, ОжидаемаяСтрока) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие
	Результат = Адрес.Нормализованный();

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("http://e:", "http://e/")
&ИсточникЗначение("http://e:80", "http://e/")
&ИсточникЗначение("http://e:00080", "http://e/")
&ИсточникЗначение("https://e:443", "https://e/")
&ИсточникЗначение("https://e:", "https://e/")
&ИсточникЗначение("ws://e:80", "ws://e/")
&ИсточникЗначение("ws://e:", "ws://e/")
&ИсточникЗначение("wss://e:443", "wss://e/")
&ИсточникЗначение("wss://e:", "wss://e/")
&ИсточникЗначение("ftp://e:21", "ftp://e")
&ИсточникЗначение("ftp://e:", "ftp://e")
&ИсточникЗначение("x://e:", "x://e")
&ИсточникЗначение("http://e:?%7e#%7e", "http://e/?~#~")
&ИсточникЗначение("http://e/?", "http://e/?")
&ИсточникЗначение("http://e/#", "http://e/#")
Процедура ТестДолжен_НормализоватьURLДляСхемы(ИсходнаяСтрока, ОжидаемаяСтрока) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие
	Результат = Адрес.НормализованныйДляСхемы();

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(".")
&ИсточникЗначение("./")
&ИсточникЗначение("..")
&ИсточникЗначение("../")
&ИсточникЗначение("../a")
&ИсточникЗначение("../../a")
&ИсточникЗначение("a/.")
&ИсточникЗначение("a/./b")
&ИсточникЗначение("a/..")
&ИсточникЗначение("a/../")
&ИсточникЗначение("a/../b")
&ИсточникЗначение("a/../../b")
&ИсточникЗначение("a/b/../../c")
&ИсточникЗначение(".//a")
&ИсточникЗначение("a/.//b")
&ИсточникЗначение("a/..//b")
&ИсточникЗначение("a//../b")
&ИсточникЗначение("x/../a:b")
&ИсточникЗначение("./a:b")
Процедура ТестДолжен_СохранятьСемантикуОтносительнойНормализации(Ссылка) Экспорт

	// Подготовка
	Базы = Новый Массив;
	Базы.Добавить("http://a/b/c/d;p?q");
	Базы.Добавить("http://a/");
	Базы.Добавить("http://a");
	Базы.Добавить("x:/a/b/c");
	Базы.Добавить("x://host/a/b/c");
	Адрес = Новый URL(Ссылка);

	// Действие и Проверка
	Для Каждого СтрокаБазы Из Базы Цикл
		База = Новый URL(СтрокаБазы);
		Ожидаем.Что(База.Разрешить(Адрес).Эквивалентен(База.Разрешить(Адрес.Нормализованный())))
			.ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
