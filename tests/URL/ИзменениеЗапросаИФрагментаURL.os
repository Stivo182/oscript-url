#Использовать asserts
#Использовать "../../src"
#Использовать "../fixtures"

Перем _Адрес; // URL
Перем _ВидКомпонента; // Строка
Перем _Значение; // Строка

#Область Тесты

&Тест
Процедура ТестДолжен_УстановитьДекодированныйЗапросСКодированием() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a#f");

	// Действие
	Результат = Адрес.УстановитьЗапрос("a b/%");

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.КодированныйЗапрос()).Равно("a%20b/%25");
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a?a%20b/%25#f");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьЯвноПустойЗапрос() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a#f");

	// Действие
	Результат = Адрес.УстановитьЗапрос("");

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.КодированныйЗапрос()).Равно("");
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a?#f");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьКодированныйЗапросБезНормализации() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a#f");

	// Действие
	Адрес.УстановитьКодированныйЗапрос("x=%7e");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a?x=%7e#f");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьЗапросНеопределеннымЗначениемИОчисткой() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a?x=1#f");

	// Действие
	Адрес.УстановитьЗапрос(Неопределено).УстановитьКодированныйЗапрос("x=1").ОчиститьЗапрос();

	// Проверка
	Ожидаем.Что(Адрес.КодированныйЗапрос()).Равно(Неопределено);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a#f");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьДекодированныйФрагментСКодированием() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a?x=1");

	// Действие
	Результат = Адрес.УстановитьФрагмент("a b/%");

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.КодированныйФрагмент()).Равно("a%20b/%25");
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a?x=1#a%20b/%25");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьЯвноПустойФрагмент() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a?x=1");

	// Действие
	Результат = Адрес.УстановитьФрагмент("");

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.КодированныйФрагмент()).Равно("");
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a?x=1#");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьКодированныйФрагментБезНормализации() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a?x=1");

	// Действие
	Адрес.УстановитьКодированныйФрагмент("x=%7e");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a?x=1#x=%7e");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьФрагментНеопределеннымЗначениемИОчисткой() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a?x=1#f");

	// Действие
	Адрес.УстановитьФрагмент(Неопределено).УстановитьКодированныйФрагмент("f").ОчиститьФрагмент();

	// Проверка
	Ожидаем.Что(Адрес.КодированныйФрагмент()).Равно(Неопределено);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a?x=1");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Путь", "тест", "url.invalid_syntax")
&ИсточникЗначение("Путь", "a?b", "url.invalid_syntax")
&ИсточникЗначение("Путь", "a%ZZ", "url.invalid_percent_encoding")
&ИсточникЗначение("Запрос", "тест", "url.invalid_syntax")
&ИсточникЗначение("Запрос", "a#b", "url.invalid_syntax")
&ИсточникЗначение("Запрос", "a%ZZ", "url.invalid_percent_encoding")
&ИсточникЗначение("Фрагмент", "тест", "url.invalid_syntax")
&ИсточникЗначение("Фрагмент", "a#b", "url.invalid_syntax")
&ИсточникЗначение("Фрагмент", "a%ZZ", "url.invalid_percent_encoding")
Процедура ТестДолжен_АтомарноОтклонитьНедопустимыйКодированныйКомпонент(
	ВидКомпонента, Значение, ОжидаемыйКод
) Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a?x=1#f");
	_Адрес = Адрес;
	_ВидКомпонента = ВидКомпонента;
	_Значение = Значение;
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "УстановитьКодированныйКомпонентДляТеста"),
		ОжидаемыйКод
	);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьКодированныйКомпонентДляТеста() Экспорт

	Если _ВидКомпонента = "Путь" Тогда
		_Адрес.УстановитьКодированныйПуть(_Значение);
	ИначеЕсли _ВидКомпонента = "Запрос" Тогда
		_Адрес.УстановитьКодированныйЗапрос(_Значение);
	Иначе
		_Адрес.УстановитьКодированныйФрагмент(_Значение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
