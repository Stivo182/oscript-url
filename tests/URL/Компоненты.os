#Использовать asserts
#Использовать "../../src"
#Использовать "../fixtures"

Перем _АдресСОшибкойКодировки; // URL

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("https://user%20name:p%3Aa@exa%6Dple.com:080/a%20b?q=%7E#f%20g")
&ИсточникЗначение("https://[2001:db8::1]/")
Процедура ТестДолжен_ВернутьДекодированныеКомпоненты(ИсходнаяСтрока) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие и Проверка
	Если ИсходнаяСтрока = "https://[2001:db8::1]/" Тогда
		Ожидаем.Что(Адрес.Хост()).Равно("[2001:db8::1]");
		Ожидаем.Что(Адрес.СервернаяЧасть()).Равно("[2001:db8::1]");
		Возврат;
	КонецЕсли;

	Ожидаем.Что(Адрес.ДанныеПользователя()).Равно("user name:p:a");
	Ожидаем.Что(Адрес.КодированноеИмяПользователя()).Равно("user%20name");
	Ожидаем.Что(Адрес.КодированныйПароль()).Равно("p%3Aa");
	Ожидаем.Что(Адрес.ИмяПользователя()).Равно("user name");
	Ожидаем.Что(Адрес.Пароль()).Равно("p:a");
	Ожидаем.Что(Адрес.Хост()).Равно("example.com");
	Ожидаем.Что(Адрес.СервернаяЧасть()).Равно("user name:p:a@example.com:080");
	Ожидаем.Что(Адрес.Путь()).Равно("/a b");
	Ожидаем.Что(Адрес.Запрос()).Равно("q=~");
	Ожидаем.Что(Адрес.Фрагмент()).Равно("f g");
	Ожидаем.Что(Адрес.ПутьИЗапрос()).Равно("/a%20b?q=%7E");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://host/", Неопределено, Неопределено, Неопределено, Неопределено)
&ИсточникЗначение("https://user@host/", "user", Неопределено, "user", Неопределено)
&ИсточникЗначение("https://user:@host/", "user", "", "user", "")
&ИсточникЗначение("https://:pass@host/", "", "pass", "", "pass")
&ИсточникЗначение("https://@host/", "", Неопределено, "", Неопределено)
&ИсточникЗначение("https://user:p:a@host/", "user", "p:a", "user", "p:a")
&ИсточникЗначение("https://user%3Aname:p@host/", "user%3Aname", "p", "user:name", "p")
&ИсточникЗначение("http://j%40ne:password@google.com", "j%40ne", "password", "j@ne", "password")
&ИсточникЗначение("http://jane:p%40ssword@google.com", "jane", "p%40ssword", "jane", "p@ssword")
&ИсточникЗначение("http://u%3Fx:p%23y@host", "u%3Fx", "p%23y", "u?x", "p#y")
&ИсточникЗначение("http://u%2Fx:p%2Fy@host", "u%2Fx", "p%2Fy", "u/x", "p/y")
&ИсточникЗначение("http://u%25:p%25@host", "u%25", "p%25", "u%", "p%")
&ИсточникЗначение("http://u:p%3Aq@host", "u", "p%3Aq", "u", "p:q")
&ИсточникЗначение("http://%D0%A4:%D1%8F@host", "%D0%A4", "%D1%8F", "Ф", "я")
&ИсточникЗначение("http://u%40x:@host", "u%40x", "", "u@x", "")
Процедура ТестДолжен_ВыделитьИмяПользователяИПароль(ИсходнаяСтрока, ОжидаемоеКодированноеИмя,
	ОжидаемыйКодированныйПароль, ОжидаемоеИмя, ОжидаемыйПароль) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие
	КодированноеИмя = Адрес.КодированноеИмяПользователя();
	КодированныйПароль = Адрес.КодированныйПароль();
	Имя = Адрес.ИмяПользователя();
	Пароль = Адрес.Пароль();

	// Проверка
	Ожидаем.Что(КодированноеИмя).Равно(ОжидаемоеКодированноеИмя);
	Ожидаем.Что(КодированныйПароль).Равно(ОжидаемыйКодированныйПароль);
	Ожидаем.Что(Имя).Равно(ОжидаемоеИмя);
	Ожидаем.Что(Пароль).Равно(ОжидаемыйПароль);
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("/a", Неопределено, Неопределено, "/a")
&ИсточникЗначение("/a?", "", Неопределено, "/a?")
&ИсточникЗначение("/a#", Неопределено, "", "/a")
&ИсточникЗначение("/a?#", "", "", "/a?")
Процедура ТестДолжен_РазличитьПустыеИОтсутствующиеДекодированныеЗапросИФрагмент(
	ИсходнаяСтрока, ОжидаемыйЗапрос, ОжидаемыйФрагмент, ОжидаемыйПутьИЗапрос
) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие и Проверка
	Ожидаем.Что(Адрес.Запрос()).Равно(ОжидаемыйЗапрос);
	Ожидаем.Что(Адрес.Фрагмент()).Равно(ОжидаемыйФрагмент);
	Ожидаем.Что(Адрес.ПутьИЗапрос()).Равно(ОжидаемыйПутьИЗапрос);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьДоступККодированнымКомпонентамПриОшибкеКодировки() Экспорт

	// Подготовка
	_АдресСОшибкойКодировки = Новый URL("/%FF?q=%FF#%FF");

	// Действие и Проверка
	Ожидаем.Что(_АдресСОшибкойКодировки.КодированныйПуть()).Равно("/%FF");
	Ожидаем.Что(_АдресСОшибкойКодировки.КодированныйЗапрос()).Равно("q=%FF");
	Ожидаем.Что(_АдресСОшибкойКодировки.КодированныйФрагмент()).Равно("%FF");
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "ПолучитьДекодированныйПутьСОшибкойКодировки"),
		"encoding.invalid"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДекодироватьAMеткиИЛогическиСохранитьНекорректнуюAMетку() Экспорт

	// Подготовка
	ДопустимыйАдрес = Новый URL("https://xn--e1afmkfd.xn--p1ai/");
	НекорректнаяМеткаАдрес = Новый URL("https://xn--invalid-/");

	// Действие
	ДопустимыйХост = ДопустимыйАдрес.Хост();
	НекорректныйХост = НекорректнаяМеткаАдрес.Хост();

	// Проверка
	Ожидаем.Что(ДопустимыйХост).Равно("пример.рф");
	Ожидаем.Что(НекорректныйХост).Равно("xn--invalid-");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьРегистрОбычныхМетокПриДекодированииPunycode() Экспорт

	// Подготовка
	Адрес = Новый URL("https://EXAMPLE.xn--e1afmkfd/");

	// Действие
	Хост = Адрес.Хост();

	// Проверка
	Ожидаем.Что(Хост).Равно("EXAMPLE.пример");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПолучитьДекодированныйПутьСОшибкойКодировки() Экспорт

	_АдресСОшибкойКодировки.Путь();

КонецПроцедуры

#КонецОбласти
