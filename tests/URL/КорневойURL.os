#Использовать asserts
#Использовать "../../src"
#Использовать "../fixtures"

Перем _Адрес; // URL

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("HTTPS://user:password@Example.COM:443/a/../b?q=1#fragment", "https://example.com/")
&ИсточникЗначение("https://example.com:8443/a", "https://example.com:8443/")
&ИсточникЗначение("ftp://Example.COM:21/a", "ftp://example.com/")
&ИсточникЗначение("X://[2001:DB8::A]:1234/a?x#y", "x://[2001:db8::a]:1234/")
&ИсточникЗначение("x://example.com:/a", "x://example.com/")
Процедура ТестДолжен_ВернутьКорневойURL(ИсходнаяСтрока, ОжидаемаяСтрока) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие
	Результат = Адрес.Корневой();

	// Проверка
	Ожидаем.Что(Результат).ИмеетТип("URL");
	Ожидаем.Что(Результат.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНезависимыйURL() Экспорт

	// Подготовка
	Адрес = Новый URL("https://user@example.com:8443/path?q=1#fragment");
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	Результат = Адрес.Корневой();
	Результат.УстановитьХост("other.example");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);
	Ожидаем.Что(Результат.ВСтроку()).Равно("https://other.example:8443/");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("path/to/resource")
&ИсточникЗначение("//example.com/path")
&ИсточникЗначение("mailto:user@example.com")
&ИсточникЗначение("x:///path")
Процедура ТестДолжен_ОтклонитьURLБезСхемыИлиУзла(ИсходнаяСтрока) Экспорт

	// Подготовка
	_Адрес = Новый URL(ИсходнаяСтрока);

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "ПолучитьКорневойURL"),
		"url.server_address_required"
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПолучитьКорневойURL() Экспорт

	_Адрес.Корневой();

КонецПроцедуры

#КонецОбласти
