#Использовать asserts
#Использовать "../../src"
#Использовать "../fixtures"

Перем _Адрес; // URL

#Область Тесты

&Тест
Процедура ТестДолжен_УстановитьДекодированныйПутьСКодированиемПроцента() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/old?x=1#fragment");

	// Действие
	Результат = Адрес.УстановитьПуть("/a b/%");

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a%20b/%25?x=1#fragment");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьПутьСохранивЗапросИФрагмент() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a/b?x=1#f");

	// Действие
	Результат = Адрес.УстановитьПуть("");

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host?x=1#f");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьКодированныйПутьБезНормализации() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/old?x=1#fragment");

	// Действие
	Результат = Адрес.УстановитьКодированныйПуть("/a%2fb");

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a%2fb?x=1#fragment");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Декодированный", "a:b")
&ИсточникЗначение("Кодированный", "a:b")
Процедура ТестДолжен_СохранитьОтносительностьПутиСДвоеточием(ВидПути, ОжидаемыйПуть) Экспорт

	// Подготовка
	Адрес = Новый URL("");

	// Действие
	Если ВидПути = "Декодированный" Тогда
		Адрес.УстановитьПуть("a:b");
	Иначе
		Адрес.УстановитьКодированныйПуть("a:b");
	КонецЕсли;

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("./" + ОжидаемыйПуть);
	Ожидаем.Что(Адрес.Схема()).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Один", "./a:b")
&ИсточникЗначение("Несколько", "./a:b/c")
Процедура ТестДолжен_СохранитьОтносительностьПриДобавленииСегментаСДвоеточием(
	КоличествоСегментов, ОжидаемаяСтрока
) Экспорт

	// Подготовка
	Адрес = Новый URL("");

	// Действие
	Если КоличествоСегментов = "Один" Тогда
		Адрес.ДобавитьСегментПути("a:b");
	Иначе
		Сегменты = Новый Массив;
		Сегменты.Добавить("a:b");
		Сегменты.Добавить("c");
		Адрес.ДобавитьСегментыПути(Сегменты);
	КонецЕсли;

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ОжидаемаяСтрока);
	Ожидаем.Что(Адрес.Схема()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавитьСегментыИзФиксированногоМассива() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host");
	ИсходныеСегменты = Новый Массив;
	ИсходныеСегменты.Добавить("a");
	ИсходныеСегменты.Добавить("b/c");
	Сегменты = Новый ФиксированныйМассив(ИсходныеСегменты);

	// Действие
	Результат = Адрес.ДобавитьСегментыПути(Сегменты);

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a/b%2Fc");

КонецПроцедуры

&Тест
Процедура ТестДолжен_АтомарноОтклонитьНедопустимыйПоследующийСегментПути() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a?x=1#f");
	_Адрес = Адрес;
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "ДобавитьНедопустимыеСегментыПутиДляТеста"),
		"argument.invalid_type"
	);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://host", "a", "https://host/a")
&ИсточникЗначение("x:", "a", "x:a")
&ИсточникЗначение("x:/", "a", "x:/a")
&ИсточникЗначение("x:/a/", "b", "x:/a/b")
&ИсточникЗначение("x:/a/", "", "x:/a//")
&ИсточникЗначение("mailto:a/b", "c", "mailto:a/b/c")
Процедура ТестДолжен_ДобавитьСегментПутиПоСтруктурнымПравилам(
	ИсходнаяСтрока, Сегмент, ОжидаемаяСтрока
) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие
	Результат = Адрес.ДобавитьСегментПути(Сегмент);

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КодироватьСлешВДобавляемомСегментеПути() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host/a");

	// Действие
	Адрес.ДобавитьСегментПути("b/c.txt");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a/b%2Fc.txt");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавитьВсеСегментыПутиПоследовательно() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host");
	Сегменты = Новый Массив;
	Сегменты.Добавить("a");
	Сегменты.Добавить("b/c");

	// Действие
	Результат = Адрес.ДобавитьСегментыПути(Сегменты);

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a/b%2Fc");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьНедопустимыеСегментыПутиДляТеста() Экспорт

	Сегменты = Новый Массив;
	Сегменты.Добавить("b");
	Сегменты.Добавить(42);
	_Адрес.ДобавитьСегментыПути(Сегменты);

КонецПроцедуры

#КонецОбласти
