#Использовать asserts
#Использовать "../../src"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("", 1, "", Неопределено, Неопределено, Неопределено, Неопределено)
&ИсточникЗначение("/", 2, "", "", Неопределено, Неопределено, Неопределено)
&ИсточникЗначение("/a", 2, "", "a", Неопределено, Неопределено, Неопределено)
&ИсточникЗначение("/a/", 3, "", "a", "", Неопределено, Неопределено)
&ИсточникЗначение("/a//b", 4, "", "a", "", "b", Неопределено)
&ИсточникЗначение("a/b", 2, "a", "b", Неопределено, Неопределено, Неопределено)
Процедура ТестДолжен_РазделитьПутьНаКодированныеСегменты(Путь, КоличествоСегментов, Первый,
	Второй, Третий, Четвертый, Пятый) Экспорт

	// Подготовка
	Адрес = Новый URL(Путь);

	// Действие
	Сегменты = Адрес.КодированныеСегментыПути();

	// Проверка
	Ожидаем.Что(ТипЗнч(Сегменты)).Равно(Тип("ФиксированныйМассив"));
	Ожидаем.Что(Сегменты.Количество()).Равно(КоличествоСегментов);
	ПроверитьСегмент(Сегменты, 0, Первый);
	ПроверитьСегмент(Сегменты, 1, Второй);
	ПроверитьСегмент(Сегменты, 2, Третий);
	ПроверитьСегмент(Сегменты, 3, Четвертый);
	ПроверитьСегмент(Сегменты, 4, Пятый);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДекодироватьКаждыйСегментПослеРазделения() Экспорт

	// Подготовка
	Адрес = Новый URL("/a%2Fb/c");

	// Действие
	КодированныеСегменты = Адрес.КодированныеСегментыПути();
	Сегменты = Адрес.СегментыПути();

	// Проверка
	Ожидаем.Что(КодированныеСегменты[0]).Равно("");
	Ожидаем.Что(КодированныеСегменты[1]).Равно("a%2Fb");
	Ожидаем.Что(КодированныеСегменты[2]).Равно("c");
	Ожидаем.Что(Сегменты[0]).Равно("");
	Ожидаем.Что(Сегменты[1]).Равно("a/b");
	Ожидаем.Что(Сегменты[2]).Равно("c");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьСегмент(Сегменты, Индекс, ОжидаемоеЗначение)

	Если ОжидаемоеЗначение <> Неопределено Тогда
		Ожидаем.Что(Сегменты[Индекс]).Равно(ОжидаемоеЗначение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
