#Использовать "../fixtures"

Перем _ОтносительнаяБаза; // URL

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("http://foo.com/bar", "http://foo.com//baz", "http://foo.com//baz")
&ИсточникЗначение("http://foo.com/bar", "http://foo.com///baz/quux", "http://foo.com///baz/quux")
&ИсточникЗначение("http://foo.com/dot/./dotdot/../foo/bar", "../baz", "http://foo.com/dot/baz")
&ИсточникЗначение("http://foo.com/foo%2fbar/", "../baz", "http://foo.com/baz")
&ИсточникЗначение("http://foo.com/1/2/3", "./a%2f../../b/..%2fc", "http://foo.com/1/2/b/..%2fc")
&ИсточникЗначение("http://foo.com/foo", "../bar%2fbaz", "http://foo.com/bar%2fbaz")
&ИсточникЗначение("http://foo.com/foo%2dbar/", "./baz-quux", "http://foo.com/foo%2dbar/baz-quux")
&ИсточникЗначение("http://foo.com?a=b", "https://bar.com/", "https://bar.com/")
&ИсточникЗначение("http://foo.com/", "https://bar.com/?", "https://bar.com/?")
&ИсточникЗначение("http://foo.com/bar", "/baz", "http://foo.com/baz")
&ИсточникЗначение("http://foo.com/bar?a=b#f", "/baz", "http://foo.com/baz")
&ИсточникЗначение("https://foo.com/bar?a=b", "//bar.com/quux", "https://bar.com/quux")
&ИсточникЗначение("http://foo.com", ".", "http://foo.com/")
&ИсточникЗначение("http://foo.com/bar/", ".", "http://foo.com/bar/")
&ИсточникЗначение("http://foo.com/bar/baz/", "quux", "http://foo.com/bar/baz/quux")
&ИсточникЗначение("http://foo.com/bar/baz", "../../../../../quux", "http://foo.com/quux")
&ИсточникЗначение("http://foo.com/bar", "..", "http://foo.com/")
&ИсточникЗначение("http://foo.com/bar/baz", "quux/dotdot/../tail", "http://foo.com/bar/quux/tail")
&ИсточникЗначение("http://foo.com/bar", "...", "http://foo.com/...")
&ИсточникЗначение("http://foo.com/bar", ".#frag", "http://foo.com/#frag")
&ИсточникЗначение("http://foo.com/1/2%2f/3%2f4/5", "../../a/b/c", "http://foo.com/1/a/b/c")
&ИсточникЗначение("http://foo.com/foo%20bar/", "../baz", "http://foo.com/baz")
&ИсточникЗначение("https://a/b/c/d;p?q", "//g?q", "https://g?q")
&ИсточникЗначение("https://a/b/c/d;p?q", "//g#s", "https://g#s")
&ИсточникЗначение("https://a/b/c/d;p?q#s", "?y", "https://a/b/c/d;p?y")
&ИсточникЗначение("https://a/b/c/d;p?q#s", "?", "https://a/b/c/d;p?")
Процедура ТестДолжен_РазрешитьСсылкуСКодированнымиРазделителями(
	Основа, Ссылка, ОжидаемаяСтрока
) Экспорт

	// Подготовка
	База = Новый URL(Основа);

	// Действие
	Результат = База.Разрешить(Ссылка);

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно(ОжидаемаяСтрока);
	Ожидаем.Что(База.ВСтроку()).Равно(Основа);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1)
&ИсточникЗначение(Null)
&ИсточникЗначение(Неопределено)
Процедура ТестДолжен_СообщитьИмяНедопустимогоАргументаРазрешения(Ссылка) Экспорт

	// Подготовка
	База = Новый URL("http://a/b/c/d;p?q");

	// Действие и Проверка
	Попытка
		База.Разрешить(Ссылка);
	Исключение
		Разбор = ДиагностикаОшибок.Разобрать(ИнформацияОбОшибке());
		Ожидаем.Что(Разбор.КодОшибки()).Равно("argument.invalid_type");
		Ожидаем.Что(Разбор.Данные().ИмяАргумента).Равно("Ссылка");
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение недопустимого типа аргумента";

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("g:h", "g:h")
&ИсточникЗначение("g", "http://a/b/c/g")
&ИсточникЗначение("g", "http://a/b/c/g", Истина)
&ИсточникЗначение("./g", "http://a/b/c/g")
&ИсточникЗначение("g/", "http://a/b/c/g/")
&ИсточникЗначение("/g", "http://a/g")
&ИсточникЗначение("//g", "http://g")
&ИсточникЗначение("?y", "http://a/b/c/d;p?y")
&ИсточникЗначение("g?y", "http://a/b/c/g?y")
&ИсточникЗначение("#s", "http://a/b/c/d;p?q#s")
&ИсточникЗначение("g#s", "http://a/b/c/g#s")
&ИсточникЗначение("g?y#s", "http://a/b/c/g?y#s")
&ИсточникЗначение(";x", "http://a/b/c/;x")
&ИсточникЗначение("g;x", "http://a/b/c/g;x")
&ИсточникЗначение("g;x?y#s", "http://a/b/c/g;x?y#s")
&ИсточникЗначение("", "http://a/b/c/d;p?q")
&ИсточникЗначение(".", "http://a/b/c/")
&ИсточникЗначение("./", "http://a/b/c/")
&ИсточникЗначение("..", "http://a/b/")
&ИсточникЗначение("../", "http://a/b/")
&ИсточникЗначение("../g", "http://a/b/g")
&ИсточникЗначение("../..", "http://a/")
&ИсточникЗначение("../../", "http://a/")
&ИсточникЗначение("../../g", "http://a/g")
Процедура ТестДолжен_РазрешитьНормальныйВекторRFC(Ссылка, ОжидаемаяСтрока, ПередатьURL = Ложь) Экспорт

	// Подготовка
	База = Новый URL("http://a/b/c/d;p?q");

	// Действие
	Если ПередатьURL Тогда
		Ссылка = Новый URL(Ссылка);
	КонецЕсли;
	Результат = База.Разрешить(Ссылка);

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно(ОжидаемаяСтрока);
	Ожидаем.Что(База.ВСтроку()).Равно("http://a/b/c/d;p?q");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("../../../g", "http://a/g")
&ИсточникЗначение("../../../../g", "http://a/g")
&ИсточникЗначение("/./g", "http://a/g")
&ИсточникЗначение("/../g", "http://a/g")
&ИсточникЗначение("g.", "http://a/b/c/g.")
&ИсточникЗначение(".g", "http://a/b/c/.g")
&ИсточникЗначение("g..", "http://a/b/c/g..")
&ИсточникЗначение("..g", "http://a/b/c/..g")
&ИсточникЗначение("./../g", "http://a/b/g")
&ИсточникЗначение("./g/.", "http://a/b/c/g/")
&ИсточникЗначение("g/./h", "http://a/b/c/g/h")
&ИсточникЗначение("g/../h", "http://a/b/c/h")
&ИсточникЗначение("g;x=1/./y", "http://a/b/c/g;x=1/y")
&ИсточникЗначение("g;x=1/../y", "http://a/b/c/y")
&ИсточникЗначение("g?y/./x", "http://a/b/c/g?y/./x")
&ИсточникЗначение("g?y/../x", "http://a/b/c/g?y/../x")
&ИсточникЗначение("g#s/./x", "http://a/b/c/g#s/./x")
&ИсточникЗначение("g#s/../x", "http://a/b/c/g#s/../x")
&ИсточникЗначение("http:g", "http:g")
Процедура ТестДолжен_РазрешитьНестандартныйВекторRFC(Ссылка, ОжидаемаяСтрока) Экспорт

	// Подготовка
	База = Новый URL("http://a/b/c/d;p?q");

	// Действие
	Результат = База.Разрешить(Ссылка);

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("", "http://a/b/c/d;p?q")
&ИсточникЗначение("//other.example/path", "http://other.example/path")
&ИсточникЗначение("?only", "http://a/b/c/d;p?only")
&ИсточникЗначение("?", "http://a/b/c/d;p?")
&ИсточникЗначение("#only", "http://a/b/c/d;p?q#only")
&ИсточникЗначение("#", "http://a/b/c/d;p?q#")
&ИсточникЗначение("%2E", "http://a/b/c/%2E")
&ИсточникЗначение("%2E%2E/g", "http://a/b/c/%2E%2E/g")
Процедура ТестДолжен_РазрешитьОсобыйСлучай(Ссылка, ОжидаемаяСтрока) Экспорт

	// Подготовка
	База = Новый URL("http://a/b/c/d;p?q#base");

	// Действие
	Результат = База.Разрешить(Ссылка);

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьОтносительнуюБазуПриРазрешении() Экспорт

	// Подготовка
	_ОтносительнаяБаза = Новый URL("relative/path");

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "РазрешитьСОтносительнойБазой"),
		"url.base_not_absolute"
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура РазрешитьСОтносительнойБазой() Экспорт

	_ОтносительнаяБаза.Разрешить("target");

КонецПроцедуры

#КонецОбласти
