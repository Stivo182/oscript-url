#Использовать asserts
#Использовать errors
#Использовать "../../src"

#Область Тесты

&Тест
Процедура ТестДолжен_БезИсключенияРазобратьКорректнуюСсылку() Экспорт

	// Подготовка
	Значение = "https://пример.рф/путь";
	Ошибка = "предыдущее значение";

	// Действие
	Результат = РазборURL.ПопытатьсяРазобрать(Значение, Ошибка);

	// Проверка
	Ожидаем.Что(ТипЗнч(Результат)).Равно(Тип("URL"));
	Ожидаем.Что(Результат.ВСтроку()).Равно(Значение);
	Ожидаем.Что(Ошибка).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("a b", "url.invalid_syntax")
&ИсточникЗначение("1x:a", "url.invalid_scheme")
&ИсточникЗначение("/%ZZ", "url.invalid_percent_encoding")
&ИсточникЗначение("//host:abc", "url.invalid_authority")
&ИсточникЗначение("//[invalid", "url.invalid_host")
&ИсточникЗначение("http://[::1]a", "url.invalid_authority")
&ИсточникЗначение("http://[::1", "url.invalid_host")
&ИсточникЗначение("http://[not-an-ip]/", "url.invalid_host")
&ИсточникЗначение("http://[::ffff:192.168.0.1000]/", "url.invalid_host")
&ИсточникЗначение("http://x:namedport", "url.invalid_authority")
&ИсточникЗначение("http://a b.com/", "url.invalid_host")
&ИсточникЗначение("1http://foo.com", "url.invalid_scheme")
&ИсточникЗначение("cache_object:foo", "url.invalid_scheme")
&ИсточникЗначение("/%", "url.invalid_percent_encoding")
&ИсточникЗначение("/%0", "url.invalid_percent_encoding")
&ИсточникЗначение("/%GG", "url.invalid_percent_encoding")
&ИсточникЗначение("http://host/%zz", "url.invalid_percent_encoding")
&ИсточникЗначение("http://[::1]extra", "url.invalid_authority")
&ИсточникЗначение("http://[::1]:named", "url.invalid_authority")
&ИсточникЗначение("http://[v1.]", "url.invalid_host")
&ИсточникЗначение("http://[v.abc]", "url.invalid_host")
&ИсточникЗначение("http://[1.2.3.4]", "url.invalid_host")
&ИсточникЗначение("http://[]", "url.invalid_host")
&ИсточникЗначение("http://host:+80", "url.invalid_authority")
&ИсточникЗначение("http://host:-1", "url.invalid_authority")
&ИсточникЗначение("http://host:8a", "url.invalid_authority")
&ИсточникЗначение("http://host:80:90", "url.invalid_authority")
&ИсточникЗначение("http://host: 80", "url.invalid_authority")
&ИсточникЗначение("http://ho[st/", "url.invalid_host")
&ИсточникЗначение("http://ho]st/", "url.invalid_host")
&ИсточникЗначение("http://user[bad]@host/", "url.invalid_authority")
&ИсточникЗначение("http://host/a b", "url.invalid_syntax")
&ИсточникЗначение("http://host/a\b", "url.invalid_syntax")
&ИсточникЗначение("http://host/?a b", "url.invalid_syntax")
&ИсточникЗначение("http://host/#a b", "url.invalid_syntax")
&ИсточникЗначение("http://host/##", "url.invalid_syntax")
&ИсточникЗначение("ht^tp://host", "url.invalid_scheme")
&ИсточникЗначение("+http://host", "url.invalid_scheme")
Процедура ТестДолжен_ВернутьНеопределеноДляОжидаемойОшибкиРазбора(Значение, ОжидаемыйКод) Экспорт

	// Подготовка
	// Значение передано параметром теста.
	Ошибка = Неопределено;

	// Действие
	Попытка
		Адрес = Новый URL(Значение);
	Исключение
		ФактическийКод = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Результат = РазборURL.ПопытатьсяРазобрать(Значение, Ошибка);

	// Проверка
	Ожидаем.Что(ФактическийКод).Равно(ОжидаемыйКод);
	Ожидаем.Что(Результат).Равно(Неопределено);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(ОжидаемыйКод);
	Ожидаем.Что(РазборURL.ЭтоКорректнаяСсылка(Значение)).ЭтоЛожь();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(42)
&ИсточникЗначение(Null)
&ИсточникЗначение(Неопределено)
Процедура ТестДолжен_ВернутьНеопределеноДляНеправильногоТипа(Значение) Экспорт

	// Подготовка
	// Значение передано параметром теста.
	Ошибка = Неопределено;

	// Действие
	Результат = РазборURL.ПопытатьсяРазобрать(Значение, Ошибка);

	// Проверка
	Ожидаем.Что(Результат).Равно(Неопределено);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("argument.invalid_type");
	Ожидаем.Что(РазборURL.ЭтоКорректнаяСсылка(Значение)).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти
