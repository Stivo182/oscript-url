&ИсточникЗначение("http://rest.rsc.io/foo%2fbar/baz%2Fquux?alt=media")
&ИсточникЗначение("x://!$&'()*+,;=hello!:1/path")
&ИсточникЗначение("https://[2001:db8::1]:17000/test/path")
&ИсточникЗначение("*")
&ИсточникЗначение("http://www.google.com")
&ИсточникЗначение("http://www.google.com/")
&ИсточникЗначение("http://www.google.com/file%20one%26two")
&ИсточникЗначение("http://www.google.com/#file%20one%26two")
&ИсточникЗначение("ftp://webmaster@www.google.com/")
&ИсточникЗначение("ftp://john%20doe@www.google.com/")
&ИсточникЗначение("http://www.google.com/?")
&ИсточникЗначение("http://www.google.com/?q=go+language")
&ИсточникЗначение("http://www.google.com/?q=go%20language")
&ИсточникЗначение("http://www.google.com/a%20b?q=c+d")
&ИсточникЗначение("mailto:/webmaster@golang.org")
&ИсточникЗначение("mailto:webmaster@golang.org")
&ИсточникЗначение("/foo?query=http://bad")
&ИсточникЗначение("//foo")
&ИсточникЗначение("//user@foo/path?a=b")
&ИсточникЗначение("///threeslashes")
&ИсточникЗначение("http://user:password@google.com")
&ИсточникЗначение("http://%3Fam:pa%3Fsword@google.com")
&ИсточникЗначение("http://host/p@th?q=@go")
&ИсточникЗначение("a/b/c")
&ИсточникЗначение("http://192.168.0.1/")
&ИсточникЗначение("http://192.168.0.1:8080/")
&ИсточникЗначение("http://[fe80::1]/")
&ИсточникЗначение("http://[fe80::1]:8080/")
&ИсточникЗначение("mysql://a,b,c/bar")
&ИсточникЗначение("http://host/!$&'()*+,;=:@")
