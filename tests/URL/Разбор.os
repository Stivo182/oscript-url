&ИсточникЗначение("http://host/?q=go+language#foo%26bar")
&ИсточникЗначение("scheme:///path")
&ИсточникЗначение("//")
Процедура ТестДолжен_РазобратьПовторноБезПотериПредставления(ИсходнаяСтрока) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие
	ПовторноРазобранный = Новый URL(Адрес.ВСтроку());

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);
	Ожидаем.Что(ПовторноРазобранный.ВСтроку()).Равно(ИсходнаяСтрока);
	Ожидаем.Что(ПовторноРазобранный.РавенПоКомпонентам(Адрес)).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("http://google.com", "http", "google.com", "")
&ИсточникЗначение("http://google.com/", "http", "google.com", "/")
&ИсточникЗначение("file:///C:/a.txt", "file", "", "/C:/a.txt")
&ИсточникЗначение("mailto:user@example.com", "mailto", Неопределено, "user@example.com")
&ИсточникЗначение("//foo", Неопределено, "foo", "")
&ИсточникЗначение("///three", Неопределено, "", "/three")
&ИсточникЗначение("a/b/c", Неопределено, Неопределено, "a/b/c")
&ИсточникЗначение("http://192.0.2.1/", "http", "192.0.2.1", "/")
&ИсточникЗначение("http://[2001:db8::1]/", "http", "[2001:db8::1]", "/")
&ИсточникЗначение("x://a,b,c/p", "x", "a,b,c", "/p")
Процедура ТестДолжен_ВыделитьОсновныеКомпоненты(
	ИсходнаяСтрока, ОжидаемаяСхема, ОжидаемыйХост, ОжидаемыйПуть
) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие и Проверка
	Ожидаем.Что(Адрес.Схема()).Равно(ОжидаемаяСхема);
	Ожидаем.Что(Адрес.Хост()).Равно(ОжидаемыйХост);
	Ожидаем.Что(Адрес.КодированныйПуть()).Равно(ОжидаемыйПуть);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("http://u:p@h:80/p?q#f", "u:p", "80", "q", "f")
&ИсточникЗначение("http://u@h/p", "u", Неопределено, Неопределено, Неопределено)
&ИсточникЗначение("http://u:@h/p", "u:", Неопределено, Неопределено, Неопределено)
&ИсточникЗначение("http://h:/p", Неопределено, "", Неопределено, Неопределено)
&ИсточникЗначение("http://h/p?", Неопределено, Неопределено, "", Неопределено)
&ИсточникЗначение("http://h/p#", Неопределено, Неопределено, Неопределено, "")
&ИсточникЗначение("http://h/p?#", Неопределено, Неопределено, "", "")
&ИсточникЗначение("?q=http://x", Неопределено, Неопределено, "q=http://x", Неопределено)
&ИсточникЗначение("#a%20b", Неопределено, Неопределено, Неопределено, "a%20b")
&ИсточникЗначение("//u:p@h:8080", "u:p", "8080", Неопределено, Неопределено)
Процедура ТестДолжен_ВыделитьНеобязательныеКомпоненты(
	ИсходнаяСтрока, ДанныеПользователя, Порт, Запрос, Фрагмент
) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие и Проверка
	Ожидаем.Что(Адрес.КодированныеДанныеПользователя()).Равно(ДанныеПользователя);
	Ожидаем.Что(Адрес.ТекстПорта()).Равно(Порт);
	Ожидаем.Что(Адрес.КодированныйЗапрос()).Равно(Запрос);
	Ожидаем.Что(Адрес.КодированныйФрагмент()).Равно(Фрагмент);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("", Неопределено, "", Ложь, Неопределено, Неопределено)
&ИсточникЗначение("mailto:user@example.com", "mailto", "user@example.com", Ложь, Неопределено, Неопределено)
&ИсточникЗначение("/path", Неопределено, "/path", Ложь, Неопределено, Неопределено)
&ИсточникЗначение("//example.com/path", Неопределено, "/path", Истина, Неопределено, Неопределено)
&ИсточникЗначение("https://example.com/", "https", "/", Истина, Неопределено, Неопределено)
&ИсточникЗначение("https://example.com", "https", "", Истина, Неопределено, Неопределено)
&ИсточникЗначение("?x=1", Неопределено, "", Ложь, "x=1", Неопределено)
&ИсточникЗначение("#top", Неопределено, "", Ложь, Неопределено, "top")
Процедура ТестДолжен_РазобратьСтруктурныеФормыURL(
	ИсходнаяСтрока, ОжидаемаяСхема, ОжидаемыйПуть, ОжидаетсяСервернаяЧасть, ОжидаемыйЗапрос, ОжидаемыйФрагмент
) Экспорт

	// Действие
	Адрес = Новый URL(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);
	Ожидаем.Что(Адрес.Схема()).Равно(ОжидаемаяСхема);
	Ожидаем.Что(Адрес.КодированныйПуть()).Равно(ОжидаемыйПуть);
	Ожидаем.Что(Адрес.СервернаяЧастьОпределена()).Равно(ОжидаетсяСервернаяЧасть);
	Ожидаем.Что(Адрес.КодированныйЗапрос()).Равно(ОжидаемыйЗапрос);
	Ожидаем.Что(Адрес.КодированныйФрагмент()).Равно(ОжидаемыйФрагмент);
	ПроверитьПовторныйРазборБезПотерь(Адрес);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСчитатьКодированныйСлешРазделителемПути() Экспорт

	// Подготовка
	ИсходнаяСтрока = "/a%2Fb/c";

	// Действие
	Адрес = Новый URL(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Адрес.КодированныйПуть()).Равно(ИсходнаяСтрока);
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);
	ПроверитьПовторныйРазборБезПотерь(Адрес);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("/%", "url.invalid_percent_encoding")
&ИсточникЗначение("/%1", "url.invalid_percent_encoding")
&ИсточникЗначение("/%ZZ", "url.invalid_percent_encoding")
Процедура ТестДолжен_ОтклонитьНедопустимуюИсходнуюСтрокуURL(Значение, ОжидаемыйКодОшибки) Экспорт

	// Подготовка
	_НедопустимыйURL = Значение;

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "СоздатьНедопустимыйURL"),
		ОжидаемыйКодОшибки
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьНедопустимыйURL() Экспорт

	Адрес = Новый URL(_НедопустимыйURL);

КонецПроцедуры

Процедура ПроверитьПовторныйРазборБезПотерь(Адрес)

	Копия = Новый URL(Адрес.ВСтроку());
	Ожидаем.Что(Копия.ВСтроку()).Равно(Адрес.ВСтроку());

КонецПроцедуры

#КонецОбласти
