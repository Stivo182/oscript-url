#Использовать asserts
#Использовать errors
#Использовать "../../src"
#Использовать "../fixtures"

Перем _Адрес; // URL
Перем _Значение; // Произвольный

#Область Тесты

&Тест
Процедура ТестДолжен_УстановитьДекодированнуюСтруктурнуюСервернуюЧасть() Экспорт

	// Подготовка
	Адрес = Новый URL("https:/a");

	// Действие
	Результат = Адрес.УстановитьСервернуюЧасть("user name:pass@example.com:080");

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://user%20name:pass@example.com:080/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьХостССимволамиUnicodeВДекодированнойСервернойЧасти() Экспорт

	// Подготовка
	Адрес = Новый URL("https:/a");

	// Действие
	Адрес.УстановитьСервернуюЧасть("пользователь@пример.рф:080");

	// Проверка
	Ожидаем.Что(Адрес.Хост()).Равно("пример.рф");
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://пользователь@пример.рф:080/a");
	ФрагментыКодированнойСтроки = Новый Массив;
	ФрагментыКодированнойСтроки.Добавить(
		"https://%D0%BF%D0%BE%D0%BB%D1%8C%D0%B7%D0%BE%D0%B2%D0%B0%D1%82%D0%B5%D0%BB%D1%8C@"
	);
	ФрагментыКодированнойСтроки.Добавить(
		"%D0%BF%D1%80%D0%B8%D0%BC%D0%B5%D1%80.%D1%80%D1%84:080/a"
	);
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно(СтрСоединить(ФрагментыКодированнойСтроки, ""));

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьКодированнуюСервернуюЧастьБезНормализации() Экспорт

	// Подготовка
	Адрес = Новый URL("https://old/a");

	// Действие
	Результат = Адрес.УстановитьКодированнуюСервернуюЧасть("u%73er@exa%6Dple.com:080");

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://u%73er@exa%6Dple.com:080/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_АтомарноОтклонитьСтруктурныеСкобкиВДанныхПользователя() Экспорт

	// Подготовка
	Адрес = Новый URL("https://old:80/a");
	_Адрес = Адрес;
	_Значение = "u[ser]@host";
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "УстановитьСервернуюЧастьДляТеста"),
		"url.invalid_authority"
	);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://host/a", "https:/a")
&ИсточникЗначение("https://user:pass@host:080/a", "https:/a")
Процедура ТестДолжен_ОчиститьВсеСоставляющиеСервернойЧасти(
	ИсходнаяСтрока, ОжидаемаяСтрока
) Экспорт

	// Подготовка
	Адрес = Новый URL(ИсходнаяСтрока);

	// Действие
	Адрес.УстановитьСервернуюЧасть(Неопределено);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ОжидаемаяСтрока);
	Ожидаем.Что(Адрес.СервернаяЧасть()).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("", "https://host:")
&ИсточникЗначение("080", "https://host:080")
&ИсточникЗначение(80, "https://host:80")
&ИсточникЗначение(8080, "https://host:8080")
&ИсточникЗначение(65536, "https://host:65536")
Процедура ТестДолжен_УстановитьПортИзСтрокиИЧисла(Значение, ОжидаемаяСтрока) Экспорт

	// Подготовка
	Адрес = Новый URL("https://host");

	// Действие
	Результат = Адрес.УстановитьПорт(Значение);

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьПортВместеСРазделителем() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host:080/a");

	// Действие
	Адрес.УстановитьПорт(Неопределено);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://host/a");
	Ожидаем.Что(Адрес.ТекстПорта()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСоздатьСервернуюЧастьПриУдаленииОтсутствующегоПорта() Экспорт

	// Подготовка
	Адрес = Новый URL("x:/a");

	// Действие
	Результат = Адрес.УстановитьПорт(Неопределено);

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("x:/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_АвтоматическиСоздатьСервернуюЧастьДляПорта() Экспорт

	// Подготовка
	Адрес = Новый URL("x:/a");

	// Действие
	Адрес.УстановитьПорт(80);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("x://:80/a");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("8a")
&ИсточникЗначение(-1)
&ИсточникЗначение(1.5)
Процедура ТестДолжен_АтомарноОтклонитьНедопустимыйПорт(Значение) Экспорт

	// Подготовка
	Адрес = Новый URL("https://host:80/a");
	_Адрес = Адрес;
	_Значение = Значение;
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "УстановитьПортДляТеста"),
		"argument.invalid_value"
	);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_АтомарноОтклонитьНедопустимыйТипПорта() Экспорт

	// Подготовка
	Адрес = Новый URL("https://host:80/a");
	_Адрес = Адрес;
	_Значение = Null;
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "УстановитьПортДляТеста"),
		"argument.invalid_type"
	);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьСервернуюЧастьДляТеста() Экспорт

	_Адрес.УстановитьСервернуюЧасть(_Значение);

КонецПроцедуры

Процедура УстановитьПортДляТеста() Экспорт

	_Адрес.УстановитьПорт(_Значение);

КонецПроцедуры

#КонецОбласти
