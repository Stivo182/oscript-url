#Использовать asserts
#Использовать "../../src"
#Использовать "../fixtures"

Перем _НедопустимыйIDNURL; // URL

#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьIDNХостДляМеждународногоДомена() Экспорт

	// Подготовка
	Адрес = Новый URL("https://пример.рф/");

	// Действие
	Результат = Адрес.IDNХост();

	// Проверка
	Ожидаем.Что(Результат).Равно("xn--e1afmkfd.xn--p1ai");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://EXAMPLE.com/", "example.com")
&ИсточникЗначение("https://xn--e1afmkfd.xn--p1ai/", "xn--e1afmkfd.xn--p1ai")
&ИсточникЗначение("https://xn--fa-hia.de/", "xn--fa-hia.de")
&ИсточникЗначение("https://XN--FA-HIA.DE/", "xn--fa-hia.de")
&ИсточникЗначение("https://%78%6e--fa-hia.de/", "xn--fa-hia.de")
&ИсточникЗначение("https://xn--fa-hia.пример/", "xn--fa-hia.xn--e1afmkfd")
&ИсточникЗначение("https://example.com./", "example.com.")
&ИсточникЗначение("https://192.0.2.1/", "192.0.2.1")
&ИсточникЗначение("https://[2001:db8::1]/", "[2001:db8::1]")
&ИсточникЗначение("x://[v1.a]/", "[v1.a]")
Процедура ТестДолжен_ВернутьIDNХостДляРазныхВидовХоста(Значение, ОжидаемыйХост) Экспорт

	// Подготовка
	Адрес = Новый URL(Значение);

	// Действие
	Результат = Адрес.IDNХост();

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемыйХост);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://xn--invalid-/")
&ИсточникЗначение("https://.example/")
&ИсточникЗначение("https://example..com/")
&ИсточникЗначение("https://-a/")
&ИсточникЗначение("https://a-/")
&ИсточникЗначение("https://ab--cd/")
&ИсточникЗначение("https://a_b/")
&ИсточникЗначение("https://-é/")
&ИсточникЗначение("https://é-/")
&ИсточникЗначение("https://ab--é/")
&ИсточникЗначение("https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/")
Процедура ТестДолжен_ОтклонитьНедопустимыйIDNХост(Значение) Экспорт

	// Подготовка
	_НедопустимыйIDNURL = Новый URL(Значение);

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "ПолучитьIDNХостНедопустимогоURL"),
		"url.invalid_host"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьIDNХостДлиннее253Октетов() Экспорт

	// Подготовка
	Метка63 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
	Метка62 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
	Хост = Метка63 + "." + Метка63 + "." + Метка63 + "." + Метка62;
	_НедопустимыйIDNURL = Новый URL("https://" + Хост + "/");

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "ПолучитьIDNХостНедопустимогоURL"),
		"url.invalid_host"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеопределеноДляURLБезХоста() Экспорт

	// Подготовка
	Адрес = Новый URL("/path");

	// Действие
	Результат = Адрес.IDNХост();

	// Проверка
	Ожидаем.Что(Результат).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(223, "fa", ".de", "xn--fa-hia.de")
&ИсточникЗначение(7838, "FA", ".de", "xn--fa-hia.de")
Процедура ТестДолжен_ПрименитьНепереходноеСопоставлениеUTS46(
	КодоваяТочка, Префикс, Суффикс, ОжидаемыйХост
) Экспорт

	// Подготовка
	Адрес = Новый URL("https://" + Префикс + Символ(КодоваяТочка) + Суффикс + "/");

	// Действие
	Результат = Адрес.IDNХост();

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемыйХост);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьСоединительВНедопустимомКонтексте() Экспорт

	// Подготовка
	_НедопустимыйIDNURL = Новый URL("https://a" + Символ(8205) + "b/");

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "ПолучитьIDNХостНедопустимогоURL"),
		"url.invalid_host"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьЗапрещеннуюUnicodeМеткуПриПреобразованииВIDN() Экспорт

	// Подготовка
	_НедопустимыйIDNURL = Новый URL("https://a" + Символ(1488) + "/");

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "ПолучитьIDNХостНедопустимогоURL"),
		"url.invalid_host"
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПолучитьIDNХостНедопустимогоURL() Экспорт

	_НедопустимыйIDNURL.IDNХост();

КонецПроцедуры

#КонецОбласти
