#Использовать asserts
#Использовать errors
#Использовать "../../src"

Перем _НеоднозначнаяСервернаяЧасть; // Строка

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("scheme:/p", Неопределено, Неопределено, Неопределено, "/p", Ложь, Ложь, Ложь)
&ИсточникЗначение("scheme:///p", "", "", Неопределено, "/p", Истина, Ложь, Ложь)
&ИсточникЗначение("scheme://@/p", "@", "", Неопределено, "/p", Истина, Истина, Ложь)
&ИсточникЗначение("scheme://host:/p", "host:", "host", "", "/p", Истина, Ложь, Истина)
Процедура ТестДолжен_СохранитьСостояниеСервернойЧасти(
	ИсходнаяСтрока,
	ОжидаемаяСервернаяЧасть,
	ОжидаемыйХост,
	ОжидаемыйПорт,
	ОжидаемыйПуть,
	ОжидаетсяСервернаяЧасть,
	ОжидаютсяДанныеПользователя,
	ОжидаетсяПорт
) Экспорт

	// Действие
	Адрес = Новый URL(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Адрес.КодированнаяСервернаяЧасть()).Равно(ОжидаемаяСервернаяЧасть);
	Ожидаем.Что(Адрес.КодированныйХост()).Равно(ОжидаемыйХост);
	Ожидаем.Что(Адрес.ТекстПорта()).Равно(ОжидаемыйПорт);
	Ожидаем.Что(Адрес.КодированныйПуть()).Равно(ОжидаемыйПуть);
	Ожидаем.Что(Адрес.КодированнаяСервернаяЧасть() <> Неопределено).Равно(ОжидаетсяСервернаяЧасть);
	Ожидаем.Что(Адрес.КодированныеДанныеПользователя() <> Неопределено).Равно(ОжидаютсяДанныеПользователя);
	Ожидаем.Что(Адрес.ТекстПорта() <> Неопределено).Равно(ОжидаетсяПорт);
	ПроверитьПовторныйРазборБезПотерь(Адрес);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличатьОтсутствующийИПустойПорт() Экспорт

	// Действие
	БезПорта = Новый URL("scheme://host/p");
	ПустойПорт = Новый URL("scheme://host:/p");

	// Проверка
	Ожидаем.Что(БезПорта.ТекстПорта()).Равно(Неопределено);
	Ожидаем.Что(ПустойПорт.ТекстПорта()).Равно("");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://example.com/path", "/path", Неопределено, Неопределено)
&ИсточникЗначение("https://example.com/path?", "/path", "", Неопределено)
&ИсточникЗначение("https://example.com/path#", "/path", Неопределено, "")
&ИсточникЗначение("https://example.com/path?#", "/path", "", "")
&ИсточникЗначение("https://example.com?", "", "", Неопределено)
&ИсточникЗначение("https://example.com#", "", Неопределено, "")
&ИсточникЗначение("https://example.com?#", "", "", "")
Процедура ТестДолжен_РазличатьОтсутствующиеИПустыеЗапросИФрагмент(
	ИсходнаяСтрока, ОжидаемыйПуть, ОжидаемыйЗапрос, ОжидаемыйФрагмент
) Экспорт

	// Действие
	Адрес = Новый URL(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Адрес.КодированныйПуть()).Равно(ОжидаемыйПуть);
	Ожидаем.Что(Адрес.КодированнаяСтрокаЗапроса()).Равно(ОжидаемыйЗапрос);
	Ожидаем.Что(Адрес.КодированныйФрагмент()).Равно(ОжидаемыйФрагмент);
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);
	ПроверитьПовторныйРазборБезПотерь(Адрес);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://user@host/", "user")
&ИсточникЗначение("https://user:@host/", "user:")
&ИсточникЗначение("https://:pass@host/", ":pass")
&ИсточникЗначение("https://@host/", "")
&ИсточникЗначение("https://user:p:a@host/", "user:p:a")
&ИсточникЗначение("https://user%3Aname:p@host/", "user%3Aname:p")
Процедура ТестДолжен_СохранитьКодированныеДанныеПользователя(ИсходнаяСтрока, ОжидаемыеДанныеПользователя) Экспорт

	// Действие
	Адрес = Новый URL(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Адрес.КодированныеДанныеПользователя()).Равно(ОжидаемыеДанныеПользователя);
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);
	ПроверитьПовторныйРазборБезПотерь(Адрес);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("http://j@ne:password@google.com")
&ИсточникЗначение("http://jane:p@ssword@google.com")
&ИсточникЗначение("http://a@b@c")
&ИсточникЗначение("http://@@host")
&ИсточникЗначение("http://user@@host/path")
&ИсточникЗначение("http://user:p@@host/path")
Процедура ТестДолжен_ОтклонитьНеоднозначныйРазделительДанныхПользователя(СтрокаАдреса) Экспорт

	// Подготовка
	_НеоднозначнаяСервернаяЧасть = СтрокаАдреса;

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "СоздатьURLСНеоднозначнойСервернойЧастью"),
		"url.invalid_authority"
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПовторныйРазборБезПотерь(Адрес)

	Копия = Новый URL(Адрес.ВСтроку());
	Ожидаем.Что(Копия.ВСтроку()).Равно(Адрес.ВСтроку());

КонецПроцедуры

Процедура СоздатьURLСНеоднозначнойСервернойЧастью() Экспорт

	Адрес = Новый URL(_НеоднозначнаяСервернаяЧасть);

КонецПроцедуры

#КонецОбласти
