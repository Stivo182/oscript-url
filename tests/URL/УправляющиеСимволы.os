#Использовать asserts
#Использовать "../../src"
#Использовать "../fixtures"

Перем _НедопустимаяСтрока; // Строка

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение(10, "http://exa", "mple.com/", "url.invalid_host")
&ИсточникЗначение(13, "http://example.com/a", "b", "url.invalid_syntax")
&ИсточникЗначение(127, "http://example.com/?a", "b", "url.invalid_syntax")
&ИсточникЗначение(0, "http://exa", "mple.com/", "url.invalid_host")
&ИсточникЗначение(13, "http://exa", "mple.com/", "url.invalid_host")
&ИсточникЗначение(127, "http://exa", "mple.com/", "url.invalid_host")
&ИсточникЗначение(0, "http://example.com/a", "b", "url.invalid_syntax")
&ИсточникЗначение(10, "http://example.com/a", "b", "url.invalid_syntax")
&ИсточникЗначение(127, "http://example.com/a", "b", "url.invalid_syntax")
&ИсточникЗначение(0, "http://example.com/?a", "b", "url.invalid_syntax")
&ИсточникЗначение(10, "http://example.com/?a", "b", "url.invalid_syntax")
&ИсточникЗначение(13, "http://example.com/?a", "b", "url.invalid_syntax")
&ИсточникЗначение(0, "http://example.com/#a", "b", "url.invalid_syntax")
&ИсточникЗначение(10, "http://example.com/#a", "b", "url.invalid_syntax")
&ИсточникЗначение(13, "http://example.com/#a", "b", "url.invalid_syntax")
&ИсточникЗначение(127, "http://example.com/#a", "b", "url.invalid_syntax")
Процедура ТестДолжен_ОтклонитьБуквальныйУправляющийСимвол(
	КодСимвола, Префикс, Суффикс, ОжидаемыйКод
) Экспорт

	// Подготовка
	_НедопустимаяСтрока = Префикс + Символ(КодСимвола) + Суффикс;

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "СоздатьURLСУправляющимСимволом"),
		ОжидаемыйКод
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("/a%0Ab")
&ИсточникЗначение("/a%0Db")
&ИсточникЗначение("/a%7Fb")
&ИсточникЗначение("/a%00b")
&ИсточникЗначение("?a=%00%0A%0D%7F")
&ИсточникЗначение("#%00%0A%0D%7F")
Процедура ТестДолжен_ПринятьПроцентноеПредставлениеУправляющегоСимвола(СтрокаАдреса) Экспорт

	// Подготовка
	// Строка адреса передана параметром теста.

	// Действие
	Адрес = Новый URL(СтрокаАдреса);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(СтрокаАдреса);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьURLСУправляющимСимволом() Экспорт

	Адрес = Новый URL(_НедопустимаяСтрока);

КонецПроцедуры

#КонецОбласти
