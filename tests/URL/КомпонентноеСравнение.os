#Использовать asserts
#Использовать "../../src"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("/a%2f", "/a%2F", Истина)
&ИсточникЗначение("HTTP://Example.COM/a", "http://example.com/a", Истина)
&ИсточникЗначение("/%7e", "/~", Ложь)
&ИсточникЗначение("/a", "/a?", Ложь)
&ИсточникЗначение("x://host", "x://host:", Ложь)
Процедура ТестДолжен_СравнитьURLПоКомпонентам(ПервоеЗначение, ВтороеЗначение, ОжидаемоеРавенство) Экспорт

	// Подготовка
	Первое = Новый URL(ПервоеЗначение);
	Второе = Новый URL(ВтороеЗначение);

	// Действие
	Результат = Первое.РавенПоКомпонентам(Второе);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемоеРавенство);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СогласоватьСортировкуСРавенством() Экспорт

	// Подготовка
	Первое = Новый URL("HTTP://Example.COM/a%2f");
	Второе = Новый URL("http://example.com/a%2F");

	// Действие и Проверка
	Ожидаем.Что(Первое.Сравнить(Второе)).Равно(0);
	Ожидаем.Что(Второе.Сравнить(Первое)).Равно(0);
	Ожидаем.Что(Первое.РавенПоКомпонентам(Второе)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДетерминированноУпорядочитьURL() Экспорт

	// Подготовка
	Первое = Новый URL("http://example.com/a");
	Второе = Новый URL("http://example.com/b");
	Третье = Новый URL("http://example.com/b?");

	// Действие и Проверка
	Ожидаем.Что(Первое.Сравнить(Второе) < 0).ЭтоИстина();
	Ожидаем.Что(Второе.Сравнить(Первое) > 0).ЭтоИстина();
	Ожидаем.Что(Второе.Сравнить(Третье) < 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьТранзитивностьСортировки() Экспорт

	// Подготовка
	Первое = Новый URL("x:a");
	Второе = Новый URL("x:b");
	Третье = Новый URL("x:c");

	// Действие и Проверка
	Ожидаем.Что(Первое.Сравнить(Второе) < 0).ЭтоИстина();
	Ожидаем.Что(Второе.Сравнить(Третье) < 0).ЭтоИстина();
	Ожидаем.Что(Первое.Сравнить(Третье) < 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДелегироватьКомпонентноеСравнениеURL() Экспорт

	// Подготовка
	Первый = Новый URL("HTTP://Example.COM/a%2f");
	Второй = Новый URL("http://example.com/a%2F");

	// Действие и Проверка
	Ожидаем.Что(Первый.РавенПоКомпонентам(Второй)).ЭтоИстина();
	Ожидаем.Что(Первый.Сравнить(Второй)).Равно(0);

КонецПроцедуры

#КонецОбласти
