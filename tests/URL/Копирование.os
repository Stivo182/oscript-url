#Использовать asserts
#Использовать "../../src"

#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьНеизменяемыйСнимокСоИсходнымНаписаниемЗапроса() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/a?x=%2f");

	// Действие
	Снимок = Адрес.Скопировать();

	// Проверка
	Ожидаем.Что(Строка(ТипЗнч(Снимок))).Равно("URL");
	Ожидаем.Что(Снимок.ВСтроку()).Равно("https://example.com/a?x=%2f");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьНезависимыйURLИзURL() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/a?x=%2f");

	// Действие
	КопияURL = Новый URL(Адрес);
	КопияURL.УстановитьФрагмент("copy");

	// Проверка
	Ожидаем.Что(Строка(ТипЗнч(КопияURL))).Равно("URL");
	Ожидаем.Что(КопияURL.ВСтроку()).Равно("https://example.com/a?x=%2f#copy");
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://example.com/a?x=%2f");
	Ожидаем.Что(КопияURL).ЭтоНе().Идентично(Адрес);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьНезависимуюКопиюURLСоИсходнымНаписаниемЗапроса() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/a?x=%2f");

	// Действие
	Копия = Адрес.Скопировать();

	// Проверка
	Ожидаем.Что(Строка(ТипЗнч(Копия))).Равно("URL");
	Ожидаем.Что(Копия.ВСтроку()).Равно("https://example.com/a?x=%2f");
	Ожидаем.Что(Копия).ЭтоНе().Идентично(Адрес);
	Ожидаем.Что(Копия.Скопировать()).ЭтоНе().Идентично(Адрес.Скопировать());

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеМенятьИсходныйURLПриИзмененииПараметровЗапросаКопии() Экспорт

	// Подготовка
	ИсходныйАдрес = Новый URL("https://example.com/?a=1");
	Копия = ИсходныйАдрес.Скопировать();

	// Действие
	Копия.ПараметрыЗапроса().Установить("a", "2");

	// Проверка
	Ожидаем.Что(ИсходныйАдрес.ВСтроку()).Равно("https://example.com/?a=1");
	Ожидаем.Что(Копия.ВСтроку()).Равно("https://example.com/?a=2");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПредписанныеТипыПреобразований() Экспорт

	// Подготовка
	Адрес = Новый URL("HTTP://Example.COM/a/../b");

	// Действие
	Разрешенный = Адрес.Разрешить("c");
	Относительный = Адрес.СделатьОтносительным("http://example.com/b/c");
	Нормализованный = Адрес.Нормализованный();
	НормализованныйДляСхемы = Адрес.НормализованныйДляСхемы();
	Разрешенный.УстановитьФрагмент("resolved");
	Относительный.УстановитьФрагмент("relative");
	Нормализованный.УстановитьФрагмент("normalized");
	НормализованныйДляСхемы.УстановитьФрагмент("scheme");

	// Проверка
	Ожидаем.Что(Строка(ТипЗнч(Разрешенный))).Равно("URL");
	Ожидаем.Что(Строка(ТипЗнч(Относительный))).Равно("URL");
	Ожидаем.Что(Строка(ТипЗнч(Нормализованный))).Равно("URL");
	Ожидаем.Что(Строка(ТипЗнч(НормализованныйДляСхемы))).Равно("URL");
	Ожидаем.Что(Разрешенный.ВСтроку()).Равно("HTTP://Example.COM/c#resolved");
	Ожидаем.Что(Относительный.ВСтроку()).Равно("b/c#relative");
	Ожидаем.Что(Нормализованный.ВСтроку()).Равно("http://example.com/b#normalized");
	Ожидаем.Что(НормализованныйДляСхемы.ВСтроку()).Равно("http://example.com/b#scheme");
	Ожидаем.Что(Адрес.ВСтроку()).Равно("HTTP://Example.COM/a/../b");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СравнитьURL() Экспорт

	// Подготовка
	Адрес = Новый URL("HTTP://EXAMPLE.COM/%7e");
	Другой = Новый URL("http://example.com/~");
	ДругойАдрес = Новый URL("http://example.com/~");

	// Действие и Проверка
	Ожидаем.Что(Адрес.Равен(Другой)).ЭтоЛожь();
	Ожидаем.Что(Адрес.Эквивалентен(ДругойАдрес)).ЭтоИстина();
	Ожидаем.Что(Адрес.ЭквивалентенДляСхемы(Другой)).ЭтоИстина();

КонецПроцедуры

#КонецОбласти
