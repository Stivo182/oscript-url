#Использовать asserts
#Использовать errors
#Использовать "../../src"
#Использовать "../fixtures"

Перем _Адрес; // URL
Перем _Значение; // Произвольный

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("example.com", "https://example.com/a")
&ИсточникЗначение("127.0.0.1", "https://127.0.0.1/a")
&ИсточникЗначение("[2001:db8::1]", "https://[2001:db8::1]/a")
&ИсточникЗначение("2001:db8::1", "https://[2001:db8::1]/a")
&ИсточникЗначение("[v1.foo:bar]", "https://[v1.foo:bar]/a")
&ИсточникЗначение("v1.foo", "https://v1.foo/a")
Процедура ТестДолжен_УстановитьДопустимыйДекодированныйХост(Хост, ОжидаемаяСтрока) Экспорт

	// Подготовка
	Адрес = Новый URL("https://old/a");

	// Действие
	Результат = Адрес.УстановитьХост(Хост);

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("exa%6Dple.com")
&ИсточникЗначение("[::1]")
&ИсточникЗначение("[vF.a:b]")
Процедура ТестДолжен_СохранитьИсходноеНаписаниеКодированногоХоста(Хост) Экспорт

	// Подготовка
	Адрес = Новый URL("https://old/a");

	// Действие
	Адрес.УстановитьКодированныйХост(Хост);

	// Проверка
	Ожидаем.Что(Адрес.КодированныйХост()).Равно(Хост);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://" + Хост + "/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_АвтоматическиСоздатьСервернуюЧастьДляХоста() Экспорт

	// Подготовка
	Адрес = Новый URL("x:/a");

	// Действие
	Адрес.УстановитьХост("host");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("x://host/a");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("[v1.]")
&ИсточникЗначение("[not-ip]")
&ИсточникЗначение("host:80")
&ИсточникЗначение("XN--INVALID-")
&ИсточникЗначение("xn--zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
Процедура ТестДолжен_АтомарноОтклонитьНедопустимыйДекодированныйХост(Хост) Экспорт

	// Подготовка
	Адрес = Новый URL("https://old:80/a");
	_Адрес = Адрес;
	_Значение = Хост;
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "УстановитьХостДляТеста"),
		"uri.invalid_host"
	);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьМеждународноеДоменноеИмя() Экспорт

	// Подготовка
	Адрес = Новый URL("https://old/a");

	// Действие
	Адрес.УстановитьХост("пример.рф");

	// Проверка
	Ожидаем.Что(Адрес.Хост()).Равно("пример.рф");
	Ожидаем.Что(Адрес.КодированныйХост()).Равно("xn--e1afmkfd.xn--p1ai");
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://xn--e1afmkfd.xn--p1ai/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьРегистрASCIIМетокМеждународногоХоста() Экспорт

	// Подготовка
	Адрес = Новый URL("https://old/a");

	// Действие
	Адрес.УстановитьХост("EXAMPLE.пример");

	// Проверка
	Ожидаем.Что(Адрес.КодированныйХост()).Равно("EXAMPLE.xn--e1afmkfd");
	Ожидаем.Что(Адрес.Хост()).Равно("EXAMPLE.пример");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("%41é")
&ИсточникЗначение("example％com")
&ИсточникЗначение("example？com")
&ИсточникЗначение("example／com")
&ИсточникЗначение("example＠com")
Процедура ТестДолжен_АтомарноОтклонитьЗапрещенныйСимволДоменаПослеIDNA(Хост) Экспорт

	// Подготовка
	Адрес = Новый URL("https://old:80/a");
	_Адрес = Адрес;
	_Значение = Хост;
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "УстановитьХостДляТеста"),
		"uri.invalid_host"
	);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_АтомарноОтклонитьНедопустимыйМеждународныйХост() Экспорт

	// Подготовка
	Адрес = Новый URL("https://old:80/a");
	_Адрес = Адрес;
	_Значение = "a" + Символ(8205);
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "УстановитьХостДляТеста"),
		"uri.invalid_host"
	);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_АтомарноОтклонитьНедопустимыйКодированныйХост() Экспорт

	// Подготовка
	Адрес = Новый URL("https://old:80/a");
	_Адрес = Адрес;
	_Значение = "exa%ZZmple.com";
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "УстановитьКодированныйХостДляТеста"),
		"uri.invalid_percent_encoding"
	);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьХостДляТеста() Экспорт

	_Адрес.УстановитьХост(_Значение);

КонецПроцедуры

Процедура УстановитьКодированныйХостДляТеста() Экспорт

	_Адрес.УстановитьКодированныйХост(_Значение);

КонецПроцедуры

#КонецОбласти
