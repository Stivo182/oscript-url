#Использовать asserts
#Использовать errors
#Использовать "../../src"
#Использовать "../fixtures"

Перем _Адрес; // URL
Перем _Значение; // Произвольный

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("example.com", "https://example.com/a")
&ИсточникЗначение("127.0.0.1", "https://127.0.0.1/a")
&ИсточникЗначение("[2001:db8::1]", "https://[2001:db8::1]/a")
&ИсточникЗначение("2001:db8::1", "https://[2001:db8::1]/a")
&ИсточникЗначение("[v1.foo:bar]", "https://[v1.foo:bar]/a")
&ИсточникЗначение("v1.foo", "https://v1.foo/a")
&ИсточникЗначение("XN--INVALID-", "https://XN--INVALID-/a")
&ИсточникЗначение(
	"xn--zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz",
	"https://xn--zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz/a"
)
Процедура ТестДолжен_УстановитьДопустимыйДекодированныйХост(Хост, ОжидаемаяСтрока) Экспорт

	// Подготовка
	Адрес = Новый URL("https://old/a");

	// Действие
	Результат = Адрес.УстановитьХост(Хост);

	// Проверка
	Ожидаем.Что(Результат).Идентично(Адрес);
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("exa%6Dple.com")
&ИсточникЗначение("[::1]")
&ИсточникЗначение("[vF.a:b]")
Процедура ТестДолжен_СохранитьИсходноеНаписаниеКодированногоХоста(Хост) Экспорт

	// Подготовка
	Адрес = Новый URL("https://old/a");

	// Действие
	Адрес.УстановитьКодированныйХост(Хост);

	// Проверка
	Ожидаем.Что(Адрес.КодированныйХост()).Равно(Хост);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://" + Хост + "/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_АвтоматическиСоздатьСервернуюЧастьДляХоста() Экспорт

	// Подготовка
	Адрес = Новый URL("x:/a");

	// Действие
	Адрес.УстановитьХост("host");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("x://host/a");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("[v1.]")
&ИсточникЗначение("[not-ip]")
&ИсточникЗначение("host:80")
Процедура ТестДолжен_АтомарноОтклонитьНедопустимыйДекодированныйХост(Хост) Экспорт

	// Подготовка
	Адрес = Новый URL("https://old:80/a");
	_Адрес = Адрес;
	_Значение = Хост;
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "УстановитьХостДляТеста"),
		"uri.invalid_host"
	);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьХостССимволамиUnicode() Экспорт

	// Подготовка
	Адрес = Новый URL("https://old/a");

	// Действие
	Адрес.УстановитьХост("пример.рф");

	// Проверка
	Ожидаем.Что(Адрес.Хост()).Равно("пример.рф");
	Ожидаем.Что(Адрес.КодированныйХост()).Равно("%D0%BF%D1%80%D0%B8%D0%BC%D0%B5%D1%80.%D1%80%D1%84");
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://пример.рф/a");
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно(
		"https://%D0%BF%D1%80%D0%B8%D0%BC%D0%B5%D1%80.%D1%80%D1%84/a"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьРегистрASCIIМетокХостаССимволамиUnicode() Экспорт

	// Подготовка
	Адрес = Новый URL("https://old/a");

	// Действие
	Адрес.УстановитьХост("EXAMPLE.пример");

	// Проверка
	Ожидаем.Что(Адрес.КодированныйХост()).Равно("EXAMPLE.%D0%BF%D1%80%D0%B8%D0%BC%D0%B5%D1%80");
	Ожидаем.Что(Адрес.Хост()).Равно("EXAMPLE.пример");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("%41é", "%2541%C3%A9", "%2541é")
&ИсточникЗначение("example％com", "example%EF%BC%85com", "example％com")
&ИсточникЗначение("example？com", "example%EF%BC%9Fcom", "example？com")
&ИсточникЗначение("example／com", "example%EF%BC%8Fcom", "example／com")
&ИсточникЗначение("example＠com", "example%EF%BC%A0com", "example＠com")
Процедура ТестДолжен_ЗакодироватьСимволыUnicodeВХостеБезIDNA(
	Хост,
	КодированныйХост,
	ПредставлениеХоста
) Экспорт

	// Подготовка
	Адрес = Новый URL("https://old/a");

	// Действие
	Адрес.УстановитьХост(Хост);

	// Проверка
	Ожидаем.Что(Адрес.Хост()).Равно(Хост);
	Ожидаем.Что(Адрес.КодированныйХост()).Равно(КодированныйХост);
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://" + ПредставлениеХоста + "/a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПринятьДопустимыйДляURIХостБезПроверкиIDNA() Экспорт

	// Подготовка
	Адрес = Новый URL("https://old/a");
	Хост = "a" + Символ(8205);

	// Действие
	Адрес.УстановитьХост(Хост);

	// Проверка
	Ожидаем.Что(Адрес.Хост()).Равно(Хост);
	Ожидаем.Что(Адрес.КодированныйХост()).Равно("a%E2%80%8D");

КонецПроцедуры

&Тест
Процедура ТестДолжен_АтомарноОтклонитьНедопустимыйКодированныйХост() Экспорт

	// Подготовка
	Адрес = Новый URL("https://old:80/a");
	_Адрес = Адрес;
	_Значение = "exa%ZZmple.com";
	ИсходнаяСтрока = Адрес.ВСтроку();

	// Действие
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "УстановитьКодированныйХостДляТеста"),
		"uri.invalid_percent_encoding"
	);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьХостДляТеста() Экспорт

	_Адрес.УстановитьХост(_Значение);

КонецПроцедуры

Процедура УстановитьКодированныйХостДляТеста() Экспорт

	_Адрес.УстановитьКодированныйХост(_Значение);

КонецПроцедуры

#КонецОбласти
