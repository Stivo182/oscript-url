#Использовать asserts
#Использовать "../../src"
#Использовать "../fixtures"

#Область Тесты

&Тест
Процедура ТестДолжен_ПринятьХостССимволамиUnicodeВСтроковомКонструкторе() Экспорт

	// Подготовка
	ИсходнаяСтрока = "https://пример.рф/";

	// Действие
	Адрес = Новый URL(ИсходнаяСтрока);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходнаяСтрока);
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно(
		"https://%D0%BF%D1%80%D0%B8%D0%BC%D0%B5%D1%80.%D1%80%D1%84/"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьURLПоУмолчанию() Экспорт

	// Действие
	Адрес = Новый URL;

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("");
	Ожидаем.Что(Адрес.Схема()).Равно(Неопределено);
	Ожидаем.Что(Адрес.Хост()).Равно(Неопределено);
	Ожидаем.Что(Адрес.Путь()).Равно("");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Строка", "https://example.com/a?x=%2f", "https://example.com/a?x=%2f")
&ИсточникЗначение("URL", "https://example.com/a?x=%2f", "https://example.com/a?x=%2f")
Процедура ТестДолжен_СоздатьАбсолютныйURLБезБазы(ВидАдреса, Значение, ОжидаемаяСтрока) Экспорт

	// Подготовка
	Адрес = СоздатьЗначение(ВидАдреса, Значение);

	// Действие
	Результат = Новый URL(Адрес);

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Строка", "../c?x=%2f", "Строка", "https://example.com/a/c?x=%2f")
&ИсточникЗначение("URL", "../c?x=%2f", "URL", "https://example.com/a/c?x=%2f")
&ИсточникЗначение("URL", "https://other.example.com/c?x=%2f", "URL", "https://other.example.com/c?x=%2f")
Процедура ТестДолжен_РазрешитьАдресОтносительноАбсолютнойБазы(
	ВидАдреса, Значение, ВидБазы, ОжидаемаяСтрока
) Экспорт

	// Подготовка
	Адрес = СоздатьЗначение(ВидАдреса, Значение);
	База = СоздатьЗначение(ВидБазы, "https://example.com/a/b/");

	// Действие
	Результат = Новый URL(Адрес, База);

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьАбсолютныйАдресПриЗаданнойБазе() Экспорт

	// Подготовка
	База = Новый URL("https://example.com/a/b/");

	// Действие
	Результат = Новый URL("https://other.example.com/a", База);

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно("https://other.example.com/a");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Строка", "a/b", "Строка")
&ИсточникЗначение("URL", "a/b", "URL")
&ИсточникЗначение("URL", "https://example.com/a", "Строка")
Процедура ТестДолжен_ОтклонитьОтносительнуюБазу(ВидАдреса, Значение, ВидБазы) Экспорт

	// Подготовка
	Адрес = СоздатьЗначение(ВидАдреса, Значение);
	База = СоздатьЗначение(ВидБазы, "a/b");

	// Действие и Проверка
	ПроверитьКодОшибкиСоздания(Адрес, База, Истина, "url.base_not_absolute");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеопределенныйАдресПриЗаданнойБазе() Экспорт

	// Подготовка
	База = Новый URL("https://example.com/");

	// Действие и Проверка
	ПроверитьКодОшибкиСоздания(Неопределено, База, Истина, "argument.required");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Null)
&ИсточникЗначение(42)
Процедура ТестДолжен_ОтклонитьНедопустимыйТипАдреса(Адрес) Экспорт

	// Действие и Проверка
	ПроверитьКодОшибкиСоздания(Адрес, Неопределено, Ложь, "argument.invalid_type");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Null)
&ИсточникЗначение(42)
Процедура ТестДолжен_ОтклонитьНедопустимыйТипБазы(База) Экспорт

	// Действие и Проверка
	ПроверитьКодОшибкиСоздания("https://example.com/", База, Истина, "argument.invalid_type");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Null, "https://example.com/")
&ИсточникЗначение(42, "https://example.com/")
&ИсточникЗначение(Null, "a/b")
&ИсточникЗначение(42, "a/b")
Процедура ТестДолжен_ОтклонитьНедопустимыйТипАдресаНезависимоОтБазы(Адрес, СтрокаБазы) Экспорт

	// Подготовка
	База = Новый URL(СтрокаБазы);

	// Действие и Проверка
	ПроверитьКодОшибкиСоздания(Адрес, База, Истина, "argument.invalid_type");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьКомпонентыВНезависимойКопии() Экспорт

	// Подготовка
	Адрес = Новый URL("https://user%20name:p%40ss@example.com:443/a%2Fb?x=%2f#f%20g");

	// Действие
	Снимок = Адрес.Скопировать();

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(Снимок.ВСтроку());
	Ожидаем.Что(Адрес.Схема()).Равно(Снимок.Схема());
	Ожидаем.Что(Адрес.СервернаяЧасть()).Равно(Снимок.СервернаяЧасть());
	Ожидаем.Что(Адрес.КодированнаяСервернаяЧасть()).Равно(Снимок.КодированнаяСервернаяЧасть());
	Ожидаем.Что(Адрес.ДанныеПользователя()).Равно(Снимок.ДанныеПользователя());
	Ожидаем.Что(Адрес.КодированныеДанныеПользователя()).Равно(Снимок.КодированныеДанныеПользователя());
	Ожидаем.Что(Адрес.ИмяПользователя()).Равно(Снимок.ИмяПользователя());
	Ожидаем.Что(Адрес.КодированноеИмяПользователя()).Равно(Снимок.КодированноеИмяПользователя());
	Ожидаем.Что(Адрес.Пароль()).Равно(Снимок.Пароль());
	Ожидаем.Что(Адрес.КодированныйПароль()).Равно(Снимок.КодированныйПароль());
	Ожидаем.Что(Адрес.Хост()).Равно(Снимок.Хост());
	Ожидаем.Что(Адрес.КодированныйХост()).Равно(Снимок.КодированныйХост());
	Ожидаем.Что(Адрес.ТекстПорта()).Равно(Снимок.ТекстПорта());
	Ожидаем.Что(Адрес.Порт()).Равно(Снимок.Порт());
	Ожидаем.Что(Адрес.ПортУказан()).Равно(Снимок.ПортУказан());
	Ожидаем.Что(Адрес.СтандартныйПорт()).Равно(Снимок.СтандартныйПорт());
	Ожидаем.Что(Адрес.ЭффективныйПорт()).Равно(Снимок.ЭффективныйПорт());
	Ожидаем.Что(Адрес.ИспользуетСтандартныйПорт()).Равно(Снимок.ИспользуетСтандартныйПорт());
	Ожидаем.Что(Адрес.Путь()).Равно(Снимок.Путь());
	Ожидаем.Что(Адрес.КодированныйПуть()).Равно(Снимок.КодированныйПуть());
	Ожидаем.Что(Адрес.СегментыПути().Количество()).Равно(Снимок.СегментыПути().Количество());
	Ожидаем.Что(Адрес.СегментыПути()[1]).Равно(Снимок.СегментыПути()[1]);
	Ожидаем.Что(Адрес.КодированныеСегментыПути()[1]).Равно(Снимок.КодированныеСегментыПути()[1]);
	Ожидаем.Что(Адрес.ПутьИЗапрос()).Равно(Снимок.ПутьИЗапрос());
	Ожидаем.Что(Адрес.Запрос()).Равно(Снимок.Запрос());
	Ожидаем.Что(Адрес.КодированныйЗапрос()).Равно(Снимок.КодированныйЗапрос());
	Ожидаем.Что(Адрес.Фрагмент()).Равно(Снимок.Фрагмент());
	Ожидаем.Что(Адрес.КодированныйФрагмент()).Равно(Снимок.КодированныйФрагмент());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьЗначение(Вид, Значение)

	Если Вид = "URL" Тогда
		Возврат Новый URL(Значение);
	КонецЕсли;

	Возврат Значение;

КонецФункции

Процедура ПроверитьКодОшибкиСоздания(Адрес, База, БазаЗадана, ОжидаемыйКод)

	Попытка
		Если БазаЗадана Тогда
			Результат = Новый URL(Адрес, База);
		Иначе
			Результат = Новый URL(Адрес);
		КонецЕсли;

	Исключение
		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке())).Равно(ОжидаемыйКод);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалось исключение с кодом " + ОжидаемыйКод;

КонецПроцедуры

#КонецОбласти
