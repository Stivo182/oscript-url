#Использовать asserts
#Использовать errors
#Использовать "../../src"
#Использовать "../fixtures"

Перем _ЗначениеДляРазбора;
Перем _СхемаПоУмолчаниюДляРазбора;

#Область Тесты

&Тест
Процедура ТестДолжен_ДобавитьПодразумеваемуюСхемуКСерверномуАдресу() Экспорт

	// Подготовка
	Значение = "hub.example/private";

	// Действие
	Адрес = РазборURL.РазобратьСоСхемойПоУмолчанию(Значение, "https");

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://hub.example/private");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("hub.example:8080/private", "https", "https://hub.example:8080/private")
&ИсточникЗначение("//hub.example/private", "https", "https://hub.example/private")
&ИсточникЗначение("http://hub.example/private", "https", "http://hub.example/private")
&ИсточникЗначение("https://hub.example/private", "http", "https://hub.example/private")
&ИсточникЗначение("[::1]:8080/private", "http", "http://[::1]:8080/private")
&ИсточникЗначение("192.0.2.1/private", "http", "http://192.0.2.1/private")
&ИсточникЗначение("пример.рф/путь", "https", "https://пример.рф/путь")
&ИсточникЗначение("hub.example/a%2Fb?q=1#part", "https", "https://hub.example/a%2Fb?q=1#part")
&ИсточникЗначение("hub.example/p:a@b?q=a:b@c#f:a@b", "https", "https://hub.example/p:a@b?q=a:b@c#f:a@b")
&ИсточникЗначение("//user:password@hub.example/private", "https", "https://user:password@hub.example/private")
&ИсточникЗначение("foo://hub.example/private", "https", "foo://hub.example/private")
&ИсточникЗначение("hub.example/private", "foo", "foo://hub.example/private")
Процедура ТестДолжен_РазобратьПоддерживаемыйСерверныйАдрес(Значение, СхемаПоУмолчанию, ОжидаемыйURL) Экспорт

	// Подготовка
	// Параметры переданы источником теста.

	// Действие
	Адрес = РазборURL.РазобратьСоСхемойПоУмолчанию(Значение, СхемаПоУмолчанию);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ОжидаемыйURL);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("", "https", "argument.required")
&ИсточникЗначение("hub.example", "", "argument.required")
&ИсточникЗначение("/private", "https", "url.server_address_required")
&ИсточникЗначение("?q=1", "https", "url.server_address_required")
&ИсточникЗначение("#part", "https", "url.server_address_required")
&ИсточникЗначение("mailto:user@example.com", "https", "url.server_address_required")
&ИсточникЗначение("urn:isbn:1", "https", "url.server_address_required")
&ИсточникЗначение("http:/private", "https", "url.server_address_required")
&ИсточникЗначение("user:password@hub.example", "https", "url.server_address_required")
&ИсточникЗначение("hub.example:", "https", "url.server_address_required")
&ИсточникЗначение("hub.example:abc/private", "https", "url.server_address_required")
&ИсточникЗначение("2001:db8::1/private", "https", "url.server_address_required")
&ИсточникЗначение("//", "https", "url.server_address_required")
&ИсточникЗначение("//user:secret@", "https", "url.server_address_required")
&ИсточникЗначение("//hub.example:", "https", "url.server_address_required")
&ИсточникЗначение("//[::1]:", "https", "url.server_address_required")
&ИсточникЗначение("http://", "https", "url.server_address_required")
&ИсточникЗначение("http://user:secret@", "https", "url.server_address_required")
&ИсточникЗначение("1http://hub.example", "https", "url.invalid_scheme")
&ИсточникЗначение("hub.example/private", "1https", "url.invalid_scheme")
&ИсточникЗначение("hub.example/%", "https", "url.invalid_percent_encoding")
&ИсточникЗначение("hub.example:65536/private", "https", "url.invalid_for_scheme")
&ИсточникЗначение(" hub.example", "https", "url.server_address_required")
&ИсточникЗначение("hub.example ", "https", "url.server_address_required")
&ИсточникЗначение("http://hub.example/a b", "https", "url.invalid_syntax")
&ИсточникЗначение("http://hub.example:named", "https", "url.invalid_authority")
&ИсточникЗначение("http://[not-an-ip]/", "https", "url.invalid_host")
Процедура ТестДолжен_ОтклонитьНеподдерживаемыйАдрес(Значение, СхемаПоУмолчанию, ОжидаемыйКод) Экспорт

	// Подготовка
	_ЗначениеДляРазбора = Значение;
	_СхемаПоУмолчаниюДляРазбора = СхемаПоУмолчанию;
	Действие = Новый Действие(ЭтотОбъект, "РазобратьАдрес");

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(Действие, ОжидаемыйКод);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(133)
&ИсточникЗначение(160)
&ИсточникЗначение(8232)
&ИсточникЗначение(12288)
Процедура ТестДолжен_ОтклонитьUnicodeПробелПоКраю(КодСимволаПробела) Экспорт

	// Подготовка
	_ЗначениеДляРазбора = "hub.example/private" + Символ(КодСимволаПробела);
	_СхемаПоУмолчаниюДляРазбора = "https";

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "РазобратьАдрес"),
		"url.server_address_required"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНедопустимыйТипЗначения() Экспорт

	// Подготовка
	_ЗначениеДляРазбора = 42;
	_СхемаПоУмолчаниюДляРазбора = "https";

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "РазобратьАдрес"),
		"argument.invalid_type"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНедопустимыйТипСхемы() Экспорт

	// Подготовка
	_ЗначениеДляРазбора = "hub.example";
	_СхемаПоУмолчаниюДляРазбора = Неопределено;

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "РазобратьАдрес"),
		"argument.invalid_type"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьУправляющийСимволПоКраю() Экспорт

	// Подготовка
	_ЗначениеДляРазбора = "hub.example" + Символ(10);
	_СхемаПоУмолчаниюДляРазбора = "https";

	// Действие и Проверка
	ПомощникТестированияURL.ПроверитьКодОшибки(
		Новый Действие(ЭтотОбъект, "РазобратьАдрес"),
		"url.server_address_required"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВключатьПарольВОшибку() Экспорт

	// Подготовка
	Значение = "user:secret@hub.example";
	Ошибка = Неопределено;

	// Действие
	Попытка
		РазборURL.РазобратьСоСхемойПоУмолчанию(Значение, "https");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ПодробноеПредставлениеОшибки(Ошибка)).Не_().Содержит("secret");
	Данные = ДиагностикаОшибок.Разобрать(Ошибка).Данные();
	Ожидаем.Что(Данные.Свойство("Значение")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНезависимыеОбъекты() Экспорт

	// Подготовка
	Первый = РазборURL.РазобратьСоСхемойПоУмолчанию("hub.example", "https");

	// Действие
	Второй = РазборURL.РазобратьСоСхемойПоУмолчанию("hub.example", "https");
	Первый.УстановитьПуть("/changed");

	// Проверка
	Ожидаем.Что(Второй.ВСтроку()).Равно("https://hub.example");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БезИсключенияРазобратьАдресСоСхемойПоУмолчанию() Экспорт

	// Подготовка
	Ошибка = "предыдущее значение";

	// Действие
	Адрес = РазборURL.ПопытатьсяРазобратьСоСхемойПоУмолчанию("hub.example/private", "https", Ошибка);

	// Проверка
	Ожидаем.Что(ТипЗнч(Адрес)).Равно(Тип("URL"));
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://hub.example/private");
	Ожидаем.Что(Ошибка).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("/private", "https", "url.server_address_required")
&ИсточникЗначение("hub.example", "1https", "url.invalid_scheme")
&ИсточникЗначение(42, "https", "argument.invalid_type")
Процедура ТестДолжен_ВернутьНеопределеноПриОшибкеБезопасногоРазбора(
	Значение,
	СхемаПоУмолчанию,
	ОжидаемыйКод
) Экспорт

	// Подготовка
	Ошибка = Неопределено;

	// Действие
	Адрес = РазборURL.ПопытатьсяРазобратьСоСхемойПоУмолчанию(Значение, СхемаПоУмолчанию, Ошибка);

	// Проверка
	Ожидаем.Что(Адрес).Равно(Неопределено);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(ОжидаемыйКод);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура РазобратьАдрес() Экспорт

	РазборURL.РазобратьСоСхемойПоУмолчанию(_ЗначениеДляРазбора, _СхемаПоУмолчаниюДляРазбора);

КонецПроцедуры

#КонецОбласти
