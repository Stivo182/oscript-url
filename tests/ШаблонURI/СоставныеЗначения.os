#Использовать asserts
#Использовать "../../src"

#Область Тесты

&Тест
Процедура ТестДолжен_РаскрытьСпискиИСоответствия() Экспорт

	// Подготовка
	Список = Новый Массив;
	Список.Добавить("red");
	Список.Добавить("green");
	Список.Добавить("blue");

	Ключи = Новый Соответствие;
	Ключи.Вставить("semi", ";");
	Ключи.Вставить("dot", ".");
	Ключи.Вставить("comma", ",");

	Значения = Новый Соответствие;
	Значения.Вставить("list", Список);
	Значения.Вставить("keys", Ключи);

	Примеры = Новый Соответствие;
	Примеры.Вставить("{list}", "red,green,blue");
	Примеры.Вставить("{/list*}", "/red/green/blue");
	Примеры.Вставить("{?list}", "?list=red,green,blue");
	Примеры.Вставить("{?list*}", "?list=red&list=green&list=blue");
	Примеры.Вставить("{keys}", "semi,%3B,dot,.,comma,%2C");
	Примеры.Вставить("{/keys*}", "/semi=%3B/dot=./comma=%2C");
	Примеры.Вставить("{?keys}", "?keys=semi,%3B,dot,.,comma,%2C");
	Примеры.Вставить("{?keys*}", "?semi=%3B&dot=.&comma=%2C");

	// Действие и Проверка
	Для Каждого Пример Из Примеры Цикл
		Результат = Новый ШаблонURI(Пример.Ключ).Раскрыть(Значения);
		Ожидаем.Что(Результат.КодированноеПредставление()).Равно(Пример.Значение);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьНеопределенныеЧленыСписка() Экспорт

	// Подготовка
	Список = Новый Массив;
	Список.Добавить("a");
	Список.Добавить(Неопределено);
	Список.Добавить(Null);
	Список.Добавить("b");
	Значения = Новый Соответствие;
	Значения.Вставить("list", Список);

	// Действие
	Результат = Новый ШаблонURI("{?list*}").Раскрыть(Значения);

	// Проверка
	Ожидаем.Что(Результат.КодированноеПредставление()).Равно("?list=a&list=b");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КодироватьКлючиРазворачиваемогоСоответствия() Экспорт

	// Подготовка
	Ключи = Новый Соответствие;
	Ключи.Вставить("/", "a");
	Ключи.Вставить("%2F", "b");
	Ключи.Вставить("ключ", "c");
	Значения = Новый Соответствие;
	Значения.Вставить("keys", Ключи);

	// Действие
	Результат = Новый ШаблонURI("{?keys*}").Раскрыть(Значения);

	// Проверка
	Ожидаем.Что(Результат.КодированноеПредставление()).Равно(
		"?%2F=a&%252F=b&%D0%BA%D0%BB%D1%8E%D1%87=c"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьСписокБезОпределенныхЧленовНеопределенным() Экспорт

	// Подготовка
	Список = Новый Массив;
	Список.Добавить(Неопределено);
	Список.Добавить(Null);
	Значения = Новый Соответствие;
	Значения.Вставить("list", Новый ФиксированныйМассив(Список));

	// Действие
	Результат = Новый ШаблонURI("before{?list}").Раскрыть(Значения);

	// Проверка
	Ожидаем.Что(Результат.КодированноеПредставление()).Равно("before");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьНеопределенныеПарыФиксированногоСоответствия() Экспорт

	// Подготовка
	ИсходноеСоответствие = Новый Соответствие;
	ИсходноеСоответствие.Вставить("skip", Неопределено);
	ИсходноеСоответствие.Вставить("keep", "value");
	Значения = Новый Соответствие;
	Значения.Вставить("keys", Новый ФиксированноеСоответствие(ИсходноеСоответствие));

	// Действие
	Результат = Новый ШаблонURI("{?keys*}").Раскрыть(Значения);

	// Проверка
	Ожидаем.Что(Результат.КодированноеПредставление()).Равно("?keep=value");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаскрытьИерархиюВложенныхСтруктур() Экспорт

	// Подготовка
	Контакты = Новый Структура;
	Контакты.Вставить("email", "ivan@example.com");
	Контакты.Вставить("phone", Неопределено);

	Профиль = Новый Структура;
	Профиль.Вставить("name", "Ivan");
	Профиль.Вставить("contact", Новый ФиксированнаяСтруктура(Контакты));

	Значения = Новый Соответствие;
	Значения.Вставить("profile", Профиль);

	// Действие
	Результат = Новый ШаблонURI("/users{?profile*}").Раскрыть(Значения);

	// Проверка
	Ожидаем.Что(Результат.КодированноеПредставление()).Равно(
		"/users?name=Ivan&contact.email=ivan%40example.com"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПовторноИспользоватьОбщуюВложеннуюСтруктуру() Экспорт

	// Подготовка
	ОбщаяСтруктура = Новый Структура("name", "Ivan");
	Профили = Новый Структура("first,second", ОбщаяСтруктура, ОбщаяСтруктура);
	Значения = Новый Структура("profiles", Профили);

	// Действие
	Результат = Новый ШаблонURI("{?profiles*}").Раскрыть(Значения);

	// Проверка
	Ожидаем.Что(Результат.КодированноеПредставление()).Равно(
		"?first.name=Ivan&second.name=Ivan"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаскрытьГлубокуюАциклическуюСтруктуру() Экспорт

	// Подготовка
	Глубина = 5000;
	ВложеннаяСтруктура = Новый Структура("leaf", "value");
	ЧастиКлюча = Новый Массив;

	Для НомерУровня = 1 По Глубина Цикл
		ВложеннаяСтруктура = Новый Структура("level", ВложеннаяСтруктура);
		ЧастиКлюча.Добавить("level");
	КонецЦикла;
	ЧастиКлюча.Добавить("leaf");

	Значения = Новый Структура("tree", ВложеннаяСтруктура);
	ОжидаемоеПредставление = "?" + СтрСоединить(ЧастиКлюча, ".") + "=value";

	// Действие
	Результат = Новый ШаблонURI("{?tree*}").Раскрыть(Значения);

	// Проверка
	Ожидаем.Что(Результат.КодированноеПредставление()).Равно(ОжидаемоеПредставление);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаскрытьПустуюРазвернутуюПаруПоПравиламОператора() Экспорт

	// Подготовка
	Пары = Новый Соответствие;
	Пары.Вставить("empty", "");
	Значения = Новый Структура("keys", Пары);

	Примеры = Новый Соответствие;
	Примеры.Вставить("{keys*}", "empty");
	Примеры.Вставить("{+keys*}", "empty");
	Примеры.Вставить("{#keys*}", "#empty");
	Примеры.Вставить("{.keys*}", ".empty");
	Примеры.Вставить("{/keys*}", "/empty");
	Примеры.Вставить("{;keys*}", ";empty");
	Примеры.Вставить("{?keys*}", "?empty=");
	Примеры.Вставить("{&keys*}", "&empty=");

	// Действие и Проверка
	Для Каждого Пример Из Примеры Цикл
		Результат = Новый ШаблонURI(Пример.Ключ).Раскрыть(Значения);
		Ожидаем.Что(Результат.КодированноеПредставление()).Равно(Пример.Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
