#Использовать asserts
#Использовать "../../src"

#Область Тесты

&Тест
Процедура ТестДолжен_ОграничитьЗначениеПоКодовымТочкамUnicode() Экспорт

	// Подготовка
	Значения = Новый Соответствие;
	Значения.Вставить("greek", "αβγ");
	Значения.Вставить("currency", "€uro");
	Значения.Вставить("clef", "𝄞stave");

	// Действие
	Результат = Новый ШаблонURI("{greek:2}/{currency:1}/{clef:1}").Раскрыть(Значения);

	// Проверка
	Ожидаем.Что(Результат.КодированноеПредставление()).Равно(
		"%CE%B1%CE%B2/%E2%82%AC/%F0%9D%84%9E"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеРазорватьПроцентноКодированныйСимволПрефиксом() Экспорт

	// Подготовка
	Значения = Новый Соответствие;
	Значения.Вставить("value", "%E2%82%ACx");

	// Действие
	Результат = Новый ШаблонURI("{+value:1}").Раскрыть(Значения);

	// Проверка
	Ожидаем.Что(Результат.КодированноеПредставление()).Равно("%E2%82%AC");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеРазорватьПроцентныйТриплетСНекорректнымUTF8Префиксом() Экспорт

	// Подготовка
	Значения = Новый Структура("value", "%FFx");

	// Действие
	Результат = Новый ШаблонURI("{+value:1}").Раскрыть(Значения);

	// Проверка
	Ожидаем.Что(Результат.КодированноеПредставление()).Равно("%FF");

КонецПроцедуры

#КонецОбласти
