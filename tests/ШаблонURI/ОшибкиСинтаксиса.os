#Область Тесты

&Тест
Процедура ТестДолжен_ОтклонитьНеверныйТипПредставления() Экспорт

	// Действие
	Попытка
		Шаблон = Новый ШаблонURI(42);
	Исключение
		// Проверка
		Ожидаем.Что(
			ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке())
		).Равно("argument.invalid_type");
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка типа представления";

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьОшибкуИтоговойСсылкиБезИсходныхДанных() Экспорт

	// Подготовка
	Представление = "{scheme}:private-template-part";
	Значения = Новый Структура("scheme", "1private-value");

	// Действие
	Попытка
		Результат = Новый ШаблонURI(Представление).Раскрыть(Значения);
	Исключение
		// Проверка
		Информация = ИнформацияОбОшибке();
		Ошибка = ДиагностикаОшибок.НайтиПервую(Информация, "url.invalid_scheme");
		Ожидаем.Что(Ошибка.Сообщение()).Равно("Недопустимая схема URI");
		Ожидаем.Что(Ошибка.Данные()).Равно(Неопределено);

		Диагностика = ДиагностикаОшибок.ДиагностическоеПредставление(Информация);
		Ожидаем.Что(СтрНайти(Диагностика, Представление)).Равно(0);
		Ожидаем.Что(СтрНайти(Диагностика, Значения.scheme)).Равно(0);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка итоговой URI-ссылки";

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("{")
&ИсточникЗначение("{}")
&ИсточникЗначение("{?}")
&ИсточникЗначение("{x..y}")
&ИсточникЗначение("{var:0}")
&ИсточникЗначение("{var:10000}")
&ИсточникЗначение("{var:2*}")
&ИсточникЗначение("{!var}")
&ИсточникЗначение("{%2x}")
Процедура ТестДолжен_ОтклонитьНедопустимыйШаблон(Представление) Экспорт

	// Действие
	Попытка
		Шаблон = Новый ШаблонURI(Представление);
	Исключение
		Ожидаем.Что(
			ДиагностикаОшибок.СодержитГруппу(ИнформацияОбОшибке(), "url.template.invalid_syntax")
		).ЭтоИстина();
		Возврат;
	КонецПопытки;

	// Проверка
	ВызватьИсключение "Ожидалась ошибка синтаксиса шаблона";

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("{var**}", 6)
&ИсточникЗначение("{var*:2}", 6)
&ИсточникЗначение("{var:2*}", 7)
&ИсточникЗначение("{var:1:2}", 7)
&ИсточникЗначение("{var*:2*}", 6)
&ИсточникЗначение("{var:1:2*}", 7)
Процедура ТестДолжен_КлассифицироватьНеверноеСочетаниеМодификаторов(Представление, Позиция) Экспорт

	// Действие
	Попытка
		Шаблон = Новый ШаблонURI(Представление);
	Исключение
		// Проверка
		Информация = ИнформацияОбОшибке();
		Ожидаем.Что(
			ДиагностикаОшибок.КодОшибки(Информация)
		).Равно("url.template.invalid_syntax.invalid_modifier");
		Ошибка = ДиагностикаОшибок.НайтиПервую(
			Информация,
			"url.template.invalid_syntax.invalid_modifier"
		);
		Ожидаем.Что(Ошибка.Данные().Позиция).Равно(Позиция);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка модификатора";

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьПрефиксСоставногоЗначения() Экспорт

	// Подготовка
	Список = Новый Массив;
	Список.Добавить("a");
	Значения = Новый Соответствие;
	Значения.Вставить("list", Список);

	// Действие
	Попытка
		Результат = Новый ШаблонURI("{list:1}").Раскрыть(Значения);
	Исключение
		Ошибка = ДиагностикаОшибок.НайтиПервую(
			ИнформацияОбОшибке(),
			"argument.invalid_value.prefix_for_composite"
		);
		ПроверитьДанныеОшибкиЗначения(
			Ошибка,
			"list",
			"модификатор префикса допустим только для простого значения"
		);
		Возврат;
	КонецПопытки;

	// Проверка
	ВызватьИсключение "Ожидалась ошибка значения";

КонецПроцедуры

&Тест
Процедура ТестДолжен_УказатьПозициюОшибкиВКодовыхТочкахUnicode() Экспорт

	// Действие
	Попытка
		Шаблон = Новый ШаблонURI("𝄞{");
	Исключение
		Ошибка = ДиагностикаОшибок.НайтиПервую(
			ИнформацияОбОшибке(),
			"url.template.invalid_syntax.unclosed_expression"
		);

		// Проверка
		Ожидаем.Что(Ошибка.Данные().Свойство("ПричинаКод")).ЭтоЛожь();
		Ожидаем.Что(Ошибка.Данные().Позиция).Равно(2);
		Ожидаем.Что(Ошибка.Данные().Свойство("Компонент")).ЭтоЛожь();
		Ожидаем.Что(Ошибка.Сообщение()).Равно(
			"Недопустимый синтаксис шаблона URI в позиции 2 (ожидается: закрывающая фигурная скобка)"
		);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка синтаксиса шаблона";

КонецПроцедуры

&Тест
Процедура ТестДолжен_УказатьПозициюНедопустимогоЛитералаВКодовыхТочках() Экспорт

	// Действие
	Попытка
		Шаблон = Новый ШаблонURI("𝄞 ");
	Исключение
		Ошибка = ДиагностикаОшибок.НайтиПервую(
			ИнформацияОбОшибке(),
			"url.template.invalid_syntax.invalid_character"
		);

		// Проверка
		Ожидаем.Что(Ошибка.Данные().Свойство("ПричинаКод")).ЭтоЛожь();
		Ожидаем.Что(Ошибка.Данные().Позиция).Равно(2);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка синтаксиса шаблона";

КонецПроцедуры

&Тест
Процедура ТестДолжен_УказатьТочныеПозицииОшибокВВыражении() Экспорт

	// Действие и Проверка
	ПроверитьПозициюОшибки("{?x..y}", 5, "invalid_variable");
	ПроверитьПозициюОшибки("{x,y..z}", 6, "invalid_variable");
	ПроверитьПозициюОшибки("𝄞{{x}", 3, "invalid_character");
	ПроверитьПозициюОшибки("{?}", 3, "empty_expression");
	ПроверитьПозициюОшибки("{var:0}", 5, "invalid_modifier");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УказатьПозициюНекорректнойСуррогатнойПоследовательности() Экспорт

	// Действие и Проверка
	ПроверитьПозициюОшибки("ab" + Символ(55296), 3, "invalid_character");

КонецПроцедуры

