&Тест
Процедура ТестДолжен_ОтклонитьНекорректнуюПоследовательностьUnicodeВЗначении() Экспорт

	// Подготовка
	Значения = Новый Структура("value", Символ(55296) + "a");

	// Действие
	Попытка
		Результат = Новый ШаблонURI("{value:1}").Раскрыть(Значения);
	Исключение
		// Проверка
		Ошибка = ДиагностикаОшибок.НайтиПервую(
			ИнформацияОбОшибке(),
			"argument.invalid_value.invalid_unicode"
		);
		ПроверитьДанныеОшибкиЗначения(
			Ошибка,
			"value",
			"строка должна содержать корректные скалярные значения Unicode"
		);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка последовательности Unicode";

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректныйUnicodeВоВсехЧастяхСоставногоЗначения() Экспорт

	// Подготовка
	СтаршийСуррогат = Символ(55296);
	МладшийСуррогат = Символ(56320);

	Список = Новый Массив;
	Список.Добавить(СтаршийСуррогат);

	СоответствиеСКлючом = Новый Соответствие;
	СоответствиеСКлючом.Вставить(МладшийСуррогат, "value");

	СоответствиеСоЗначением = Новый Соответствие;
	СоответствиеСоЗначением.Вставить("key", СтаршийСуррогат);

	ВложеннаяСтруктура = Новый Структура("field", МладшийСуррогат);

	// Действие и Проверка
	ПроверитьНекорректныйUnicode("{value}", Новый Структура("value", МладшийСуррогат), "value");
	ПроверитьНекорректныйUnicode("{value}", Новый Структура("value", СтаршийСуррогат), "value");
	ПроверитьНекорректныйUnicode("{value}", Новый Структура("value", Список), "value");
	ПроверитьНекорректныйUnicode("{value}", Новый Структура("value", СоответствиеСКлючом), "value");
	ПроверитьНекорректныйUnicode("{value}", Новый Структура("value", СоответствиеСоЗначением), "value");
	ПроверитьНекорректныйUnicode("{value}", Новый Структура("value", ВложеннаяСтруктура), "value");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьЦиклВоВложеннойСтруктуре() Экспорт

	// Подготовка
	ЦиклическаяСтруктура = Новый Структура;
	ЦиклическаяСтруктура.Вставить("self", ЦиклическаяСтруктура);
	Значения = Новый Структура("value", ЦиклическаяСтруктура);

	// Действие
	Попытка
		Результат = Новый ШаблонURI("{?value*}").Раскрыть(Значения);
	Исключение
		// Проверка
		Ошибка = ДиагностикаОшибок.НайтиПервую(
			ИнформацияОбОшибке(),
			"argument.invalid_value.cyclic_structure"
		);
		ПроверитьДанныеОшибкиЗначения(
			Ошибка,
			"value",
			"вложенная структура не должна содержать циклические ссылки"
		);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка циклической структуры";

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьКосвенныйЦиклВоВложеннойСтруктуре() Экспорт

	// Подготовка
	ПерваяСтруктура = Новый Структура;
	ВтораяСтруктура = Новый Структура("first", ПерваяСтруктура);
	ПерваяСтруктура.Вставить("second", ВтораяСтруктура);
	Значения = Новый Структура("value", ПерваяСтруктура);

	// Действие
	Попытка
		Результат = Новый ШаблонURI("{?value*}").Раскрыть(Значения);
	Исключение
		// Проверка
		Ожидаем.Что(
			ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке())
		).Равно("argument.invalid_value.cyclic_structure");
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка циклической структуры";

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПозициюОшибки(Представление, ОжидаемаяПозиция, УточнениеКода)

	Попытка
		Шаблон = Новый ШаблонURI(Представление);
	Исключение
		Ошибка = ДиагностикаОшибок.НайтиПервую(
			ИнформацияОбОшибке(),
			"url.template.invalid_syntax." + УточнениеКода
		);
		Ожидаем.Что(Ошибка.Данные().Позиция).Равно(ОжидаемаяПозиция);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка синтаксиса шаблона";

КонецПроцедуры

Процедура ПроверитьДанныеОшибкиЗначения(Ошибка, ИмяПеременной, Ожидание)

	ДанныеОшибки = Ошибка.Данные();
	Ожидаем.Что(ДанныеОшибки.Свойство("Компонент")).ЭтоЛожь();
	Ожидаем.Что(ДанныеОшибки.Свойство("ИмяАргумента")).ЭтоЛожь();
	Ожидаем.Что(ДанныеОшибки.ИмяПеременной).Равно(ИмяПеременной);
	Ожидаем.Что(ДанныеОшибки.Свойство("ПричинаКод")).ЭтоЛожь();
	Ожидаем.Что(ДанныеОшибки.Ожидание).Равно(Ожидание);
	Ожидаем.Что(Ошибка.Сообщение()).Равно(
		СтрШаблон("Недопустимое значение переменной шаблона URI ""%1"": %2", ИмяПеременной, Ожидание)
	);

КонецПроцедуры

Процедура ПроверитьНекорректныйUnicode(Представление, Значения, ИмяПеременной)

	Попытка
		Результат = Новый ШаблонURI(Представление).Раскрыть(Значения);
	Исключение
		Ошибка = ДиагностикаОшибок.НайтиПервую(
			ИнформацияОбОшибке(),
			"argument.invalid_value.invalid_unicode"
		);
		ПроверитьДанныеОшибкиЗначения(
			Ошибка,
			ИмяПеременной,
			"строка должна содержать корректные скалярные значения Unicode"
		);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка последовательности Unicode";

КонецПроцедуры

#КонецОбласти
