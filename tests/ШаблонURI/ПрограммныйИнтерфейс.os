#Использовать asserts
#Использовать "../../src"

#Область Тесты

&Тест
Процедура ТестДолжен_РаскрытьПростуюПеременнуюВURL() Экспорт

	// Подготовка
	Шаблон = Новый ШаблонURI("https://example.com/users/{id}");
	Значения = Новый Соответствие;
	Значения.Вставить("id", "Иван/42");

	// Действие
	Адрес = Шаблон.Раскрыть(Значения);

	// Проверка
	Ожидаем.Что(Адрес).ИмеетТип("URL");
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно(
		"https://example.com/users/%D0%98%D0%B2%D0%B0%D0%BD%2F42"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьИсходныйШаблонИИменаПеременных() Экспорт

	// Подготовка
	Представление = "{/id}{?page,id,Some%20Thing}";
	Шаблон = Новый ШаблонURI(Представление);

	// Действие
	Имена = Шаблон.ИменаПеременных();

	// Проверка
	Ожидаем.Что(Шаблон.ВСтроку()).Равно(Представление);
	Ожидаем.Что(Имена).ИмеетТип("Массив");
	Ожидаем.Что(Имена.Количество()).Равно(3);
	Ожидаем.Что(Имена[0]).Равно("id");
	Ожидаем.Что(Имена[1]).Равно("page");
	Ожидаем.Что(Имена[2]).Равно("Some%20Thing");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьИзменяемуюКопиюИменПеременных() Экспорт

	// Подготовка
	Шаблон = Новый ШаблонURI("{/id}{?page}");
	Имена = Шаблон.ИменаПеременных();

	// Действие
	Имена.Удалить(0);
	ПовторноПолученныеИмена = Шаблон.ИменаПеременных();

	// Проверка
	Ожидаем.Что(Имена.Количество()).Равно(1);
	Ожидаем.Что(ПовторноПолученныеИмена.Количество()).Равно(2);
	Ожидаем.Что(ПовторноПолученныеИмена[0]).Равно("id");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаскрытьПустойШаблонБезЗначений() Экспорт

	// Действие
	Адрес = Новый ШаблонURI("").Раскрыть();

	// Проверка
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПринятьСтруктуруИПреобразоватьПростыеТипы() Экспорт

	// Подготовка
	Шаблон = Новый ШаблонURI("{?number,flag,date}");
	Значения = Новый ФиксированнаяСтруктура(
		Новый Структура("number,flag,date", 6, Истина, '20260912123456')
	);

	// Действие
	Адрес = Шаблон.Раскрыть(Значения);

	// Проверка
	Ожидаем.Что(Адрес.КодированноеПредставление()).Равно(
		"?number=6&flag=true&date=2026-09-12T12%3A34%3A56"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьНезависимыеРезультатыПовторныхРаскрытий() Экспорт

	// Подготовка
	Шаблон = Новый ШаблонURI("{/id}");
	ПервыеЗначения = Новый Структура("id", "first");
	ВторыеЗначения = Новый Структура("id", "second");

	// Действие
	Первый = Шаблон.Раскрыть(ПервыеЗначения);
	Второй = Шаблон.Раскрыть(ВторыеЗначения);
	Первый.ДобавитьСегментПути("changed");

	// Проверка
	Ожидаем.Что(Первый.КодированноеПредставление()).Равно("/first/changed");
	Ожидаем.Что(Второй.КодированноеПредставление()).Равно("/second");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УчитыватьРегистрИменПеременныхДляВсехКоллекций() Экспорт

	// Подготовка
	СоответствиеЗначений = Новый Соответствие;
	СоответствиеЗначений.Вставить("foo", "lower");

	Коллекции = Новый Массив;
	Коллекции.Добавить(СоответствиеЗначений);
	Коллекции.Добавить(Новый ФиксированноеСоответствие(СоответствиеЗначений));
	Коллекции.Добавить(Новый Структура("foo", "lower"));
	Коллекции.Добавить(Новый ФиксированнаяСтруктура("foo", "lower"));

	Шаблон = Новый ШаблонURI("{foo}/{FOO}");
	КоличествоПроверенныхКоллекций = 0;

	// Действие и Проверка
	Для Каждого Значения Из Коллекции Цикл
		Результат = Шаблон.Раскрыть(Значения);
		Ожидаем.Что(Результат.КодированноеПредставление()).Равно("lower/");
		КоличествоПроверенныхКоллекций = КоличествоПроверенныхКоллекций + 1;
	КонецЦикла;
	Ожидаем.Что(КоличествоПроверенныхКоллекций).Равно(4);

КонецПроцедуры

#КонецОбласти
