#Использовать asserts
#Использовать errors
#Использовать "../../src"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("spec-examples.json")
&ИсточникЗначение("spec-examples-by-section.json")
&ИсточникЗначение("extended-tests.json")
&ИсточникЗначение("negative-tests.json")
Процедура ТестДолжен_ПройтиКаноническийНабор(ИмяФайла) Экспорт

	// Подготовка
	Наборы = ПрочитатьНаборы(ИмяФайла);

	// Действие и Проверка
	Для Каждого ПараНабора Из Наборы Цикл
		Набор = ПараНабора.Значение;
		Значения = Набор["variables"];
		Для Каждого Пример Из Набор["testcases"] Цикл
			ПроверитьПример(Пример[0], Пример[1], Значения, ПараНабора.Ключ);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьНаборы(ИмяФайла)

	Путь = ОбъединитьПути(ТекущийКаталог(), "tests/fixtures/rfc6570", ИмяФайла);
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);

	Попытка
		Результат = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

Процедура ПроверитьПример(Представление, ОжидаемыйРезультат, Значения, ИмяНабора)

	ОжидаетсяОшибка = ТипЗнч(ОжидаемыйРезультат) = Тип("Булево") И Не ОжидаемыйРезультат;

	Попытка
		Результат = Новый ШаблонURI(Представление).Раскрыть(Значения).КодированноеПредставление();
	Исключение
		Если ОжидаетсяОшибка Тогда
			Ошибка = ИнформацияОбОшибке();
			ДопустимаяОшибка = ЭтоОжидаемаяОшибкаОтрицательногоПримера(Ошибка, Представление);
			Если Не ДопустимаяОшибка Тогда
				ВызватьИсключение ОписаниеПримера(ИмяНабора, Представление)
					+ ": ожидалась предметная ошибка шаблона, получена "
					+ ДиагностикаОшибок.КодОшибки(Ошибка);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		ВызватьИсключение ОписаниеПримера(ИмяНабора, Представление) + ": " + ОписаниеОшибки();
	КонецПопытки;

	Если ОжидаетсяОшибка Тогда
		ВызватьИсключение ОписаниеПримера(ИмяНабора, Представление) + ": ожидалась ошибка";
	КонецЕсли;

	Если ТипЗнч(ОжидаемыйРезультат) = Тип("Массив") Тогда
		Для Каждого ДопустимыйРезультат Из ОжидаемыйРезультат Цикл
			Если Результат = ДопустимыйРезультат Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Результат = ОжидаемыйРезультат Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение ОписаниеПримера(ИмяНабора, Представление) + ": получено " + Результат;

КонецПроцедуры

Функция ЭтоОжидаемаяОшибкаОтрицательногоПримера(Ошибка, Представление)

	Если Представление = "{keys:1}" Или Представление = "{+keys:1}" Тогда
		Возврат ДиагностикаОшибок.КодОшибки(Ошибка) = "argument.invalid_value.prefix_for_composite";
	КонецЕсли;

	Возврат ДиагностикаОшибок.СодержитГруппу(Ошибка, "url.template.invalid_syntax");

КонецФункции

Функция ОписаниеПримера(ИмяНабора, Представление)

	Возврат ИмяНабора + ", шаблон " + Представление;

КонецФункции

#КонецОбласти
