#Область Тесты

&Тест
Процедура ТестДолжен_ПроверитьИКодироватьКомпонентIRIЗаОдинПроход() Экспорт

	// Подготовка
	Кодировщик = Новый КодировщикКомпонентаIRI;
	Значение = "a" + Символ(55357) + Символ(56832) + "/б%20";

	// Действие
	Результат = Кодировщик.Кодировать(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно("a%F0%9F%98%80/%D0%B1%20");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗакодироватьНижнююГраницуUCSChar() Экспорт

	// Подготовка
	Кодировщик = Новый КодировщикКомпонентаIRI;

	// Действие
	Результат = Кодировщик.Кодировать(Символ(160));

	// Проверка
	Ожидаем.Что(Результат).Равно("%C2%A0");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьЧастнуюКодовуюТочкуДляЗапроса() Экспорт

	// Подготовка
	Кодировщик = Новый КодировщикКомпонентаIRI;

	// Действие
	Результат = Кодировщик.Кодировать(Символ(57344), Истина);

	// Проверка
	Ожидаем.Что(Результат).Равно("%EE%80%80");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Старший")
&ИсточникЗначение("Младший")
&ИсточникЗначение("НарушеннаяПара")
Процедура ТестДолжен_ОтклонитьНекорректнуюПоследовательностьСуррогатов(ВидПоследовательности) Экспорт

	// Подготовка
	Кодировщик = Новый КодировщикКомпонентаIRI;

	Если ВидПоследовательности = "Старший" Тогда
		Значение = Символ(55296);
	ИначеЕсли ВидПоследовательности = "Младший" Тогда
		Значение = Символ(56320);
	Иначе
		Значение = Символ(55296) + "a";
	КонецЕсли;

	КодОшибки = Неопределено;

	// Действие
	Попытка
		Кодировщик.Кодировать(Значение);
	Исключение
		КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("url.invalid_syntax");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьКодовуюТочкуВнеUCSChar() Экспорт

	// Подготовка
	Кодировщик = Новый КодировщикКомпонентаIRI;
	КодОшибки = Неопределено;

	// Действие
	Попытка
		Кодировщик.Кодировать(Символ(159));
	Исключение
		КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("url.invalid_syntax");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьКомпонентБезКодирования() Экспорт

	// Подготовка
	Кодировщик = Новый КодировщикКомпонентаIRI;
	КодОшибки = Неопределено;

	// Действие
	Попытка
		Кодировщик.Проверить(Символ(57344));
	Исключение
		КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("url.invalid_syntax");

КонецПроцедуры

#КонецОбласти
