#Использовать asserts
#Использовать errors
#Использовать "../../src"
#Использовать "../../src/internal"

#Область Тесты

&Тест
Процедура ТестДолжен_СобратьСтрокуURLИзКомпонентов() Экспорт

	// Подготовка
	Компоненты = СоздатьКомпонентыURL();
	Компоненты.КодированныйПуть = "../new";
	Компоненты.ПредставлениеПути = "../new";
	Компоненты.ЗапросОпределен = Истина;
	Компоненты.КодированныйЗапрос = "x=1";
	Компоненты.ПредставлениеЗапроса = "x=1";

	// Действие
	Результат = СервисыБиблиотекиURL.СборщикURL().Собрать(Компоненты);

	// Проверка
	Ожидаем.Что(ТипЗнч(Результат)).Равно(Тип("Строка"));
	Ожидаем.Что(Результат).Равно("../new?x=1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗащититьДвоеточиеВПервомСегментеОтносительногоПути() Экспорт

	// Подготовка
	Компоненты = СоздатьКомпонентыURL();
	Компоненты.КодированныйПуть = "a:b";
	Компоненты.ПредставлениеПути = "a:b";

	// Действие
	Результат = СервисыБиблиотекиURL.СборщикURL().Собрать(Компоненты);

	// Проверка
	Ожидаем.Что(Результат).Равно("./a:b");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ДанныеПользователя")
&ИсточникЗначение("Хост")
&ИсточникЗначение("Путь")
&ИсточникЗначение("Запрос")
&ИсточникЗначение("Фрагмент")
Процедура ТестДолжен_ОтклонитьПредставлениеИногоКомпонента(Компонент) Экспорт

	// Подготовка
	Компоненты = СоздатьКомпонентыURL();
	ЗаполнитьНесогласованныйКомпонент(Компоненты, Компонент);

	// Действие и Проверка
	Попытка
		Результат = СервисыБиблиотекиURL.СборщикURL().Собрать(Компоненты);
	Исключение
		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке())).Равно("url.invalid_syntax");
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка несогласованного представления компонента";

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("/bad%ZZ", "url.invalid_percent_encoding")
&ИсточникЗначение("//host/path", "url.invalid_syntax")
Процедура ТестДолжен_ОтклонитьНесогласованноеПредставлениеПути(Представление, ОжидаемыйКод) Экспорт

	// Подготовка
	Компоненты = СоздатьКомпонентыURL();
	Компоненты.КодированныйПуть = "/safe";
	Компоненты.ПредставлениеПути = Представление;

	// Действие и Проверка
	Попытка
		Результат = СервисыБиблиотекиURL.СборщикURL().Собрать(Компоненты);
	Исключение
		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке())).Равно(ОжидаемыйКод);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка несогласованного представления пути";

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьПредставлениеСервернойЧасти() Экспорт

	// Подготовка
	Компоненты = СоздатьКомпонентыURL();
	Компоненты.СервернаяЧастьОпределена = Истина;
	Компоненты.ДанныеПользователяОпределены = Истина;
	Компоненты.ПредставлениеДанныхПользователя = "user";
	Компоненты.ПредставлениеХоста = "host";
	Компоненты.ПортУказан = Истина;
	Компоненты.ТекстПорта = "80";

	// Действие
	Результат = СервисыБиблиотекиURL.СборщикURL().СобратьСервернуюЧасть(Компоненты);

	// Проверка
	Ожидаем.Что(Результат).Равно("user@host:80");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПереданноеПредставлениеКомпонента() Экспорт

	// Подготовка
	Компоненты = СоздатьКомпонентыURL();
	Компоненты.КодированныйПуть = "/new%2Fpath";
	Компоненты.ПредставлениеПути = "/new%2fpath";

	// Действие
	Результат = СервисыБиблиотекиURL.СборщикURL().Собрать(Компоненты);

	// Проверка
	Ожидаем.Что(Результат).Равно("/new%2fpath");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНесовместимыеКомпоненты() Экспорт

	// Подготовка
	Компоненты = СоздатьКомпонентыURL();
	Компоненты.Схема = "https";
	Компоненты.СервернаяЧастьОпределена = Истина;
	Компоненты.КодированныйХост = "host";
	Компоненты.ПредставлениеХоста = "host";
	Компоненты.КодированныйПуть = "relative";
	Компоненты.ПредставлениеПути = "relative";

	// Действие и Проверка
	Попытка
		Результат = СервисыБиблиотекиURL.СборщикURL().Собрать(Компоненты);
	Исключение
		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке()))
			.Равно("url.incompatible_components");
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка несовместимых компонентов";

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Схема", "url.invalid_scheme")
&ИсточникЗначение("Путь", "url.invalid_percent_encoding")
Процедура ТестДолжен_ОтклонитьСинтаксическиНедопустимыеКомпоненты(Компонент, ОжидаемыйКод) Экспорт

	// Подготовка
	Компоненты = СоздатьКомпонентыURL();
	Компоненты.Схема = "https";
	Компоненты.СервернаяЧастьОпределена = Истина;
	Компоненты.КодированныйХост = "host";
	Компоненты.ПредставлениеХоста = "host";
	Компоненты.КодированныйПуть = "/path";
	Компоненты.ПредставлениеПути = "/path";

	Если Компонент = "Схема" Тогда
		Компоненты.Схема = "1bad";
	Иначе
		Компоненты.КодированныйПуть = "/bad%ZZ";
		Компоненты.ПредставлениеПути = "/bad%ZZ";
	КонецЕсли;

	// Действие и Проверка
	Попытка
		Результат = СервисыБиблиотекиURL.СборщикURL().Собрать(Компоненты);
	Исключение
		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке())).Равно(ОжидаемыйКод);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка синтаксиса компонентов";

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьКомпонентыURL()

	Компоненты = Новый Структура;
	Компоненты.Вставить("Схема", Неопределено);
	Компоненты.Вставить("СервернаяЧастьОпределена", Ложь);
	Компоненты.Вставить("ДанныеПользователяОпределены", Ложь);
	Компоненты.Вставить("КодированныеДанныеПользователя", Неопределено);
	Компоненты.Вставить("КодированныйХост", Неопределено);
	Компоненты.Вставить("ВидХоста", Неопределено);
	Компоненты.Вставить("ПортУказан", Ложь);
	Компоненты.Вставить("ТекстПорта", Неопределено);
	Компоненты.Вставить("КодированныйПуть", "");
	Компоненты.Вставить("ЗапросОпределен", Ложь);
	Компоненты.Вставить("КодированныйЗапрос", Неопределено);
	Компоненты.Вставить("ФрагментОпределен", Ложь);
	Компоненты.Вставить("КодированныйФрагмент", Неопределено);
	Компоненты.Вставить("ПредставлениеДанныхПользователя", Неопределено);
	Компоненты.Вставить("ПредставлениеХоста", Неопределено);
	Компоненты.Вставить("ПредставлениеПути", "");
	Компоненты.Вставить("ПредставлениеЗапроса", Неопределено);
	Компоненты.Вставить("ПредставлениеФрагмента", Неопределено);

	Возврат Компоненты;

КонецФункции

Процедура ЗаполнитьНесогласованныйКомпонент(Компоненты, Компонент)

	Если Компонент = "ДанныеПользователя" Тогда
		Компоненты.СервернаяЧастьОпределена = Истина;
		Компоненты.ДанныеПользователяОпределены = Истина;
		Компоненты.КодированныеДанныеПользователя = "safe";
		Компоненты.ПредставлениеДанныхПользователя = "other";
		Компоненты.КодированныйХост = "host";
		Компоненты.ПредставлениеХоста = "host";
	ИначеЕсли Компонент = "Хост" Тогда
		Компоненты.СервернаяЧастьОпределена = Истина;
		Компоненты.КодированныйХост = "host";
		Компоненты.ПредставлениеХоста = "other";
	ИначеЕсли Компонент = "Путь" Тогда
		Компоненты.КодированныйПуть = "/safe";
		Компоненты.ПредставлениеПути = "/other";
	ИначеЕсли Компонент = "Запрос" Тогда
		Компоненты.ЗапросОпределен = Истина;
		Компоненты.КодированныйЗапрос = "safe";
		Компоненты.ПредставлениеЗапроса = "other";
	Иначе
		Компоненты.ФрагментОпределен = Истина;
		Компоненты.КодированныйФрагмент = "safe";
		Компоненты.ПредставлениеФрагмента = "other";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
