#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьВременныеКомпонентыURL() Экспорт

	// Подготовка
	Парсер = СервисыБиблиотекиURL.ПарсерIRI();

	// Действие
	Компоненты = Парсер.Разобрать("https://example.com/path?");

	// Проверка
	Ожидаем.Что(Компоненты).ИмеетТип("Структура");
	Ожидаем.Что(Компоненты.Схема).Равно("https");
	Ожидаем.Что(Компоненты.КодированныйХост).Равно("example.com");
	Ожидаем.Что(Компоненты.КодированныйПуть).Равно("/path");
	Ожидаем.Что(Компоненты.ЗапросОпределен).Равно(Истина);
	Ожидаем.Что(Компоненты.КодированныйЗапрос).Равно("");

КонецПроцедуры

#КонецОбласти
