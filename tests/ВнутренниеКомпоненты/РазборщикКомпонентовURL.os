#Область Тесты

&Тест
Процедура ТестДолжен_РазобратьКодированнуюСервернуюЧасть() Экспорт

	// Действие
	Компоненты = СервисыБиблиотекиURL.РазборщикКомпонентовURL().РазобратьКодированнуюСервернуюЧасть(
		"user%20name@example.com:8080"
	);

	// Проверка
	Ожидаем.Что(Компоненты.КодированныеДанныеПользователя).Равно("user%20name");
	Ожидаем.Что(Компоненты.КодированныйХост).Равно("example.com");
	Ожидаем.Что(Компоненты.ТекстПорта).Равно("8080");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьДекодированнуюСервернуюЧасть() Экспорт

	// Действие
	Компоненты = СервисыБиблиотекиURL.РазборщикКомпонентовURL().РазобратьДекодированнуюСервернуюЧасть(
		"имя:пароль@пример.рф:443"
	);

	// Проверка
	Ожидаем.Что(Компоненты.КодированныеДанныеПользователя).Равно(
		"%D0%B8%D0%BC%D1%8F:%D0%BF%D0%B0%D1%80%D0%BE%D0%BB%D1%8C"
	);
	Ожидаем.Что(Компоненты.ПредставлениеХоста).Равно("пример.рф");
	Ожидаем.Что(Компоненты.ТекстПорта).Равно("443");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодготовитьДекодированныеКомпоненты() Экспорт

	// Подготовка

	// Действие
	ДанныеПользователя = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьДанныеПользователя("имя пароль");
	Путь = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьПуть("/каталог/новый файл");
	Запрос = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьЗапрос("ключ=значение");
	Фрагмент = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьФрагмент("часть 1");

	// Проверка
	Ожидаем.Что(ДанныеПользователя.КодированноеЗначение).Равно(
		"%D0%B8%D0%BC%D1%8F%20%D0%BF%D0%B0%D1%80%D0%BE%D0%BB%D1%8C"
	);
	Ожидаем.Что(Путь.Представление).Равно("/каталог/новый%20файл");
	Ожидаем.Что(Запрос.КодированноеЗначение).Равно(
		"%D0%BA%D0%BB%D1%8E%D1%87=%D0%B7%D0%BD%D0%B0%D1%87%D0%B5%D0%BD%D0%B8%D0%B5"
	);
	Ожидаем.Что(Фрагмент.Представление).Равно("часть%201");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Путь", "/bad%", "url.invalid_percent_encoding")
&ИсточникЗначение("Запрос", "a#b", "url.invalid_syntax")
&ИсточникЗначение("Фрагмент", "a#b", "url.invalid_syntax")
Процедура ТестДолжен_ОтклонитьНедопустимыйКодированныйКомпонент(
	ВидКомпонента,
	Значение,
	ОжидаемыйКод
) Экспорт

	// Подготовка

	// Действие и Проверка
	Попытка
		Если ВидКомпонента = "Путь" Тогда
			Результат = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПроверитьКодированныйПуть(Значение);
		ИначеЕсли ВидКомпонента = "Запрос" Тогда
			Результат = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПроверитьКодированныйЗапрос(Значение);
		Иначе
			Результат = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПроверитьКодированныйФрагмент(Значение);
		КонецЕсли;
	Исключение
		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке())).Равно(ОжидаемыйКод);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка кодированного компонента";

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодготовитьОтдельныеКомпонентыURL() Экспорт

	// Подготовка

	// Действие
	Схема = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьСхему("git+ssh");
	Сегмент = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьСегментПути("a/b");
	Хост = СервисыБиблиотекиURL.РазборщикКомпонентовURL().РазобратьДекодированныйХост("2001:db8::1");
	Порт = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьПорт(8080);

	// Проверка
	Ожидаем.Что(Схема).Равно("git+ssh");
	Ожидаем.Что(Сегмент.КодированноеЗначение).Равно("a%2Fb");
	Ожидаем.Что(Хост.КодированныйХост).Равно("[2001:db8::1]");
	Ожидаем.Что(Хост.ВидХоста).Равно(ВидыХостаURL.IPv6());
	Ожидаем.Что(Порт).Равно("8080");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Схема", "1bad", "url.invalid_scheme")
&ИсточникЗначение("Хост", "host:80", "url.invalid_host")
&ИсточникЗначение("Порт", "8a", "argument.invalid_value")
Процедура ТестДолжен_ОтклонитьНедопустимыйОтдельныйКомпонент(Компонент, Значение, ОжидаемыйКод) Экспорт

	// Подготовка

	// Действие и Проверка
	Попытка
		Если Компонент = "Схема" Тогда
			Результат = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьСхему(Значение);
		ИначеЕсли Компонент = "Хост" Тогда
			Результат = СервисыБиблиотекиURL.РазборщикКомпонентовURL().РазобратьДекодированныйХост(Значение);
		Иначе
			Результат = СервисыБиблиотекиURL.РазборщикКомпонентовURL().ПодготовитьПорт(Значение);
		КонецЕсли;
	Исключение
		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке())).Равно(ОжидаемыйКод);
		Возврат;
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка отдельного компонента";

КонецПроцедуры

#КонецОбласти
