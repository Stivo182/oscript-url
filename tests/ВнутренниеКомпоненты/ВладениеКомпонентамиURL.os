#Использовать asserts
#Использовать "../../src"
#Использовать "../../src/internal"

#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьСнимокСобственныхКомпонентовURL() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/path");

	// Действие
	Компоненты = Адрес.СнимокКомпонентов();

	// Проверка
	Ожидаем.Что(ТипЗнч(Компоненты)).Равно(Тип("ФиксированнаяСтруктура"));
	Ожидаем.Что(Компоненты.Схема).Равно("https");
	Ожидаем.Что(Компоненты.КодированныйХост).Равно("example.com");
	Ожидаем.Что(Компоненты.КодированныйПуть).Равно("/path");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеизменяемыеСнимкиКомпонентов() Экспорт

	// Подготовка
	Адрес = Новый URL("https://example.com/path");

	// Действие
	ПервыйСнимок = Адрес.СнимокКомпонентов();
	ВторойСнимок = Адрес.СнимокКомпонентов();

	// Проверка
	Ожидаем.Что(ТипЗнч(ПервыйСнимок)).Равно(Тип("ФиксированнаяСтруктура"));
	Ожидаем.Что(ТипЗнч(ВторойСнимок)).Равно(Тип("ФиксированнаяСтруктура"));
	Ожидаем.Что(ВторойСнимок.Схема).Равно("https");
	Ожидаем.Что(ВторойСнимок.КодированныйПуть).Равно("/path");
	Ожидаем.Что(Адрес.ВСтроку()).Равно("https://example.com/path");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВычислитьПроизводныеКомпонентыБезПовторногоРазбора() Экспорт

	// Подготовка
	Адрес = Новый URL(
		"https://user%20name:p%40ss@xn--e1afmkfd.xn--p1ai:443/a%2Fb/c?q=%D1%8F#f%20g"
	);

	// Действие и Проверка
	Ожидаем.Что(Адрес.СервернаяЧасть()).Равно("user name:p@ss@пример.рф:443");
	Ожидаем.Что(Адрес.ДанныеПользователя()).Равно("user name:p@ss");
	Ожидаем.Что(Адрес.Хост()).Равно("пример.рф");
	Ожидаем.Что(Адрес.IDNХост()).Равно("xn--e1afmkfd.xn--p1ai");
	Ожидаем.Что(Адрес.Порт()).Равно(443);
	Ожидаем.Что(Адрес.СтандартныйПорт()).Равно(443);
	Ожидаем.Что(Адрес.ЭффективныйПорт()).Равно(443);
	Ожидаем.Что(Адрес.ИспользуетСтандартныйПорт()).Равно(Истина);
	Ожидаем.Что(Адрес.Путь()).Равно("/a/b/c");
	Ожидаем.Что(Адрес.КодированныеСегментыПути()[1]).Равно("a%2Fb");
	Ожидаем.Что(Адрес.СегментыПути()[1]).Равно("a/b");
	Ожидаем.Что(Адрес.ПутьИСтрокаЗапроса()).Равно("/a%2Fb/c?q=%D1%8F");
	Ожидаем.Что(Адрес.СтрокаЗапроса()).Равно("q=я");
	Ожидаем.Что(Адрес.Фрагмент()).Равно("f g");

КонецПроцедуры

#КонецОбласти
