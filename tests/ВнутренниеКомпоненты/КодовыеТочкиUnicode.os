#Использовать asserts
#Использовать errors
#Использовать "../../src"
#Использовать "../../src/internal"

#Область Тесты

&Тест
Процедура ТестДолжен_ПреобразоватьСтрокуВКодовыеТочкиИОбратно() Экспорт

	// Подготовка
	ИсходнаяСтрока = "A" + Символ(55357) + Символ(56832);

	// Действие
	Точки = КодовыеТочкиUnicode.ИзСтроки(ИсходнаяСтрока);
	Результат = КодовыеТочкиUnicode.ВСтроку(Точки);

	// Проверка
	Ожидаем.Что(Точки.Количество()).Равно(2);
	Ожидаем.Что(Точки[0]).Равно(65);
	Ожидаем.Что(Точки[1]).Равно(128512);
	Ожидаем.Что(Результат).Равно(ИсходнаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(55296)
&ИсточникЗначение(56320)
Процедура ТестДолжен_ВернутьНеопределеноДляОдиночногоСуррогата(КодСуррогата) Экспорт

	// Подготовка
	// Код суррогата передан параметром теста.

	// Действие
	Результат = КодовыеТочкиUnicode.ИзСтроки(Символ(КодСуррогата));

	// Проверка
	Ожидаем.Что(Результат).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(9, Неопределено)
&ИсточникЗначение(10, 0)
&ИсточникЗначение(25, 1)
&ИсточникЗначение(30, Неопределено)
Процедура ТестДолжен_НайтиДиапазонДвоичнымПоиском(Значение, ОжидаемыйИндекс) Экспорт

	// Подготовка
	Начала = Новый ФиксированныйМассив(МассивЗначений(10, 20));
	Концы = Новый ФиксированныйМассив(МассивЗначений(15, 25));

	// Действие
	Результат = КодовыеТочкиUnicode.ИндексДиапазона(Значение, Начала, Концы);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемыйИндекс);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(-1)
&ИсточникЗначение(55296)
&ИсточникЗначение(57343)
&ИсточникЗначение(1114112)
Процедура ТестДолжен_ОтклонитьНедопустимуюКодовуюТочкуПриСборкеСтроки(КодоваяТочка) Экспорт

	// Подготовка
	НедопустимыеКодовыеТочки = Новый Массив;
	НедопустимыеКодовыеТочки.Добавить(КодоваяТочка);
	КодОшибки = Неопределено;

	// Действие
	Попытка
		КодовыеТочкиUnicode.ВСтроку(НедопустимыеКодовыеТочки);
	Исключение
		КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("argument.invalid_value");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МассивЗначений(Первое, Второе)

	Результат = Новый Массив;
	Результат.Добавить(Первое);
	Результат.Добавить(Второе);
	Возврат Результат;

КонецФункции

#КонецОбласти
