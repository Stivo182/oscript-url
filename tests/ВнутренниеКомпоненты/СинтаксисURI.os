#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("http", Истина)
&ИсточникЗначение("git+ssh", Истина)
&ИсточникЗначение("a.b-c", Истина)
&ИсточникЗначение("1http", Ложь)
&ИсточникЗначение("ht_tp", Ложь)
&ИсточникЗначение("", Ложь)
Процедура ТестДолжен_ПроверитьСхему(Значение, ОжидаемыйРезультат) Экспорт

	// Действие
	Результат = СинтаксисURI.ЭтоДопустимаяСхема(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемыйРезультат);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("0", Истина)
&ИсточникЗначение("A", Истина)
&ИсточникЗначение("f", Истина)
&ИсточникЗначение("G", Ложь)
&ИсточникЗначение("я", Ложь)
Процедура ТестДолжен_ПроверитьШестнадцатеричныйСимвол(Символ, ОжидаемыйРезультат) Экспорт

	// Действие
	Результат = СинтаксисURI.ЭтоШестнадцатеричныйСимвол(Символ);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемыйРезультат);

КонецПроцедуры

