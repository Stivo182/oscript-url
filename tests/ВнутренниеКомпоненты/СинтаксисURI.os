&ИсточникЗначение("0", 0)
&ИсточникЗначение("9", 9)
&ИсточникЗначение("A", 10)
&ИсточникЗначение("f", 15)
Процедура ТестДолжен_ПреобразоватьШестнадцатеричныйСимвол(Символ, ОжидаемоеЗначение) Экспорт

	// Действие
	Результат = КодированиеКомпонентовURI.ЗначениеШестнадцатеричногоСимвола(Символ);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемоеЗначение);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(0, "00")
&ИсточникЗначение(15, "0F")
&ИсточникЗначение(32, "20")
&ИсточникЗначение(255, "FF")
Процедура ТестДолжен_ПреобразоватьБайтВШестнадцатеричнуюСтроку(Байт, ОжидаемаяСтрока) Экспорт

	// Действие
	Результат = КодированиеКомпонентовURI.ШестнадцатеричноеПредставлениеБайта(Байт);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемаяСтрока);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("A", Истина, Ложь)
&ИсточникЗначение("z", Истина, Ложь)
&ИсточникЗначение("0", Ложь, Истина)
&ИсточникЗначение("9", Ложь, Истина)
&ИсточникЗначение("я", Ложь, Ложь)
Процедура ТестДолжен_РазличитьБуквыИЦифрыASCII(Символ, ОжидаетсяБуква, ОжидаетсяЦифра) Экспорт

	// Подготовка

	// Действие
	ЭтоБуква = СинтаксисURI.ЭтоБукваASCII(Символ);
	ЭтоЦифра = СинтаксисURI.ЭтоЦифраASCII(Символ);

	// Проверка
	Ожидаем.Что(ЭтоБуква).Равно(ОжидаетсяБуква);
	Ожидаем.Что(ЭтоЦифра).Равно(ОжидаетсяЦифра);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("00", 0)
&ИсточникЗначение("0f", 15)
&ИсточникЗначение("A0", 160)
&ИсточникЗначение("FF", 255)
&ИсточникЗначение("G0", Неопределено)
&ИсточникЗначение("F", Неопределено)
Процедура ТестДолжен_ПреобразоватьШестнадцатеричноеПредставлениеБайта(Значение, ОжидаемыйБайт) Экспорт

	// Действие
	Результат = КодированиеКомпонентовURI.ЗначениеШестнадцатеричногоБайта(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемыйБайт);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("", Истина)
&ИсточникЗначение("0123456789", Истина)
&ИсточникЗначение("12a", Ложь)
&ИсточникЗначение("١٢", Ложь)
&ИсточникЗначение(Неопределено, Истина)
Процедура ТестДолжен_ПроверитьСтрокуИзЦифрASCII(Значение, ОжидаемыйРезультат) Экспорт

	// Действие
	Результат = СинтаксисURI.ТолькоЦифрыASCII(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемыйРезультат);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ascii", Ложь)
&ИсточникЗначение("café", Истина)
&ИсточникЗначение("😀", Истина)
Процедура ТестДолжен_НайтиСимволыВнеASCII(Значение, ОжидаемыйРезультат) Экспорт

	// Действие
	Результат = СинтаксисURI.СодержитСимволыВнеASCII(Значение);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемыйРезультат);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ЗарегистрированноеИмя", "!", Истина)
&ИсточникЗначение("ЗарегистрированноеИмя", ":", Ложь)
&ИсточникЗначение("Путь", "/", Истина)
&ИсточникЗначение("Путь", "?", Ложь)
&ИсточникЗначение("СегментПути", ":", Истина)
&ИсточникЗначение("СегментПути", "/", Ложь)
&ИсточникЗначение("ИмяПользователя", ":", Ложь)
&ИсточникЗначение("ДанныеПользователя", ":", Истина)
&ИсточникЗначение("ЗапросИФрагмент", "?", Истина)
&ИсточникЗначение("ЗапросИФрагмент", "#", Ложь)
Процедура ТестДолжен_ПроверитьНаборДопустимыхСимволов(Набор, Символ, ОжидаемыйРезультат) Экспорт

	// Подготовка

	Если Набор = "ЗарегистрированноеИмя" Тогда
		ДопустимыеСимволы = СинтаксисURI.ДопустимыеСимволыЗарегистрированногоИмени();
	ИначеЕсли Набор = "Путь" Тогда
		ДопустимыеСимволы = СинтаксисURI.ДопустимыеСимволыПути();
	ИначеЕсли Набор = "СегментПути" Тогда
		ДопустимыеСимволы = СинтаксисURI.ДопустимыеСимволыСегментаПути();
	ИначеЕсли Набор = "ИмяПользователя" Тогда
		ДопустимыеСимволы = СинтаксисURI.ДопустимыеСимволыИмениПользователя();
	ИначеЕсли Набор = "ДанныеПользователя" Тогда
		ДопустимыеСимволы = СинтаксисURI.ДопустимыеСимволыДанныхПользователя();
	Иначе
		ДопустимыеСимволы = СинтаксисURI.ДопустимыеСимволыЗапросаИФрагмента();
	КонецЕсли;

	// Действие
	Результат = СтрНайти(ДопустимыеСимволы, Символ) > 0;

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемыйРезультат);

КонецПроцедуры

#КонецОбласти
